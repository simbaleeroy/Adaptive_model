@Test
public void GIVEN_backfillTenantId_WHEN_ccgTenantIdIsNull_THEN_updatesDatabase() throws Exception {
    // Arrange
    CrossConnectGroupDo crossConnectGroupDo = generateCrossConnectGroupDo(crossConnectGroupBl);
    String ccgID = crossConnectGroupDo.getId();
    String tenantID = IdentityMetadataHelper.TENANT_ID_LOCAL;

    try (Transaction t = crossConnectGroupBl.beginTransaction("test")) {
        crossConnectGroupBl.getBucket().put(t, crossConnectGroupDo.toBuilder().tenantId(null).build());
        t.commit();
    }

    // Act
    CrossConnectGroupDo result = crossConnectGroupBl.backfillTenantId(ccgID, tenantID);

    // Assert
    assertEquals(tenantID, result.getTenantId());
}
