    @DELETE
    @Timed(name = "deleteIPNetworkVCNConnection")
    @Path("/ipnetworkvcnconnections/{ipnetworkvcnconnection-id}/")
    @VpnSkipAuthorization
    public Response deleteIPNetworkVCNConnection(@PathParam("ipnetworkvcnconnection-id") String ipnetworkvcnconnectionId) throws Exception {


        log.info("Starting to delete the IPNetworkVCNConnection: {}", ipnetworkvcnconnectionId);
        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = workRequestBl.beginTransaction("delete-ipnetworkvcnconnection-workflow")) {
                IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo = ipNetworkVCNConnectionBl.getOrThrow(t, ipnetworkvcnconnectionId);

                log.info("Marking IPNetworkVCNConnectionDo for termination");
                ipNetworkVCNConnectionBl.update(t,
                        ipNetworkVCNConnectionDo.toBuilder().state(IPNetworkVCNConnectionDo.State.Terminating).build());

                log.info("Launching workflow to delete the IPNetworkVCNConnection(IPNetworkVCNConnectionDo={})", ipNetworkVCNConnectionDo);
                WorkRequestDo workRequestDo = IPNetworkVCNConnectionHelper.buildDeleteIPNetworkVCNConnectionWorkRequest(ipNetworkVCNConnectionDo,
                        limitsHelper.checkCustomerTenancyByTenantId(ipNetworkVCNConnectionDo.getTenantId()), RequestIdHolder.get());
                workRequestDo = workRequestBl.create(t, workRequestDo);

                String message = String.format("Created WorkRequestDo for workflow to delete the connection. (workRequestDo=%s)", workRequestDo);
                log.info(message);
                t.commit();
            }

            return Response.accepted().build();
        });
    }

    @POST
    @Timed(name = "createIPNetworkVCNConnection")
    @Path("/ipnetworkvcnconnection")
    @VpnSkipAuthorization
    public IPNetworkVCNConnection createIPNetworkVCNConnection(@Valid @NonNull CreateIPNetworkConnectionDetails request) throws Exception {

        log.info("Validating Create IPNetworkVCNConnection request");
        String drgCompartmentId;
        VirtualCircuitDo.GatewayType gatewayType;
        if (drgV2Helper.isDrgV2(request.getDrgId())) {
            Optional<Drg> drgV2 = drgV2Helper.getDrgV2(request.getDrgId());
            drgCompartmentId = (drgV2.isPresent()) ? drgV2.get().getCompartmentId() : "";
            gatewayType = VirtualCircuitDo.GatewayType.DRG_V2;
        } else {
            DrgDo drgDo = drgBl.getOrThrow(request.getDrgId());
            drgCompartmentId = drgDo.getCompartmentId();
            gatewayType = VirtualCircuitDo.GatewayType.DRG;
        }

        String tenantId = identityHelper.getTenantId(drgCompartmentId);
        if (!request.getTenantId().equals(tenantId)) {
            throw new ValidationException(
                    ErrorCode.InvalidParameter,
                    String.format("Tenant Id does not match. (TenantId=%s, DrgId=%s, QueriedTenantId=%s)",
                            request.getTenantId(),
                            request.getDrgId(),
                            tenantId));
        }

        try {
            PrivateGatewayResponse privateGatewayResponse = ociClassicFastConnectClient.getPrivateGateway(request.getOcicPgwName());
            if (privateGatewayResponse == null
                    || privateGatewayResponse.getResult() == null
                    || privateGatewayResponse.getResult().size() == 0
                    || !privateGatewayResponse.getResult().stream().anyMatch(p -> request.getOcicPgwName().equals(p.getName()))) {
                throw new InvalidParameterException(
                        String.format(
                                "PrivateGatewayResponse or its result is null or empty for give private gateway name. (PrivateGatewayName=%s)",
                                request.getOcicPgwName()));
            }
        } catch (Exception e) {
            log.error(e.toString());
            throw new ValidationException(
                    ErrorCode.InvalidParameter,
                    String.format("Cannot find given private gateway name. (PrivateGatewayName=%s, IdentityDomain=%s)",
                            request.getOcicPgwName(),
                            request.getOcicIdentityDomainName()));
        }

        IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo = IPNetworkVCNConnectionDo.builder()
                .tenantId(request.getTenantId())
                .drgId(request.getDrgId())
                .ocicIdentityDomainName(request.getOcicIdentityDomainName())
                .ocicPgwName(request.getOcicPgwName())
                .build();

        IPNetworkVCNConnectionDo ipNetworkVCNConnectionDoFinal = ipNetworkVCNConnectionDo;

        log.info("Creating ipNetworkVCNConnectionDo. (ipNetworkVCNConnectionDo={})", ipNetworkVCNConnectionDo);
        return withRetriesOnCommitConflictException(() -> {

            IPNetworkVCNConnectionDo ipNetworkVCNConnectionDoRes;
            try (Transaction t = ipNetworkVCNConnectionBl.beginTransaction("create-ipnetworkvcnconnection")) {

                final String compartmentId = propertiesBl.getOrThrow(t, IPNetworkVCNConnectionBl.OCI_CLASSIC_INTEGRATION_TENANT_COMPARTMENT).getValue();
                // provider compartment name in LHR, IAD: ociclassic_fastconnect_comp
                // provider compartment name in SYD, GRU: OPC_fastconnect_prov_comp
                final String providerCompartmentId = propertiesBl.getOrThrow(t, IPNetworkVCNConnectionBl.OCI_CLASSIC_INTEGRATION_PROVIDER_COMPARTMENT).getValue();
                final String providerServiceId = propertiesBl.getOrThrow(t, IPNetworkVCNConnectionBl.OCI_CLASSIC_INTEGRATION_PROVIDER_SERVICE).getValue();

                IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo1 = ipNetworkVCNConnectionBl.create(t, ipNetworkVCNConnectionDoFinal);

                log.info("Creating Internal Virtual Circuit for IPNetworkVCNConnectionDo {}", ipNetworkVCNConnectionDo1.getId());
                VirtualCircuitDo internalVcDo = VirtualCircuitDo.builder()
                        .compartmentId(compartmentId)
                        .providerCompartmentId(providerCompartmentId)
                        .providerServiceId(providerServiceId)
                        .displayName(ipNetworkVCNConnectionBl.generateDisplayName(request.getCustomerAccountName()))
                        .gatewayId(ipNetworkVCNConnectionDo1.getDrgId())
                        .gatewayType(gatewayType)
                        .ipAddressType(VirtualCircuitDo.IpAddressType.PRIVATE)
                        .maxPrefix(VirtualCircuitDo.getDefaultVirtualCircuitMaxPrefix(VirtualCircuitDo.IpAddressType.PRIVATE))
                        .bandwidthInMbps(VirtualCircuitValidationHelper.getBandwidthInMbps(IPNetworkVCNConnectionBl.OCI_VC_BANDWIDTH))
                        .oracleBgpAsn(regionBgpAsn.intValue())
                        .ociClassicIntegrationType(VirtualCircuitDo.OciClassicIntegrationType.OCI_CLASSIC_IPNW_VCN)
                        .tenantId(tenantId)
                        .build();

                internalVcDo = virtualCircuitBl.createWithL3Provider(t, internalVcDo);
                String msg = String.format("Created Internal Virtual Circuit %s", internalVcDo.getId());
                IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo2 = ipNetworkVCNConnectionBl.update(t,
                        ipNetworkVCNConnectionDo1.toBuilder()
                                .compartmentId(compartmentId)
                                .virtualCircuitId(internalVcDo.getId())
                                .displayName(internalVcDo.getDisplayName())
                                .stateComment(msg)
                                .build());
                eventBl.create(t, ipNetworkVCNConnectionDo2.getId(), Component.WORKER, msg);

                String ociClassicVcName = String.format("%s/%s",
                        ociClassicFastConnectClient.getUser(),
                        ipNetworkVCNConnectionDo2.getDisplayName());
                VirtualCircuitPostRequest postRequest = VirtualCircuitPostRequest.builder()
                        .name(ociClassicVcName)
                        .gatewayId(request.getOcicPgwName())
                        .referenceId(ipNetworkVCNConnectionDo2.getId())
                        .bandwidthShapeName(IPNetworkVCNConnectionBl.OCI_CLASSIC_VC_BANDWDITH)
                        .customerBgpAsn(internalVcDo.getOracleBgpAsn())
                        .type(VirtualCircuitPostRequest.Type.Private)
                        .build();

                log.info("Calling OCI Classic to create OciClassicVirtualCircuit with request {} internalVcDo {}", postRequest, internalVcDo);
                VirtualCircuitResponse virtualCircuitResponse = ociClassicFastConnectClient.addVirtualCircuit(postRequest);

                msg = String.format("Created OCI Classic Virtual Circuit %s for ipnetworkVCNConnectonDo %s response %s.",
                        virtualCircuitResponse.getId(), ipNetworkVCNConnectionDo2.getId(), virtualCircuitResponse);
                IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo3 = ipNetworkVCNConnectionDo2.toBuilder()
                        .ocicVirtualCircuitId(virtualCircuitResponse.getId())
                        .ocicVirtualCircuitName(virtualCircuitResponse.getName())
                        .build();
                IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo4 = ipNetworkVCNConnectionBl.update(t, ipNetworkVCNConnectionDo3);
                log.info(msg);
                eventBl.create(t, ipNetworkVCNConnectionDo4.getId(), Component.WORKER, msg);

                OciClassicVirtualCircuitDo ociClassicVirtualCircuitDo = OciClassicVirtualCircuitDo.builder()
                        .id(internalVcDo.getId())
                        .ociClassicVcId(virtualCircuitResponse.getId())
                        .build();

                ociClassicVirtualCircuitBl.create(t, ociClassicVirtualCircuitDo);

                log.info("Launching workflow to provision the connection");
                Boolean isCustomer = limitsHelper.checkCustomerTenancyByTenantId(tenantId);
                WorkRequestDo workRequestDo = IPNetworkVCNConnectionHelper.buildProvisionIPNetworkVCNConnectionWorkRequest(
                        ipNetworkVCNConnectionDo4, isCustomer, RequestIdHolder.get());
                workRequestDo = workRequestBl.create(t, workRequestDo);

                log.info("WorkRequestDo = {}", workRequestDo);

                String message = String.format("Created WorkRequestDo for workflow to provision the connection. (workRequestDo=%s)", workRequestDo);
                log.info(message);
                t.commit();

                ipNetworkVCNConnectionDoRes = ipNetworkVCNConnectionDo4;
            }

            return toModel(ipNetworkVCNConnectionDoRes);
        });
    }

    @GET
    @Path("/vpnInternalConsumption")
    @Timed(name = "listInternalVpnConsumptions")
    @VpnSkipAuthorization
    public PaginatedResponse<LimitConsumption> listVpnConsumptions(
            @DefaultValue("100") @QueryParam(Params.LIMIT) int limit,
            @QueryParam("compartmentId") String compartmentId,
            @QueryParam(Params.PAGE) String opaqueToken)
            throws AuthServerUnavailableException, CompartmentQuotaException {

        if (compartmentId.equals("all")) {
            return listVpnQuotasConsumptions(5000, null);
        }

        String tenantId = compartmentId;

        List<LimitConsumption> limitConsumptionList = ResourceUtils.getVpnConsumptionForTenant(
                tenantId, vpnLimitsHelper, true);

        return new PaginatedResponse<>(limitConsumptionList);
    }

    private IPNetworkVCNConnection toModel(IPNetworkVCNConnectionDo ipNetworkVCNConnectionDo) {

        return IPNetworkVCNConnection.builder()
                .id(ipNetworkVCNConnectionDo.getId())
                .tenantId(ipNetworkVCNConnectionDo.getTenantId())
                .compartmentId(ipNetworkVCNConnectionDo.getCompartmentId())
                .drgId(ipNetworkVCNConnectionDo.getDrgId())
                .virtualCircuitId(ipNetworkVCNConnectionDo.getVirtualCircuitId())
                .ocicIdentityDomainName(ipNetworkVCNConnectionDo.getOcicIdentityDomainName())
                .ocicPgwName(ipNetworkVCNConnectionDo.getOcicPgwName())
                .ocicVirtualCircuitId(ipNetworkVCNConnectionDo.getOcicVirtualCircuitId())
                .reference(ipNetworkVCNConnectionDo.getReference())
                .state(IPNetworkVCNConnection.State.valueOf(ipNetworkVCNConnectionDo.getState().toString()))
                .build();
    }

    @GET
    @Path("/vpnQuotasConsumption")
    @Timed(name = "listQuotasVpnConsumptions")
    @VpnSkipAuthorization
    public PaginatedResponse<LimitConsumption> listVpnQuotasConsumptions(
            @DefaultValue("1000") @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken)
            throws AuthServerUnavailableException, CompartmentQuotaException {

        Set<String> tenantsInQuotasTable = new HashSet<>();

        List<ColumnValueSet> allRows = KievGetRawData.scanBucketRawdata(deviceBl.getMappedDataStore(),
                NetworkTopologyDaoModule.Buckets.COMPARTMENT_QUOTAS.getKievName());
        for (ColumnValueSet row : allRows) {
            String tenantId = row.getString("TENANTID");
            tenantsInQuotasTable.add(tenantId);
        }

        List<LimitConsumption> limitConsumptionForAllTennats = new ArrayList<>();
        for (String tenantId : tenantsInQuotasTable) {
            List<LimitConsumption> limitConsumptionPerTenant = ResourceUtils.getVpnConsumptionForTenant(
                    tenantId, vpnLimitsHelper, true);
            limitConsumptionForAllTennats.addAll(limitConsumptionPerTenant);
        }

        return new PaginatedResponse<>(limitConsumptionForAllTennats);
    }

    @PUT
    @Path("/crossConnectGroups/{crossConnectGroupId}/migratePorts")
    @Timed(name = "migratePortsForCrossConnectGroup")
    @VpnSkipAuthorization
    public Response migratePortsForCrossConnectGroup(
            @NonNull @PathParam("crossConnectGroupId") String crossconnectgroupId,
            @Valid @NonNull MigratePortsForCrossConnectGroupRequest migratePortsForCrossConnectGroupRequest)
            throws ValidationException, CommitConflictException, AuthServerUnavailableException {

        CrossConnectGroupDo crossConnectGroupDo;
        if (migratePortsForCrossConnectGroupRequest.getRequestType().equals(MigratePortsForCrossConnectGroupRequest.RequestType.Reprovisioning)) {

            log.info("Starting to Migrate Ports Reprovisioning for CCG {}", crossconnectgroupId);
            try (Transaction t = crossConnectBl.beginTransaction("migratePortsForCrossConnectGroupReprovisioning")) {
                crossConnectGroupDo = crossConnectGroupBl.getOrThrow(t, crossconnectgroupId);
                if (!crossConnectGroupDo.getState().equals(CrossConnectGroupDo.State.MIGRATING)
                        && !crossConnectGroupDo.getState().equals(CrossConnectGroupDo.State.PROVISIONING)) {
                    throw new ValidationException(
                            ErrorCode.IncorrectState,
                            String.format("CrossConnectGroupDo %s is not in MIGRATING or PROVISIONING state and cannot launch Port migration.",
                                    crossConnectGroupDo));
                }

                Boolean isCustomer = limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectGroupDo.getCompartmentId());
                log.info("Launching Reprovision workflow to Migrate Ports for {}", crossconnectgroupId);
                WorkRequestDo workRequestDo = PortMigrationUtils.buildMigratePortsReprovisioningWorkRequest(crossConnectGroupDo, isCustomer);
                workRequestDo = workRequestBl.create(t, workRequestDo);

                // Update KievTxTimestamp() to prevent Workflow step in-tempered exception
                PortMigrationBackupDo portMigrationBackupDo = portMigrationBackupBl.getOrThrow(crossconnectgroupId);
                portMigrationBackupBl.update(t, portMigrationBackupDo.toBuilder().lastKievTxTimestamp(workRequestDo.getKievTxTimestamp()).build());

                String message = String.format("Created WorkRequestDo for workflow to provision the connection. (workRequestDo=%s)", workRequestDo);
                log.info(message);
                eventBl.create(t, crossconnectgroupId, Component.API, message);

                t.commit();
            }
        } else {

            log.info("Starting to Migrate Ports Deprovisioning for CCG {}", crossconnectgroupId);
            Set<String> virtualCircuitIds = Collections.emptySet();
            try (Transaction t = crossConnectGroupBl.beginTransaction("migratePortsForCrossConnectGroupDeprovisioning")) {

                log.info("Validating MigratePortsForCrossConnectGroup Request {} for CrossConnectGroup {}",
                        migratePortsForCrossConnectGroupRequest, crossconnectgroupId);

                crossConnectGroupDo = crossConnectGroupBl.getOrThrow(t, crossconnectgroupId);
                PortMigrationUtils.validateCrossConnectGroupState(crossConnectGroupDo);

                if (crossConnectGroupDo.getVcsToVlans() != null && crossConnectGroupDo.getVcsToVlans().size() > 0) {
                    virtualCircuitIds = crossConnectGroupDo.getVcsToVlans().keySet();
                    for (String virtualCircuitId : virtualCircuitIds) {
                        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
                        PortMigrationUtils.validateVirtualCircuitState(virtualCircuitDo);
                    }
                }

                PortMigrationUtils.validateCrossConnectsInGroupAndMatch(
                        crossConnectGroupDo, migratePortsForCrossConnectGroupRequest.getCrossConnectAndInterfacePairList());
                for (CrossConnectAndInterfacePair pair : migratePortsForCrossConnectGroupRequest.getCrossConnectAndInterfacePairList()) {
                    Optional<InterfaceDo> interfaceDoOpt = interfaceBl.getInterfaceByName(
                            t, pair.getInterfaceName(), migratePortsForCrossConnectGroupRequest.getDeviceId());
                    PortMigrationUtils.isInterfacePresent(interfaceDoOpt);

                    InterfaceDo interfaceDo = interfaceDoOpt.get();
                    PortMigrationUtils.validateInterfaceState(interfaceDo);
                }

                String oldDeviceId = crossConnectBl.getDeviceId(crossConnectGroupDo);
                DeviceDo oldDeviceDo = deviceBl.getOrThrow(t, oldDeviceId);
                DeviceDo newDeviceDo = deviceBl.getOrThrow(t, migratePortsForCrossConnectGroupRequest.getDeviceId());
                PortMigrationUtils.validateDevicesState(oldDeviceDo, newDeviceDo);

                log.info("Completed validating resource states and begin to migrate ports for {}", crossconnectgroupId);

                log.info("Updating resource state to Migrating for {}", crossconnectgroupId);
                crossConnectGroupDo = crossConnectGroupBl.update(
                        t, crossConnectGroupDo.toBuilder().state(CrossConnectGroupDo.State.MIGRATING).build());
                for (String crossConnectId : crossConnectGroupDo.getCrossConnectIds()) {
                    CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectId);
                    crossConnectBl.update(t, crossConnectDo.toBuilder().state(CrossConnectDo.State.MIGRATING).build());
                }

                for (String virtualCircuitId : virtualCircuitIds) {
                    VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(t, virtualCircuitId);
                    virtualCircuitBl.update(t, virtualCircuitDo.toBuilder().state(VirtualCircuitDo.State.MIGRATING).build());
                }

                log.info("Cleaning up previous Backup for {} if any", crossconnectgroupId);
                PortMigrationUtils.cleanupPortMigrationBackup(portMigrationBackupBl, crossconnectgroupId, t);

                log.info("Creating Migration Backup for {}", crossconnectgroupId);
                PortMigrationUtils.createMigrationBackup(crossConnectGroupDo,
                        portMigrationBackupBl, configSnippetBl, virtualCircuitBl, bgpBl, crossConnectBl, virtualCircuitIds, t);

                for (CrossConnectAndInterfacePair pair : migratePortsForCrossConnectGroupRequest.getCrossConnectAndInterfacePairList()) {
                    log.info("Updating CrossConnect {} from CrossConnectGroup {} with new device and interface, and updating its PPPP & LOA state",
                            pair.getCrossConnectId(), crossconnectgroupId);
                    CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(t, pair.getCrossConnectId());
                    Optional<InterfaceDo> interfaceDoOpt = interfaceBl.getInterfaceByName(
                            t, pair.getInterfaceName(), migratePortsForCrossConnectGroupRequest.getDeviceId());

                    Optional<PatchPanelPortPairDo> oldPatchPanelPortPairDo = patchPanelPortPairBl.getPortPairByInterface(t, crossConnectDo.getInterfaceId());
                    patchPanelPortPairBl.update(t, oldPatchPanelPortPairDo.get().toBuilder().status(PatchPanelPortPairDo.PortStatus.Reserved).build());
                    InterfaceDo oldInterfaceDo = interfaceBl.getOrThrow(crossConnectDo.getInterfaceId());
                    interfaceBl.update(t, oldInterfaceDo.toBuilder().state(InterfaceDo.State.Reserved).build());

                    Optional<PatchPanelPortPairDo> newPatchPanelPortPairDo = patchPanelPortPairBl.getPortPairByInterface(t, interfaceDoOpt.get().getId());
                    patchPanelPortPairBl.update(t, newPatchPanelPortPairDo.get().toBuilder().status(PatchPanelPortPairDo.PortStatus.Assigned).build());
                    interfaceBl.update(t, interfaceDoOpt.get().toBuilder().state(InterfaceDo.State.Assigned).build());

                    Optional<LoaDo> loaDoOptional = loaBl.getLoa(crossConnectDo);
                    if (loaDoOptional.isPresent()) {
                        loaBl.update(t, loaDoOptional.get().toBuilder().patchPanelPortPairId(newPatchPanelPortPairDo.get().getId()).build());
                    }

                    crossConnectBl.update(t, crossConnectDo.toBuilder()
                            .deviceId(migratePortsForCrossConnectGroupRequest.getDeviceId())
                            .interfaceId(interfaceDoOpt.get().getId())
                            .build());
                }

                log.info("Launching Deprovision workflow to Migrate Ports for {}", crossconnectgroupId);
                WorkRequestDo workRequestDo = PortMigrationUtils.buildMigratePortsDeprovisioningWorkRequest(crossConnectGroupDo, oldDeviceId,
                        limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectGroupDo.getCompartmentId()));
                workRequestDo = workRequestBl.create(t, workRequestDo);

                String message = String.format("Created WorkRequestDo for workflow to provision the connection. (workRequestDo=%s)", workRequestDo);
                log.info(message);
                eventBl.create(t, crossconnectgroupId, Component.API, message);

                t.commit();
            }
        }

        return Response.ok(crossConnectGroupBl.toModel(encryptionManager, deviceBl, crossConnectBl, crossConnectGroupDo)).build();
    }

    @POST
    @Timed(name = "SaveGeneratedBOM")
    @Produces("application/json")
    @Path("/bom/saveGeneratedBOM")
    @VpnSkipAuthorization
    public SaveGeneratedBOMResponseDetails saveGeneratedBOM(@HeaderParam(Headers.RETRY_TOKEN) String opcRetryToken, @HeaderParam(Headers.REQUEST_ID) String opcRequestId,
                                                            SaveGeneratedBOMRequestDetails request) throws CommitConflictException, ValidationException, CsvRequiredFieldEmptyException, CsvDataTypeMismatchException, IOException {
        log.info("save Generated BOM request received with opc-request-id : {}, opc-retry-token: {} and request : {}"
                ,opcRequestId, opcRetryToken,mapper.writeValueAsString(request));
        try(MetricsScope scope = MetricsScope.parent(API_SAVE_GENERATED_BOM, true, false)) {
            metricHelper.setupScopeDimensions(scope, null, false, false);

            Transaction t = bomBl.beginTransaction("save-generated-bom");
            BOMSDo BOMSDo = bomBl.createBOM(t, prepareBOMDo(request,opcRequestId));
            t.commit();
            scope.emit(MetricConstants.SUCCESS, 1);
            return this.toModel(BOMSDo);
        }
    }

    private BOMSDo prepareBOMDo(SaveGeneratedBOMRequestDetails request, String opcRequestId)
            throws JsonProcessingException {
        return BOMSDo.builder()
                .id(UUID.randomUUID().toString())
                .dateCreated(new Date())
                .jiraTicketUrl(request.getJiraTicket())
                .opcRequestId(opcRequestId)
                .boms(mapper.writeValueAsString(request.getBoms()))
                .build();
    }
    private SaveGeneratedBOMResponseDetails toModel(BOMSDo BOMSDo) {
        List<BOM> boms = new ArrayList<>();
        try{
            boms = mapper.readValue(BOMSDo.getBoms(), new TypeReference<List<BOM>>(){});
        }catch (Exception ex) {
            log.error("could not deserialize the bomdo {} ", BOMSDo.toString());
        }
        return SaveGeneratedBOMResponseDetails.builder()
                .timeCreated(BOMSDo.getDateCreated())
                .jiraTicket(BOMSDo.getJiraTicketUrl())
                .boms(boms)
                .build();
    }


    @GET
    @Timed(name = "generatedBOM")
    @Produces("application/json")
    @Path("/bom/saveGeneratedBOM")
    @VpnSkipAuthorization
    public PaginatedResponse<SaveGeneratedBOMResponseDetails> getGeneratedBOMList(
            @DefaultValue(DEFAULT_PAGE_SIZE) @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken) throws JsonProcessingException{
        return PaginationUtils.getScanPage(
                opaqueToken,
                () -> bomCreatedDateIndex.beginScan(limit, Bucket.Direction.DESCENDING),
                bomCreatedDateIndex::scan,
                this::toModel,
                bomBl.getMappedDataStore());
    }

