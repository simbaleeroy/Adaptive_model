#!/usr/bin/env python3
"""
Unit tests for file.py - OCID data retrieval functionality
"""

import unittest
from unittest.mock import Mock, patch, MagicMock, call
import json
import sys
import os
import argparse
from io import StringIO

# Add the current directory to the path to import the module
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

# Import the module under test
import file as ocid_module


class TestOCIDDataRetrieval(unittest.TestCase):
    """Test cases for OCID data retrieval functionality"""

    def setUp(self):
        """Set up test fixtures before each test method."""
        self.sample_ocid = "ocid1.crossconnect.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"
        self.sample_vc_ocid = "ocid1.virtualcircuit.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"
        self.sample_ccg_ocid = "ocid1.crossconnectgroup.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"
        
        # Sample response data
        self.sample_crossconnect_data = {
            "id": self.sample_ocid,
            "ociPhysicalDeviceName": "device-001",
            "ociLogicalDeviceName": "logical-device-001",
            "lifecycleState": "ACTIVE"
        }
        
        self.sample_virtualcircuit_data = {
            "id": self.sample_vc_ocid,
            "configSnippetAttributes": [{
                "routerName": "router-001",
                "vcInterface": "et-0/0/1"
            }],
            "crossConnectMappings": [{
                "customerBgpPeeringIp": "10.0.0.1",
                "crossConnectOrCrossConnectGroupId": self.sample_ocid
            }]
        }
        
        self.sample_crossconnectgroup_data = {
            "id": self.sample_ccg_ocid,
            "ociPhysicalDeviceName": "group-device-001",
            "lifecycleState": "ACTIVE"
        }

    def test_get_free_port(self):
        """Test get_free_port function returns a valid port number."""
        port = ocid_module.get_free_port()
        self.assertIsInstance(port, int)
        self.assertGreaterEqual(port, 1024)  # Should be a valid port number
        self.assertLessEqual(port, 65535)

    def test_init_parser(self):
        """Test argument parser initialization."""
        parser = ocid_module.init_parser()
        self.assertIsInstance(parser, argparse.ArgumentParser)
        
        # Test that required arguments are defined
        args = parser.parse_args(['--ocid', 'test-ocid', '--realm', 'oc1', '--region', 'us-phoenix-1'])
        self.assertEqual(args.ocid, 'test-ocid')
        self.assertEqual(args.realm, 'oc1')
        self.assertEqual(args.region, 'us-phoenix-1')

    @patch('requests.get')
    def test_getC3MultiAttributes_success_crossconnect(self, mock_get):
        """Test getC3MultiAttributes with successful crossconnect response."""
        # Mock error response for first type, success for crossConnect
        error_response = {"code": "NotFound", "message": "Resource not found"}
        success_response = self.sample_crossconnect_data
        
        mock_get.side_effect = [
            Mock(text=json.dumps(error_response)),  # virtualCircuit fails
            Mock(text=json.dumps(success_response)),  # crossConnect succeeds
            Mock(text=json.dumps(error_response))   # crossConnectGroup fails (won't be called)
        ]
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes(self.sample_ocid)
        
        # Verify the result
        self.assertIn('crossConnect', result)
        self.assertEqual(result['crossConnect'], self.sample_crossconnect_data)
        
        # Verify two API calls were made (virtualCircuit failed, crossConnect succeeded)
        self.assertEqual(mock_get.call_count, 2)

    @patch('requests.get')
    def test_getC3MultiAttributes_success_virtualcircuit(self, mock_get):
        """Test getC3MultiAttributes with successful virtualcircuit response."""
        # Mock successful response for virtualCircuit (first in sequence)
        mock_response = Mock()
        mock_response.text = json.dumps(self.sample_virtualcircuit_data)
        mock_get.return_value = mock_response
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes(self.sample_vc_ocid)
        
        # Verify the result
        self.assertIn('virtualCircuit', result)
        self.assertEqual(result['virtualCircuit'], self.sample_virtualcircuit_data)
        
        # Verify only one API call was made (first one succeeded)
        self.assertEqual(mock_get.call_count, 1)

    @patch('requests.get')
    def test_getC3MultiAttributes_error_response(self, mock_get):
        """Test getC3MultiAttributes with error response."""
        # Mock error response
        error_response = {"code": "NotFound", "message": "Resource not found"}
        mock_response = Mock()
        mock_response.text = json.dumps(error_response)
        mock_get.return_value = mock_response
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes(self.sample_ocid)
        
        # Should return empty dict when all requests fail
        self.assertEqual(result, {})

    def test_C3Data(self):
        """Test C3Data function."""
        test_data = {"test": "data"}
        
        # Capture print output
        with patch('builtins.print') as mock_print:
            ocid_module.C3Data(test_data)
            mock_print.assert_called_once_with(f'\n{test_data}')


class TestOCIDDataRetrievalIntegration(unittest.TestCase):
    """Integration tests for OCID data retrieval functionality"""

    def setUp(self):
        """Set up test fixtures for integration tests."""
        self.sample_ocid = "ocid1.crossconnect.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"
        self.sample_vc_ocid = "ocid1.virtualcircuit.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"
        self.sample_ccg_ocid = "ocid1.crossconnectgroup.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa"

    @patch('requests.get')
    def test_end_to_end_crossconnect_retrieval(self, mock_get):
        """Test end-to-end crossconnect data retrieval."""
        # Mock error responses for first two types, success for crossConnect
        error_response = {"code": "NotFound", "message": "Resource not found"}
        success_response = {
            "id": self.sample_ocid,
            "ociPhysicalDeviceName": "device-001",
            "ociLogicalDeviceName": "logical-device-001",
            "lifecycleState": "ACTIVE"
        }
        
        mock_get.side_effect = [
            Mock(text=json.dumps(error_response)),  # virtualCircuit fails
            Mock(text=json.dumps(success_response)),  # crossConnect succeeds
            Mock(text=json.dumps(error_response))   # crossConnectGroup fails (won't be called)
        ]
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes("test-ocid")
        
        # Verify the complete flow
        self.assertIn('crossConnect', result)
        self.assertEqual(result['crossConnect']['ociPhysicalDeviceName'], 'device-001')

    @patch('requests.get')
    def test_end_to_end_virtualcircuit_retrieval(self, mock_get):
        """Test end-to-end virtualcircuit data retrieval."""
        # Mock successful API response
        mock_response = Mock()
        mock_response.text = json.dumps({
            "id": self.sample_vc_ocid,
            "configSnippetAttributes": [{
                "routerName": "router-001",
                "vcInterface": "et-0/0/1"
            }],
            "crossConnectMappings": [{
                "customerBgpPeeringIp": "10.0.0.1",
                "crossConnectOrCrossConnectGroupId": self.sample_ocid
            }]
        })
        mock_get.return_value = mock_response
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes("test-vc-ocid")
        
        # Verify the complete flow
        self.assertIn('virtualCircuit', result)
        self.assertEqual(result['virtualCircuit']['configSnippetAttributes'][0]['routerName'], 'router-001')

    @patch('requests.get')
    def test_end_to_end_crossconnectgroup_retrieval(self, mock_get):
        """Test end-to-end crossconnectgroup data retrieval."""
        # Mock error responses for first two types, success for crossConnectGroup
        error_response = {"code": "NotFound", "message": "Resource not found"}
        success_response = {
            "id": self.sample_ccg_ocid,
            "ociPhysicalDeviceName": "group-device-001",
            "lifecycleState": "ACTIVE"
        }
        
        mock_get.side_effect = [
            Mock(text=json.dumps(error_response)),  # virtualCircuit fails
            Mock(text=json.dumps(error_response)),  # crossConnect fails
            Mock(text=json.dumps(success_response))  # crossConnectGroup succeeds
        ]
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes("test-ccg-ocid")
        
        # Verify the complete flow
        self.assertIn('crossConnectGroup', result)
        self.assertEqual(result['crossConnectGroup']['ociPhysicalDeviceName'], 'group-device-001')

    def test_error_handling_invalid_ocid(self):
        """Test error handling with invalid OCID format."""
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        with patch('requests.get') as mock_get:
            # Mock error response for all OCID types
            error_response = {"code": "InvalidParameter", "message": "Invalid OCID format"}
            mock_response = Mock()
            mock_response.text = json.dumps(error_response)
            mock_get.return_value = mock_response
            
            result = ocid_module.getC3MultiAttributes("invalid-ocid")
            self.assertEqual(result, {})

    @patch('requests.get')
    def test_api_call_sequence(self, mock_get):
        """Test that API calls are made in the correct sequence."""
        # Mock error responses for first two types, success for third
        error_response = {"code": "NotFound", "message": "Resource not found"}
        success_response = {"id": "test-ccg", "ociPhysicalDeviceName": "device-001"}
        
        mock_get.side_effect = [
            Mock(text=json.dumps(error_response)),  # virtualCircuit fails
            Mock(text=json.dumps(error_response)),  # crossConnect fails  
            Mock(text=json.dumps(success_response))  # crossConnectGroup succeeds
        ]
        
        # Set the global variables directly
        ocid_module.hostname = 'test-hostname'
        ocid_module.signer = Mock()
        ocid_module.LOCAL_PORT = 12345
        
        result = ocid_module.getC3MultiAttributes("test-ocid")
        
        # Verify all three API calls were made
        self.assertEqual(mock_get.call_count, 3)
        
        # Verify the successful result
        self.assertIn('crossConnectGroup', result)
        self.assertEqual(result['crossConnectGroup']['ociPhysicalDeviceName'], 'device-001')


if __name__ == '__main__':
    # Run the tests
    unittest.main(verbosity=2)
