definitions:
  # IMPORTANT: This file is exactly included in another spec file, so the two space indentation must be maintained.

  GlanceResource:
    x-obmcs-splat:
      resourceKind: GlanceResource
      adLocality: regional
    type: object
    description: Glance resource.
    properties:
      id:
        type: string
      compartmentId:
        type: string
      displayName:
        type: string

  # Define enum once.
  EncryptionInTransitType:
    description: |
      The attachment type of a BM volume.
      If the attachment is in-transit encryption, the field is BM_ENCRYPTION_IN_TRANSIT.
      Otherwise, the field is None.
    type: string
    enum: &EncryptionInTransitType
      - NONE
      - BM_ENCRYPTION_IN_TRANSIT # The attachment is under in-transit encryption/IPsec.
  AttachBootVolumeDetails:
    properties:
      bootVolumeId:
        description: The OCID of the  boot volume.
        maxLength: 255
        minLength: 1
        type: string
      displayName: *ref-displayName
      instanceId:
        description: The OCID of the instance.
        maxLength: 255
        minLength: 1
        type: string
      encryptionInTransitType:
        description: |
          Refer the top-level definition of encryptionInTransitType.
          The default value is NONE.
        type: string
        x-obmcs-top-level-enum: '#/definitions/EncryptionInTransitType'
        enum: *EncryptionInTransitType
        default: NONE
    required:
      - instanceId
      - bootVolumeId
  AttachEmulatedVolumeDetails:
    allOf:
      - $ref: '#/definitions/AttachVolumeDetails'
      - discriminator: emulated
  AttachIScsiVolumeDetails:
    allOf:
      - $ref: '#/definitions/AttachVolumeDetails'
      - discriminator: iscsi
        properties:
          useChap:
            description: |
              Whether to use CHAP authentication for the volume attachment. Defaults to false.
            type: boolean
          encryptionInTransitType:
            description: |
              Refer the top-level definition of encryptionInTransitType.
              The default value is NONE.
            type: string
            x-obmcs-top-level-enum: '#/definitions/EncryptionInTransitType'
            enum: *EncryptionInTransitType
            default: NONE
  AttachParavirtualizedVolumeDetails:
    allOf:
      - $ref: '#/definitions/AttachVolumeDetails'
      - discriminator: paravirtualized
        properties:
          isPvEncryptionInTransitEnabled:
            description: Whether to enable in-transit encryption for the data volume's paravirtualized attachment. The default value is false.
            type: boolean
  AttachServiceDeterminedVolumeDetails:
    allOf:
      - $ref: '#/definitions/AttachVolumeDetails'
      - discriminator: service_determined
  AttachVnicDetails:
    properties:
      createVnicDetails:
        $ref: '#/definitions/CreateVnicDetails'
      displayName: *ref-displayName
      instanceId:
        description: |
          The OCID of the instance. For AttachVnic operation, this is a required field for the request,
          see [AttachVnic](#/en/iaas/latest/VnicAttachment/AttachVnic).
        maxLength: 255
        minLength: 1
        type: string
      nicIndex:
        description: |
          Which physical network interface card (NIC) the VNIC will use. Defaults to 0.
          Certain bare metal instance shapes have two active physical NICs (0 and 1). If
          you add a secondary VNIC to one of these instances, you can specify which NIC
          the VNIC will use. For more information, see
          [Virtual Network Interface Cards (VNICs)](/iaas/Content/Network/Tasks/managingVNICs.htm).
        format: int32
        maximum: 31
        minimum: 0
        type: integer
    required:
      - createVnicDetails
  AttachVolumeDetails:
    discriminator: type
    properties:
      device:
        description: The device name. To retrieve a list of devices for a given instance, see [ListInstanceDevices](#/en/iaas/latest/Device/ListInstanceDevices).
        maxLength: 100
        minLength: 3
        type: string
      displayName: *ref-displayName
      instanceId:
        description: |
          The OCID of the instance. For AttachVolume operation, this is a required field for the request,
          see [AttachVolume](#/en/iaas/latest/VolumeAttachment/AttachVolume).
        maxLength: 255
        minLength: 1
        type: string
      isReadOnly:
        description: Whether the attachment was created in read-only mode.
        type: boolean
      isShareable:
        description: |
          Whether the attachment should be created in shareable mode. If an attachment
          is created in shareable mode, then other instances can attach the same volume, provided
          that they also create their attachments in shareable mode. Only certain volume types can
          be attached in shareable mode. Defaults to false if not specified.
        type: boolean
      type:
        description: |
          The type of volume. The only supported values are "iscsi" and "paravirtualized".
        maxLength: 255
        minLength: 1
        type: string
      volumeId:
        description: The OCID of the volume.
        maxLength: 255
        minLength: 1
        type: string
    required:
      - volumeId
      - type
  BootVolumeAttachment:
    x-obmcs-splat:
      resourceKind: BootVolumeAttachment
      adLocality: ad-local
    description: |
      Represents an attachment between a boot volume and an instance.

      **Warning:** Oracle recommends that you avoid using any confidential information when you
      supply string values using the API.
    properties:
      availabilityDomain:
        description: |
          The availability domain of an instance.

          Example: `Uocm:PHX-AD-1`
        maxLength: 255
        minLength: 1
        type: string
      bootVolumeId:
        description: The OCID of the boot volume.
        maxLength: 255
        minLength: 1
        type: string
      compartmentId:
        description: The OCID of the compartment.
        maxLength: 255
        minLength: 1
        type: string
      displayName: *ref-displayName
      id:
        description: The OCID of the boot volume attachment.
        maxLength: 255
        minLength: 1
        type: string
      instanceId:
        description: The OCID of the instance the boot volume is attached to.
        maxLength: 255
        minLength: 1
        type: string
      lifecycleState:
        description: The current state of the boot volume attachment.
        enum:
          - ATTACHING
          - ATTACHED
          - DETACHING
          - DETACHED
        type: string
      timeCreated:
        description: |
          The date and time the boot volume was created, in the format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).

          Example: `2016-08-25T21:10:29.600Z`
        format: date-time
        type: string
      attachmentType:
        description: The type of boot volume attachment.
        maxLength: 255
        minLength: 1
        type: string
      isPvEncryptionInTransitEnabled:
        description: Whether in-transit encryption for the boot volume's paravirtualized attachment is enabled or not.
        type: boolean
      encryptionInTransitType:
        description: |
          Refer the top-level definition of encryptionInTransitType.
          The default value is NONE.
        type: string
        x-obmcs-top-level-enum: '#/definitions/EncryptionInTransitType'
        enum: *EncryptionInTransitType
        default: NONE
    required:
      - id
      - instanceId
      - bootVolumeId
      - lifecycleState
      - compartmentId
      - availabilityDomain
      - timeCreated
  CaptureConsoleHistoryDetails:
    properties:
      definedTags: *ref-definedTags
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags
      instanceId:
        description: The OCID of the instance to get the console history from.
        maxLength: 255
        minLength: 1
        type: string
    required:
      - instanceId
  InstanceScreenshot:
    x-obmcs-splat:
      resourceKind: instance
      adLocality: ad-local
    description: |
      An instance's screenshot. It is a screen capture of the current state of the instance.
      Generally it will show the login screen of the machine.
    properties:
      id:
        description: The OCID of the screenshot object.
        maxLength: 255
        minLength: 1
        type: string
      instanceId:
        description: The OCID of the instance this screenshot was fetched from.
        maxLength: 255
        minLength: 1
        type: string
      lifecycleState:
        description: The current state of the screenshot capture.
        enum:
          - CREATING
          - ACTIVE
          - FAILED
          - DELETED
          - DELETING
        type: string
      timeCreated:
        description: |
          The date and time the screenshot was captured, in the format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).
          Example: `2016-08-25T21:10:29.600Z`
        format: date-time
        type: string
    required:
      - id
      - lifecycleState
      - timeCreated
      - instanceId
  InstanceScreenshotSummary:
    x-obmcs-splat:
      resourceKind: instance
      adLocality: ad-local
    description: |
      The summary data for an instance screenshot.
    properties:
      id:
        description: The OCID of the screenshot object.
        maxLength: 255
        minLength: 1
        type: string
      instanceId:
        description: The OCID of the instance this screenshot was fetched from.
        maxLength: 255
        minLength: 1
        type: string
      lifecycleState:
        description: The current state of the screenshot.
        type: string
        x-obmcs-enumref: "#/definitions/InstanceScreenshot/lifecycleState"
      timeCreated:
        description: |
          The date and time the screenshot was captured, in the format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).
          Example: `2016-08-25T21:10:29.600Z`
        format: date-time
        type: string
    required:
      - id
      - lifecycleState
      - timeCreated
      - instanceId

  ChangeDedicatedVmHostCompartmentDetails:
    description: Specifies the compartment to move the dedicated virtual machine host to.
    properties:
      compartmentId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the compartment
          to move the dedicated virtual machine host to.
        maxLength: 255
        minLength: 1
        type: string
    required:
