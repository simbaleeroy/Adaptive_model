        description: The configured redundancy level of the virtual circuit
        enum:
          - DEVICE
          - POP
          - REGION
          - NON_REDUNDANT
          - PENDING
        type: string
      ipv4bgpSessionRedundancyStatus:
        description: IPV4 BGP redundancy status indicates if the configured redundancy level is met
        enum:
          - CONFIGURATION_MATCH       # Indicates that the configured redundancy level has been successfully achieved
          - CONFIGURATION_MISMATCH    # Indicates that the configured redundancy level has not been met. Still meets minimum requirements for Service Level Agreement (SLA).
          - NOT_MET_SLA               # Indicates that the redundancy level does not meet the required Service Level Agreement (SLA) standards.
        type: string
      ipv6bgpSessionRedundancyStatus:
        description: IPV6 BGP redundancy status indicates if the configured redundancy level is met
        enum:
