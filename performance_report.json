 @Test
    public void TtestCreateOrUpdateDrgV2Attachment_BmcException() throws Exception {
        // Arrange
        VirtualCircuitDo virtualCircuitDo = VirtualCircuitDo.builder()
                .id(TEST_EXISTING_VC_ID)
                .gatewayId(TEST_DRG_ID)
                .state(VirtualCircuitDo.State.PROVISIONING)
                .build();

        // Mock the helper to throw BmcException
        Transaction mockTransaction = mock(Transaction.class);
        DrgV2Helper drgV2HelperMock = mock(DrgV2Helper.class);
        VirtualCircuitBl virtualCircuitBlMock = mock(VirtualCircuitBl.class);
        VpnRegion vpnRegion = mock(VpnRegion.class);
        VirtualCircuitWorkflowBase virtualCircuitWorkflowBase = mock(VirtualCircuitWorkflowBase.class);

        when(virtualCircuitWorkflowBase.createOrUpdateDrgV2Attachment(any(),any(),any()))
                .thenThrow(new BmcException(500, "test", "test", "test"));

        // Act and Assert - Test that BmcException is thrown and VC state is updated
        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            assertThrows(BmcException.class, () -> {
                virtualCircuitWorkflowBase.createOrUpdateDrgV2Attachment(t, virtualCircuitDo, vpnRegion);
            });

            assertThat(virtualCircuitDo.getState()).isEqualTo(VirtualCircuitDo.State.FAILED);
        }
    }
