    @VisibleForTesting
    void baseValidate(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        // Drg will be associated with only a private virtual circuit.
        if (virtualCircuitDo.isDrg()) {

            if (StringUtils.isBlank(virtualCircuitDo.getGatewayId())) {
                PublicValidation.failEmptyDrgId();
            }

            DrgDo drgDo = drgBl.getOrThrow(t, virtualCircuitDo.getGatewayId());
            if (drgDo.getState() != DrgDo.State.Provisioned
                    && !drgDo.isUnpromoting()) {
                PublicValidation.failDrgState(drgDo.getId());
            }

            Set<String> bgpIpNetworksOnVc = virtualCircuitDo.getOracleBgpIpNetworks();
            for (String bgpIpNetworkOnVc : bgpIpNetworksOnVc) {
                for (Entry<String, Set<String>> entry : drgDo.getVcToIpHelper().getIdsToReservations().entrySet()) {
                    Set<String> ipNetworksOnDrg = entry.getValue().stream()
                            .filter(Objects::nonNull)
                            .map(IpUtils::getNetworkAddress)
                            .collect(Collectors.toSet());
                    for (String ipNetworkOnDrg : ipNetworksOnDrg) {
                        if (IpUtils.isOverlap(bgpIpNetworkOnVc, ipNetworkOnDrg)) {
                            // Don't fail if the network belongs to the same virtual circuit.
                            if (!entry.getKey().equals(virtualCircuitDo.getId())) {
                                PublicValidation.failIpNetworkAlreadyInUseOnDrg(bgpIpNetworkOnVc);
                            }
                        }
                    }
                }
            }
        }

        // Private IPSecGateway will be associated with only a private IPSec Gateway virtual circuit.
        if (virtualCircuitDo.isPrivateIpsecGateway()) {

            if (StringUtils.isBlank(virtualCircuitDo.getGatewayId())) {
                PublicValidation.failEmptyPrivateIPSecGatewayId();
            }

            PrivateIPSecGatewayDo privateIPSecGatewayDo = privateIPSecGatewayBl.getOrThrow(t, virtualCircuitDo.getGatewayId());
            if (privateIPSecGatewayDo.getState() != PrivateIPSecGatewayDo.State.Provisioned) {
                PublicValidation.failPrivateIPSecGatewayState(privateIPSecGatewayDo.getId());
            }

            Set<String> bgpIpNetworksOnVc = virtualCircuitDo.getOracleBgpIpNetworks();
            for (String bgpIpNetworkOnVc : bgpIpNetworksOnVc) {
                for (Entry<String, Set<String>> entry : privateIPSecGatewayDo.getVcToIpHelper().getIdsToReservations().entrySet()) {
                    Set<String> ipNetworksOnDrg = entry.getValue().stream()
                            .filter(Objects::nonNull)
                            .map(IpUtils::getNetworkAddress)
                            .collect(Collectors.toSet());
                    for (String ipNetworkOnDrg : ipNetworksOnDrg) {
                        if (IpUtils.isOverlap(bgpIpNetworkOnVc, ipNetworkOnDrg)) {
                            // Don't fail if the network belongs to the same virtual circuit.
                            if (!entry.getKey().equals(virtualCircuitDo.getId())) {
                                PublicValidation.failIpNetworkAlreadyInUseOnDrg(bgpIpNetworkOnVc);
                            }
                        }
                    }
                }
            }
        }

        validateRoutingPolicy(virtualCircuitDo);

        // Don't do any cross-connect related validation for oci-classic integration virtual circuit
        // since the cross-connect ids will not be valid.
        if (virtualCircuitDo.isOciClassicProviderVirtualCircuit()) {
            return;
        }

        Map<String, Set<Integer>> crossConnectGroups = virtualCircuitDo.getDesiredCcgToVlanMappings();
        for (Entry<String, Set<Integer>> entry : crossConnectGroups.entrySet()) {
            CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(t, entry.getKey());
            // If we have a cc we will have 1 vlan
            Integer vlan = entry.getValue().iterator().next();
            Optional<String> vcForVlan = crossConnectGroupDo.getVcToVlanHelper().getTargetFromReservation(vlan);
            if (vcForVlan.isPresent() && !vcForVlan.get().equals(virtualCircuitDo.getId())) {
                PublicValidation.failVlanAlreadyInUseOnCcg(vlan);
            }

            //to check in new mapping bucket
            Optional<VcToVlanMappingDo> mapping = vcToVlanMappingBl.getMappingByCcOrCcgPlusVlan(t, crossConnectGroupDo.getId(), vlan);
            if (mapping.isPresent() && !mapping.get().getVirtualCircuitId().equals(virtualCircuitDo.getId())) {
                PublicValidation.failVlanAlreadyInUseOnCcg(vlan);
            }
        }

        Map<String, Set<Integer>> crossConnects = virtualCircuitDo.getDesiredCcToVlanMappings();
        for (Entry<String, Set<Integer>> entry : crossConnects.entrySet()) {
            CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(t, entry.getKey());
            // If we have a cc we will have 1 vlan
            Integer vlan = entry.getValue().iterator().next();
            Optional<String> vcForVlan = crossConnectDo.getVcToVlanHelper().getTargetFromReservation(vlan);
            if (vcForVlan.isPresent() && !vcForVlan.get().equals(virtualCircuitDo.getId())) {
                PublicValidation.failVlanAlreadyInUseOnCc(vlan);
            }

            //to check in new mapping bucket
            Optional<VcToVlanMappingDo> mapping = vcToVlanMappingBl.getMappingByCcOrCcgPlusVlan(t, crossConnectDo.getId(), vlan);
            if (mapping.isPresent() && !mapping.get().getVirtualCircuitId().equals(virtualCircuitDo.getId())) {
                PublicValidation.failVlanAlreadyInUseOnCc(vlan);
            }
        }
    }

    private void validateRoutingPolicy(VirtualCircuitDo virtualCircuitDo) throws ValidationException{
        // Only one routing policy per virtual circuit is supported for now.
        Set<RoutingPolicy> policies = virtualCircuitDo.getRoutingPolicies();
        if(policies.size() > 1) {

            PublicValidation.failMultipleRoutingPolicyPerConnection();
        } else if(policies.size() == 1) {
            RoutingPolicy policy = (RoutingPolicy) policies.toArray()[0];

            if(virtualCircuitDo.isPublic()
                    && !ALLOWED_ROUTING_POLICY_FOR_PUBLIC_VC.contains(policy)) {

                PublicValidation.failWrongRoutingPolicyForVirtualCircuit(policy, virtualCircuitDo.getIpAddressType());
            }
        }
    }

    public void validateCreateForCustomer(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        // Only semantic validation. Authorization should be done in VirtualCircuitResourceHelper
        Preconditions.checkState(virtualCircuitDo.getProviderCompartmentId() == null);
    }

    public void validatePreActiveNetworkSettingsForL2(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        Preconditions.checkState(virtualCircuitDo.getProviderCompartmentId() != null);

        if (virtualCircuitDo.isPrivate()) {
            if (virtualCircuitDo.getCrossConnectMapping().getMappings().length != 1) {
                PublicValidation.failL2ProviderRequiresOneCrossConnect();
            } else {
                validateCrossConnectMappingForL2(virtualCircuitDo);
            }
        }

        if (virtualCircuitDo.getBandwidthInMbps() == null) {
            PublicValidation.fieldRequired("bandwidthShapeName");
        }
    }

    public static void validateCrossConnectMappingForL2(VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        Mapping mapping = virtualCircuitDo.getCrossConnectMapping().getMappings()[0];

        if (virtualCircuitDo.isPrivate()) {
            PublicValidation.validateBgpPeeringAddress(mapping.getOracleBgpPeeringIp());
            PublicValidation.validateBgpPeeringAddress(mapping.getRemoteBgpPeeringIp());
            PublicValidation.validateSameSubnet(mapping.getOracleBgpPeeringIp(), mapping.getRemoteBgpPeeringIp());
            PublicValidation.validateNotSameHost(mapping.getOracleBgpPeeringIp(), mapping.getRemoteBgpPeeringIp());

            // Validating IPv6 addresses. Since IPv6 addresses are optional either both addresses are null or both are valid.
            if ((mapping.getRemoteBgpPeeringIpv6() != null) && (mapping.getOracleBgpPeeringIpv6() != null)) {
                PublicValidation.validateBgpPeeringIPv6Network(mapping.getRemoteBgpPeeringIpv6());
                PublicValidation.validateBgpPeeringIPv6Network(mapping.getOracleBgpPeeringIpv6());
                PublicValidation.validateSameSubnet(mapping.getOracleBgpPeeringIpv6(), mapping.getRemoteBgpPeeringIpv6());
                PublicValidation.validateNotSameHost(mapping.getOracleBgpPeeringIpv6(), mapping.getRemoteBgpPeeringIpv6());
            } else {
                if (mapping.getOracleBgpPeeringIpv6() != null) {
                    PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.CUSTOMER_BGP_PEERING_IPV6_FIELD);
                }
                if (mapping.getRemoteBgpPeeringIpv6() != null) {
                    PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.ORACLE_BGP_PEERING_IPV6_FIELD);
                }
            }

        }

        validateBgpMd5AuthKey(mapping.getBgpMd5Authkey());
    }

    public void validatePreActiveNetworkSettingsForL3(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        // Only semantic validation. Authorization should be done in VirtualCircuitResourceHelper
        Preconditions.checkState(virtualCircuitDo.getProviderCompartmentId() != null);

        if (virtualCircuitDo.getBandwidthInMbps() == null) {
            PublicValidation.fieldRequired("bandwidthShapeName");
        }
    }

    @VisibleForTesting
    private void validateNetworkingForAPIOrWorkflow(VirtualCircuitDo virtualCircuitDo, Transaction t, boolean validateForWorkflow) throws ValidationException {

        // Code bug for these to be null at this point
        Preconditions.checkNotNull(virtualCircuitDo.getCrossConnectMapping(),
                "CrossConnectMappings should not be null");
        Preconditions.checkNotNull(virtualCircuitDo.getCrossConnectMapping().getMappings(),
                "CrossConnectMappings.mappings should not be null");
        Preconditions.checkNotNull(virtualCircuitDo.getIpAddressType(),
                "IPAddress type should not be null");

        // Don't validate cross-connect mappings or BGP ASNs for oci-classic integration virtual circuits.
        if (virtualCircuitDo.isOciClassicProviderVirtualCircuit()) {
            return;
        }

        if(virtualCircuitDo.getRemoteAsn() == null && virtualCircuitDo.getRemoteBgpAsn() == null) {
            PublicValidation.failAsnValueNotProvided();
        }

        if (virtualCircuitDo.getCrossConnectMapping()
                .getMappings().length < MIN_CROSS_CONNECTS) {
            PublicValidation.failMinCrossConnects(virtualCircuitDo.getId(),
                    virtualCircuitDo.getCrossConnectMapping().getMappings().length,
                    MIN_CROSS_CONNECTS);
        }
        if (virtualCircuitDo.getCrossConnectMapping()
                .getMappings().length > MAX_CROSS_CONNECTS) {
            PublicValidation.failMaxCrossConnects(virtualCircuitDo.getId(),
                    virtualCircuitDo.getCrossConnectMapping().getMappings().length,
                    MAX_CROSS_CONNECTS);
        }

        boolean microsoftPeered = false;
        if (StringUtils.isNotBlank(virtualCircuitDo.getProviderServiceId())) {
            microsoftPeered = providerServiceBl.isMicrosoftPeered(virtualCircuitDo.getProviderServiceId());
        }

        Set<DeviceDo> devices = new HashSet<>();
        for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {
            // For virtual circuits peered with Microsoft, we accept vlans starting from 1.
            // For non-microsoft peered virtual circuits, the vlans should be between 100 & 4094.
            if (mapping.getVlan() == null) {
                PublicValidation.failEmptyVlanNumber();
            } else {
                PublicValidation.validateVlanRange(mapping.getVlan(), microsoftPeered);
            }

            boolean gcpPeered = false;
            if (StringUtils.isNotBlank(virtualCircuitDo.getProviderServiceId())) {
                gcpPeered = providerServiceBl.isGCPPeered(virtualCircuitDo.getProviderServiceId());
            }

            if (gcpPeered) {
                if (!virtualCircuitDo.isDrgV2()) {
                    PublicValidation.failGcpForDRGGv1(virtualCircuitDo.getGatewayId());
                }

                if (virtualCircuitDo.getCrossConnectMapping().getMappings().length != 1) {
                    PublicValidation.failGcpForWrongMappings(virtualCircuitDo.getId());
                }
            }

            if (virtualCircuitDo.isPrivate()) {

                // Validating IPv4 addresses.
                if (mapping.getRemoteBgpPeeringIp() != null) {
                    PublicValidation.validateBgpPeeringAddress(mapping.getRemoteBgpPeeringIp());
                } else {
                    PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.CUSTOMER_BGP_PEERING_IP_FIELD);
                }

                if (mapping.getOracleBgpPeeringIp() != null) {
                    PublicValidation.validateBgpPeeringAddress(mapping.getOracleBgpPeeringIp());
                } else {
                    PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.ORACLE_BGP_PEERING_IP_FIELD);
                }

                PublicValidation.validateSameSubnet(mapping.getOracleBgpPeeringIp(), mapping.getRemoteBgpPeeringIp());
                PublicValidation.validateNotSameHost(mapping.getOracleBgpPeeringIp(), mapping.getRemoteBgpPeeringIp());

                // Validating IPv6 addresses. Since IPv6 addresses are optional either both addresses are null or both are valid.
                if ((mapping.getRemoteBgpPeeringIpv6() != null) && (mapping.getOracleBgpPeeringIpv6() != null)) {
                    PublicValidation.validateBgpPeeringIPv6Network(mapping.getRemoteBgpPeeringIpv6());
                    PublicValidation.validateBgpPeeringIPv6Network(mapping.getOracleBgpPeeringIpv6());
                    PublicValidation.validateSameSubnet(mapping.getOracleBgpPeeringIpv6(), mapping.getRemoteBgpPeeringIpv6());
                    PublicValidation.validateNotSameHost(mapping.getOracleBgpPeeringIpv6(), mapping.getRemoteBgpPeeringIpv6());
                } else {
                    if (mapping.getOracleBgpPeeringIpv6() != null) {
                        PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.CUSTOMER_BGP_PEERING_IPV6_FIELD);
                    }
                    if (mapping.getRemoteBgpPeeringIpv6() != null) {
                        PublicValidation.failFieldMustNotBeNull(VirtualCircuitValidationHelper.ORACLE_BGP_PEERING_IPV6_FIELD);
                    }
                }
            }

            validateBgpMd5AuthKey(mapping.getBgpMd5Authkey());

            // CrossConnect
            // TODO: Validate that cross connect mapping IDs are present.
            // TODO: Validate the number of cross connects per provider type.
            // Validate number of crossConnects
            // TODO: We could do smart validation for a given provider service,
            // i.e. layer two must have exactly 1 CC.

            // The cross connect validation below are not done transactionally. This is OK since all these
            // validations are best effort only.
            if (isCrossConnect(mapping.getCrossConnectId())) {
                CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
                if (crossConnectDo.getState() != CrossConnectDo.State.PROVISIONED) {
                    PublicValidation.failCrossConnectNotInCorrectState(
                            crossConnectDo.getId(), crossConnectDo.getState().name());
                }

                if (crossConnectDo.getCrossConnectGroupId() != null) {
                    PublicValidation.failMustUseCrossConnectGroupWhenCrossConnectInGroup(crossConnectDo.getId());
                }

                if (crossConnectDo.getDeviceId() != null) {

                    DeviceDo crossConnectDevice = deviceBl.getOrThrow(crossConnectDo.getDeviceId());
                    if (crossConnectDevice.getState() != DeviceDo.State.ACTIVE) {
                        try {
                            PublicValidation.failCrossConnectDeviceIsNotActive(crossConnectDo.getId());
                        } catch (ValidationException ex) {
                            if (validateForWorkflow) {
                                throw new RetryableException(String.format("CrossConnect %s device is not active, wait for %d seconds to retry", crossConnectDo.getId(), 15));
                            } else {
                                throw ex;
                            }
                        }
                    }
                    if (devices.contains(crossConnectDevice)) {
                        PublicValidation.failCannotHaveMultipleCrossConnectsOnSameDeviceInVC();
                    } else {
                        devices.add(crossConnectDevice);
                    }

                    if (deviceBl.isQfxSwitchRole(crossConnectDevice)) {
                        // Get parent MX, currently code is only support single parent MX
                        if (crossConnectDevice.getCcgsBetweenMxAndQfx().size() > 1) {
                            PublicValidation.qfxDeviceConnectToMoreThanOneMx();
                        }
                        String mxDeviceId = crossConnectDevice.getCcgsBetweenMxAndQfx().get(0).getConnectToDeviceId();
                        if (StringUtils.isBlank(mxDeviceId)) {
                            PublicValidation.qfxDeviceHasNoConnectionToMx();
                        }

                        DeviceDo parentMxDevice = deviceBl.getOrThrow(t, mxDeviceId);
                        if (devices.contains(parentMxDevice)) {
                            PublicValidation.failCannotHaveMultipleCrossConnectsOnSameDeviceInVC();
                        } else {
                            devices.add(parentMxDevice);
                        }
                    }
                } else if (crossConnectDo.getGlobalPopCcMetadata() != null) {
                    log.info("VirtualCircuitDo is on global pop cc, skip validating networking for device");
                    // TODO: Ensure the crossConnectsMapping for CCs are on separate OC1 devices
                    // TODO: Ensure the OC3 primary/secondary CCG MX devices are not in maintenance
                    return;
                } else {
                    PublicValidation.failApiNotEnabled();
                }

            } else if (isCrossConnectGroup(mapping.getCrossConnectId())) {
                CrossConnectGroupDo crossConnectGroupDo =  crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                if (crossConnectGroupDo.getState() != CrossConnectGroupDo.State.PROVISIONED) {
                    PublicValidation.failCrossConnectGroupNotInCorrectState(
                            crossConnectGroupDo.getId(), crossConnectGroupDo.getState().name());
                }

                if (crossConnectGroupDo.getCrossConnectIds().length == 0) {
                    PublicValidation.failCrossConnectGroupCannotBeUsedWithoutCrossConnects();
                }

                if (crossConnectGroupDo.getGlobalPopCcgMetadata() == null) {

                    // Since all the cross connects in a group belong to the same device, we get the device from
                    // the first cross connect and check its state.
                    String crossConnectId = crossConnectGroupDo.getCrossConnectIds()[0];
                    DeviceDo crossConnectDevice = deviceBl
                            .getOrThrow(crossConnectBl
                                    .getOrThrow(crossConnectId)
                                    .getDeviceId());
                    if (crossConnectDevice.getState() != DeviceDo.State.ACTIVE) {
                        try{
                            PublicValidation.failCrossConnectDeviceIsNotActive(crossConnectGroupDo.getId());
                        }catch (ValidationException ex) {
                            if(validateForWorkflow) {
                                throw new RetryableException(String.format("CrossConnectGroup %s device is not active, wait for %d seconds to retry", crossConnectGroupDo.getId(), 15));
                            } else {
                                throw ex;
                            }

                        }
                    }
                    if (devices.contains(crossConnectDevice)) {
                        PublicValidation.failCannotHaveMultipleCrossConnectsOnSameDeviceInVC();
                    } else {
                        devices.add(crossConnectDevice);
                    }

                    if (deviceBl.isQfxSwitchRole(crossConnectDevice)) {
                        // Get parent MX, currently code is only support single parent MX
                        if (crossConnectDevice.getCcgsBetweenMxAndQfx().size() > 1) {
                            PublicValidation.qfxDeviceConnectToMoreThanOneMx();
                        }
                        String mxDeviceId = crossConnectDevice.getCcgsBetweenMxAndQfx().get(0).getConnectToDeviceId();
                        if (StringUtils.isBlank(mxDeviceId)) {
                            PublicValidation.qfxDeviceHasNoConnectionToMx();
                        }

                        DeviceDo parentMxDevice = deviceBl.getOrThrow(t, mxDeviceId);
                        if (devices.contains(parentMxDevice)) {
                            PublicValidation.failCannotHaveMultipleCrossConnectsOnSameDeviceInVC();
                        } else {
                            devices.add(parentMxDevice);
                        }
                    } else if (crossConnectDevice.getRoles().contains(DeviceDo.Role.AristaSwitch)) {
                        // Get parent MX, currently code is only support single parent MX
                        if (crossConnectDevice.getDeviceConfig().getConnectionToMxList().size() > 1) {
                            PublicValidation.aristaDeviceConnectToMoreThanOneMx();
                        }
                        String mxDeviceId = crossConnectDevice.getDeviceConfig().getConnectionToMxList().get(0).getConnectToDeviceId();
                        if (StringUtils.isBlank(mxDeviceId)) {
                            PublicValidation.aristaDeviceHasNoConnectionToMx();
                        }

                        DeviceDo parentMxDevice = deviceBl.getOrThrow(t, mxDeviceId);
                        if (devices.contains(parentMxDevice)) {
                            PublicValidation.failCannotHaveMultipleCrossConnectsOnSameDeviceInVC();
                        } else {
                            devices.add(parentMxDevice);
                        }
                    }
                } else {
                    log.info("VirtualCircuitDo is on global pop ccg, skip validating networking for device");
                    // TODO: Ensure the crossConnectsMapping for CCs are on separate OC1 devices
                    // TODO: Ensure the OC3 primary/secondary CCG MX devices are not in maintenance
                    return;
                }

            } else {
                PublicValidation.failUnknownCrossConnectOrCrossConnectId(mapping.getCrossConnectId());
            }
        }
    }

