                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("Customer is not whitelisted to utilise QoS bandwidth reservation");

        Assertions.assertThatThrownBy(
                        () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("Customer is not whitelisted to utilise QoS bandwidth reservation");

        PropertiesBlTest.addOrUpdateProperty(propertiesBl, PropertiesDo.Keys.ENABLE_VC_BANDWIDTH_VALIDATION.getKeyName(), "true");

        UpdateVirtualCircuitDetails update1 = UpdateVirtualCircuitDetails.builder()
