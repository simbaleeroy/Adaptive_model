    @Step(name = Steps.INITIAL,
            numAssignmentsBeforeFailure = DEFAULT_NUMBER_OF_ALLOWED_ASSIGNMENTS,
            assignmentTTLMillis = DEFAULT_ASSIGNMENT_TIME_MILLIS,
            leaseTTLMillis = DEFAULT_LEASE_TIME_MILLIS)
    public StepResult<BasicWorkflowState> initial(
            RowRevisionSensitiveWorkflowArgs<VirtualCircuitWorkflowArgs> args,
            BasicWorkflowState state,
            WorkflowInfo info) {
        final VirtualCircuitWorkflowArgs arg = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope scope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arg.getOperationType()))) {
            perfMetric.setupScopeDimensions(scope, arg.getOperationType(), arg.getIsFakeDevice(), arg.getIsCustomer());
            perfMetric.emitStart(scope, arg.getOperationType(), arg.getInitialTimeEpochMs());
            perfMetric.emitTillNowTimeInMs(scope, MetricConstants.waitCompleteTime(Steps.INITIAL), arg.getInitialTimeEpochMs());
            return Results.completeStep(Steps.DEPROVISION_CROSS_CONNECTS, state);
        }
    }


