PROXY_TEMPLATE = "bastion-ad1.rb.{region}.{devops_dns_name}"
VPN_API_TEMPLATE = "vpn-api-internal.splat.svc.ad1.{region}" # == hostname | server comment this line for testing in alpha and uncomment when done
