// Add crossConnectOrCrossConnectGroupId and vlan to payload if showing
      // For Internet type, always include crossConnectOrCrossConnectGroupId even if VLAN input is not shown
      if (vlanInputShowing || type === VirtualCircuitTypeEnum.Internet) {
        mapping[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId] =
          crossConnectOrCrossConnectGroupId;
        if (vlanInputShowing) {
          mapping[VirtualCircuitFieldNames.Vlan] = vlan;
        } else if (type === VirtualCircuitTypeEnum.Internet) {
          // Hardcode VLAN to 102 for Internet type
          mapping[VirtualCircuitFieldNames.Vlan] = 102;
        }
      }
