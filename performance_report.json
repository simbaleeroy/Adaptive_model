 @Test
        public void GIVEN_createOrUpdateDrgV2Attachment_WHEN_BmcExceptionDuringCreate_THEN_VcStateSetToFailed()
                        throws Exception {

                // ===== ARRANGE =====
                
                // Create a test VirtualCircuitDo with required fields
                VirtualCircuitDo testVc = VirtualCircuitDo.builder()
                                .id("test-vc-id-123")
                                .gatewayId(TEST_DRG_ID)
                                .state(VirtualCircuitDo.State.PROVISIONING)
                                .displayName("Test VC")
                                .compartmentId("test-compartment-id")
                                .ipAddressType(VirtualCircuitDo.IpAddressType.PUBLIC)
                                .build();

                // Create a mock DrgV2Helper that throws BmcException when createDrgV2AttachmentAndDo is called
                DrgV2Helper mockHelper = mock(DrgV2Helper.class);
                when(mockHelper.createDrgV2AttachmentAndDo(
                                any(Transaction.class),
                                any(VirtualCircuitDo.class),
                                any(Boolean.class)))
                                .thenThrow(new BmcException(500, "test-service-code", "Internal Server Error", "test-opc-request-id"));

                // ===== ACT & ASSERT =====
                
                try {
                        // Use reflection to replace the drgV2Helper field with our mock
                        Field drgV2HelperField = VirtualCircuitWorkflowBase.class.getDeclaredField("drgV2Helper");
                        drgV2HelperField.setAccessible(true);
                        drgV2HelperField.set(createVcDrgV2AttachmentWorkflow, mockHelper);
                        System.out.println("✅ Successfully replaced drgV2Helper field with mock");

                        // Use reflection to call the protected createOrUpdateDrgV2Attachment method
                        Method createOrUpdateMethod = VirtualCircuitWorkflowBase.class.getDeclaredMethod(
                                        "createOrUpdateDrgV2Attachment",
                                        Transaction.class,
                                        VirtualCircuitDo.class,
                                        VpnRegion.class);
                        createOrUpdateMethod.setAccessible(true);
                        System.out.println("✅ Successfully obtained createOrUpdateDrgV2Attachment method");

                        // Call the method - this should throw BmcException due to our mock
                        System.out.println("🔄 Calling createOrUpdateDrgV2Attachment method...");
                        createOrUpdateMethod.invoke(createVcDrgV2AttachmentWorkflow, mock(Transaction.class), testVc, (VpnRegion) null);
                        
                        // If we get here, the method didn't throw an exception as expected
                        fail("❌ Expected BmcException to be thrown, but method completed successfully");
                        
                } catch (BmcException e) {
                        // ✅ Expected exception - verify the error details
                        System.out.println("✅ Successfully caught expected BmcException: " + e.getMessage());
                        assertThat(e.getMessage()).contains("Internal Server Error");
                        assertThat(e.getStatusCode()).isEqualTo(500);
                        System.out.println("✅ BmcException has correct error message and status code");
                        
                } catch (Exception e) {
                        // Handle reflection or other unexpected exceptions
                        System.out.println("❌ Unexpected exception: " + e.getClass().getSimpleName() + " - " + e.getMessage());
                        e.printStackTrace();
                        fail("Unexpected exception: " + e.getMessage());
                }
        }
