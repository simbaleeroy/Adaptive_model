    @Test
    public void GIVEN_changeCompartment_WHEN_Success_THEN_VcStateChangeToPendingProvider() throws CommitConflictException, ValidationException {

        VirtualCircuitDo vcDo = VirtualCircuitDo.builder()
                .id(TEST_EXISTING_VC_ID)
                .gatewayId(TEST_DRG_ID)
                .state(VirtualCircuitDo.State.PROVISIONING)
                .displayName(TEST_DISPLAY_NAME)
                .compartmentId(TEST_ORIGINAL_COMPARTMENT_ID)
                .build();

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            drgV2Helper.createDrgV2AttachmentAndDo(t, vcDo, false);
            t.commit();
        } catch (ValidationException e) {
            e.printStackTrace();
        }

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            DrgV2AttachmentDo drgV2AttachmentDo = drgV2AttachmentBl.listByAttachedResourceId(t, TEST_EXISTING_VC_ID).get(0);
            assertThat(drgV2AttachmentDo.getMplsLabel()).isEqualTo(TEST_MPLS_LABEL);
            assertThat(drgV2AttachmentDo.getId()).isEqualTo(TEST_EXISTING_DRG_ATTACHMENT_ID);
            assertThat(drgV2AttachmentDo.getImportEPRouteTarget()).isEqualTo(TEST_IMPORT_RT);
            assertThat(drgV2AttachmentDo.getExportEPRouteTarget()).isEqualTo(TEST_EXPORT_RT);
        }

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {

            createVcDrgV2AttachmentWorkflow.changeCompartment(null, t, null, vcDo);
            vcDo = virtualCircuitBl.getOrThrow(t, vcDo.getId());

            // assertThat state changed to PENDING_PROVIDER
            assertThat(vcDo.getState()).isEqualTo(VirtualCircuitDo.State.PENDING_PROVIDER);
        }
    }

    @Test
    public void GIVEN_createDrgV2Attachment_WHEN_DrgIdUpdatedByCustomer_THEN_DeleteOldDrgV2AttachmentAndCreateNewAttachment() throws Exception {

        VirtualCircuitDo virtualCircuitDo = generateVirtualCircuitDo(VirtualCircuitDo.IpAddressType.PUBLIC, null, null);

        try (Transaction t = virtualCircuitBl.beginTransaction("update-vc")) {
            virtualCircuitDo = virtualCircuitBl.update(t, virtualCircuitBl.getOrThrow(t, virtualCircuitDo.getId()).toBuilder()
                    .gatewayId(TEST_DRG_ID)
                    .build());
            t.commit();
        }

        try (Transaction t = drgV2AttachmentBl.beginTransaction("create_drgV2Attachment")) {
            DrgV2AttachmentDo drgV2AttachmentDo = DrgV2AttachmentDo.builder()
                    .id(TEST_EXISTING_DRG_ATTACHMENT_ID)
                    .type(DrgV2AttachmentDo.Type.VirtualCircuit)
                    .importEPRouteTarget(TEST_IMPORT_RT)
                    .exportEPRouteTarget(TEST_EXPORT_RT)
                    .mplsLabel(TEST_MPLS_LABEL)
                    .attachedResourceId(virtualCircuitDo.getId())
                    .drgId(TEST_DRG_ID)
                    .build();
            drgV2AttachmentBl.create(t, drgV2AttachmentDo);
            t.commit();
        }

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            DrgV2AttachmentDo drgV2AttachmentDo = drgV2AttachmentBl.listByAttachedResourceId(t,virtualCircuitDo.getId()).get(0);
            assertThat(drgV2AttachmentDo.getMplsLabel()).isEqualTo(TEST_MPLS_LABEL);
            assertThat(drgV2AttachmentDo.getId()).isEqualTo(TEST_EXISTING_DRG_ATTACHMENT_ID);
            assertThat(drgV2AttachmentDo.getImportEPRouteTarget()).isEqualTo(TEST_IMPORT_RT);
            assertThat(drgV2AttachmentDo.getExportEPRouteTarget()).isEqualTo(TEST_EXPORT_RT);
            assertThat(drgV2AttachmentDo.getDrgId()).isEqualTo(TEST_DRG_ID);
        }

        // Manually change the Drg id
        try (Transaction t = virtualCircuitBl.beginTransaction("update-vc")) {
            virtualCircuitDo = virtualCircuitBl.update(t, virtualCircuitBl.getOrThrow(t, virtualCircuitDo.getId()).toBuilder()
                    .gatewayId(TEST_DRG_ID_2)
                    .gatewayType(VirtualCircuitDo.GatewayType.DRG_V2)
                    .ipAddressType(VirtualCircuitDo.IpAddressType.PRIVATE)
                    .build());
            t.commit();
        }

        mockDeleteC3DrgAttachmentRequest(TEST_EXISTING_DRG_ATTACHMENT_ID);
        mockCreateC3DrgAttachment(virtualCircuitDo);
        // Mock PNP call for 404 on Get after deletion
        when(virtualNetworkClient.getC3DrgAttachment(any())).thenThrow(new BmcException(404, "", "", ""));

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            createVcDrgV2AttachmentWorkflow.createDrgV2Attachment(null, t, null, virtualCircuitDo);
            t.commit();
        }

        // deleted old DrgV2Attachment and created new Attachment
        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            assertThat(drgV2AttachmentBl.listByAttachedResourceId(t,virtualCircuitDo.getId()).size()).isEqualTo(1);
            DrgV2AttachmentDo drgV2AttachmentDo = drgV2AttachmentBl.listByAttachedResourceId(t,virtualCircuitDo.getId()).get(0);
            assertThat(drgV2AttachmentDo.getMplsLabel()).isEqualTo(TEST_MPLS_LABEL_2);
            assertThat(drgV2AttachmentDo.getId()).isEqualTo(TEST_EXISTING_DRG_ATTACHMENT_ID_2);
            assertThat(drgV2AttachmentDo.getImportEPRouteTarget()).isEqualTo(TEST_IMPORT_RT_2);
            assertThat(drgV2AttachmentDo.getExportEPRouteTarget()).isEqualTo(TEST_EXPORT_RT_2);
            assertThat(drgV2AttachmentDo.getDrgId()).isEqualTo(TEST_DRG_ID_2);
        }
    }

