        }
    }

    ////////////////////////////////////////////////////////////////////////////////
    //// Deprovision - wait for deletions to finish
    ////////////////////////////////////////////////////////////////////////////////

    @Step(name = Steps.WAIT_FOR_DEPROVISION,
            numAssignmentsBeforeFailure = DEFAULT_NUMBER_OF_ALLOWED_ASSIGNMENTS,
            assignmentTTLMillis = DEFAULT_ASSIGNMENT_TIME_MILLIS,
            leaseTTLMillis = DEFAULT_LEASE_TIME_MILLIS)
    public StepResult<BasicWorkflowState> waitForDeprovision(
            RowRevisionSensitiveWorkflowArgs<VirtualCircuitWorkflowArgs> args,
            BasicWorkflowState state,
            WorkflowInfo info) throws InterruptedException, CommitConflictException {
        final VirtualCircuitWorkflowArgs arguments = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope wfStepScope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arguments.getOperationType()), false, false);
             MetricsScope scope = MetricsScope.parent("createVirtualCircuit.WaitForDeprovision")) {
            return waitForDeprovision(scope, wfStepScope, info.getAssignmentId().getStepInstanceId().getSequenceNumber(),
                    arguments, state);
        }
    }

    public StepResult<BasicWorkflowState> waitForDeprovision(
            MetricsScope scope,
            MetricsScope wfStepScope,
            int assignmentNumber,
            VirtualCircuitWorkflowArgs args,
            BasicWorkflowState state) throws InterruptedException, CommitConflictException {
        // Don't need row revision for read-only checks.
        // Using row revision here is a bit hard because next steps are always determined
        // by the state of the object, but we don't want to use multiple states here.
        // e.g. PendingDeprovision, PendingProvision.
        VirtualCircuitDo virtualCircuitDo = null;
        try (Transaction t = virtualCircuitBl.getMappedDataStore().beginTransaction("WaitForDeprovision")) {
            perfMetric.setupScopeDimensions(wfStepScope, args.getOperationType(), args.getIsFakeDevice(), args.getIsCustomer());
            virtualCircuitDo = virtualCircuitBl.getOrThrow(args.getVirtualCircuitId());
            Set<ConfigSnippetDo> snippets = getSnippetsToDeprovision(t, virtualCircuitDo);
            eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, "Deprovisioning: " + snippets);

            if (snippets.size() != 0) {
                // Make sure that this is always the last event emitted, otherwise we might
                // emit many duplicate events
                WorkflowEventUtil.emitSnippetStatusEvent(assignmentNumber,
                        eventBl, t, new HashSet<>(snippets), virtualCircuitDo, "Waiting for device sync");

                for (ConfigSnippetDo snippetDo : snippets) {
                    checkExpectedDeletionState(snippetDo);
                }

                t.commit();

                sleepOp.sleep(WAIT_SLEEP_TIME);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);

                return Results.completeStep(Steps.WAIT_FOR_DEPROVISION, state);

            } else {
                String msg = String.format("Deprovision Complete. " +
                        "Didn't find any snippets for virtualCircuitDo %s.", virtualCircuitDo.getId());
                log.info(msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                perfMetric.emitTillNowTimeInMs(wfStepScope, MetricConstants.waitCompleteTime(Steps.WAIT_FOR_DEPROVISION), args.getInitialTimeEpochMs());

                t.commit();
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);

                return Results.completeStep(Steps.CREATE_ROUTING_ATTACHMENTS, state);
            }
        } catch (ValidationException e) {
            if (virtualCircuitDo != null) {
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
                Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, drgV2AttachmentDo);
                return vcWorkflowHelper.terminateWorkflow(e, state, dimensions);
            }
            return vcWorkflowHelper.terminateWorkflow(e, state);
        }
    }

    @VisibleForTesting
    void checkExpectedDeletionState(ConfigSnippetDo snippet) throws ValidationException {
        if (snippet.getState() != ConfigSnippetDo.State.PendingDelete) {
            log.error("Snippet {} is in invalid state for delete workflow. Terminating workflow.", snippet);
            throw new ValidationException(ErrorCode.IncorrectState,
                    String.format("Invalid snippet state: %s",
                            snippet.getState()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }
    }

