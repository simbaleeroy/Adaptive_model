    @GET
    @Timed(name = "list-virtual-circuit-errors")
    @NetworkBasedAccessControl
    @Path("/{virtualCircuitId}/errors")
    @AuthorizationPermission(Permissions.VIRTUAL_CIRCUIT_READ)
    @AuthorizeReadOnly
    @VariableOperationName(VpnAuthConstants.Operations.ListVirtualCircuitErrors)
    @ApiPerf(sla = ApiSLA.ListVirtualCircuitErrors)
    public PaginatedResponse<VirtualCircuitErrorDetails> listVirtualCircuitErrors(
            @PrincipalContext Principal principal,
            @NbacRequestContext NbacRequest nbacRequest,
            @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
            @PathParam("virtualCircuitId") String virtualCircuitId,
            @DefaultValue("10") @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken,
            @QueryParam(Params.COMPARTMENT_ID) String compartmentId,
            @AuditContext AuditPayloadAppender auditPayloadAppender) throws ValidationException, AuthServerUnavailableException {

        Validation.limitParamValidate(limit);
        Validation.OCIDValidate(compartmentId);
        Validation.OCIDValidate(virtualCircuitId);

        auditPayloadAppender.setEventName("listVirtualCircuitErrors", OperationSynchronousType.Synchronous);

        List<String> permissions = ImmutableList.of(Permissions.VIRTUAL_CIRCUIT_READ);
        authorizationHelper.authorize(
                nbacRequest, authorizationRequest, compartmentId, permissions,
                VpnAuthConstants.Operations.ListQosBandwidthReservationTemplateShapes, principal, null);

        String tenancyId = identityMetadataHelper.getTenantId(compartmentId);

        boolean whitelistedForQosBandwidthReservation = featureController
                .isTenancyWhitelisted(VpnLimitsClient.VpnProperty.FEATURE_FC_DYNAMIC_QOS, tenancyId);

        boolean whitelistedForVcBandwidthValidation = featureController
                .isTenancyWhitelisted(VpnLimitsClient.VpnProperty.FEATURE_VC_BANDWIDTH_VALIDATION, tenancyId);

        if (!whitelistedForQosBandwidthReservation || !whitelistedForVcBandwidthValidation){
            throw new ValidationException(ErrorCode.NotAuthorizedOrNotFound,
                    "Customer is not whitelisted to get the list of Virtual Circuit Errors");
        }

        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrowForAuth(virtualCircuitId);
        List<VirtualCircuitErrorDetails> virtualCircuitErrorDetailsList = new ArrayList<>();
        if(!virtualCircuitDo.isDynamicQosEnabled()) {
            log.info("Dynamic QoS is not enabled on the provided VC: {}", virtualCircuitId);
            return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
        }

        if (virtualCircuitDo.getCrossConnectMapping().getMappings().length > 1){
            log.info("Multiple mappings are present on Dynamic QoS enabled VC : {}", virtualCircuitId);
            return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
        }

        try (Transaction t = vcToVlanMappingBl.beginTransaction("get-vc-to-vlan-mapping")) {
            List<VcToVlanMappingDo> vcToVlanMappingDoListByVcId = vcToVlanMappingBl.getMappingByVcId(t, virtualCircuitId);
            if(vcToVlanMappingDoListByVcId.isEmpty()) {
                return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
            }
            String vcAssociatedCcOrCcgId = vcToVlanMappingDoListByVcId.get(0).getCcOrCcgId();
            Integer lagCapacity;
            try {
                lagCapacity = calculateLagCapacity(vcAssociatedCcOrCcgId) * 1000;
            } catch (ValidationException ex) {
                log.error("Exception while calculating LAG capacity of CrossConnectOrGroup : {}", vcAssociatedCcOrCcgId);
                return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
            }

            DynamicQosValidationData dynamicQosValidationData;
            try {
                dynamicQosValidationData = generateDynamicQosValidationData(t, vcAssociatedCcOrCcgId);
            } catch (ValidationException ex){
                log.error("Exception while populating Dynamic QoS Validation Data for VC : {}", virtualCircuitId);
                return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
            }

            log.info("Calculated LAG Capacity : {} and Utilised bandwidth : {} for VC : {}", lagCapacity, dynamicQosValidationData.getVcTotalBandwidthUtilisation(), virtualCircuitId);
            if(dynamicQosValidationData.getVcTotalBandwidthUtilisation() > lagCapacity) {
                VirtualCircuitErrorConfiguration.VirtualCircuitErrorResponse virtualCircuitErrorResponse = virtualCircuitErrorConfiguration
                        .getVirtualCircuitErrorResponseForErrorCase("BANDWIDTH_OVERSUBSCRIBED");

                String errorDescription = String.format(virtualCircuitErrorResponse.getErrorDescription(),
                        lagCapacity / 1000 + " Gbps",
                        lagCapacity / 1000 + " Gbps");

                String solution = String.format(virtualCircuitErrorResponse.getSolution(), lagCapacity/1000 + " Gbps");

                virtualCircuitErrorDetailsList.add(buildVirtualCircuitErrorDetails(virtualCircuitErrorResponse, errorDescription, solution));
            } else if (dynamicQosValidationData.getVcTotalBandwidthUtilisation() < lagCapacity) {
                VirtualCircuitErrorConfiguration.VirtualCircuitErrorResponse virtualCircuitErrorResponse = virtualCircuitErrorConfiguration
                        .getVirtualCircuitErrorResponseForErrorCase("BANDWIDTH_UNDERSUBSCRIBED");

                String errorDescription = String.format(virtualCircuitErrorResponse.getErrorDescription(),
                        lagCapacity / 1000 + " Gbps",
                        lagCapacity / 1000 + " Gbps");

                String solution = String.format(virtualCircuitErrorResponse.getSolution(), lagCapacity/1000 + " Gbps");

                virtualCircuitErrorDetailsList.add(buildVirtualCircuitErrorDetails(virtualCircuitErrorResponse, errorDescription, solution));

            }

            if(dynamicQosValidationData.getVcCountNotHavingDynamicQoSEnabled() > 0) {
                VirtualCircuitErrorConfiguration.VirtualCircuitErrorResponse virtualCircuitErrorResponse = virtualCircuitErrorConfiguration
                        .getVirtualCircuitErrorResponseForErrorCase("QOS_MISSING");

                virtualCircuitErrorDetailsList.add(buildVirtualCircuitErrorDetails(virtualCircuitErrorResponse,
                        virtualCircuitErrorResponse.getErrorDescription(),
                        virtualCircuitErrorResponse.getSolution()));
            }
        }

        return new PaginatedResponse<>(virtualCircuitErrorDetailsList);
    }

    private VirtualCircuitErrorDetails buildVirtualCircuitErrorDetails(VirtualCircuitErrorConfiguration.VirtualCircuitErrorResponse virtualCircuitErrorResponse,
                                                                       String errorDescription,
                                                                       String solution){
        return VirtualCircuitErrorDetails.builder()
                .severityLevel(virtualCircuitErrorResponse.getSeverityLevel())
                .errorCode(virtualCircuitErrorResponse.getErrorCode())
                .errorDescription(errorDescription)
                .solution(solution)
                .ociResourcesLink(virtualCircuitErrorResponse.getOciResourcesLink())
                .build();
    }

    private Integer calculateLagCapacity(String vcAssociatedCcOrCcgId) throws ValidationException {
        int lagCapacity = 0;
        if(VirtualCircuitBl.isCrossConnect(vcAssociatedCcOrCcgId)) {
            lagCapacity = InterfaceDo.PortSpeed.create(crossConnectBl
                            .getOrThrowForAuth(vcAssociatedCcOrCcgId)
                                .getPortSpeed()).map(portSpeed -> portSpeed.portSpeedInGbs).orElse(0);
        } else {
            String[] associatedCrossConnectIds = crossConnectGroupBl
                    .getOrThrowForAuth(vcAssociatedCcOrCcgId).getCrossConnectIds();
            for (String crossConnectId: associatedCrossConnectIds) {
                lagCapacity += InterfaceDo.PortSpeed.create(crossConnectBl
                                .getOrThrowForAuth(crossConnectId)
                                    .getPortSpeed()).map(portSpeed -> portSpeed.portSpeedInGbs).orElse(0);
            }
        }
        return lagCapacity;
    }

    private DynamicQosValidationData generateDynamicQosValidationData(Transaction t,
                                                                      String vcAssociatedCcOrCcgId) throws ValidationException {
        List<VcToVlanMappingDo> vcToVlanMappingDoListByCcOrCcgId = vcToVlanMappingBl
                .getMappingByCcOrCcgId(t, vcAssociatedCcOrCcgId);

        Map<String, Integer> vcToBandwidthUtilisedMap = new HashMap<>();
        Map<String, Boolean> vcToDynamicQoSEnabledMap = new HashMap<>();

        for (VcToVlanMappingDo vcToVlanMappingDo: vcToVlanMappingDoListByCcOrCcgId) {
            String virtualCircuitId = vcToVlanMappingDo.getVirtualCircuitId();
            Boolean isDynamicQosEnabled = vcToVlanMappingDo.getIsDynamicQosEnabled();
            Integer bandwidthInMbps = vcToVlanMappingDo.getBandwidthInMbps();
            if (bandwidthInMbps == null){
                VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
                isDynamicQosEnabled = virtualCircuitDo.getIsDynamicQosEnabled();
                bandwidthInMbps = virtualCircuitDo.getBandwidthInMbps();
            }
            vcToBandwidthUtilisedMap.put(virtualCircuitId, bandwidthInMbps);
            vcToDynamicQoSEnabledMap.put(virtualCircuitId, isDynamicQosEnabled);
        }
        Set<String> newVirtualCircuitIds = vcToBandwidthUtilisedMap.keySet();
        Set<String> oldVirtualCircuitIds = new HashSet<>();

        if (VirtualCircuitBl.isCrossConnect(vcAssociatedCcOrCcgId)){
            CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(vcAssociatedCcOrCcgId);
            if (crossConnectDo.getVcsToVlans() != null) {
                oldVirtualCircuitIds = crossConnectDo.getVcsToVlans().keySet();
            }
        } else{
            CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(vcAssociatedCcOrCcgId);
            if (crossConnectGroupDo.getVcsToVlans() != null) {
                oldVirtualCircuitIds = crossConnectGroupDo.getVcsToVlans().keySet();
            }
        }

        if (!oldVirtualCircuitIds.isEmpty()){
            Set<String> vcsNotPresentInVcToVlanMapping = oldVirtualCircuitIds.stream()
                    .filter(virtualCircuitId -> !newVirtualCircuitIds.contains(virtualCircuitId))
                    .collect(Collectors.toSet());
            for (String virtualCircuitId : vcsNotPresentInVcToVlanMapping){
                VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
                vcToBandwidthUtilisedMap.put(virtualCircuitId, virtualCircuitDo.getBandwidthInMbps());
                vcToDynamicQoSEnabledMap.put(virtualCircuitId, virtualCircuitDo.getIsDynamicQosEnabled());
            }
        }

        int totalVcBandwidthUtilisation = 0;
        int countOfVcNotHavingDynamicQoSEnabled = 0;
        for (String vcOcid: vcToBandwidthUtilisedMap.keySet()) {
            totalVcBandwidthUtilisation += vcToBandwidthUtilisedMap.getOrDefault(vcOcid, 0);
            countOfVcNotHavingDynamicQoSEnabled += Boolean.TRUE.equals(vcToDynamicQoSEnabledMap.getOrDefault(vcOcid, false)) ? 0 : 1;
        }

        return DynamicQosValidationData.builder()
                .ccOrCcgOcid(vcAssociatedCcOrCcgId)
                .associatedVcOcids(new ArrayList<>(vcToBandwidthUtilisedMap.keySet()))
                .vcTotalBandwidthUtilisation(totalVcBandwidthUtilisation)
                .vcCountNotHavingDynamicQoSEnabled(countOfVcNotHavingDynamicQoSEnabled)
                .build();
    }

