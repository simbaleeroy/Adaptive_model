    // This is a raw create that creates the DO with no validation. This should used with caution and is
    // currently used only for test purpose.
    public VirtualCircuitDo createDo(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        String tenantId = null;
        try {
            tenantId = identityMetadataHelper.getTenantId(virtualCircuitDo.getCompartmentId());
            log.debug("Getting tenantId for virtualCircuitDo {} tenantId {}", virtualCircuitDo, tenantId);
            virtualCircuitDo = virtualCircuitDo.toBuilder()
                    .tenantId(tenantId)
                    .build();
        } catch (Exception e) {
            log.warn("Issue getting tenantId for vcDo {}", virtualCircuitDo, e);
        }
        return super.create(t, virtualCircuitDo);
    }

    /**
     * This method created DO in DB and also records create with RQS service
     */
    private VirtualCircuitDo doCreate(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        String tenantId = null;
        try {
            tenantId = identityMetadataHelper.getTenantId(virtualCircuitDo.getCompartmentId());
            virtualCircuitDo = virtualCircuitDo.toBuilder()
                    .tenantId(tenantId)
                    .build();
        } catch (Exception e) {
            log.warn("Issue getting tenantId for vcDo {}", virtualCircuitDo, e);
        }

        VirtualCircuitDo effectivelyFinal = super.create(t, virtualCircuitDo);

        if (rqsHelper.isRQSEnabled()) {
            VirtualCircuitRqsModel virtualCircuitRqsModel = VirtualCircuitRqsModel.createFrom(effectivelyFinal.toModel(providerServiceBl, vcTunnelAssociationBl,tenancyMetadataBl, identityMetadataHelper, null, null, null));
            rqsHelper.createOrUpdate(virtualCircuitRqsModel, VirtualCircuitRqsModel.TYPE, String.valueOf(virtualCircuitRqsModel.getChecksum()), t);
        }
        return effectivelyFinal;
    }
    @Override
    public VirtualCircuitDo create(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        return create(t, virtualCircuitDo, false);
    }

    public VirtualCircuitDo create(Transaction t, VirtualCircuitDo virtualCircuitDo, boolean whitelistedForIpv6) throws ValidationException {
        virtualCircuitDo = virtualCircuitDo.toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnVirtualCircuit).serialize())
                .groupId(UUID.randomUUID().toString())
                .state(State.PROVISIONING)
                .lastStateChanged(new Date())
                .build();

        if (virtualCircuitDo.isPublic()) {
            virtualCircuitDo = allocateBgpPeerIps(t, virtualCircuitDo, Optional.empty(), whitelistedForIpv6);
        }

        baseValidate(t, virtualCircuitDo);
        validateCreateForCustomer(virtualCircuitDo);
        if (virtualCircuitDo.getGlobalPopVcMetadata() == null) {
            validateNetworking(virtualCircuitDo, t);
        }
        virtualCircuitDo = associationHelper.addAssociations(t, virtualCircuitDo);
        return doCreate(t, virtualCircuitDo);
    }


    public VirtualCircuitDo createWithL2Provider(Transaction t, VirtualCircuitDo virtualCircuitDo, boolean whitelistedForIpv6) throws ValidationException {
        virtualCircuitDo = virtualCircuitDo.toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnVirtualCircuit).serialize())
                .groupId(UUID.randomUUID().toString())
                .state(getInitialStateForCreateWithProvider(virtualCircuitDo, providerServiceBl, propertiesBl))
                .build();

        if (virtualCircuitDo.isPublic()) {
            virtualCircuitDo = allocateBgpPeerIps(t, virtualCircuitDo, Optional.empty(), whitelistedForIpv6);
        }

            baseValidate(t, virtualCircuitDo);
        validatePreActiveNetworkSettingsForL2(virtualCircuitDo);
        virtualCircuitDo = associationHelper.addAssociations(t, virtualCircuitDo);

        return doCreate(t, virtualCircuitDo);
    }

    public VirtualCircuitDo createWithL3Provider(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
