    @POST
    @Timed(name = "createConfigSnippet")
    @Path("/configSnippets")
    @VpnSkipAuthorization
    public ConfigSnippet createConfigSnippet(@Valid @NonNull CreateConfigSnippetRequestDetails request)
            throws Exception {
        String deviceId = request.getDeviceId();
        deviceBl.getOrThrow(deviceId);
        String groupName = request.getGroupName();
        Optional<ConfigSnippetDo> configSnippetDoOptional = configSnippetBl.getConfigSnippetByDeviceAndGroup(deviceId, groupName);
        configSnippetDoOptional.ifPresent(configSnippetDo -> {
            throw new RenderableException(
                    ErrorCode.InvalidParameter,
                    "ConfigSnippet for groupName already exists with ID", configSnippetDo.getId());
        });
        Map<String, Object> newTemplateValue = ResourceUtils.parseStringifyiedJson(
                request.getTemplateValues());

        for (String key : REDACTED_CONFIG_SNIPPET_TEMPLATE_KEY_VALUES) {
            if (newTemplateValue.containsKey(key)) {
                newTemplateValue.put(key, encryptedValue(newTemplateValue.get(key)));
            }
        }
        Boolean isActive = request.getIsActive() != null ? request.getIsActive() : true;
        ConfigSnippetDo configSnippetDo = ConfigSnippetDo.builder()
                .deviceId(deviceId)
                .groupName(groupName)
                .deviceConfigGroupName(baseConfigGroupToTemplates.contains(request.getTemplateName()) ?
                    C3_BASE_CONFIG_GROUP_NAME : C3_CUSTOMER_CONFIG_GROUP_NAME)
                .templateValues(newTemplateValue)
                .referenceId(request.getReferenceId())
                .templateName(request.getTemplateName())
                .overrideTemplate(request.getOverrideTemplate())
                .isActive(isActive)
                .failed(false)
                .build();

        return withRetriesOnCommitConflictException(() -> {
            ConfigSnippetDo configSnippetDo1;
            try (Transaction t = configSnippetBl.beginTransaction("create new config snippet")) {
                configSnippetDo1 = configSnippetBl.create(t, configSnippetDo);
                t.commit();
            }
            return toModel(configSnippetDo1);
        });
    }

