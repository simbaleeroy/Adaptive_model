def get_free_port():
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        s.bind(('', 0))
        return s.getsockname()[1]

LOCAL_PORT = get_free_port()

def init_parser():
    parser = argparse.ArgumentParser(
        description="Enable Arp on devices",
        epilog="Example: python3 ocid_c3_ncp_tool.py --ocid ocid1.crossconnect.region1.sea.aaaaaaaa2sz23y3g5a2m5uvxsp2ypmy6jti6mlp7ofezcmp3def4jjjpq2sa --realm oc1 --region -iad")
    parser.add_argument("--ocid", action="store",
                        help="Ocid")
    parser.add_argument("--realm", action="store",
                        help="Realm")
    parser.add_argument("--region", action="store",
                        help="Region")
    # parser.add_argument('--tenancy', action = "store")
    return parser


def setup(realm, region):
    regionTemp = region

    realmTemp =  realm # "OC1"

    global hostname
    global signer

    # Clean Tunnel
    print("SetUp Step 3 :Clean the Tunnel")
    # Change this according to region.
    # proxy = PROXY_TEMPLATE.format(region=json_data['region'], devops_dns_name="oci.oraclerealm17.com")
    proxy = PROXY_TEMPLATE.format(region=regionTemp, devops_dns_name="oci.oracleiaas.com")
    clean_tunnel(proxy)

    # Create Tunnel
    print("SetUp Step 4 :Create tunnel to vpn-api")
    run_command("ssh -f -N -D {port} {proxy}".format(port=LOCAL_PORT, proxy=proxy))

    print("SetUp Step 5 : Create Yubikey Signer")
    # Create Yubikey Signer
    signer = create_auth_signer(realmTemp) # put realm param


    if regionTemp == 'us-phoenix-1':
        regionTemp = 'r2'

    hostname = VPN_API_TEMPLATE.format(region=regionTemp)
    print("SetUp Completed ")


def clean_tunnel(proxy):
    run_command("ps ax | grep ssh | grep {proxy} | cut -d' ' -f 1 | xargs kill".format(proxy=proxy),
                exit_when_fail=False)


def getC3MultiAttributes(_ocid):
    attributes = {}
    resource_name = "None"
    ocids = ['virtualCircuit', 'crossConnect', 'crossConnectGroup']

    # for each_ocid in multiple_ocids:
    for ocid_type in ocids:
        response = requests.get(
        'https://{hostname}/v1/management/{ocid_type}s/{ocid}'.format(hostname=hostname, ocid_type=ocid_type,ocid=_ocid),
        auth=signer,
        proxies={'https': 'socks5h://127.0.0.1:{port}'.format(port=LOCAL_PORT)},
        verify=False)
        requestResponse = json.loads(response.text)
        if "code" not in requestResponse:
            resource_name = ocid_type
            attributes = {resource_name:requestResponse}
            break


    return attributes


def remove_color_codes(text):
    ansi_escape = re.compile(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[@~])')
    return ansi_escape.sub('', text)


