export function getVirtualCircuitBreadcrumbs(
  path: string,
  crossConnectId: string,
  t: MauiTranslate,
  isProviderTenant: boolean,
  isNewIa?: boolean,
  isCustomerConnectivityOverviewPageEnabled?: boolean,
): BreadCrumbItem[] {
  const subpath = ["cross-connect-group/", "cross-connect/"].find(key => path.includes(key));
  const providerPath = isProviderTenant ? "provider/" : "";
  let breadCrumbItems: BreadCrumbItem[] = [
    {
      id: "networking-title",
      label: t(MessagesKeys.breadcrumb.networking),
      href: "/networking",
    },
    {
      id: "fast-connect",
      label: t(MessagesKeys.breadcrumb.fastConnect),
      href: `/networking/fast-connect/${providerPath}`,
    },
    // Show VC subresource breadcrumb if comes from cross connect
    ...(subpath
      ? [
          {
            id: "virtual-circuits",
            label: t(MessagesKeys.breadcrumb.virtualCircuits),
            href: `/networking/fast-connect/${providerPath}${subpath}${crossConnectId}/virtual-circuits`,
          },
        ]
      : []),
    {
      id: "virtual-circuit",
      label: t(MessagesKeys.breadcrumb.connectionDetails),
      current: "page",
    },
  ];
  if (isNewIa) {
    breadCrumbItems = [
      ...breadCrumbItems.slice(0, 1),
      {
        id: "customer-connectivity",
        label: t(MessagesKeys.breadcrumb.customerConnectivity),
        href: isCustomerConnectivityOverviewPageEnabled
          ? "/networking/customer-connectivity"
          : undefined,
      },
      ...breadCrumbItems.slice(1),
    ];
  }
  return breadCrumbItems;
}

export function getVirtualCircuitConnectionType(
  serviceType: ApiVirtualCircuitServiceTypeEnum,
): ConnectionType {
  return serviceType && serviceType === VirtualCircuitServiceTypeEnum.Colocated
    ? ConnectionType.Colocated
    : ConnectionType.Provider;
}

export function disableVirtualCircuitUpdate(
  lifeCycleState: ApiVirtualCircuitLifecycleStateEnum,
): boolean {
  return ["PROVISIONING", "TERMINATING", "FAILED"].includes(lifeCycleState);
}

export function disableVirtualCircuitDelete(
  lifeCycleState: ApiVirtualCircuitLifecycleStateEnum,
): boolean {
  return [
    "TERMINATING",
    // "FAILED"
  ].includes(lifeCycleState);
}
