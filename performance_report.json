export const isVirtualCircuitTypeValid = (
  formFields: Record<string, any>,
  vcList: DEFINITION_CoreServicesApi_FastConnectProviderService[] = [],
  providerServiceFields: string[] = [VirtualCircuitFieldNames.ProviderServiceId],
): boolean => {
  if (!formFields) return true;

  const vcType = formFields[VirtualCircuitFieldNames.Type];

  // Check for all providerServiceFields, return false if any violates public/private rules
  return !providerServiceFields.some(providerServiceField => {
    const providerServiceId = formFields[providerServiceField];
    return (
      (isPublicDisable(providerServiceId, vcList) && vcType === VCTypeEnum.Public) ||
      (isPrivateDisable(providerServiceId, vcList) && vcType === VCTypeEnum.Private) ||
      (isInternetDisable(providerServiceField, vcList) && vcType === VCTypeEnum.Internet)
    );
  });
};

