            format: bianry

  DefaultDrgRouteTables:
    description: |
      The default DRG route table for this DRG. Each network type
      has a default DRG route table.

      You can update a network type to use a different DRG route table, but
      each network type must have a default DRG route table. You cannot delete
      a default DRG route table.

    properties:
      vcn:
        description: |
          The [OCID](/Content/General/Concepts/identifiers.htm) of the default DRG route table to be assigned to DRG attachments
          of type VCN on creation.
        maxLength: 255
        minLength: 1
        type: string
      ipsecTunnel:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the default DRG route table assigned to DRG attachments
          of type IPSEC_TUNNEL on creation.
        maxLength: 255
        minLength: 1
        type: string
      virtualCircuit:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the default DRG route table to be assigned to DRG attachments
          of type VIRTUAL_CIRCUIT on creation.
        maxLength: 255
        minLength: 1
        type: string
      remotePeeringConnection:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the default DRG route table to be assigned to DRG attachments
          of type REMOTE_PEERING_CONNECTION on creation.
        maxLength: 255
        minLength: 1
        type: string

  CreateDrgRouteTableDetails:
    description: |
      Details used in a request to create a DRG route table.
    properties:
      definedTags: *ref-definedTags
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags
      drgId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the DRG the DRG route table belongs to.
        maxLength: 255
        minLength: 1
        type: string
      importDrgRouteDistributionId:
        description: |
          The [OCID](/Content/General/Concepts/identifiers.htm) of the import route distribution used to specify how incoming route advertisements through
          referenced attachments are inserted into the DRG route table.
        maxLength: 255
        minLength: 1
        type: string
      isEcmpEnabled:
        description: |
          If you want traffic to be routed using ECMP across your virtual circuits or IPSec tunnels to
          your on-premises networks, enable ECMP on the DRG route table.
        type: boolean
        default: false
    required:
      - drgId
  UpdateDrgRouteTableDetails:
    description: |
      Details used in a request to update a DRG route table.

      You can't assign a table to a virtual circuit or IPSec tunnel attachment if there is a static route rule for an RPC attachment.
    properties:
      definedTags: *ref-definedTags
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags
      importDrgRouteDistributionId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the import route distribution used to specify how incoming route advertisements through
          referenced attachements are inserted into the DRG route table.
        maxLength: 255
        minLength: 1
        type: string
      isEcmpEnabled:
        description: |
          If you want traffic to be routed using ECMP across your virtual circuits or IPSec tunnels to
          your on-prem networks, set this value to true on the route table.
        type: boolean
  AddDrgRouteRulesDetails:
    description: |
      Details used in a request to add static routes to a DRG route table.
    properties:
      routeRules:
        description: |
          The collection of static rules used to insert routes into the DRG route table.
        items:
          $ref: '#/definitions/AddDrgRouteRuleDetails'
        maxItems: 100
        minItems: 1
        type: array

  AddDrgRouteRuleDetails:
    description: |
      Details needed when adding a DRG route rule.
    properties:
      destinationType:
        description: |
          Type of destination for the rule. Required if `direction` = `EGRESS`.
          Allowed values:
            * `CIDR_BLOCK`: If the rule's `destination` is an IP address range in CIDR notation.
        enum:
          - CIDR_BLOCK
        type: string
      destination:
        description: |
          This is the range of IP addresses used for matching when routing
          traffic. Only CIDR_BLOCK values are allowed.

          Potential values:
            * IP address range in CIDR notation. This can be an IPv4 or IPv6 CIDR. For example: `192.168.1.0/24`
            or `2001:0db8:0123:45::/56`.
        maxLength: 255
        minLength: 1
        type: string
      nextHopDrgAttachmentId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the next hop DRG attachment. The next hop DRG attachment is responsible
          for reaching the network destination.
        maxLength: 255
        minLength: 1
        type: string
    required:
      - destination
      - nextHopDrgAttachmentId
      - destinationType
  RemoveDrgRouteRulesDetails:
    description: |
      Details used in a request to remove static routes from a DRG route table.
    properties:
      routeRuleIds:
        description: |
          The Oracle-assigned ID of each DRG route rule to be deleted.
        items:
          type: string
        maxItems: 100
        minItems: 1
        type: array

  UpdateDrgRouteRulesDetails:
    description: |
      Details used to update route rules in a DRG route table.
    properties:
      routeRules:
        description: The DRG rute rules to update.
        items:
          $ref: '#/definitions/UpdateDrgRouteRuleDetails'
        maxItems: 100
        minItems: 1
        type: array

  UpdateDrgRouteRuleDetails:
    description: |
      Details used to update a route rule in the DRG route table.
    properties:
      id:
        description: |
          The Oracle-assigned ID of each DRG route rule to update.
        maxLength: 255
        minLength: 1
        type: string
      destination:
        description: |
          The range of IP addresses used for matching when routing traffic.

          Potential values:
            * IP address range in CIDR notation. Can be an IPv4 or IPv6 CIDR. For example: `192.168.1.0/24`
            or `2001:0db8:0123:45::/56`.
        maxLength: 255
        minLength: 1
        type: string
      destinationType:
        description: |
          Type of destination for the rule. Required if `direction` = `EGRESS`.
          Allowed values:
            * `CIDR_BLOCK`: If the rule's `destination` is an IP address range in CIDR notation.
        enum:
          - CIDR_BLOCK
        type: string
      nextHopDrgAttachmentId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the next hop DRG attachment. The next hop DRG attachment is responsible
          for reaching the network destination.
        maxLength: 255
        minLength: 1
        type: string
    required:
      - id

  CreateDrgRouteDistributionDetails:
    description: |
      Details used to create a route distribution.
    properties:
      definedTags: *ref-definedTags
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags
      drgId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the DRG the DRG route table belongs to.
        maxLength: 255
        minLength: 1
        type: string
      distributionType:
        description: |
          Whether this distribution defines how routes get imported into route tables or exported through DRG Attachments
        enum:
          - IMPORT
        type: string
    required:
      - drgId
      - distributionType

  UpdateDrgRouteDistributionDetails:
    description: |
      Details used in a request to update a route distribution.

      You cannot assign a table to a virtual circuit or IPSec tunnel attachment if there is a static route rule for an RPC attachment.
    properties:
      definedTags: *ref-definedTags
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags

  AddDrgRouteDistributionStatementsDetails:
    description: |
      Details request to add statements to a route distribution.
    properties:
      statements:
        description: |
          The collection of route distribution statements to insert into the route distribution.
        items:
          $ref: '#/definitions/AddDrgRouteDistributionStatementDetails'
        maxItems: 100
        minItems: 0
        type: array
    required:
      - statements

  AddDrgRouteDistributionStatementDetails:
    description: |
      Details used to add a route distribution statement.
    properties:
      matchCriteria:
        description: |
          The action is applied only if all of the match criteria is met.
          If there are no match criteria in a statement, match ALL is implied.
        items:
          $ref: '#/definitions/DrgRouteDistributionMatchCriteria'
        maxItems: 1
        minItems: 0
        type: array
      action:
        description: |
          Accept: import/export the route "as is"
        enum:
          - ACCEPT
        type: string
      priority:
        description: |
          This field is used to specify the priority of each statement in a route distribution.
          The priority will be represented as a number between 0 and 65535 where a lower number
          indicates a higher priority. When a route is processed, statements are applied in the order
          defined by their priority. The first matching rule dictates the action that will be taken
          on the route.
        maximum: 65535
        minimum: 1
        type: integer
    required:
      - matchCriteria
      - action
      - priority

  RemoveDrgRouteDistributionStatementsDetails:
    description: |
      Details request to remove statements from a route distribution.
    properties:
      statementIds:
        description: |
          The Oracle-assigned ID of each route distribution to remove.
        items:
          type: string
        maxItems: 100
        minItems: 1
        type: array

  UpdateDrgRouteDistributionStatementsDetails:
    description: |
      Details request to update statements in a route distribution.
    properties:
      statements:
        description: |
          The route distribution statements to update, and the details to be updated.
        items:
          $ref: '#/definitions/UpdateDrgRouteDistributionStatementDetails'
        maxItems: 100
        minItems: 0
        type: array
    required:
      - statements

  UpdateDrgRouteDistributionStatementDetails:
    description: |
      Route distribution statements to update in the route distribution.
    properties:
      id:
        description: |
          The Oracle-assigned ID of each route distribution statement to be updated.
        maxLength: 255
        minLength: 1
        type: string
      matchCriteria:
        description: |
          The action is applied only if all of the match criteria is met.
          If there are no match criteria in a statement, match ALL is implied.
        items:
          $ref: '#/definitions/DrgRouteDistributionMatchCriteria'
        maxItems: 1
        minItems: 0
        type: array
      priority:
        description: |
          The priority of the statement you'd like to update.
        maximum: 65535
        minimum: 1
        type: integer
    required:
      - id
  TopologyEntityRelationship:
    discriminator: type
    description: Defines the relationship between Virtual Network topology entities.
    properties:
      id1:
        type: string
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the first entity in the relationship.
      id2:
        type: string
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the second entity in the relationship.
      type:
        description: The type of relationship between the entities.
        type: string
        enum:
          - CONTAINS
          - ASSOCIATED_WITH
          - ROUTES_TO
    required:
      - id1
      - id2
      - type

  TopologyContainsEntityRelationship:
    description: |
      Defines the `contains` relationship between virtual network topology entities. A `Contains` relationship
      is defined when an entity fully owns, contains or manages another entity.
      For example, a subnet is contained and managed in the scope of a VCN, therefore a VCN has a
      `contains` relationship to a subnet.
    allOf:
      - $ref: '#/definitions/TopologyEntityRelationship'
      - discriminator: CONTAINS

  TopologyAssociatedWithEntityRelationship:
    description: |
      Defines the `associatedWith` relationship between virtual network topology entities. An `AssociatedWith` relationship
      is defined when there is no obvious `contains` relationship but entities are still related.
      For example, a DRG is associated with a VCN because a DRG is not managed by VCN but can be
      attached to a VCN.
    allOf:
      - $ref: '#/definitions/TopologyEntityRelationship'
      - discriminator: ASSOCIATED_WITH
        properties:
          associatedWithDetails:
            $ref: "#/definitions/TopologyAssociatedWithRelationshipDetails"
  TopologyAssociatedWithRelationshipDetails:
    description: Defines association details for a `associatedWith` relationship.
    properties:
      via:
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the entities via which the relationship is created. For example an Instance is associated with a Network Security Group via the VnicAttachment and the Vnic.
        type: array
        items:
          type: string
          minLength: 1
          maxLength: 255

  TopologyRoutesToEntityRelationship:
    description: |
      Defines the `routesTo` relationship between virtual network topology entities. A `RoutesTo` relationship
      is defined when a routing table and a routing rule  are used to govern how to route traffic
      from one entity to another. For example, a DRG might have a routing rule to send certain traffic to an LPG.
    allOf:
      - $ref: '#/definitions/TopologyEntityRelationship'
      - discriminator: ROUTES_TO
        properties:
          routeRuleDetails:
            $ref: "#/definitions/TopologyRoutesToRelationshipDetails"
        required:
          - routeRuleDetails

  TopologyRoutesToRelationshipDetails:
    description: Defines route rule details for a `routesTo` relationship.
    properties:
      destinationType:
        description: |
          The destinationType can be set to one of two values:

          * Use `CIDR_BLOCK` if the rule's `destination` is an IP address range in CIDR notation.

          * Use `SERVICE_CIDR_BLOCK` if the rule's `destination` is the `cidrBlock` value for a [Service](#/en/iaas/latest/Service/).
        type: string
      destination:
        description: An IP address range in CIDR notation or the `cidrBlock` value for a [Service](#/en/iaas/latest/Service/).
        type: string
        maxLength: 255
        minLength: 1
      routeTableId:
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the routing table that contains the route rule.
        maxLength: 255
        minLength: 1
        type: string
      routeType:
        description: |
          A route rule can be STATIC if manually added to the Route Table or DYNAMIC if imported from another Route Table:
        enum:
          - STATIC
          - DYNAMIC
        type: string
    required:
      - destinationType
      - destination
      - routeTableId

  Topology:
    description: Defines the representation of a virtual network topology.
    discriminator: type
    required:
      - type
      - entities
      - relationships
      - timeCreated
    properties:
      type:
        description: Type of the topology object.
        type: string
        enum:
          - NETWORKING
          - VCN
          - SUBNET
      entities:
        description: Lists entities comprising the virtual network topology.
        type: array
        items:
          type: object
      relationships:
        description: Lists relationships between entities in the virtual network topology.
        type: array
        items:
          $ref: '#/definitions/TopologyEntityRelationship'
      timeCreated:
        description: Records when the virtual network topology was created, in [RFC3339](https://tools.ietf.org/html/rfc3339) format for date and time.
        type: string
        format: date-time

  NetworkingTopology:
    description: Defines the representation of a virtual network topology for a region.
    allOf:
      - $ref: '#/definitions/Topology'
      - discriminator: NETWORKING

  VcnTopology:
    description: Defines the representation of a virtual network topology for a VCN.
    allOf:
      - $ref: '#/definitions/Topology'
      - discriminator: VCN
        properties:
          vcnId:
            description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the VCN for which the topology is generated.
            maxLength: 255
            minLength: 1
            type: string

  SubnetTopology:
    description: Defines the representation of a Subnet topology for a VCN.
    allOf:
      - $ref: '#/definitions/Topology'
      - discriminator: SUBNET
        properties:
          subnetId:
            description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the Subnet for which the topology is generated.
            maxLength: 255
            minLength: 1
            type: string

  Dav:
    description: A Direct Attached Vnic.
    properties:
      id:
        type: string
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the Direct Attached Vnic.
        minLength: 1
        maxLength: 255
      displayName: *ref-displayName
      compartmentId:
        type: string
        description: The [OCID](/Content/General/Concepts/identifiers.htm) of the Direct Attached Vnic's compartment.
        minLength: 1
        maxLength: 255
      lifecycleState:
        type: string
        description: The current state of the Direct Attached Vnic.
        enum:
          - PROVISIONING
          - UPDATING
          - AVAILABLE
          - TERMINATING
          - TERMINATED
      instanceId:
        type: string
        description: The [OCID](/Content/General/Concepts/identifiers.htm) of the instance.
        minLength: 1
        maxLength: 255
      macAddress:
        type: string
        description: |
          The MAC address for the DAV. This will be a newly allocated MAC address
          and not the one used by the instance.
        minLength: 1
        maxLength: 32
      nicIndex:
        type: integer
        description: Index of NIC for Direct Attached Vnic.
        format: int32
        minimum: 0
      substrateIp:
        type: string
        description: |
          The substrate IP of DAV and primary VNIC attached to the instance.
          This field will be null in case the DAV is not attached.
        minLength: 7
        maxLength: 15
      slotId:
        type: integer
        description: The allocated slot id for the Dav.
      vlanTag:
        type: integer
        description: The VLAN Tag assigned to Direct Attached Vnic.
        format: int32
      virtualRouterMac:
        type: string
        description: The MAC address of the Virtual Router.
        minLength: 1
        maxLength: 32
      remoteEndpointSubstrateIp:
        type: string
        description: Substrate IP address of the remote endpoint.
        minLength: 7
        maxLength: 15
      vcnxAttachmentIds:
        type: array
        description: List of VCNx Attachments to a DRG.
        uniqueItems: true
        items:
          type: string
          minLength: 1
          maxLength: 255
      labelType:
        type: string
        description: |
          The label type for Direct Attached Vnic. This is used to determine the
          label forwarding to be used by the Direct Attached Vnic.
        enum:
          - MPLS
      freeformTags: *ref-freeformTags
      definedTags: *ref-definedTags
    required:
      - id
      - compartmentId
      - nicIndex
      - lifecycleState
  CreateDavDetails:
    description: Details to create a Direct Attached Vnic.
    properties:
      displayName: *ref-displayName
      compartmentId:
        type: string
        description: The [OCID](/Content/General/Concepts/identifiers.htm) of the Direct Attached Vnic's compartment.
        minLength: 1
        maxLength: 255
      remoteEndpointSubstrateIp:
        type: string
        description: |
          Substrate IP address of the remote endpoint. This is a required property if
          vcnxAttachmentIds property is not defined.
        minLength: 7
        maxLength: 15
      labelType:
        type: string
        description: |
          The label type for Direct Attached Vnic. This is used to determine the
          label forwarding to be used by the Direct Attached Vnic.
        enum:
          - MPLS
      vcnxAttachmentIds:
        type: array
        description: |
          List of VCNx Attachments to a DRG. This is a required property
          if remoteEndpointSubstrateIp property is not defined.
        uniqueItems: true
        items:
          type: string
          minLength: 1
          maxLength: 255
      nicIndex:
        type: integer
        description: Index of NIC for Direct Attached Vnic.
        format: int32
        minimum: 0
      freeformTags: *ref-freeformTags
      definedTags: *ref-definedTags
    required:
      - compartmentId
      - nicIndex
  UpdateDavDetails:
    description: Details to update a Direct Attached Vnic.
    properties:
      displayName: *ref-displayName
      vcnxAttachmentIds:
        type: array
        description: List of VCNx Attachments to a DRG.
        uniqueItems: true
        items:
          type: string
          minLength: 1
          maxLength: 255
      freeformTags: *ref-freeformTags
      definedTags: *ref-definedTags
  AttachDavDetails:
    description: Details to attach a Direct Attached Vnic to an instance.
    required:
      - hostInstanceId
    properties:
      hostInstanceId:
        type: string
        description: The [OCID](/Content/General/Concepts/identifiers.htm) of the host instance.
        minLength: 1
        maxLength: 255
  IPSecConnectionTunnelErrorDetails:
    description: Ipsec tunnels error details
    properties:
      id:
        type: string
        description: unique id generated for each error report
        minLength: 1
        maxLength: 255
      errorCode:
        type: string
        description: unique code describes error type
        minLength: 1
        maxLength: 255
      errorDescription:
        type: string
        description: detailed description of the error
        minLength: 1
        maxLength: 1000
      solution:
        type: string
        description: how to resolve the error
        minLength: 1
        maxLength: 1000
      ociResourcesLink:
        type: string
        description: link to oracle resources
        minLength: 1
        maxLength: 255
      timestamp:
        description: timestamp when error occurred.
        format: date-time
        type: string
    required:
      - id
      - errorCode
      - errorDescription
      - solution
      - ociResourcesLink
      - timestamp
  # IMPORTANT: This file is exactly included in another spec file, so the two space indentation must be maintained.

  BootVolume:
    description: |
      A detachable boot volume device that contains the image used to boot a Compute instance. For more information, see
      [Overview of Boot Volumes](/iaas/Content/Block/Concepts/bootvolumes.htm).

      To use any of the API operations, you must be authorized in an IAM policy. If you're not authorized,
      talk to an administrator. If you're an administrator who needs to write policies to give users access, see
      [Getting Started with Policies](/iaas/Content/Identity/Concepts/policygetstarted.htm).

      **Warning:** Oracle recommends that you avoid using any confidential information when you
      supply string values using the API.

    x-obmcs-splat:
      resourceKind: volumes
      adLocality: ad-local
      getOperationId: GetBootVolume
      listResourcesOperationId: ListBootVolumes
      ocidEntityType: bootvolume
      activeLifecycleStates: ['AVAILABLE']
      deletedLifecycleStates: ['TERMINATED', 'FAULTY', 'TERMINATING']
      searchMetadata:
        resourceSchemaVersion: 1
        resourceType: BootVolume
        scope: customer
        rvnFromHeader: true
    properties:
      availabilityDomain:
        description: |
          The availability domain of the boot volume.

          Example: `Uocm:PHX-AD-1`
        maxLength: 255
        minLength: 1
        type: string
      compartmentId:
        description: The OCID of the compartment that contains the boot volume.
        maxLength: 255
        minLength: 1
        type: string
      definedTags: *ref-definedTags
      systemTags:
        <<: *ref-definedTags  # extend ref-definedTags, but fix description
        description: |
          System tags for this resource. Each key is predefined and scoped to a namespace.
          Example: `{"foo-namespace": {"bar-key": "value"}}`
      displayName: *ref-displayName
      freeformTags: *ref-freeformTags
      id:
        description: The boot volume's Oracle ID (OCID).
        maxLength: 255
        minLength: 1
        type: string
      imageId:
        description: The image OCID used to create the boot volume.
        maxLength: 255
        minLength: 1
        type: string
      isHydrated:
        description: |
          Specifies whether the boot volume's data has finished copying
          from the source boot volume or boot volume backup.
        type: boolean
      vpusPerGB:
        description: |
          The number of volume performance units (VPUs) that will be applied to this boot volume per GB,
          representing the Block Volume service's elastic performance options.
          See [Block Volume Elastic Performance](/iaas/Content/Block/Concepts/blockvolumeelasticperformance.htm) for more information.

          Allowed values:

            * `10`: Represents Balanced option.

            * `20`: Represents Higher Performance option.
        format: int64
        type: integer
      lifecycleState:
        description: The current state of a boot volume.
        enum:
          - PROVISIONING
          - RESTORING
          - AVAILABLE
          - TERMINATING
          - TERMINATED
          - FAULTY
        type: string
      sizeInGBs:
        description: The size of the boot volume in GBs.
        format: int64
        type: integer
      sizeInMBs:
        description: |
          The size of the volume in MBs. The value must be a multiple of 1024.
          This field is deprecated. Please use sizeInGBs.
        format: int64
        type: integer
      sourceDetails:
        $ref: '#/definitions/BootVolumeSourceDetails'
      timeCreated:
        description: |
          The date and time the boot volume was created. Format defined
          by [RFC3339](https://tools.ietf.org/html/rfc3339).
        format: date-time
        type: string
      volumeGroupId:
        description: The OCID of the source volume group.
        maxLength: 255
        minLength: 1
        type: string
      kmsKeyId:
        description: The OCID of the Key Management master encryption key assigned to the boot volume.
        maxLength: 255
        minLength: 1
        type: string
      isAutoTuneEnabled:
        description: |
          Specifies whether the auto-tune performance is enabled for this boot volume.
        type: boolean
      autoTunedVpusPerGB:
        description: |
          The number of Volume Performance Units per GB that this boot volume is effectively tuned to when it's idle.
        format: int64
        type: integer
      bootVolumeReplicas:
        description: The list of boot volume replicas of this boot volume
        items:
          $ref: '#/definitions/BootVolumeReplicaInfo'
        type: array
    required:
      - id
      - availabilityDomain
      - sizeInMBs
      - compartmentId
      - timeCreated
      - lifecycleState
  BootVolumeKmsKey:
    description: |
      The Key Management master encryption key associated with this volume.
    x-obmcs-splat:
      resourceKind: keys
      adLocality: ad-local
      getOperationId: GetBootVolumeKmsKey
      ocidEntityType: key
    properties:
      kmsKeyId:
        description: |
          The OCID of the Key Management key assigned to this volume. If the volume is not using Key Management, then the `kmsKeyId` will be a null string.
        maxLength: 255
        minLength: 1
        type: string
  BootVolumeBackup:
    description: |
      A point-in-time copy of a boot volume that can then be used to create
      a new boot volume or recover a boot volume. For more information, see [Overview
      of Boot Volume Backups](/iaas/Content/Block/Concepts/bootvolumebackups.htm)
      To use any of the API operations, you must be authorized in an IAM policy.
      If you're not authorized, talk to an administrator. If you're an administrator
      who needs to write policies to give users access, see [Getting Started with
      Policies](/iaas/Content/Identity/Concepts/policygetstarted.htm).

      **Warning:** Oracle recommends that you avoid using any confidential information when you
      supply string values using the API.
    x-obmcs-splat:
      resourceKind: boot-volume-backups
      adLocality: regional
      getOperationId: GetBootVolumeBackup
      listResourcesOperationId: ListBootVolumeBackups
      ocidEntityType: bootvolumebackup
      activeLifecycleStates: ['AVAILABLE']
      deletedLifecycleStates: ['TERMINATED', 'FAULTY']
      searchMetadata:
        resourceSchemaVersion: 1
        resourceType: BootVolumeBackup
        scope: customer
        rvnFromHeader: true
        fieldNameMap: {'bootVolumeId':'volumeId'}
    properties:
      bootVolumeId:
        description: The OCID of the boot volume.
        maxLength: 255
        minLength: 1
        type: string
      compartmentId:
        description: The OCID of the compartment that contains the boot volume backup.
        maxLength: 255
        minLength: 1
        type: string
      definedTags: *ref-definedTags
      systemTags:
        <<: *ref-definedTags  # extend ref-definedTags, but fix description
        description: |
          System tags for this resource. Each key is predefined and scoped to a namespace.
          Example: `{"foo-namespace": {"bar-key": "value"}}`
      displayName: *ref-displayName
      expirationTime:
        description: |
          The date and time the volume backup will expire and be automatically deleted.
          Format defined by [RFC3339](https://tools.ietf.org/html/rfc3339). This parameter will always be present for backups that
          were created automatically by a scheduled-backup policy. For manually created backups,
          it will be absent, signifying that there is no expiration time and the backup will
          last forever until manually deleted.
        format: date-time
        type: string
      freeformTags: *ref-freeformTags
      id:
        description: The OCID of the boot volume backup.
        maxLength: 255
        minLength: 1
        type: string
      imageId:
        description: |
          The image OCID used to create the boot volume the backup is taken from.
        maxLength: 255
        minLength: 1
        type: string
      kmsKeyId:
        description: |
          The OCID of the Key Management master encryption assigned to the boot volume backup.
          For more information about the Key Management service and encryption keys, see
          [Overview of Key Management](/iaas/Content/KeyManagement/Concepts/keyoverview.htm) and
          [Using Keys](/iaas/Content/KeyManagement/Tasks/usingkeys.htm).
        maxLength: 255
        minLength: 1
        type: string
      lifecycleState:
        description: The current state of a boot volume backup.
        enum:
          - CREATING
          - AVAILABLE
          - TERMINATING
          - TERMINATED
          - FAULTY
          - REQUEST_RECEIVED
        type: string
      sizeInGBs:
        description: |
          The size of the boot volume, in GBs.
        format: int64
        maximum: 16384
        minimum: 1
        type: integer
      sourceBootVolumeBackupId:
        type: string
        description: The OCID of the source boot volume backup.
        minLength: 1
        maxLength: 255
      sourceType:
        description: |
          Specifies whether the backup was created manually, or via scheduled backup policy.
        enum:
          - MANUAL
          - SCHEDULED
        type: string
      timeCreated:
        description: |
          The date and time the boot volume backup was created. This is the time the actual point-in-time image
          of the volume data was taken. Format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).
        format: date-time
        type: string
      timeRequestReceived:
        description: |
          The date and time the request to create the boot volume backup was received. Format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).
        format: date-time
        type: string
      type:
        description: The type of a volume backup.
        enum:
          - FULL
          - INCREMENTAL
        type: string
      uniqueSizeInGBs:
        description: |
          The size used by the backup, in GBs. It is typically smaller than sizeInGBs, depending on the space
          consumed on the boot volume and whether the backup is full or incremental.
        format: int64
        maximum: 16384
        minimum: 0
        type: integer
      backupProgress:
        description: |
          The percentage complete of the operation to create the boot volume backup, based on the boot volume backup size.
        maximum: 100
        minimum: 0
        type: integer
    required:
      - id
      - displayName
      - compartmentId
      - timeCreated
      - lifecycleState
