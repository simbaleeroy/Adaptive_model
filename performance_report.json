    @GET
    @Timed(name = "get-crossConnectStatus")
    @Path("/{crossConnectId}/status")
    @VpnSkipAuthorization
    public Response getCrossConnectStatus(@PathParam("crossConnectId") String id) throws Exception {

        CrossConnectDo crossConnectDo = crossConnectBl.getOrThrowForAuth(id);

        CrossConnectStatus status = null;

        if(crossConnectDo.isGlobalPopControllerVirtualCc() && propertiesBl.isJwccGlobalPopEnabled()) {

            GlobalPopCcMetadata globalPopCcMetadata = crossConnectDo.getGlobalPopCcMetadata();

            if (globalPopCcMetadata == null || globalPopCcMetadata.getAgentTargetCcId() == null) {
                PublicValidation.failKeyNotFound(getClass().getSimpleName(), crossConnectDo.getId());
            }

            log.info("Getting CrossConnect status from AgentTargetCc");

            status = globalPopHelper.getCrossConnectStatusFromRegion(globalPopCcMetadata.getAgentTargetCcId(), globalPopCcMetadata.getAgentTargetRegion());

            if (status == null) {
                status = CrossConnectStatus.builder()
                        .crossConnectId(crossConnectDo.getId())
                        .lightLevelIndBm(0.0f)
                        .lightLevelIndicator(CrossConnectStatus.LightLevelIndicator.Bad)
                        .interfaceState(CrossConnectStatus.InterfaceState.Down)
                        .encryptionStatus(CrossConnectStatus.EncryptionStatus.Down)
                        .build();
            }

            status = CrossConnectStatus.builder()
                    .copy(status)
                    .crossConnectId(crossConnectDo.getId())
                    .build();

            return Response.ok(crossConnectStatusToModel(status)).build();

        } else {
            status = CrossConnectResource.handleGetCrossConnectStatus(crossConnectDo, statusProvider);
            return Response.ok(crossConnectStatusToModel(status)).build();
        }
    }

    @DELETE
    @Path("/{crossConnectId}")
    @Timed(name = "delete-crossConnect")
    public Response deleteCrossConnect(
            @PathParam("crossConnectId") String id,
            @HeaderParam("oci-splat-resource-permissions") String ociSplatPermissionsHeader) throws Exception {

        try (MetricsScope scope = MetricsScope.parent(MetricConstants.CrossConnect.API_DELETE_CROSSCONNECT, true, false);
            Transaction t = crossConnectBl.beginTransaction("delete-crossConnect")) {
            Map<String, Set<String>> permissionMap = ResourceUtils.extractOciSplatPermissionsFromHeader(ociSplatPermissionsHeader);
            CrossConnectDo crossConnectDo = crossConnectBl.getOrThrowForAuth(t, id);
            if (crossConnectDo.isMacsecEnabled() &&
                !ResourceUtils.hasRestrictedDelete(permissionMap, VpnAuthConstants.ResourceTypes.GLANCE_RESOURCE)) {
                throw new ValidationException(ErrorCode.NotAuthorizedOrNotFound, String.format(
                    "CrossConnect %s with macsec enabled does not have sufficient permission to delete.", crossConnectDo.getId()
                ));
            }

            validateDeleteRequest(crossConnectBl, crossConnectGroupBl, virtualCircuitBl, t, crossConnectDo);

            // Launch a workflow if CrossConnect is already provisioned as part of the CrossConnectGroup.
            boolean launchWorkflow =
                    (CrossConnectResource.isPartOfCrossConnectGroup(crossConnectDo) &&
                            crossConnectDo.getState() != CrossConnectDo.State.PENDING_CUSTOMER);

            DeviceDo deviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
            Boolean isFakeDevice = deviceDo.isFakeDevice();
            Boolean isCustomer = limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectDo.getCompartmentId());
            perfMetric.setupScopeDimensions(scope, null, isFakeDevice, isCustomer);

            String tenantName = identityHelper.getTenantName(crossConnectDo.getCompartmentId());
            String tenantId = identityHelper.getTenantId(crossConnectDo.getCompartmentId());

            CrossConnectResource.processDeleteCrossConnectRequest(
                    crossConnectBl,
                    crossConnectGroupBl,
                    propertiesBl,
                    eventBl,
                    workRequestBl,
                    deviceBl,
                    t,
                    crossConnectDo,
                    launchWorkflow,
                    vpnMetering,
                    limitsHelper,
                    isFakeDevice,
                    isCustomer,
                    tenantId,
                    tenancyMetadataBl);

            loaBl.safeLoaDelete(t, crossConnectDo, tenantId, tenantName);
            if (!launchWorkflow) {
                eventBl.tryBatchDeleteEventsForReferenceId(crossConnectDo.getId());
            }
            t.commit();
            scope.emit(MetricConstants.SUCCESS, 1);
        }

        return Response.accepted().build();
    }

    @PUT
    @Path("/{crossConnectId}")
    @Timed(name = "update-crossConnect")
    @VpnSkipAuthorization
    public Response updateCrossConnects(
            @PathParam("crossConnectId") String id,
            @Valid @NonNull UpdateCrossConnectInternalDetails request,
            @HeaderParam("interfaceDescription") String interfaceDescription,
            @QueryParam("forceUpdate") Boolean forceUpdate) throws Exception {

        TagUtils.validateTags(request.getFreeformTags(), request.getDefinedTags());

        try (MetricsScope scope = MetricsScope.parent(MetricConstants.CrossConnect.API_UPDATE_CROSSCONNECT, true, false);
             Transaction t = crossConnectBl.beginTransaction("update-CrossConnect")) {

            CrossConnectDo crossConnectDo = crossConnectBl.getOrThrowForAuth(t, id);
            if(interfaceDescription != null) {
                PublicValidation.validateNonAsciiChar(interfaceDescription, "Interface description");
            }
            boolean isActivatingCrossConnect = isActivatingCrossConnect(request, crossConnectDo);

            boolean shouldlaunchWorkflow = false;

            MacsecProperties macsecProperties = request.getMacsecProperties();
            MacsecPropertiesInternal macsecPropertiesInternal = null;

            if(macsecProperties != null && macsecProperties.getState().equals(MacsecProperties.State.Enabled)){

                if(crossConnectDo.getCrossConnectGroupId() != null) {
                    PublicValidation.failInvalidCrossConnectUpdateRequest();
                }

                if(macsecProperties.getEncryptionCipher() == null) {
                    PublicValidation.failNullEncryptionCipher();
                }
                if(crossConnectDo.getMacsecKey() != null && crossConnectDo.getMacsecKey().getServiceSecretOcid() != null){
                    shouldlaunchWorkflow = true;
                }
                macsecPropertiesInternal = MacsecPropertiesInternal.builder()
                        .bypassLldp(macsecProperties.getBypassLldp() != null? macsecProperties.getBypassLldp() : false)
                        .mkaServerPriority(macsecProperties.getMkaServerPriority() != null? macsecProperties.getMkaServerPriority() : 0)
                        .replayProtectionWindow(macsecProperties.getReplayProtectionWindow() != null ? macsecProperties.getReplayProtectionWindow() : 0L)
                        .rekeyPeriod(macsecProperties.getRekeyPeriod() != null ? macsecProperties.getRekeyPeriod() : 3600)
                        .allowUnprotectedTraffic(Optional.ofNullable(macsecProperties).map(MacsecProperties::getAllowUnprotectedTraffic).orElse(false))
                        .build();
            }

            // TOOD verify description is in key value pair form.
            if (crossConnectDo.getState().equals(CrossConnectDo.State.PROVISIONED)) {
                shouldlaunchWorkflow |= ((interfaceDescription != null) && (!StringUtils.equals(interfaceDescription, crossConnectDo.getInterfaceDescr())));
                shouldlaunchWorkflow |= ((request.getInterfaceDescr() != null) && (!StringUtils.equals(request.getInterfaceDescr(), crossConnectDo.getInterfaceDescr())) && (interfaceDescription == null));
            }

            String finalInterfaceDescription = Optional.ofNullable(interfaceDescription)
                    .orElse(request.getInterfaceDescr());

            crossConnectDo = crossConnectDo.toBuilder()
                    .displayName(Optional.ofNullable(request.getDisplayName())
                            .orElseGet(crossConnectDo::getDisplayName))
                    .customerReferenceId(Optional.ofNullable(request.getCustomerReferenceName())
                            .orElseGet(crossConnectDo::getCustomerReferenceId))
                    .tags(TagUtils.encodeUpdatedTags(
                            request.getFreeformTags(),
                            request.getDefinedTags(),
                            crossConnectDo.getTags()))
                    .interfaceDescr(Optional.ofNullable(finalInterfaceDescription)
                            .orElseGet(crossConnectDo::getInterfaceDescr))
                    .macsecPropertiesInternal(macsecPropertiesInternal)
                    .build();

            DeviceDo deviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
            Boolean isFakeDevice = deviceDo.isFakeDevice();
            Boolean isCustomer = limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectDo.getCompartmentId());
            perfMetric.setupScopeDimensions(scope, null, isFakeDevice, isCustomer);

            Boolean newEnableHoldTimer = request.getEnableInterfaceHoldTimer();
            Boolean currentEnableHoldTimer = crossConnectDo.getEnableInterfaceHoldTimer();
            Integer newTimerValue = request.getInterfaceDownTimerValue();
            Integer currentTimerValue = crossConnectDo.getInterfaceDownTimeValue();

            validateInterfaceHoldTimerRequest(newEnableHoldTimer, newTimerValue);
            if (newEnableHoldTimer != null && currentEnableHoldTimer != null) {
                if (newEnableHoldTimer && currentEnableHoldTimer && !newTimerValue.equals(currentTimerValue)){

                    log.info("Re-configuring the interface hold timer while updating the crossconnect {}.", crossConnectDo.getId());
                    shouldlaunchWorkflow = true;
                    crossConnectDo = crossConnectDo.toBuilder()
                            .enableInterfaceHoldTimer(newEnableHoldTimer)
                            .interfaceDownTimeValue(newTimerValue)
                            .build();

                } else if (newEnableHoldTimer && !currentEnableHoldTimer) {

                    log.info("Activating the interface hold timer while updating the crossconnect {}.", crossConnectDo.getId());
                    shouldlaunchWorkflow = true;
                    crossConnectDo = crossConnectDo.toBuilder()
                            .enableInterfaceHoldTimer(newEnableHoldTimer)
                            .interfaceDownTimeValue(newTimerValue)
                            .build();
                } else if (!newEnableHoldTimer && currentEnableHoldTimer) {
                    log.info("De-activating the interface hold timer while updating the crossconnect {}.", crossConnectDo.getId());
                    shouldlaunchWorkflow = true;
                    crossConnectDo = crossConnectDo.toBuilder()
                            .enableInterfaceHoldTimer(newEnableHoldTimer)
                            .interfaceDownTimeValue(null)
                            .build();
                }
            } else if (newEnableHoldTimer != null && newEnableHoldTimer){
                log.info("Activating the interface hold timer while updating the crossconnect {}.", crossConnectDo.getId());
                shouldlaunchWorkflow = true;
                crossConnectDo = crossConnectDo.toBuilder()
                        .enableInterfaceHoldTimer(newEnableHoldTimer)
                        .interfaceDownTimeValue(newTimerValue)
                        .build();
            }

            if (Boolean.TRUE.equals(forceUpdate) || isActivatingCrossConnect || shouldlaunchWorkflow) {

                crossConnectDo = CrossConnectResource.processUpdateCrossConnectRequest(
                        crossConnectBl,
                        crossConnectGroupBl,
                        eventBl,
                        workRequestBl,
                        deviceBl,
                        t,
                        crossConnectDo,
                        vpnMetering,
                        false,
                        isFakeDevice,
                        isCustomer);
            }

            crossConnectDo = crossConnectBl.update(t, crossConnectDo);

            t.commit();
            scope.emit(MetricConstants.SUCCESS, 1);

            return Response.ok(toModel(patchPanelPortPairBl, locationBl, crossConnectDo, encryptionManager, crossConnectGroupBl, deviceBl)).build();
        }
    }

    @PUT
    @Path("/{crossConnectId}/migratePorts")
    @Timed(name = "migratePortsForCrossConnect")
    @VpnSkipAuthorization
    public Response migratePortsForCrossConnect(
            @NonNull @PathParam("crossConnectId") String crossConnectId,
            @Valid @NonNull MigratePortsForCrossConnectRequest migratePortsForCrossConnectRequest)
            throws ValidationException, CommitConflictException, AuthServerUnavailableException {

        if (migratePortsForCrossConnectRequest.getRequestType().equals(MigratePortsForCrossConnectRequest.RequestType.Reprovisioning)) {

            log.info("Starting to Migrate Ports Reprovisioning for CC {}", crossConnectId);
            try (MetricsScope scope = MetricsScope.parent(MetricConstants.CrossConnect.API_MIGRATEPORTS_REPROVISIONING, true, false);
                 Transaction t = crossConnectBl.beginTransaction("migratePortsForCrossConnectReprovisioning")) {
                CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectId);

                DeviceDo deviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
                Boolean isFakeDevice = deviceDo.isFakeDevice();
                perfMetric.setupScopeDimensions(scope, null, isFakeDevice, null);


                if (!crossConnectDo.getState().equals(CrossConnectDo.State.MIGRATING)
                        && !crossConnectDo.getState().equals(CrossConnectDo.State.PROVISIONING)) {
                    throw new ValidationException(
                            ErrorCode.IncorrectState,
                            String.format("CrossConnectDo %s is not in Migrating or PROVISIONING state and cannot launch Port migration.",
                                    crossConnectDo));
                }

                log.info("Launching workflow to Migrate Ports for {}", crossConnectId);
                WorkRequestDo workRequestDo = PortMigrationUtils.buildMigratePortsReprovisioningWorkRequest(crossConnectDo, isFakeDevice,
                        limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectDo.getCompartmentId()));
                workRequestDo = workRequestBl.create(t, workRequestDo);

                // Update KievTxTimestamp() to prevent Workflow step in-tempered exception
                PortMigrationBackupDo portMigrationBackupDo = portMigrationBackupBl.getOrThrow(crossConnectId);
                portMigrationBackupBl.update(t, portMigrationBackupDo.toBuilder().lastKievTxTimestamp(workRequestDo.getKievTxTimestamp()).build());

                String message = String.format("Created WorkRequestDo for workflow to provision the connection. (workRequestDo=%s)", workRequestDo);
                log.info(message);
                eventBl.create(t, crossConnectId, Component.API, message);

                t.commit();
                scope.emit(MetricConstants.SUCCESS, 1);
            }
        } else {

            log.info("Starting to Migrate Ports Deprovisioning for CC {}", crossConnectId);
            CrossConnectDo crossConnectDo;
            InterfaceDo interfaceDo = null;
            Set<String> virtualCircuitIds = Collections.emptySet();
            try (MetricsScope scope = MetricsScope.parent(MetricConstants.CrossConnect.API_MIGRATEPORTS_DEPROVISIONING, true, false);
                 Transaction t = crossConnectBl.beginTransaction("migratePortsForCrossConnectDeprovisioning")) {

                log.info("Validating MigratePortsForCrossConnect Request {} for CrossConnect {}",
                        migratePortsForCrossConnectRequest, crossConnectId);

                crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectId);
                PortMigrationUtils.validateCrossConnectState(crossConnectDo);
                PortMigrationUtils.validateCrossConnectNotInGroup(crossConnectDo);

                if (crossConnectDo.getVcsToVlans() != null && crossConnectDo.getVcsToVlans().size() > 0) {
                    virtualCircuitIds = crossConnectDo.getVcsToVlans().keySet();
                    for (String virtualCircuitId : virtualCircuitIds) {
                        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
                        PortMigrationUtils.validateVirtualCircuitState(virtualCircuitDo);
                    }
                }

                Optional<InterfaceDo> interfaceDoOpt = interfaceBl.getInterfaceByName(
                        t, migratePortsForCrossConnectRequest.getInterfaceName(), migratePortsForCrossConnectRequest.getDeviceId());
                PortMigrationUtils.isInterfacePresent(interfaceDoOpt);

                interfaceDo = interfaceDoOpt.get();
                PortMigrationUtils.validateInterfaceState(interfaceDo);

                String oldDeviceId = crossConnectDo.getDeviceId();
                DeviceDo oldDeviceDo = deviceBl.getOrThrow(t, oldDeviceId);
                DeviceDo newDeviceDo = deviceBl.getOrThrow(t, migratePortsForCrossConnectRequest.getDeviceId());
                PortMigrationUtils.validateDevicesState(oldDeviceDo, newDeviceDo);
                Boolean isFakeDevice = newDeviceDo.isFakeDevice();
                perfMetric.setupScopeDimensions(scope, null, isFakeDevice, null);


                log.info("Completed validating resource states and begin to migrate ports for {}", crossConnectId);

                log.info("Updating PPPP, LOA and interface state for CrossConnect {}", crossConnectId);
                Optional<PatchPanelPortPairDo> oldPatchPanelPortPairDo = patchPanelPortPairBl.getPortPairByInterface(t, crossConnectDo.getInterfaceId());
                patchPanelPortPairBl.update(t, oldPatchPanelPortPairDo.get().toBuilder().status(PatchPanelPortPairDo.PortStatus.Reserved).build());
                InterfaceDo oldInterfaceDo = interfaceBl.getOrThrow(crossConnectDo.getInterfaceId());
                interfaceBl.update(t, oldInterfaceDo.toBuilder().state(InterfaceDo.State.Reserved).build());

                Optional<PatchPanelPortPairDo> newPatchPanelPortPairDo = patchPanelPortPairBl.getPortPairByInterface(t, interfaceDo.getId());
                patchPanelPortPairBl.update(t, newPatchPanelPortPairDo.get().toBuilder().status(PatchPanelPortPairDo.PortStatus.Assigned).build());
                interfaceBl.update(t, interfaceDo.toBuilder().state(InterfaceDo.State.Assigned).build());

                Optional<LoaDo> loaDoOptional = loaBl.getLoa(crossConnectDo);
                if (loaDoOptional.isPresent()) {
                    loaBl.update(t, loaDoOptional.get().toBuilder().patchPanelPortPairId(newPatchPanelPortPairDo.get().getId()).build());
                }

                if (crossConnectDo.getState().equals(CrossConnectDo.State.PENDING_CUSTOMER)) {
                    log.info("CrossConnect {} is in Pending_Customer state, hence updating interface name and device id without launching workflow", crossConnectId);
                    crossConnectDo = crossConnectDo.toBuilder()
                            .deviceId(migratePortsForCrossConnectRequest.getDeviceId())
                            .interfaceId(interfaceDo.getId()).build();
                    crossConnectBl.update(t, crossConnectDo);

                } else {
                    log.info("Updating resource state to Migrating for {}", crossConnectId);
                    crossConnectDo = crossConnectDo.toBuilder().state(CrossConnectDo.State.MIGRATING).build();
                    crossConnectDo = crossConnectBl.update(t, crossConnectDo);

                    for (String virtualCircuitId : virtualCircuitIds) {
                        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
                        virtualCircuitBl.update(t, virtualCircuitDo.toBuilder().state(VirtualCircuitDo.State.MIGRATING).build());
                    }

                    log.info("Cleaning up previous Backup for {} if any", crossConnectId);
                    PortMigrationUtils.cleanupPortMigrationBackup(portMigrationBackupBl, crossConnectId, t);

                    log.info("Creating Migration Backup for {}", crossConnectId);
                    PortMigrationUtils.createMigrationBackup(crossConnectDo,
                            portMigrationBackupBl, configSnippetBl, virtualCircuitBl, bgpBl, virtualCircuitIds, t);

                    log.info("Updating CrossConnect {} with new device and interface", crossConnectId);
                    crossConnectDo = crossConnectBl.update(t, crossConnectDo.toBuilder()
                            .deviceId(migratePortsForCrossConnectRequest.getDeviceId())
                            .interfaceId(interfaceDo.getId())
                            .build());

                    log.info("Launching workflow to Migrate Ports for {}", crossConnectId);
                    WorkRequestDo workRequestDo = PortMigrationUtils.buildMigratePortsDeprovisioningWorkRequest(crossConnectDo, oldDeviceId, isFakeDevice,
                            limitsHelper.checkCustomerTenancyByCompartmentId(crossConnectDo.getCompartmentId()));
                    workRequestDo = workRequestBl.create(t, workRequestDo);

                    String message = String.format("Created WorkRequestDo for workflow to provision the connection. (workRequestDo=%s)", workRequestDo);
                    log.info(message);
                    eventBl.create(t, crossConnectId, Component.API, message);
                }

                t.commit();
                scope.emit(MetricConstants.SUCCESS, 1);
            }
        }

        return Response.ok(toModel(patchPanelPortPairBl, locationBl, crossConnectBl.getOrThrowForAuth(crossConnectId), encryptionManager, crossConnectGroupBl, deviceBl)).build();
    }

    @PUT
    @Timed(name = "convert-crossConnect")
    @Path("/{crossConnectId}/actions/convert")
    @Produces({"application/json", "application/x-json-stream"})
    @VpnSkipAuthorization
    public Response ccConvert(
            @PathParam("crossConnectId") String ccId,
            @Valid @NonNull ConvertCrossConnectDetails request
    ) throws ValidationException, CommitConflictException, IllegalArgumentException {

        // Check if OCIDs provided are valid
        if (!ResourceUtils.isCrossConnect(ccId)) {
            String err = "CC-OCID provided is not a valid CrossConnect OCID";
            log.error("{} CC-OCID: {}", err, ccId);
            throw new ValidationException(ErrorCode.InvalidParameter, err, ccId);
        }
        if (request.getCcgId() != null && !ResourceUtils.isCrossConnectGroup(request.getCcgId())) {
            String err = "CCG-OCID provided is not a valid CrossConnectGroup OCID";
            log.error("{} CCG-OCID: {}", err, request.getCcgId());
            throw new ValidationException(ErrorCode.InvalidParameter, err, request.getCcgId());
        }

        CrossConnectDo crossConnectDo = crossConnectBl.getOrThrowForAuth(ccId);
        CrossConnectGroupDo crossConnectGroupDo;

        switch (request.getType()) {
            case ConvertToCcGroup:
                // Check that CC is already a part of a CCG
                if (crossConnectDo.getCrossConnectGroupId() != null) {
                    String err = "CCtoCCG: CC provided is already part of a CCG";
                    log.error("{} CC-OCID: {} Part of CCG: {}", err, ccId, crossConnectDo.getCrossConnectGroupId());
                    throw new ValidationException(ErrorCode.InvalidParameter, err, ccId);
                }
                // Ensure ccgId is provided in request
                if (request.getCcgId() == null) {
                    String err = "CCG-OCID not provided while trying to convert to CCG";
                    log.error(err);
                    throw new ValidationException(ErrorCode.InvalidParameter, err);
                }
                crossConnectGroupDo = crossConnectGroupBl.getOrThrowForAuth(request.getCcgId());
                crossConnectDo = ccToCcg(crossConnectDo, crossConnectGroupDo);
                break;
            case ConvertToCcNoGroup:
                // Check that CC is not a part of a CCG
                if (crossConnectDo.getCrossConnectGroupId() == null) {
                    String err = "CCGtoCC: CC provided is not a part of a CCG";
                    log.error("{} CC-OCID: {}", err, ccId);
                    throw new ValidationException(ErrorCode.InvalidParameter, err, ccId);
                }
                crossConnectGroupDo = crossConnectGroupBl.getOrThrowForAuth(crossConnectDo.getCrossConnectGroupId());
                crossConnectDo = ccToNoCcg(crossConnectDo, crossConnectGroupDo);
                break;
            default:
                throw new ValidationException(ErrorCode.InvalidParameter, "Unsupported conversion type:",
                        request.getType().getValue());
        }
        return Response.ok(crossConnectDo.toModel(patchPanelPortPairBl, locationBl, encryptionManager, crossConnectGroupBl, deviceBl))
                .header(Headers.ETAG, OptimisticConcurrencyUtils.getETag(crossConnectDo))
                .build();
    }

    private CrossConnectDo ccToCcg(CrossConnectDo crossConnectDo, CrossConnectGroupDo crossConnectGroupDo)
            throws ValidationException, CommitConflictException {
        if (crossConnectDo.getState() == CrossConnectDo.State.PENDING_CUSTOMER) {
            if (crossConnectGroupDo.getState() == CrossConnectGroupDo.State.INACTIVE
                    || crossConnectGroupDo.getState() == CrossConnectGroupDo.State.PROVISIONED) {
                // Check if CC and CCG have the same device ID
                String ccgDeviceId = crossConnectBl.getDeviceId(crossConnectGroupDo);
                if (Objects.equals(crossConnectDo.getDeviceId(), ccgDeviceId) || ccgDeviceId == null ) {
                    // Update CC with CCG-ID
                    try (Transaction t = crossConnectBl.beginTransaction("update-CrossConnect")) {
                        crossConnectDo = crossConnectDo.toBuilder()
                                .crossConnectGroupId(crossConnectGroupDo.getId())
                                .build();

                        crossConnectDo = crossConnectBl.update(t, crossConnectDo);

                        eventBl.create(t, crossConnectDo.getId(), Component.API,
                                "Updated CrossConnect %s ", crossConnectDo);
                        log.info("Updated CrossConnect(do={})", crossConnectDo);
                        t.commit();
                    }

                    // Update CCG with CC-ID
                    String[] updatedCcIds = ArrayUtils.add(crossConnectGroupDo.getCrossConnectIds(), crossConnectDo.getId());
                    try (Transaction t = crossConnectGroupBl.beginTransaction("update-CrossConnectGroup")) {
                        crossConnectGroupDo = crossConnectGroupDo.toBuilder()
                                .crossConnectIds(updatedCcIds)
                                .build();

                        crossConnectGroupDo = crossConnectGroupBl.update(t, crossConnectGroupDo);

                        eventBl.create(t, crossConnectGroupDo.getId(), Component.API,
                                "Updated CrossConnectGroup %s ", crossConnectGroupDo);
                        log.info("Updated crossConnectGroupDo(do={})", crossConnectGroupDo);
                        t.commit();
                    }
                } else {
                    String err = "CCtoCCG: CC and CCG must have the same device ID";
                    log.error("{} CC OCID: {} CC deviceId: {} CCG deviceId: {}",
                            err, crossConnectDo.getId(), crossConnectDo.getDeviceId(), ccgDeviceId);
                    throw new ValidationException(ErrorCode.InvalidParameter, err, crossConnectDo.getId());
                }
            } else {
                String err = "CCtoCCG: CCG must be in PROVISIONED/INACTIVE state";
                log.error("{} CCG OCID: {} CCG state: {}",
                        err, crossConnectGroupDo.getId(), crossConnectGroupDo.getState());
                throw new ValidationException(ErrorCode.InvalidParameter, err, crossConnectDo.getId());
            }
        } else {
            String err = "CCtoCCG: CC must be in PENDING_CUSTOMER state";
            log.error("{} CC OCID: {} CC state: {}",
                    err, crossConnectDo.getId(), crossConnectDo.getState());
            throw new ValidationException(ErrorCode.InvalidParameter, err, crossConnectDo.getId());
        }
        return crossConnectDo;
    }

    private CrossConnectDo ccToNoCcg(CrossConnectDo crossConnectDo, CrossConnectGroupDo crossConnectGroupDo)
            throws ValidationException, CommitConflictException {
        if (crossConnectDo.getState() == CrossConnectDo.State.PENDING_CUSTOMER) {
            if (crossConnectGroupDo.getState() == CrossConnectGroupDo.State.INACTIVE
                    || crossConnectGroupDo.getState() == CrossConnectGroupDo.State.PROVISIONED) {
                // Remove CCG-ID from CC
                try (Transaction t = crossConnectBl.beginTransaction("update-CrossConnect")) {
                    crossConnectDo = crossConnectDo.toBuilder()
                            .crossConnectGroupId(null)
                            .build();

                    crossConnectDo = crossConnectBl.update(t, crossConnectDo);

                    eventBl.create(t, crossConnectDo.getId(), Component.API,
                            "Updated CrossConnect %s ", crossConnectDo);
                    log.info("Updated CrossConnect(do={})", crossConnectDo);
                    t.commit();
                }

                // Remove CC-ID from CCG
                String[] updatedCcIds = ArrayUtils.removeElement(crossConnectGroupDo.getCrossConnectIds(), crossConnectDo.getId());
                try (Transaction t = crossConnectGroupBl.beginTransaction("update-CrossConnectGroup")) {
                    crossConnectGroupDo = crossConnectGroupDo.toBuilder()
                            .crossConnectIds(updatedCcIds)
                            .build();

                    crossConnectGroupDo = crossConnectGroupBl.update(t, crossConnectGroupDo);

                    eventBl.create(t, crossConnectGroupDo.getId(), Component.API,
                            "Updated CrossConnectGroup %s ", crossConnectGroupDo);
                    log.info("Updated crossConnectGroupDo(do={})", crossConnectGroupDo);
                    t.commit();
                }
            } else {
                String err = "CCtoNoCCG: CCG must be in PROVISIONED/INACTIVE state";
                log.error("{} CC OCID: {}CC state: {} CCG state: {}",
                        err, crossConnectDo.getId(), crossConnectDo.getState(), crossConnectGroupDo.getState());
                throw new ValidationException(ErrorCode.InvalidParameter, err, crossConnectDo.getId());
            }
        } else {
            String err = "CCtoNoCCG: CC must be in PENDING_CUSTOMER state";
            log.error("{} CC OCID: {} CC state: {} CCG state: {}",
                    err, crossConnectDo.getId(), crossConnectDo.getState(), crossConnectGroupDo.getState());
            throw new ValidationException(ErrorCode.InvalidParameter, err, crossConnectDo.getId());
        }
        return crossConnectDo;
    }

    private CreateCrossConnectDetails convert(CreateCrossConnectInternalDetails request) {
        return CreateCrossConnectDetails.builder()
                .compartmentId(request.getCompartmentId())
                .crossConnectGroupId(request.getCrossConnectGroupId())
                .definedTags(request.getDefinedTags())
                .freeformTags(request.getFreeformTags())
                .displayName(request.getDisplayName())
                .locationName(request.getLocationName())
                .nearCrossConnectOrCrossConnectGroupId(request.getNearCrossConnectOrCrossConnectGroupId())
                .farCrossConnectOrCrossConnectGroupId(request.getFarCrossConnectOrCrossConnectGroupId())
                .portSpeedShapeName(request.getPortSpeedShapeName())
                .customerReferenceName(request.getCustomerReferenceId())
                .build();
    }
    private FFabQfxCanaryConfig createCanaryConfig(Qfx5120CanaryConfigDetails config) {

        return FFabQfxCanaryConfig.builder()
                .cvlanNumber(config.getCvlanNumber())
                .fcCpeIPv4WithMask(config.getFcCpeIPv4WithMask())
                .fcCpeIPv6WithMask(config.getFcCpeIPv6WithMask())
                .remoteBgpIPv4(config.getRemoteBgpIPv4())
                .remoteBgpIPv6(config.getRemoteBgpIPv6())
                .lo0UnitNumber(config.getLo0UnitNumber())
                .fcCanaryLoopbackIPv4(config.getFcCanaryLoopbackIPv4())
                .fcCanaryLoopbackIPv6(config.getFcCanaryLoopbackIPv6())
                .fcCpeLoopbackIpv4SubnetWithMask(config.getFcCpeLoopbackIpv4SubnetWithMask())
                .fcCpeIpv6SubnetWithMask(config.getFcCpeIpv6SubnetWithMask())
                .fcCanaryBgpAsn(config.getFcCanaryBgpAsn())
                .remoteBgpAsn(config.getRemoteBgpAsn())
                .fcRoutingInstanceId(config.getFcRoutingInstanceId())
                .build();
    }

    private static boolean isActivatingCrossConnect(
            UpdateCrossConnectInternalDetails updateRequest,
            CrossConnectDo crossConnectDo) {

        return Boolean.TRUE.equals(updateRequest.getIsActive()) &&
                crossConnectDo.getState() == CrossConnectDo.State.PENDING_CUSTOMER;

    }

    public static void validateDeleteRequest(
            CrossConnectBl crossConnectBl,
            CrossConnectGroupBl crossConnectGroupBl,
            VirtualCircuitBl virtualCircuitBl,
            Transaction t,
            CrossConnectDo crossConnectDo) throws ValidationException {

        if (CrossConnectResource.isPartOfCrossConnectGroup(crossConnectDo)) {

            CrossConnectGroupDo ccg = crossConnectGroupBl.getOrThrow(t, crossConnectDo.getCrossConnectGroupId());

            // Make sure that we don't terminate the CrossConnect if there are VCs associated with the
            // CrossConnectGroup and this is the only provisioned CrossConnect in the group.
            if (ccg.getState() == CrossConnectGroupDo.State.PROVISIONED &&
                    crossConnectDo.getState() == CrossConnectDo.State.PROVISIONED &&
                    crossConnectBl.getProvisionedCrossConnects(ccg).size() == 1) {

                crossConnectGroupBl.validateNoVirtualCircuitExists(t, ccg);
            }

            virtualCircuitBl.validateNoVcInProvisioningOrTerminatingState(ccg.getId());

        } else {
            crossConnectBl.validateNoVirtualCircuitExists(t, crossConnectDo);
        }
    }


