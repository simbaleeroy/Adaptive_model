            * [GetTunnelCpeDeviceConfig](#/en/iaas/latest/TunnelCpeDeviceConfig/GetTunnelCpeDeviceConfig)
        maxLength: 255
        minLength: 1
        type: string
  UpdateCrossConnectDetails:
    description: |
      Update a CrossConnect
    properties:
