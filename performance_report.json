    @POST
    @Timed(name = "uploadPatchPanelPortPairsFile")
    @Path("/patchPanelPortPair/uploadPatchPanelPortPairsFile")
    @VpnSkipAuthorization
    public UploadPatchPanelPortPairsFileResult uploadPatchPanelPortPairsFile(
            @HeaderParam(Headers.RETRY_TOKEN) String opcRetryToken, @HeaderParam(Headers.REQUEST_ID) String opcRequestId,
            UploadPatchPanelPortPairsFileDetail uploadPatchPanelPortPairsFileDetail) throws Exception {
        log.info("Upload Patch Panel Port File Detail request received with opc-request-id : {}, opc-retry-token: {} and request : {}"
                ,opcRequestId, opcRetryToken,mapper.writeValueAsString(uploadPatchPanelPortPairsFileDetail));

        try(MetricsScope scope = MetricsScope.parent(API_UPLOAD_PPPP_FILE, true, false)){
            PatchPanelPortPairFileRequestMetaData patchPanelPortPairFileRequestMetaData =
                    uploadPatchPanelPortPairsFileDetail.getPatchPanelPortPairFileRequestMetaData();

            List<PatchPanelPortPairFileSheetResult> results =  patchPanelPortPairTemplateValidator
                    .applyValidation(uploadPatchPanelPortPairsFileDetail.getPatchPanelPortPairFileSheetResults());

            if(!patchPanelPortPairTemplateValidator.validateValidationResults(results)){
                return UploadPatchPanelPortPairsFileResult.builder()
                        .patchPanelPortPairFileSheetResults(results)
                        .build();
            }

            objectStorageClientHelper.getOrCreateBucket(PPPP_FILE_UPLOAD_BUCKET,
                    identityConfiguration.getServiceTenantOcid(), CreateBucketDetails.Versioning.Enabled);
            String jsonContent = mapper.writerWithDefaultPrettyPrinter().writeValueAsString(uploadPatchPanelPortPairsFileDetail);
            String objectName = getPatchPanelPortPairFilePath(patchPanelPortPairFileRequestMetaData.getFileName());
            objectStorageClientHelper.upload(jsonContent, PPPP_FILE_UPLOAD_BUCKET, objectName, FILE_CONTENT_TYPE,
                    new HashMap<>(), true);
            Transaction t = patchPanelPortPairFileMetaDataBl.beginTransaction("upload-pppp-file-metadata");
            PatchPanelPortPairFileMetaDataDo patchPanelPortPairFileMetaDataDo =
                    patchPanelPortPairFileMetaDataBl.create(t,
                            preparePatchPanelPortPairFileMetaData(objectName,patchPanelPortPairFileRequestMetaData.getJiraTicket(),
                                    1));
            t.commit();
            scope.emit(MetricConstants.SUCCESS, 1);
            return UploadPatchPanelPortPairsFileResult.builder()
                    .patchPanelPortPairFileSheetResults(uploadPatchPanelPortPairsFileDetail.getPatchPanelPortPairFileSheetResults())
                    .patchPanelPortPairFileMetaData(toPatchPanelPortPairFileMetaData(patchPanelPortPairFileMetaDataDo))
                    .build();
        }

    }
    public String getPatchPanelPortPairFilePath(String fileName) {
