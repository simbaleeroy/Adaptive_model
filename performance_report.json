    public VirtualCircuitDo generateVirtualCircuitDo(VirtualCircuitDo.IpAddressType type, RoutingPolicy policy, CrossConnectMappings.Mapping mapping) throws Exception {

        if(mapping == null) {
            mapping = CrossConnectMappings.Mapping.builder()
                    .crossConnectId(getPhxCrossConnectGroupDo().getId())
                    .vlan(VirtualCircuitBlTest.VLAN)
                    .remoteBgpPeeringIp(REMOTE_BGP_PEERING_IP)
                    .oracleBgpPeeringIp(ORACLE_BGP_PEERING_IP)
                    .build();

        }

        VirtualCircuitDo virtualCircuitDo = VirtualCircuitBlTest.generateVirtualCircuitDo(
                virtualCircuitBl, drgBl, mapping, type, null, null);

        if(policy != null) {
            try (Transaction t = virtualCircuitBl.beginTransaction("test")) {
                virtualCircuitDo = virtualCircuitBl.update(t, virtualCircuitDo.toBuilder()
                        .routingPolicies(Collections.singleton(policy))
                        .build());
                t.commit();
            }
        }

        return virtualCircuitDo;
    }

    private CrossConnectGroupDo getPhxCrossConnectGroupDo() throws Exception {
        final String PHX_LOCATION = "phx-location";

        DeviceDo phxDeviceDo;
        try (Transaction t = mappedDataStore.beginTransaction("setup-tests")) {
            // Create location. Ex PHX
            LocationDo locationDo = LocationDo.builder()
                    .id(PHX_LOCATION)
                    .name(PHX_LOCATION)
                    .address(PHX_LOCATION)
                    .facility(PHX_LOCATION)
                    .description(PHX_LOCATION)
                    .build();

            locationBl.create(t, locationDo);

            // Create device in PHX.
            phxDeviceDo = DeviceDo.builder()
                    .id("PHX-MX-DEVICE")
                    .managementIpAddress("1.2.3.4")
                    .name("PHX-MX-DEVICE")
                    .ad("phx1a")
                    .anycastIp("4.3.2.1")
                    .auth(new Authentication("user", "password"))
                    .deviceType(DeviceDo.DeviceType.Juniper)
                    .state(DeviceDo.State.ACTIVE)
                    .roles(FJava.toSet(DeviceDo.Role.Vpn, DeviceDo.Role.FastConnectMx, DeviceDo.Role.FastConnectMx10k))
                    .lastUpdated(new Date())
                    .configSyncEnabled(true)
                    .deviceConfig(DeviceConfig.builder().bgpAdSpecifier("phx1").build())
                    .build();

            phxDeviceDo = deviceBl.create(t, phxDeviceDo);

            t.commit();
        }

        // Create CrossConnect on device in PHX
        CrossConnectGroupDo phxCrossConnectGroupDo = CrossConnectGroupBlTest.generateCrossConnectGroupDo(crossConnectGroupBl);
        CrossConnectBlTest.generateCrossConnectDo(crossConnectBl, crossConnectGroupBl, locationBl, phxDeviceDo, phxCrossConnectGroupDo, PHX_LOCATION, PHX_LOCATION);

        return phxCrossConnectGroupDo;
    }

