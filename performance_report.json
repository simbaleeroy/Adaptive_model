export const getMultipleCrossConnectsBodyC2 = (
  user: any,
  newCcgData: DEFINITION_CoreServicesApi_CrossConnectGroup,
  ccg1Data: any,
): Array<{ crossConnectPayload: Record<string, any> }> => {
  const formFields = user?.forms?.["intent.fast-connect.create.Step2"]?.$formFields;
  const numberOfCrossConnects = formFields?.[`${CrossConnectFieldNames.NumberOfCrossConnects}-1`];
  const { freeformTags, definedTags } = convertTags(formFields?.tags1);

  const payloads: Array<{ crossConnectPayload: Record<string, any> }> = [];

  for (let i = 0; i < numberOfCrossConnects; i++) {
    const displayName = formFields?.["displayName-1"]
      ? `${formFields?.["displayName-1"]}-${i + 1}`
      : `${newCcgData?.displayName?.replace("group", "")}-${i + 1}`;

    const crossConnectPayload: Record<string, any> = {
      compartmentId: formFields?.["compartmentId-1"],
      locationName: formFields?.["locationName-1"] ?? formFields?.locationName,
      portSpeedShapeName: formFields?.["portSpeedShapeName-1"],
      freeformTags: freeformTags ?? {},
      definedTags: definedTags ?? {},
      displayName,
      customerReferenceName: formFields?.["customerReferenceName-1"],
      crossConnectGroupId: newCcgData?.id,
      farCrossConnectOrCrossConnectGroupId: ccg1Data?.id,
    };

    payloads.push({ crossConnectPayload });
  }

  //   console.log("getMultipleCrossConnectsBodyC2 -->", payloads);
  return payloads;
};

