    @ResourceAssociationReviewed
    @AuthorizeReadOnly
    public CrossConnectMappingDetailsCollection listCrossConnectMappings(
            @PrincipalContext Principal principal,
            @NbacRequestContext NbacRequest nbacRequest,
            @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
            @PathParam("virtualCircuitId") String id,
            @AuditContext AuditPayloadAppender auditPayloadAppender) throws ValidationException {

        auditPayloadAppender.setEventName("listCrossConnectMappings", OperationSynchronousType.Synchronous);
        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrowForAuth(id);
        String compartmentId = virtualCircuitDo.getCompartmentId();
        auditPayloadAppender.overrideCompartmentId( compartmentId);

        List<String> permissions = ImmutableList.of(Permissions.VIRTUAL_CIRCUIT_READ);
        boolean isProviderVirtualCircuit = StringUtils.isNotBlank(virtualCircuitDo.getProviderName());

        try {
            authorizationHelper.authorizeGet(
                    nbacRequest, authorizationRequest, compartmentId, permissions, Operations.ListCrossConnectMappings,
                    principal, vcContextVariable, virtualCircuitDo.getTags());
        } catch (RenderableException ex) {
            if (ex.getErrorCode() == ErrorCode.NotAuthorizedOrNotFound && isProviderVirtualCircuit) {

                // authorize against provider compartment.
                compartmentId = virtualCircuitDo.getProviderCompartmentId();
                authorizationHelper.authorizeGet(
                        nbacRequest, authorizationRequest, compartmentId, permissions, Operations.ListCrossConnectMappings,
                        principal, vcContextVariable, virtualCircuitDo.getTags());
            } else {
                throw ex;
            }
        }
        auditUpdate(auditPayloadAppender, virtualCircuitDo, "ListCrossConnectMappings");

        BgpStateMap bgpStateMap = bgpBl.prepareBgpStateMap();

        return virtualCircuitDo.getCrossConnectMappingDetails(bgpBl, bgpStateMap, virtualCircuitBl);
    }

