    @GET
    @Timed(name="getVirtualCircuitRoutes")
    @Produces({"application/json"})
    @Path("/{virtualCircuitId}/bgpRoutes")
    @VpnSkipAuthorization
    public Response getVirtualCircuitRoutes(
            @PathParam("virtualCircuitId") String vcId
    ) throws Exception {
        log.info("getVirtualCircuitRoutes request for device: {}", vcId);

        ArrayList<VirtualCircuitBgpRoute> devicebgpRouteInformationRoutes =  new ArrayList<>();

        //get devices from config snippets
        List<ConfigSnippetDo> listConfigSnippetDos = configSnippetBl.listSnippetsForDomainObject(vcId);
        for ( ConfigSnippetDo configSnippetDo : listConfigSnippetDos) {
            String deviceId = configSnippetDo.getDeviceId();
            Map<String, Object> templateValues = configSnippetDo.getTemplateValues();
            String tableName = "VPN-DRG-" + templateValues.get("xnetId").toString() + ".inet.0";
            String peerAddress = templateValues.get("remoteBgpIp").toString();
            if(!StringUtils.isBlank(deviceId) &&
                    !StringUtils.isBlank(tableName) &&
                    !StringUtils.isBlank(peerAddress)) {

                DeviceDo deviceDo = deviceBl.getOrThrow(deviceId);
                try {
                    String deviceIP = deviceBl.getDeviceIpFromDevice(deviceDo);
                    DeviceConnector connector = deviceBl.getDeviceConnector(deviceIP, deviceDo);
                    connector.startSession(DEVICE_CONNECTOR_TIMEOUT_MILLISEC);
                    Set<RouteInformation> advertisingRoutes = connector.getRouteInformationFromTable(peerAddress, tableName, "advertising");
                    Set<RouteInformation> receiveRoutes = connector.getRouteInformationFromTable(peerAddress, tableName, "receiving");

                    //convert to Model before response
                    List<com.oracle.pic.vpn.model.RouteInformation> advertisingRoutesList = new ArrayList<>();
                    for( RouteInformation route : advertisingRoutes)
                    {
                        advertisingRoutesList.add(com.oracle.pic.vpn.model.RouteInformation
                                .builder()
                                .deviceName(route.getDeviceName())
                                .hostAddress(route.getHostAddress())
                                .mplsLabel(route.getMplsLabel())
                                .routeTarget(route.getRouteTarget())
                                .substrateIP(route.getSubstrateIP())
                                .routingInstance(route.getRoutingInstance())
                                .build());
                    }

                    List<com.oracle.pic.vpn.model.RouteInformation> receiveRoutesList = new ArrayList<>();
                    for( RouteInformation route : receiveRoutes)
                    {
                        receiveRoutesList.add(com.oracle.pic.vpn.model.RouteInformation
                                .builder()
                                .deviceName(route.getDeviceName())
                                .hostAddress(route.getHostAddress())
                                .mplsLabel(route.getMplsLabel())
                                .routeTarget(route.getRouteTarget())
                                .substrateIP(route.getSubstrateIP())
                                .routingInstance(route.getRoutingInstance())
                                .build());
                    }
                    log.info("getVirtualCircuitRoutes request for device: {} peerAddress: {} tableName: {}", vcId, peerAddress, tableName);

                    VirtualCircuitBgpRoute deviceRoute = VirtualCircuitBgpRoute.builder()
                            .deviceId(deviceId)
                            .advertisingRoutes(advertisingRoutesList)
                            .receivingRoutes(receiveRoutesList)
                            .build();

                    devicebgpRouteInformationRoutes.add(deviceRoute);
                    connector.closeSession();
                } catch (Exception e) {
                    log.error("getRouteInformationFromTable failed with exception: {} request for device: {} peerAddress: {} tableName: {}", e.getMessage(), deviceId, peerAddress, tableName);
                }
            }
        }

        VirtualCircuitBgpRoutes routes = VirtualCircuitBgpRoutes.builder()
                .virtualCircuitId(vcId)
                .bgpRouteInformation(devicebgpRouteInformationRoutes)
                .build();
        return Response.ok(routes).build();
    }

    @GET
    @Timed(name = "getVirtualCircuitUnitNumber")
    @Path("/{virtualCircuitId}/unitNumber")
    @VpnSkipAuthorization
    public UnitNumber getVirtualCircuitUnitNumber(
            @PathParam("virtualCircuitId") String virtualCircuitId) throws Exception {
        try (Transaction t = unitNumberBl.beginTransaction("get-UnitNumberForTunnel")) {

            VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(t, virtualCircuitId);
            if (virtualCircuitDo.isPublic()) {
                PublicValidation.failInvalidVcType(virtualCircuitId);
            }

            List<UnitNumberDo> unitNumberDos = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitId);
            if (unitNumberDos.size() == 0) {
                PublicValidation.failKeyNotFound(getClass().getSimpleName(), virtualCircuitId);
            }
            return UnitNumber.builder()
                    .id(unitNumberDos.get(0).getId())
                    .assocObjId(unitNumberDos.get(0).getAssocObjId())
                    .deviceId(unitNumberDos.get(0).getDeviceId())
                    .unitNumber(unitNumberDos.get(0).getUnitNumber())
                    .vcUnitNumberForQfx(virtualCircuitDo.getVcUnitNumberForQfx())
                    .build();
        }
    }

    @PUT
    @Timed(name = "updateVirtualCircuitUnitNumber")
    @Path("/{virtualCircuitId}/unitNumber")
    @VpnSkipAuthorization
    public Response updateVirtualCircuitUnitNumber(
            @PathParam("virtualCircuitId") String virtualCircuitId,
            @Valid @NonNull UpdateUnitNumberRequest request,
            @Nullable @HeaderParam("updateVcUnitNumberForQfx") Boolean updateVcUnitNumberForQfx) throws Exception {
        boolean vcUnitNumberForQfx = updateVcUnitNumberForQfx != null && updateVcUnitNumberForQfx;
        if (request.getChangeId() == null && !vcUnitNumberForQfx) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Request must contain either a valid changeId or updateVcUnitNumberForQfx set to true.");
        }
        try (Transaction t = virtualCircuitBl.beginTransaction("update-virtual-circuit")) {
            VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(t, virtualCircuitId);
            if (virtualCircuitDo.isPublic()) {
                PublicValidation.failInvalidVcType(virtualCircuitId);
            }

            // If provider name is valid, this is treated as a provider VC.
            Optional<ProviderServiceDo> providerDo = Optional.empty();
            if (StringUtils.isNotBlank(virtualCircuitDo.getProviderServiceId())) {
                providerDo = providerBl.get(virtualCircuitDo.getProviderServiceId());
            }

            Boolean isFakeDevice = VirtualCircuitHelper.isFakeDeviceVc(virtualCircuitDo, deviceBl, virtualCircuitBl, crossConnectBl, crossConnectGroupBl);
            if (VirtualCircuitHelper.inStateToRunWorkflow(virtualCircuitDo, virtualCircuitDo)) {
                eventBl.create(t, virtualCircuitId, Component.API, "Management Update IPSecTunnel Request %s", request);
                Boolean isCustomer = limitsHelper.checkCustomerTenancyByCompartmentId(virtualCircuitDo.getCompartmentId());
                WorkRequestDo workRequestDo = VirtualCircuitHelper.getWorkRequestForVirtualCircuitUpdate(virtualCircuitDo, virtualCircuitDo, providerDo, providerBl,
                        propertiesBl, OperationType.UPDATE, isFakeDevice, isCustomer, RequestIdHolder.get());
                if (vcUnitNumberForQfx) {
                    virtualCircuitDo = virtualCircuitDo.toBuilder().vcUnitNumberForQfx(null).build();
                    virtualCircuitBl.update(t, virtualCircuitDo);
                } else {
                    unitNumberBl.deleteAssociatedUnitNumbers(t, virtualCircuitId);
                }

                virtualCircuitDo = VirtualCircuitHelper.launchUpdateWorkflow(t, virtualCircuitDo, virtualCircuitBl, workRequestBl, eventBl, workRequestDo);
                String eventMessage = String.format(
                        "Launching update workflow for %s with workRequest %s",
                        virtualCircuitDo, workRequestDo.getId());
                if (request.getChangeId() != null) {
                    eventMessage = String.format(
                            "Launching update workflow for %s with workRequest %s and ChangeId %s",
                            virtualCircuitDo, workRequestDo.getId(), request.getChangeId());
                }
                eventBl.create(t, virtualCircuitDo.getId(), Component.API, eventMessage);
                log.info(eventMessage);
                t.commit();
            } else {
                log.info("Not in correct state to launch update workflow for {}", virtualCircuitDo);
            }
            return Response.accepted().build();
        }

    }

    @GET
    @Timed(name = "listVirtualCircuitProperties")
    @Path("/{virtualCircuitId}/property")
    @VpnSkipAuthorization
    public List<Property> listVirtualCircuitProperties(
            @NonNull @PathParam("virtualCircuitId") String virtualCircuitId) throws Exception {
        
        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitId);
        Map<String, String> properties = virtualCircuitDo.getProperties() == null ?
                new HashMap<>() : virtualCircuitDo.getProperties();

        return properties.entrySet().stream()
                .map(this::toModel)
                .collect(Collectors.toList());
    }

    private Property toModel(Map.Entry<String, String> entry) {
        return Property.builder()
                .key(entry.getKey())
                .value(entry.getValue())
                .build();
    }

    @DELETE
    @Timed(name = "deleteVirtualCircuitProperty")
    @Path("/{virtualCircuitId}/property/{property-id}")
    @VpnSkipAuthorization
    public Response deleteVirtualCircuitProperty(
            @PathParam("virtualCircuitId") String virtualCircuitId,
            @PathParam("property-id") String property) throws Exception {
        
        try (Transaction t = virtualCircuitBl.beginTransaction("delete-vc-property")) {
            VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(t, virtualCircuitId);

            Map<String, String> properties = virtualCircuitDo.getProperties() == null ?
                    new HashMap<String, String>() : virtualCircuitDo.getProperties();

            // validate property exists
            if (!properties.containsKey(property)) {
                PublicValidation.failVcPropertyNotFound(property, virtualCircuitId);
            }
            
            properties.remove(property);
            virtualCircuitDo = virtualCircuitDo.toBuilder().properties(properties).build();
            virtualCircuitBl.update(t, virtualCircuitDo);
            String eventMessage = String.format("Management Deleted VC property: %s", property);
            eventBl.create(t, virtualCircuitId, Component.API, eventMessage);
            log.info(eventMessage);
            t.commit();
        }

        return Response.accepted().build();
        
    }
    
    @PUT
    @Timed(name = "updateVirtualCircuitProperty")
    @Path("/{virtualCircuitId}/property")
    @VpnSkipAuthorization
    public Response updateVirtualCircuitProperty(
            @PathParam("virtualCircuitId") String virtualCircuitId,
            @Valid @NonNull UpdatePropertyRequest request) throws Exception {

        try (Transaction t = virtualCircuitBl.beginTransaction("update-vc-property")) {
            VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(t, virtualCircuitId);
            Map<String, String> properties = virtualCircuitDo.getProperties() == null ?
                    new HashMap<String, String>() : virtualCircuitDo.getProperties();
            log.info("Validating for Qos");
            validateQos(request, virtualCircuitDo);
            properties.put(request.getKey(), request.getValue());
            virtualCircuitDo = virtualCircuitDo.toBuilder().properties(properties).build();
            virtualCircuitBl.update(t, virtualCircuitDo);

            String eventMessage = String.format("Management Update VC property Request %s", request);
            eventBl.create(t, virtualCircuitId, Component.API, eventMessage);
            log.info(eventMessage);
            t.commit();

            return Response.accepted().build();
        }
    }

    @POST
    @Timed(name = "virtualCircuitDrgPingIp")
    @Produces({"application/json"})
    @Path("/{virtualCircuitId}/pingIp")
    @VpnSkipAuthorization
    public List<PingResultResponse> pingFromDrg(
            @PathParam("virtualCircuitId") String id,
            @Valid @NonNull PingRequestDetails request) throws ValidationException {

        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(id);

        String routingInstanceName =  null;

        if(virtualCircuitDo.isDrgV2()) {
            if(virtualCircuitDo.getGroupId() != null) {
                routingInstanceName = "VPN-DRG-" + virtualCircuitDo.getGroupId();
            }

        } else {
            Optional<DrgDo> drgDoOptional = drgBl.get(virtualCircuitDo.getGatewayId());
            if (!drgDoOptional.isPresent()) {
                throw new ValidationException(ErrorCode.InvalidParameter, "No drg exists with id: ", virtualCircuitDo.getGatewayId());
            } else {
                if(drgDoOptional.get().getGroupId() != null) {
                    routingInstanceName = "VPN-DRG-" + drgDoOptional.get().getGroupId();
                }
            }
        }

        if(routingInstanceName == null) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Routing Instance Name cannot be null");
        }


        Optional<DeviceDo> deviceDoOptional = deviceBl.get(request.getDeviceId());
        if (!deviceDoOptional.isPresent()) {
            throw new ValidationException(ErrorCode.InvalidParameter, "No device exists with id: ", request.getDeviceId());
        }

        HashSet<String> deviceIds = new HashSet<>();

        for (CrossConnectMappings.Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {

            boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
            CrossConnectGroupDo crossConnectGroupDo = null;
            CrossConnectDo crossConnectDo;
            DeviceDo crossConnectDeviceDo;
            DeviceDo mxDeviceDo;
            // get deviceId
            if (isCrossConnect) {
                crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
            } else {
                crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                crossConnectDo = crossConnectBl.getOrThrow(crossConnectGroupDo.getCrossConnectIds()[0]);
            }
            crossConnectDeviceDo = deviceBl.getOrThrow(crossConnectDo.getDeviceId());
            mxDeviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(crossConnectDeviceDo);
            deviceIds.add(mxDeviceDo.getId());
        }

        if(!deviceIds.contains(request.getDeviceId())) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Invalid Device id: ", request.getDeviceId());
        }

        if (request.getTargetIp() == null) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Target IP must be set.");
        }

        DeviceConnector connector;
        try {
            String deviceIP = deviceBl.getDeviceIpFromDevice(deviceDoOptional.get());
            connector = deviceBl.getDeviceConnector(deviceIP, deviceDoOptional.get());
        } catch (EncryptionException e) {
            throw new RenderableException(ErrorCode.InternalError, "Error retrieving device credentials");
        }

        List<PingResult> pingResults;
        try {
            pingResults = connector.pingIp(
                    request.getTargetIp(),
                    routingInstanceName,
                    request.getMtu(),
                    request.getCount());
        } catch (FatalDeviceException | DeviceIOException e) {
            throw new RenderableException(ErrorCode.InternalError, "Error performing ping", e);
        }

        return pingResults.stream()
                .map(this::toModel)
                .collect(Collectors.toList());
    }

    private void validateQos(UpdatePropertyRequest request, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        log.info("Validating for Qos");
        if (request.getKey().equals(VirtualCircuitDo.ENABLE_QOS) && !virtualCircuitBl.isFfab(virtualCircuitDo)) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Qos is supported only on Qfx5120 devices.");
        }
    }

    protected String getVcTenantId(String compartmentId) {
        try {
            return identityMetadataHelper.getTenantId(compartmentId);
        } catch (RuntimeException | AuthServerUnavailableException | ValidationException e) {
            log.error("TenantId lookup failed for compartment {}.", compartmentId, e);
            return null;
        }
    }

    private PingResultResponse toModel(PingResult pingResult) {
        return PingResultResponse.builder()
                .targetIp(pingResult.getTargetIp())
                .packetSize(pingResult.getPacketSize())
                .probeIndex(pingResult.getProbeIndex())
                .sequenceNumber(pingResult.getSequenceNumber())
                .success(pingResult.getSuccess())
                .rtt(pingResult.getRtt())
                .build();
    }

