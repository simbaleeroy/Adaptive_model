    public static boolean isCrossConnect(String ocid) throws ValidationException {
        if (StringUtils.isBlank(ocid)) {
            return false;
        }
        try {
            Id id = OCIDParser.fromString(ocid);
            return id.getEntityType() == EntityType.VpnCrossConnect;
        } catch (InvalidOCIDException e) {
            PublicValidation.failUnknownCrossConnectOrCrossConnectId(ocid);
            return false; // Dead code
        }
    }

    public static boolean isCrossConnectGroup(String ocid) throws ValidationException {
        if (StringUtils.isBlank(ocid)) {
            return false;
        }
        try {
            Id id = OCIDParser.fromString(ocid);
            return id.getEntityType() == EntityType.VpnCrossConnectGroup;
        } catch (InvalidOCIDException e) {
            PublicValidation.failUnknownCrossConnectOrCrossConnectId(ocid);
            return false; // Dead code
        }
    }

