    @Test
    public void GIVEN_listVirtualCircuits_THEN_correctVirtualCircuitsListed() throws Exception {

        setupVcDependencies();

        PaginatedResponse<com.oracle.pic.vpn.model.VirtualCircuit> response =
                virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, null, null, null);
        assertThat(response.getResults().size()).isEqualTo(0);

        final Integer MAX_VIRTUAL_CIRCUITS = 5;

        for (int i = 0; i < MAX_VIRTUAL_CIRCUITS; i++) {
            CreateVirtualCircuitDetails createVirtualCircuitDetails = getCreateL3ProviderDetails(l3ProviderId).build();

            VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                    .createVirtualCircuitDetails(createVirtualCircuitDetails)
                    .build()).getVirtualCircuit();
        }

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        response = virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, null, null, null);
        assertThat(response.getResults().size()).isEqualTo(MAX_VIRTUAL_CIRCUITS + 1);

        response = virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, MY_COMPARTMENT, null, null);
        assertThat(response.getResults().size()).isEqualTo(MAX_VIRTUAL_CIRCUITS + 1);

        response = virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, PROVIDER_COMPARTMENT, null, null);
        assertThat(response.getResults().size()).isEqualTo(MAX_VIRTUAL_CIRCUITS);
    }

    @Test
    public void GIVEN_getVirtualCircuit_THEN_correctVirtualCircuitReturned() throws Exception {
        setupVcDependencies();

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateL2ProviderDetailsWithId(l2ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        Response response = virtualCircuitManagementResourceV1.getVirtualCircuit(vc.getId());
        com.oracle.pic.vpn.model.VirtualCircuit vcReturned = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();

        assertEquals(vc.getProviderName(), vcReturned.getProviderName());
        assertEquals(vc.getBandwidthShapeName(), vcReturned.getBandwidthShapeName());
        assertEquals(vc.getCompartmentId(), vcReturned.getCompartmentId());
        assertNull(vcReturned.getVirtualCircuitRedundancyMetadata());
        assertEquals(false, vcReturned.getIsDrgV2());
        assertEquals(vc.getBgpAdminState().toString(),vcReturned.getBgpAdminState().toString());
    }

    @Test
    public void GIVEN_getVirtualCircuit_THEN_backfillsTenantId_WhenMissing() throws Exception {
        setupVcDependencies();

        CreateVirtualCircuitDetails createDetails =
                getCreateL2ProviderDetailsWithId(l2ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(
                CreateVirtualCircuitRequest.builder()
                        .createVirtualCircuitDetails(createDetails)
                        .build()
        ).getVirtualCircuit();

        VirtualCircuitManagementResourceV1 resourceSpy = spy(virtualCircuitManagementResourceV1);

        // This replaces virtualCircuitBl with a spy of the real BL
        Field virtualCircuitBl = VirtualCircuitManagementResourceV1.class.getDeclaredField("virtualCircuitBl");
        virtualCircuitBl.setAccessible(true);
        Object realBlObj = virtualCircuitBl.get(resourceSpy);
        VirtualCircuitBl blSpy = spy((VirtualCircuitBl) realBlObj);
        virtualCircuitBl.set(resourceSpy, blSpy);

        VirtualCircuitDo realDo = blSpy.getOrThrow(vc.getId());
        VirtualCircuitDo doSpy = spy(realDo);
        // set tenantId to null, so that backfill is triggered
        doReturn(null).when(doSpy).getTenantId();

        doReturn(doSpy).when(blSpy).getOrThrow(vc.getId());

        String expectedTenantId = "tenancyId";
        doReturn(expectedTenantId).when(resourceSpy).getVcTenantId(vc.getCompartmentId());

        VirtualCircuitDo afterBackfill = spy(realDo);
        doReturn(expectedTenantId).when(afterBackfill).getTenantId();
        doReturn(afterBackfill).when(blSpy).backfillTenantId(vc.getId(), expectedTenantId);

        Response response = resourceSpy.getVirtualCircuit(vc.getId());
        com.oracle.pic.vpn.model.VirtualCircuit vcReturned =
                (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();

        // assert that VC in response has TenancyId
        assertThat(vcReturned.getTenancyId()).isNotNull();

        // assert that we hit the backfill path
        verify(blSpy).backfillTenantId(vc.getId(), expectedTenantId);
    }
