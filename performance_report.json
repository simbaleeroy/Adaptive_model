{
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          isRedundancyEnabled($app) &&
        $crossConnectOrCrossConnectGroupId &&
        ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
          $virtualCircuit?.type) !== VirtualCircuitTypeEnum.Internet,
      ),
      content: [
        {
          type: "FieldSet",
          legend: Messages.VirtualCircuit.form.redundantCrossConnectHeader,
          content: [
            {
              type: "Switch",
              name: VirtualCircuitFieldNames.AdditionalCrossConnect,
              label: Messages.VirtualCircuit.form.attachAdditionalCrossConnect,
              defaultValue: mauiExpression($virtualCircuit?.crossConnectMappings?.length > 1),
              hint: Messages.VirtualCircuit.form.enableDesc,
              onChangeAction: [VirtualCircuitDetailsActions.shouldGetRedundantCrossConnects],
            },
          ],
        },
        {
          type: "ConditionalRender",
          predicate: mauiExpression(
            $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.AdditionalCrossConnect],
          ),
          content: [
            {
              name: VirtualCircuitFieldNames.CompartmentIdForCrossConnect,
              fieldName: VirtualCircuitFieldNames.CompartmentIdForCrossConnect,
              type: "CompartmentScoped",
              label: Messages.VirtualCircuit.form.crossConnectCompartment,
              initialCompartmentId: mauiExpression($app?.consoleState?.compartmentId),
              onChangeAction: [VirtualCircuitDetailsActions.shouldGetRedundantCrossConnects],
              fields: [
                {
                  name: VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupIdRcc2,
                  label: Messages.VirtualCircuit.form.crossConnect,
                  type: "Select",
                  options: mauiExpression(
                    getRedundantCrossConnectOptions(
                      CoreServicesApi.ListCrossConnects.namespaced(
                        virtualCircuitFormRedundant,
                      )?.response()?.data,
                      CoreServicesApi.ListCrossConnectGroups.namespaced(
                        virtualCircuitFormRedundant,
                      )?.response()?.data,
                    ),
                  ),
                  placeholder: Messages.CrossConnect.form.selectAValue,
                  defaultValue: mauiExpression(
                    $virtualCircuit?.crossConnectMappings?.[1]?.crossConnectOrCrossConnectGroupId,
                  ),
                  validators: [
                    {
                      type: "required",
                      message: Messages.VirtualCircuit.form.crossConnectError,
                    },
                  ],
                },
              ],
            },
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                shouldShowProviderServiceKeyName($user?.providerService, $isEdit),
              ),
              content: [
                {
                  type: "TextInput",
                  name: VirtualCircuitFieldNames.ProviderServiceKeyNameRcc2,
                  label: Messages.VirtualCircuit.form.partnerKey,
                  optional: mauiExpression(isATT($user?.providerService)),
                  tooltip: {
                    text: Messages.VirtualCircuit.form.partnerKeyInfo,
                  },
                  validators: [
                    {
                      type: "max-length",
                      maxLength: validationRules.providerServiceKeyMaxLength,
                      message: Messages.VirtualCircuit.form.partnerKeyErrorLength(
                        String(validationRules.providerServiceKeyMinLength),
                        String(validationRules.providerServiceKeyMaxLength),
                      ),
                    },
                    {
                      type: "min-length",
                      minLength: validationRules.providerServiceKeyMinLength,
                      message: Messages.VirtualCircuit.form.partnerKeyErrorLength(
                        String(validationRules.providerServiceKeyMinLength),
                        String(validationRules.providerServiceKeyMaxLength),
                      ),
                    },
                  ],
                  defaultValue: mauiExpression($virtualCircuit?.providerServiceKeyName),
                },
              ],
            },
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                $isEdit
                  ? $virtualCircuit?.type && !$virtualCircuit?.providerServiceId
                  : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type],
              ),
              content: [
                {
                  type: "ConditionalRender",
                  predicate: mauiExpression(
                    ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                      $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet,
                  ),
                  content: [
                    {
                      type: "TextInput",
                      name: VirtualCircuitFieldNames.VlanRcc2,
                      label: Messages.VirtualCircuit.form.vlan,
                      value: "102",
                      readOnly: true,
                    },
                  ],
                },
                {
                  type: "ConditionalRender",
                  predicate: mauiExpression(
                    ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                      $virtualCircuit?.type) !== VirtualCircuitTypeEnum.Internet,
                  ),
                  content: [
                    {
                      type: "NumberInput",
                      name: VirtualCircuitFieldNames.VlanRcc2,
                      label: Messages.VirtualCircuit.form.vlan,
                      min: validationRules.vlanMinValue,
                      max: validationRules.vlanMaxValue,
                      validators: [
                        {
                          type: "required",
                          message: Messages.VirtualCircuit.form.vlanError,
                        },
                        {
                          type: "max",
                          max: validationRules.vlanMaxValue,
                          message: Messages.VirtualCircuit.form.vlanValueError(
                            String(validationRules.vlanMinValue),
                            String(validationRules.vlanMaxValue),
                          ),
                        },
                      ],
                      defaultValue: mauiExpression(
                        $virtualCircuit?.crossConnectMappings?.[1]?.vlan,
                      ),
                    },
                  ],
                },
              ],
            },
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                shouldShowIpFields(
                  $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                    $virtualCircuit?.type,
                  $user?.providerService,
                ),
              ),
              content: [
                {
                  type: "FieldSet",
                  legend: Messages.VirtualCircuit.form.bgpIpAddresses,
                  content: [
                    {
                      type: "ConditionalRender",
                      predicate: mauiExpression(
                         ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                          $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet ||
                        $user?.providerService?.requiredTotalCrossConnects === 1,
                      ),
                      content: [
                        {
                          type: "TextInput",
                          name: mauiExpression(
                            getIndexedFieldName(
                              VirtualCircuitFieldNames.CustomerBgpPeeringIp,
                              1,
                              true,
                            ),
                          ),
                          label: Messages.VirtualCircuit.form.customerIpv4,
                          hint: Messages.VirtualCircuit.form.customerIpHint,
                          validators: [
                            {
                              type: "required",
                              message: Messages.VirtualCircuit.form.ipMissingError,
                            },
                            {
                              type: "max-length",
                              maxLength: validationRules.ipMaxLength,
                              message: Messages.VirtualCircuit.form.ipLengthError(
                                String(validationRules.ipMinLength),
                                String(validationRules.ipMaxLength),
                              ),
                            },
                            {
                              type: "custom",
                              isValid: mauiExpression(
                                isValidIpv4CidrAddress(
                                  $user?.forms?.[$formId]?.$formFields?.[
                                    getIndexedFieldName(
                                      VirtualCircuitFieldNames.CustomerBgpPeeringIp,
                                      1,
                                      true,
                                    )
                                  ],
                                ),
                              ),
                              message: Messages.VirtualCircuit.form.ipInvalidError,
                            },
                          ],
                          defaultValue: mauiExpression(
                            $virtualCircuit?.crossConnectMappings?.[1]?.customerBgpPeeringIp,
                          ),
                        },
                        {
                          type: "TextInput",
                          name: mauiExpression(
                            getIndexedFieldName(
                              VirtualCircuitFieldNames.OracleBgpPeeringIp,
                              1,
                              true,
                            ),
                          ),
                          label: Messages.VirtualCircuit.form.oracleIpv4,
                          hint: Messages.VirtualCircuit.form.oracleIpHint,
                          validators: [
                            {
                              type: "max-length",
                              maxLength: validationRules.ipMaxLength,
                              message: Messages.VirtualCircuit.form.ipLengthError(
                                String(validationRules.ipMinLength),
                                String(validationRules.ipMaxLength),
                              ),
                            },
                            {
                              type: "custom",
                              isValid: mauiExpression(
                                isValidIpv4CidrAddress(
                                  $user?.forms?.[$formId]?.$formFields?.[
                                    getIndexedFieldName(
                                      VirtualCircuitFieldNames.OracleBgpPeeringIp,
                                      1,
                                      true,
                                    )
                                  ],
                                ),
                              ),
                              message: Messages.VirtualCircuit.form.ipInvalidError,
                            },
                          ],
                          defaultValue: mauiExpression(
                            $virtualCircuit?.crossConnectMappings?.[1]?.oracleBgpPeeringIp,
                          ),
                          optional: true,
                        },
                      ],
                    },
                  ],
                },
              ],
            },
            /* IPv6 toggle & fields */
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                whitelistIpv6($app) &&
                (shouldShowIpv6Fields(
                    $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                      $virtualCircuit?.type,
                    $user?.providerService,
                  ) ||
                  ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                    $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet),
              ),
              content: [
                {
                  type: "Switch",
                  name: VirtualCircuitFieldNames.Ipv6EnabledRcc2,
                  label: Messages.VirtualCircuit.form.enableIpv6,
                  defaultValue: mauiExpression(getInitialIsIpv6Enabled($virtualCircuit)),
                },
                {
                  type: "ConditionalRender",
                  predicate: mauiExpression(
                    !$user?.forms?.[$formId]?.$formFields?.[
                      VirtualCircuitFieldNames.Ipv6EnabledRcc2
                    ] &&
                      $isEdit &&
                      getInitialIsIpv6Enabled($virtualCircuit),
                  ),
                  content: [
                    {
                      type: "InfoBlock",
                      title: Messages.VirtualCircuit.form.important,
                      infoText: Messages.VirtualCircuit.form.ipv6DisableInfo,
                      status: "warning",
                    },
                  ],
                },
                {
                  type: "ConditionalRender",
                  predicate: mauiExpression(
                    $user?.forms?.[$formId]?.$formFields?.[
                      VirtualCircuitFieldNames.Ipv6EnabledRcc2
                    ],
                  ),
                  content: [
                    {
                      type: "ConditionalRender",
                      predicate: mauiExpression(
                        $user?.providerService?.requiredTotalCrossConnects === 1,
                      ),
                      content: [
                        {
                          type: "TextInput",
                          name: mauiExpression(
                            getIndexedFieldName(
                              VirtualCircuitFieldNames.CustomerBgpPeeringIpv6,
                              1,
                              true,
                            ),
                          ),
                          label: Messages.VirtualCircuit.form.customerIpv6,
                          hint: Messages.VirtualCircuit.form.ipv6Hint,
                          validators: [
                            {
                              type: "required",
                              message: Messages.VirtualCircuit.form.ipMissingError,
                            },
                            {
                              type: "max-length",
                              maxLength: validationRules.ipMaxLength,
                              message: Messages.VirtualCircuit.form.ipLengthError(
                                String(validationRules.ipMinLength),
                                String(validationRules.ipMaxLength),
                              ),
                            },
                            {
                              type: "custom",
                              isValid: mauiExpression(
                                isValidIpv6CidrAddress(
                                  $user?.forms?.[$formId]?.$formFields?.[
                                    getIndexedFieldName(
                                      VirtualCircuitFieldNames.CustomerBgpPeeringIpv6,
                                      1,
                                      true,
                                    )
                                  ],
                                ),
                              ),
                              message: Messages.VirtualCircuit.form.ipInvalidError,
                            },
                          ],
                          defaultValue: mauiExpression(
                            $virtualCircuit?.crossConnectMappings?.[1]?.customerBgpPeeringIpv6,
                          ),
                        },
                        {
                          type: "TextInput",
                          name: mauiExpression(
                            getIndexedFieldName(
                              VirtualCircuitFieldNames.OracleBgpPeeringIpv6,
                              1,
                              true,
                            ),
                          ),
                          label: Messages.VirtualCircuit.form.oracleIpv6,
                          hint: Messages.VirtualCircuit.form.ipv6Hint,
                          validators: [
                            {
                              type: "max-length",
                              maxLength: validationRules.ipMaxLength,
                              message: Messages.VirtualCircuit.form.ipLengthError(
                                String(validationRules.ipMinLength),
                                String(validationRules.ipMaxLength),
                              ),
                            },
                            {
                              type: "custom",
                              isValid: mauiExpression(
                                isValidIpv6CidrAddress(
                                  $user?.forms?.[$formId]?.$formFields?.[
                                    getIndexedFieldName(
                                      VirtualCircuitFieldNames.OracleBgpPeeringIpv6,
                                      1,
                                      true,
                                    )
                                  ],
                                ),
                              ),
                              message: Messages.VirtualCircuit.form.ipInvalidError,
                            },
                          ],
                          defaultValue: mauiExpression(
                            $virtualCircuit?.crossConnectMappings?.[1]?.oracleBgpPeeringIpv6,
                          ),
                          optional: true,
                        },
                      ],
                    },
                  ],
                },
              ],
            },
            /* BGP IP MD5 toggle & field */
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                shouldShowBgpMd5Elements(
                  $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                    $virtualCircuit?.type,
                  $user?.providerService,
                ),
              ),
              content: [
                {
                  type: "Switch",
                  name: VirtualCircuitFieldNames.BgpMd5AuthKeyEnabledRcc2,
                  label: Messages.VirtualCircuit.form.enableMd5,
                  defaultValue: mauiExpression(
                    !!$virtualCircuit?.crossConnectMappings?.[0]?.bgpMd5AuthKey,
                  ),
                  hint: Messages.VirtualCircuit.form.enableMd5Hint,
                },
                {
                  type: "ConditionalRender",
                  predicate: mauiExpression(
                    $user?.forms?.[$formId]?.$formFields?.[
                      VirtualCircuitFieldNames.BgpMd5AuthKeyEnabledRcc2
                    ],
                  ),
                  content: [
                    {
                      type: "ConditionalRender",
                      predicate: mauiExpression(
                        $user?.providerService?.requiredTotalCrossConnects === 2,
                      ),
                      content: [
                        {
                          type: "TextInput",
                          name: mauiExpression(
                            getIndexedFieldName(VirtualCircuitFieldNames.BgpMd5AuthKey, 1, true),
                          ),
                          label: Messages.VirtualCircuit.form.md5AuthKey,
                          validators: [
                            {
                              type: "max-length",
                              maxLength: validationRules.bgpMd5AuthKeyMaxLength,
                              message: Messages.VirtualCircuit.form.md5AuthKeyErrorLength(
                                String(validationRules.bgpMd5AuthKeyMinLength),
                                String(validationRules.bgpMd5AuthKeyMaxLength),
                              ),
                            },
                            {
                              type: "required",
                              message: Messages.VirtualCircuit.form.md5AuthKeyErrorMissing,
                            },
                          ],
                          defaultValue: mauiExpression(
                            $virtualCircuit?.crossConnectMappings?.[1].bgpMd5AuthKey,
                          ),
                        },
                      ],
                    },
                  ],
                },
              ],
            },
          ],
        },
      ],
    },
    /* Customer BGP ASN */
