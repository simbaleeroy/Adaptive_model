            initial = () -> crossConnectGroupBl.scanForList(compartmentId, null, limit, Optional.empty(), Optional.empty(), Optional.empty());
            fromToken = (PaginationToken p) -> crossConnectGroupBl.scanForList(compartmentId, null, limit,
                    PaginationTokenUtils.deserializeAndValidate(opaqueToken, crossConnectGroupBl.getMappedDataStore()), Optional.empty(), Optional.empty());

        } else if (lifecyclestateInternal != null) {
            CrossConnectGroupDo.State effectiveState = crossConnectGroupBl.getAndValidateLifecycleStateInternal(lifecyclestateInternal);
            initial = () -> crossConnectGroupBl.scanByState(effectiveState, limit, Optional.empty());
            fromToken = (PaginationToken p) -> crossConnectGroupBl.scanByState(effectiveState, limit,
                    PaginationTokenUtils.deserializeAndValidate(opaqueToken, crossConnectGroupBl.getMappedDataStore()));
        }

        if (initial != null) {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    initial,
                    fromToken,
                    (crossConnectGroupDo) -> crossConnectGroupBl.toModel(encryptionManager, deviceBl, crossConnectBl, crossConnectGroupDo),
                    crossConnectGroupBl.getMappedDataStore()
            );
        }

        return PaginationUtils.getScanPage(
                opaqueToken,
                limit,
                crossConnectGroupBl,
                (crossConnectGroupDo) -> crossConnectGroupBl.toModel(encryptionManager, deviceBl, crossConnectBl, crossConnectGroupDo)
        );
    }

    public com.oracle.pic.vpn.model.CrossConnectGroup crossConnectGroupToModel(CrossConnectGroupDo ccgDo) {
        com.oracle.pic.vpn.model.CrossConnectGroup.LifecycleState effectiveState = com.oracle.pic.vpn.model.CrossConnectGroup.LifecycleState.create(
                CrossConnectGroupDo.translateIntoEffectiveState(ccgDo.getState()).name());

        com.oracle.pic.vpn.model.MacsecProperties macsecProperties = null;

        if(crossConnectBl.getDeviceId(ccgDo) == null || CrossConnectUtils.isMacsecCapableDevice(crossConnectBl.getDeviceId(ccgDo), deviceBl)) {

            com.oracle.pic.vpn.model.MacsecProperties.State state = ccgDo.isMacsecEnabled() ? com.oracle.pic.vpn.model.MacsecProperties.State.Enabled : com.oracle.pic.vpn.model.MacsecProperties.State.Disabled;

            MacsecKeyInternal macsecKeyInternal = ccgDo.getMacsecKey();

            MacsecKey macsecKey = null;
            MacsecPropertiesInternal macsecPropertiesInternal = ccgDo.getMacsecPropertiesInternal();

            if(macsecKeyInternal != null) {
                macsecKey = MacsecKey.builder()
                        .connectivityAssociationNameSecretId(macsecKeyInternal.getCustomerCknSecretOcid())
                        .connectivityAssociationNameSecretVersion(macsecKeyInternal.getCustomerCknSecretVersion())
                        .connectivityAssociationKeySecretId(macsecKeyInternal.getCustomerCakSecretOcid())
                        .connectivityAssociationKeySecretVersion(macsecKeyInternal.getCustomerCakSecretVersion())
                        .serviceSecretOcid(macsecKeyInternal.getServiceSecretOcid())
                        .build();
            }
            macsecProperties = com.oracle.pic.vpn.model.MacsecProperties.builder()
                    .state(state)
                    .primaryKey(macsecKey)
                    .encryptionCipher(ccgDo.getEncryptionCipher() != null ? MacsecProperties.EncryptionCipher.create(ccgDo.getEncryptionCipher().name()) : null)
                    .bypassLldp(macsecPropertiesInternal != null ?  macsecPropertiesInternal.getBypassLldp() : false)
                    .rekeyPeriod(macsecPropertiesInternal != null ? macsecPropertiesInternal.getRekeyPeriod() : 3600)
                    .replayProtectionWindow(macsecPropertiesInternal != null ? macsecPropertiesInternal.getReplayProtectionWindow() : 0L)
                    .mkaServerPriority(macsecPropertiesInternal != null ? macsecPropertiesInternal.getMkaServerPriority() : 0)
                    .allowUnprotectedTraffic(Optional.ofNullable(macsecPropertiesInternal).map(MacsecPropertiesInternal::getAllowUnprotectedTraffic).orElse(false))
                    .build();

        }

        com.oracle.pic.vpn.db.model.GlobalPopCcgMetadata globalPop = ccgDo.getGlobalPopCcgMetadata();
        com.oracle.pic.vpn.model.GlobalPopCcgMetadata globalPopCcgMetadata = null;

        if (globalPop != null) {
            globalPopCcgMetadata = globalPopCcgMetadata.builder()
                    .agentDirectRegion(globalPop.getAgentDirectRegion() != null ? globalPop.getAgentDirectRegion().getName() : null)
                    .agentTargetRegion(globalPop.getAgentTargetRegion() != null ? globalPop.getAgentTargetRegion().getName() : null)
                    .agentTargetCcgId(globalPop.getAgentTargetCcgId() != null ? globalPop.getAgentTargetCcgId() : null)
                    .state(globalPop.getState() != null ? globalPop.getState().toString() : null)
                    .build();
        }
        String vcsToVlans;
        try {
            vcsToVlans = new ObjectMapper().registerModule(new Jdk8Module()).writeValueAsString(ccgDo.getVcsToVlans());
        } catch (JsonProcessingException e) {
            String errorMessage = "Error converting vcsToVlans map to JSON:" + e;
            throw new RenderableException(ErrorCode.InternalError, errorMessage);
        }

        try {
            return com.oracle.pic.vpn.model.CrossConnectGroup.builder()
                    .id(ccgDo.getId())
                    .displayName(ccgDo.getDisplayName())
                    .compartmentId(ccgDo.getCompartmentId())
                    .timeCreated(ccgDo.getDateCreated())
                    .lifecycleState(effectiveState)
                    .timeCreated(ccgDo.getDateCreated())
                    .crossConnectIdList(new ArrayList<>(Arrays.asList(ccgDo.getCrossConnectIds())))
                    .macsecProperties(macsecProperties)
                    .globalPopCcgMetadata(globalPopCcgMetadata)
                    .ociPhysicalDeviceName(CrossConnectUtils.getPhysicalDeviceName(crossConnectBl.getDeviceId(ccgDo), deviceBl))
                    .ociLogicalDeviceName(CrossConnectUtils.getLogicalDeviceName(crossConnectBl.getDeviceId(ccgDo), deviceBl))
                    .vcsToVlans(vcsToVlans)
                    .build();
        } catch (ValidationException e) {
            e.printStackTrace();
            log.error("Failed to read DeviceName.", e);
            throw new RuntimeException("Unexpected ValidationError", e);
        }
    }

