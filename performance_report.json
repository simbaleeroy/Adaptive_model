        # Verify the list has exactly 3 items
        self.assertEqual(len(ocids), 3)

    def test_invalid_ocid_format(self):
        """Test behavior with invalid OCID formats."""
        invalid_ocids = [
            'invalid-ocid',
            'ocid1.invalid.region1.sea.test',  # invalid resource type
            'ocid1..region1.sea.test',  # empty resource type
            '',  # empty string
            'not-an-ocid-at-all'
        ]
        
        ocids = ['virtualcircuit', 'crossconnect', 'crossconnectgroup']
        
        for invalid_ocid in invalid_ocids:
            parts = invalid_ocid.split('.')
            if len(parts) >= 2:
                ocid_type = parts[1]
                # Invalid OCID types should not be in the ocids list
                if ocid_type not in ocids:
                    self.assertNotIn(ocid_type, ocids)


class TestEnvironmentVariables(unittest.TestCase):
    """Test environment variable handling."""
    
    def test_missing_hostname_env_var(self):
        """Test behavior when hostname environment variable is missing."""
        with patch.dict(os.environ, {}, clear=True):
            # Your function likely uses os.environ.get('hostname') or similar
            # Test that it handles missing environment variables gracefully
            hostname = os.environ.get('hostname', 'default-hostname')
            self.assertEqual(hostname, 'default-hostname')

    def test_missing_local_port_env_var(self):
        """Test behavior when LOCAL_PORT environment variable is missing."""
        with patch.dict(os.environ, {}, clear=True):
            local_port = os.environ.get('LOCAL_PORT', '8080')
            self.assertEqual(local_port, '8080')

    @patch.dict(os.environ, {'hostname': 'custom-host.com', 'LOCAL_PORT': '9000'})
    def test_custom_environment_variables(self):
        """Test with custom environment variables."""
        hostname = os.environ.get('hostname')
        local_port = os.environ.get('LOCAL_PORT')
        
        self.assertEqual(hostname, 'custom-host.com')
        self.assertEqual(local_port, '9000')


