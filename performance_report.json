        name = "createVirtualCircuit",
        majorVersion = 5,
        minorVersion = 4,
        approximateMaxRuntimeSeconds = WorkflowConstants.MAX_WORKFLOW_RUNTIME_SECONDS,
        approximateStartTimeoutSeconds = WorkflowConstants.APPROX_START_TIMEOUT_SECONDS_2_DAYS,
        pollingMode = WorkflowConstants.POLLING_MODE_ROUND_ROBIN,
        firstStep = CreateVirtualCircuitWorkflowV5.Steps.INITIAL)
