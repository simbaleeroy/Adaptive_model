    @VisibleForTesting
    RqsHelper rqsHelper;

    @Inject
    /*package*/ CrossConnectBl(MappedDataStore mappedDataStore,
            MappedHashBucket<String, CrossConnectDo> bucket,
            MappedHashBucket<String, ArchiveDo> archiveBucket,
            UniqueIndex<String, CrossConnectDo> publicIdIndex,
            Index<CompartmentIdKey, CrossConnectDo> compartmentIndex,
            @Named(CrossConnectDo.CC_COMP_NAME_DATE_INDEX) Index<PublicNamedScanDo.CompartmentIdNameDateKey, CrossConnectDo> ccCompIdNameDateIndex,
            @Named(CrossConnectDo.CC_COMP_DATE_INDEX) Index<PublicNamedScanDo.CompartmentIdNameDateKey, CrossConnectDo> ccCompIdDateIndex,
            @Named(CrossConnectDo.CC_SVLAN_PFABCLUSTERID_IDX) Index<CrossConnectDo.SVlanAndPFabClusterIdKey, CrossConnectDo> ccSVlanAndPFabClusterIdIndex,
            @Named(CrossConnectDo.CC_STATE_INDEX) Index<CrossConnectDo.State, CrossConnectDo> stateIndex,
            @Named(CrossConnectDo.CC_DEVICE_ID_INDEX) Index<String, CrossConnectDo> deviceIdIndex,
            RegionIdFactory regionIdFactory,
            CrossConnectGroupBl crossConnectGroupBl,
            RqsHelper rqsHelper,
            PatchPanelPortPairBl patchPanelPortPairBl,
            LocationBl locationBl,
            EncryptionManager encryptionManager,
            DeviceBl deviceBl,
            VcToVlanMappingBl vcToVlanMappingBl,
                               PropertiesBl propertiesBl,
                               IdentityMetadataHelper identityMetadataHelper) {

        super(mappedDataStore, bucket, Buckets.CROSS_CONNECT.getKievName(),
                archiveBucket, publicIdIndex, false, compartmentIndex,
                ccCompIdNameDateIndex, ccCompIdDateIndex);

        this.regionIdFactory = regionIdFactory;
        this.crossConnectGroupBl = crossConnectGroupBl;
        this.ccSVlanAndPFabClusterIdIndex = ccSVlanAndPFabClusterIdIndex;
        this.deviceIdIndex = deviceIdIndex;
        this.rqsHelper = rqsHelper;
        this.patchPanelPortPairBl = patchPanelPortPairBl;
        this.locationBl = locationBl;
        this.stateIndex = stateIndex;
        this.encryptionManager = encryptionManager;
        this.deviceBl = deviceBl;
        this.vcToVlanMappingBl = vcToVlanMappingBl;
        this.propertiesBl = propertiesBl;
        this.identityMetadataHelper = identityMetadataHelper;
    }

    /**
     * This method created DO in DB and also records create with RQS service
     */
    private CrossConnectDo doCreate(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        String tenantId = null;
        try {
            tenantId = identityMetadataHelper.getTenantId(crossConnectDo.getCompartmentId());
            log.debug("Getting tenantId for crossConnectDo {} tenantId {}", crossConnectDo, tenantId);
            crossConnectDo = crossConnectDo.toBuilder()
                    .tenantId(tenantId)
                    .build();
        } catch (Exception e) {
            log.warn("Issue getting tenantId for ccDo {}", crossConnectDo, e);
        }
        CrossConnectDo effectivelyFinal = super.create(t, crossConnectDo);
        if (rqsHelper.isRQSEnabled()) {
            CrossConnectRqsModel crossConnectRqsModel = CrossConnectRqsModel.createFrom(effectivelyFinal.toModel(patchPanelPortPairBl, locationBl, encryptionManager, crossConnectGroupBl, deviceBl));
            rqsHelper.createOrUpdate(crossConnectRqsModel, CrossConnectRqsModel.TYPE, String.valueOf(crossConnectRqsModel.getChecksum()), t);
        }
        return effectivelyFinal;
    }

    @Override
    public CrossConnectDo create(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        String tenantId = null;
        try {
            tenantId = identityMetadataHelper.getTenantId(crossConnectDo.getCompartmentId());
        } catch (Exception e) {
            log.warn("Issue getting tenantId for ccDo {}", crossConnectDo, e);
        }
        crossConnectDo = crossConnectDo
                .toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnCrossConnect).serialize())
                .groupId(UUID.randomUUID().toString())
                .state(State.PROVISIONING)
                .lastStateChanged(new Date())
                .tenantId(tenantId)
                .build();
        updateCrossConnectGroupOnCreate(t, crossConnectDo);
        return doCreate(t, crossConnectDo);
    }

    @Override
    public CrossConnectDo update(Transaction t, CrossConnectDo objectDO) throws ValidationException {

        //ensure that it is not accidentally set
        if(!CrossConnectUtils.isMacsecCapableDevice(objectDO.getDeviceId(), deviceBl)) {
            objectDO =  objectDO.toBuilder()
                    .macsecEnabled(null)
                    .encryptionCipher(null)
                    .macsecKey(null)
                    .build();
        }

        updateCrossConnectGroupOnUpdate(t, objectDO);

        CrossConnectDo effectivelyFinal = super.update(t, objectDO);
        if (rqsHelper.isRQSEnabled()) {
            CrossConnectRqsModel crossConnectRqsModel = CrossConnectRqsModel.createFrom(effectivelyFinal.toModel(patchPanelPortPairBl, locationBl, encryptionManager, crossConnectGroupBl, deviceBl));
            rqsHelper.createOrUpdate(crossConnectRqsModel, CrossConnectRqsModel.TYPE, String.valueOf(crossConnectRqsModel.getChecksum()), t);
        }
        return effectivelyFinal;
    }

    public CrossConnectDo createAvailable(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        crossConnectDo = crossConnectDo
                .toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnCrossConnect).serialize())
                .groupId(UUID.randomUUID().toString())
                .state(State.PROVISIONED)
                .build();
        updateCrossConnectGroupOnCreate(t, crossConnectDo);
        return doCreate(t, crossConnectDo);
    }

    public CrossConnectDo createPending(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        crossConnectDo = crossConnectDo
                .toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnCrossConnect).serialize())
                .groupId(UUID.randomUUID().toString())
                .state(State.PENDING_CUSTOMER)
                .build();
        return doCreate(t, crossConnectDo);
    }

    public CrossConnectDo createProvisioning(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        crossConnectDo = crossConnectDo
                .toBuilder()
                .id(regionIdFactory.generate(EntityType.VpnCrossConnect).serialize())
                .groupId(UUID.randomUUID().toString())
