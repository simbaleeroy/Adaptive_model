export const getFilteredVCFromBulkResponse = (
  VirtualCircuitBulkRes: BulkQueryResponse<DEFINITION_CoreServicesApi_VirtualCircuit>,
  ListDrgAttachmentsBulkRes: BulkQueryResponse<DEFINITION_CoreServicesApi_DrgAttachment[]>,
) => {
  const VCsResponse = {
    response: {
      data:
        VirtualCircuitBulkRes?.aggregatedResults?.map(virtualCircuit => ({
          ...virtualCircuit,
          uiType: FastConnectType.VirtualCircuit,
        })) || [],
    },
    error: VirtualCircuitBulkRes?.error,
    loading: VirtualCircuitBulkRes?.loading || ListDrgAttachmentsBulkRes?.loading,
    refreshing: false,
  };
  return VCsResponse;
};

export const getVirtualCircuitList = (
  isRedundantVC: boolean,
  VirtualCircuitBulkRes: BulkQueryResponse<DEFINITION_CoreServicesApi_VirtualCircuit>,
  ListDrgAttachmentsBulkRes: BulkQueryResponse<DEFINITION_CoreServicesApi_DrgAttachment[]>,
  ListVirtualCircuits: typeof CoreServicesApi.ListVirtualCircuits.datasource,
  fastConnectId: string,
) => {
  if (isRedundantVC) {
    return getFilteredVCFromBulkResponse(VirtualCircuitBulkRes, ListDrgAttachmentsBulkRes);
  }
  return getVirtualCircuitsResponse(ListVirtualCircuits, fastConnectId);
};

export const getFilteredVirtualCircuitIds = (
  response: BulkQueryResponse<DEFINITION_CoreServicesApi_DrgAttachment[]>,
  id: string,
) => {
  const virtualCircuitIds = response?.aggregatedResults
    ?.flat()
    ?.filter(
      result =>
        result?.networkDetails?.type === FastConnectType.VirtualCircuit &&
        result?.networkDetails?.id !== id,
    )
    .map(res => res?.networkDetails?.id);
  return virtualCircuitIds;
};

export const getAssociatedVirtualCircuitPath = (
  fastConnectId: string,
  row: VirtualCircuit | CrossConnect | CrossConnectGroup,
  isRedundantVC: boolean,
  parentId?: string,
) => {
  /**
   * redundantVCFromCrossConnectGroupSubVC: redundant VirtualCircuit path from CrossConnectGroup subresource VirtualCircuit details subresource
   * redundantVCFromCrossConnectSubVC: redundant VirtualCircuit path from CrossConnect subresource VirtualCircuit details subresource
   * crossConnectGroupSubVC: VirtualCircuit path from CrossConnectGroup subresource
   * crossConnectSubVC: VirtualCircuit path from CrossConnect subresource
   * virtualCircuitSubVC: redundant VirtualCircuit from virtualCircuit subresourcedirectly
   * */
  const basePaths = {
    redundantVCFromCrossConnectGroupSubVC: `/networking/fast-connect/cross-connect-group/${parentId}/virtual-circuit/${row?.id}`,
    redundantVCFromCrossConnectSubVC: `/networking/fast-connect/cross-connect/${parentId}/virtual-circuit/${row?.id}`,
    crossConnectGroupSubVC: `/networking/fast-connect/cross-connect-group/${fastConnectId}/virtual-circuit/${row?.id}`,
    crossConnectSubVC: `/networking/fast-connect/cross-connect/${fastConnectId}/virtual-circuit/${row?.id}`,
    virtualCircuitSubVC: `/networking/fast-connect/virtual-circuit/${row?.id}`,
  };
  let path: string;

  if (isRedundantVC && parentId?.includes("crossconnectgroup")) {
    path = basePaths.redundantVCFromCrossConnectGroupSubVC;
  } else if (isRedundantVC && parentId?.includes("crossconnect")) {
    path = basePaths.redundantVCFromCrossConnectSubVC;
  } else if (fastConnectId?.includes("crossconnectgroup")) {
    path = basePaths.crossConnectGroupSubVC;
  } else if (fastConnectId?.includes("crossconnect")) {
    path = basePaths.crossConnectSubVC;
  } else {
    path = basePaths.virtualCircuitSubVC;
  }

  return path;
};

export const getAssociatedVirtualCircuitLink = (
  fastConnectId: string,
  row: VirtualCircuit | CrossConnect | CrossConnectGroup,
  $consoleState: ConsoleState,
  isRedundantVC: boolean,
  parentId?: string,
) => {
  const path = getAssociatedVirtualCircuitPath(fastConnectId, row, isRedundantVC, parentId);
  return getMakePluginUrl($consoleState, path);
};
