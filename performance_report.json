        private String changeTicket;
        private State state;
    }

    public enum State {
        PENDING_VERIFICATION,
        NE_VERIFIED,
        DEPLOYING,
        DEPLOYED,
        PREVIOUSLY_DEPLOYED,
        VERIFICATION_FAILED,
        DEPLOY_FAILED,
        ROLLBACK_IN_PROGRESS,
        ROLLED_BACK
    }
}


