export const getType2Body = (
  user: any,
  vcList: DEFINITION_CoreServicesApi_FastConnectProviderService[] = [],
) => {
  const formFields = user?.forms?.["intent.fast-connect.create.Step2"]?.$formFields;
  const { freeformTags, definedTags } = convertTags(formFields?.tags);

  const providerService = vcList.find(vc => vc.id === formFields?.providerServiceId);

  const res: any = {
    displayName: formFields?.displayName,
    compartmentId: formFields?.compartmentId,
    providerServiceId: formFields?.providerServiceId,
    type: formFields?.type,
    ipMtu: formFields?.ipMtu,
    isBfdEnabled: formFields?.isBfdEnabled,
    bandwidthShapeName: formFields?.bandwidthShapeName,
    customerAsn: formFields?.customerAsn,

    // Default: single mapping with all values
    crossConnectMappings: [
      {
        customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-0"],
        oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-0"],
        customerBgpPeeringIpv6: formFields?.["customerBgpPeeringIpv6-0"],
        oracleBgpPeeringIpv6: formFields?.["oracleBgpPeeringIpv6-0"],
        bgpMd5AuthKey: formFields?.["bgpMd5AuthKey-0"],
      },
    ],

    // Conditionally add PUBLIC props
    ...(formFields?.type === VCTypeEnum.Public && {
      publicPrefixes:
        formFields?.publicPrefixes !== "" ? [{ cidrBlock: formFields?.publicPrefixes }] : [],
      routingPolicy: [formFields?.routingPolicy],
    }),

    // Conditionally add PRIVATE props
    ...(formFields?.type === VCTypeEnum.Private && {
      isTransportMode: formFields?.isTransportMode === TransportTrafficType.ipsecTraffic,
      gatewayId: formFields?.gatewayId,
    }),

    freeformTags: freeformTags ?? {},
    definedTags: definedTags ?? {},
  };

  // Case: providerServiceKeyName
  if (shouldShowProviderServiceKeyInput(providerService)) {
    res.providerServiceKeyName = formFields?.providerServiceKeyName;
  }

  // Special case: provider with requiredTotalCrossConnects = 2
  if (providerService && hasTwoCrossConnects(providerService)) {
    res.crossConnectMappings = [
      {
        customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-0"],
        oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-0"],
      },
      {
        customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-1"],
        oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-1"],
      },
    ];
  }

  // Cleanup: remove any mapping where all values undefined
  if (res.crossConnectMappings?.length) {
    res.crossConnectMappings = res.crossConnectMappings.filter(
      (m: any) => !Object.values(m ?? {}).every(v => v === undefined),
    );

    if (res.crossConnectMappings.length === 0) {
      delete res.crossConnectMappings;
    }
  }

  return res;
};

