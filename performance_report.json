    @PUT
    @Path("/flexibleConfigGroups/{flexibleConfigGroupName}")
    @Timed(name = "updateFlexibleConfigGroup")
    @Consumes(MediaType.APPLICATION_JSON)
    @Produces(MediaType.APPLICATION_JSON)
    public Response updateFlexibleConfigGroup(@PrincipalContext Principal principal,
                                              @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
                                              @HeaderParam("opc-request-id") String opcRequestId,
                                              @NonNull @PathParam("flexibleConfigGroupName") String flexibleConfigGroupName,
                                              @Valid UpdateFlexibleConfigGroupRequest updateFlexibleConfigGroupRequest) throws Exception {

        if(authorizationRequest == null) {
            throw new ValidationException(ErrorCode.NotAuthenticated, "User is not authenticated to complete the update flexible config request.");
        }

        if (updateFlexibleConfigGroupRequest == null) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Update Flexible Config Group Request cannot be NULL.");
        }

        log.info("Received update request for Flexible Config Group: {}", flexibleConfigGroupName);

        //Ensure that at least 1 device is provided in the request
        if(updateFlexibleConfigGroupRequest.getDeviceIds() == null || updateFlexibleConfigGroupRequest.getDeviceIds().isEmpty()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "At least one device is required to update the Flexible Config Group: " + flexibleConfigGroupName);
        }

        //Ensure that not more than 100 devices are provided in the request
        if(updateFlexibleConfigGroupRequest.getDeviceIds().size() > 100) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Limit of 100 devices exceeded cannot update the Flexible Config Group: " + flexibleConfigGroupName);
        }

        //Ensure that the provided CHANGE ticket is valid
        validateChangeTicket(updateFlexibleConfigGroupRequest.getChangeTicket(), flexibleConfigGroupName);

        //Ensure that the provided Expiry Date is valid
        validateFlexibleConfigExpiryDateGreaterThanToday(updateFlexibleConfigGroupRequest.getExpiryDate(), flexibleConfigGroupName);

        //Ensure that the provided Devices is of type Juniper only
        validateFlexibleConfigDeviceType(flexibleConfigGroupName, updateFlexibleConfigGroupRequest.getDeviceIds());

        // Ensure the group exists
        List<ConfigSnippetDo> snippets = Optional.ofNullable(
                        configSnippetBl.listSnippetsForDeviceConfigGroupName(flexibleConfigGroupName, Optional.empty(), 1))
                .map(ScanPage::results).orElse(Collections.emptyList());

        if(snippets.isEmpty()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Flexible Config Group does not exist: " + flexibleConfigGroupName);
        }

        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = configSnippetBl.beginTransaction("update-flexible-config-group")) {

                Iterable<ConfigSnippetDo> snippetsForDeviceGroupName =
                        ScanAllIterable.fromPrefix(flexibleConfigGroupName, configSnippetBl::listSnippetsForDeviceConfigGroupName, 50);

                List<ConfigSnippetDo> configSnippetDoList = StreamSupport.stream(snippetsForDeviceGroupName.spliterator(), false)
                        .toList();

                if (configSnippetDoList.isEmpty()) {
                    throw new ValidationException(ErrorCode.InvalidParameter,
                            "No snippets found for Flexible Config Group: " + flexibleConfigGroupName);
                }

                log.info("Starting updating Flexible Config Group: {}", flexibleConfigGroupName);

                JuniperConfigHelper renderer = new JuniperConfigHelper();
                ConfigPair flexibleConfig = renderer.flexibleConfig(flexibleConfigGroupName, updateFlexibleConfigGroupRequest.getFlexibleConfigSnippet());
                Set<String> updatedDeviceIdSet = new HashSet<>(updateFlexibleConfigGroupRequest.getDeviceIds());
                int configUpdatedForDeviceCnt = 0;
                int configDeletedForDeviceCnt = 0;

                log.info("Device count {} received for flexible config update for Flexible Config Group {}", updatedDeviceIdSet.size(), flexibleConfigGroupName);

                for (ConfigSnippetDo configSnippetDo : configSnippetDoList) {
                    if(ConfigSnippetDo.State.PendingDelete.equals(configSnippetDo.getState())) {
                        throw new ValidationException(ErrorCode.InvalidParameter,
                                "Flexible Config Group already in PendingDelete State: " + flexibleConfigGroupName);
                    }
                    if(updatedDeviceIdSet.contains(configSnippetDo.getDeviceId())) {
                        configUpdatedForDeviceCnt++;
                        configSnippetDo = configSnippetBl.resetStatusFields(configSnippetDo.toBuilder(), ConfigSnippetDo.State.PendingUpdate)
                                .templateValues(flexibleConfig.getProperties())
                                .isActive(true)
                                .changeTicket(updateFlexibleConfigGroupRequest.getChangeTicket())
                                .expiryDate(updateFlexibleConfigGroupRequest.getExpiryDate())
                                .build();
                        configSnippetBl.update(t, configSnippetDo);
                        updatedDeviceIdSet.remove(configSnippetDo.getDeviceId());
                    } else {
                        configDeletedForDeviceCnt++;
                        configSnippetBl.markAsDeleting(t, configSnippetDo.getId(), updateFlexibleConfigGroupRequest.getChangeTicket());
                    }
                }

                log.info("Updated {} snippets as part of Update API for Flexible Config Group {}", configUpdatedForDeviceCnt, flexibleConfigGroupName);
                log.info("Deleted {} snippets as part of Update API for Flexible Config Group {}", configDeletedForDeviceCnt, flexibleConfigGroupName);

                log.info("Creating {} snippets as part of Update API for Flexible Config Group {}", updatedDeviceIdSet.size(), flexibleConfigGroupName);

                for (String deviceId: updatedDeviceIdSet) {
                    ConfigSnippetDo configSnippetDo = ConfigSnippetDo.builder()
                            .deviceId(deviceId)
                            .groupName(flexibleConfig.getGroupName())
                            .deviceConfigGroupName(flexibleConfigGroupName)
                            .referenceId(flexibleConfigGroupName + "_" + deviceId)
                            .templateValues(flexibleConfig.getProperties())
                            .templateName(flexibleConfig.getTemplateName())
                            .isActive(true)
                            .failed(false)
                            .changeTicket(updateFlexibleConfigGroupRequest.getChangeTicket())
                            .expiryDate(updateFlexibleConfigGroupRequest.getExpiryDate())
                            .build();
                    configSnippetBl.create(t, configSnippetDo);
                }

                log.info("Created {} snippets as part of Update API for Flexible Config Group {}", updatedDeviceIdSet.size(), flexibleConfigGroupName);

                t.commit();
                log.info("Successfully updated Flexible Config Group: {}", flexibleConfigGroupName);
            }

            return Response.status(Response.Status.ACCEPTED)
                    .entity(UpdateFlexibleConfigGroupResponse.builder()
                            .flexibleConfigGroupName(flexibleConfigGroupName)
                            .deviceIds(updateFlexibleConfigGroupRequest.getDeviceIds())
                            .flexibleConfigSnippet(updateFlexibleConfigGroupRequest.getFlexibleConfigSnippet())
                            .changeTicket(updateFlexibleConfigGroupRequest.getChangeTicket())
                            .expiryDate(updateFlexibleConfigGroupRequest.getExpiryDate())
                            .build())
                    .build();
        });
    }

    @DELETE
    @Path("/flexibleConfigGroups/{flexibleConfigGroupName}")
    @Timed(name = "deleteFlexibleConfigGroup")
    public Response deleteFlexibleConfigGroup(@PrincipalContext Principal principal,
                                              @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
                                              @HeaderParam("opc-request-id") String opcRequestId,
                                              @NonNull @PathParam("flexibleConfigGroupName") String flexibleConfigGroupName) throws Exception {

        if(authorizationRequest == null) {
            throw new ValidationException(ErrorCode.NotAuthenticated, "User is not authenticated to complete the delete flexible config request.");
        }

        log.info("Received delete request for Flexible Config Group: {}", flexibleConfigGroupName);

        // Ensure the group exists
        List<ConfigSnippetDo> snippets = Optional.ofNullable(
                configSnippetBl.listSnippetsForDeviceConfigGroupName(flexibleConfigGroupName, Optional.empty(), 1))
                .map(ScanPage::results).orElse(Collections.emptyList());

        if(snippets.isEmpty()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Flexible Config Group does not exist: " + flexibleConfigGroupName);
        }

        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = configSnippetBl.beginTransaction("delete-flexible-config-group")) {

                Iterable<ConfigSnippetDo> snippetsForDeviceGroupName =
                        ScanAllIterable.fromPrefix(flexibleConfigGroupName, configSnippetBl::listSnippetsForDeviceConfigGroupName, 50);

                List<ConfigSnippetDo> configSnippetDoList = StreamSupport.stream(snippetsForDeviceGroupName.spliterator(), false)
                        .toList();

                if (configSnippetDoList.isEmpty()) {
                    throw new ValidationException(ErrorCode.InvalidParameter,
                            "No snippets found for Flexible Config Group: " + flexibleConfigGroupName);
                }

                log.info("Deleting {} snippets for Flexible Config Group {}", configSnippetDoList.size(), flexibleConfigGroupName);

                for (ConfigSnippetDo configSnippetDo : configSnippetDoList) {
                    configSnippetBl.markAsDeleting(t, configSnippetDo.getId());
                }

                t.commit();
                log.info("Successfully deleted Flexible Config Group: {}", flexibleConfigGroupName);
            }

            return Response.status(Response.Status.ACCEPTED).build();
        });
    }

    public static ConfigSnippet toModel(ConfigSnippetDo configSnippetDo) {
        Map<String, Object> templateValues = configSnippetDo.getTemplateValues();
        String resultTemplateValues;
        try {
            resultTemplateValues = shahashTemplateValues(templateValues);
        } catch (IOException e) {
            throw new RenderableException(ErrorCode.InternalError,
                    "Cannot Parse Template Values for ConfigSnippet.", e);
        }
        return ConfigSnippet.builder()
                .id(configSnippetDo.getId())
                .state(ConfigSnippet.State.valueOf(configSnippetDo.getState().toString()))
                .stateComment(configSnippetDo.getStateComment())
                .deviceId(configSnippetDo.getDeviceId())
                .referenceId(configSnippetDo.getReferenceId())
                .templateName(configSnippetDo.getTemplateName())
                .groupName(configSnippetDo.getGroupName())
                .deviceConfigGroupName(configSnippetDo.getDeviceConfigGroupName())
                .templateValues(resultTemplateValues)
                .overrideTemplate(configSnippetDo.getOverrideTemplate())
                .isActive(configSnippetDo.getIsActive())
                .lastAttempt(configSnippetDo.getLastAttempt())
                .attempts(configSnippetDo.getAttempts())
                .failed(configSnippetDo.getFailed())
                .changeTicket(configSnippetDo.getChangeTicket())
                .expiryDate(configSnippetDo.getExpiryDate())
                .build();
    }

    //partial hash the template value whose key is tunnelPSK & bgpMd5AuthKey
    public static String shahashTemplateValues(Map<String, Object> templateValues) throws IOException {
        Arrays.stream(REDACTED_CONFIG_SNIPPET_TEMPLATE_KEY_VALUES).forEach(redactedKey -> {
            if (templateValues.containsKey(redactedKey)) {
                if (templateValues.get(redactedKey) != null) {
                    templateValues.put(redactedKey, shahashTemplateValue(templateValues.get(redactedKey)));
                }
            }
        });
        return ResourceUtils.stringifyMap(templateValues);
    }

    /**
     * return the last 6 digits of shahashed value given an object value
     * Note: in maxOS terminal, when check the shasum value, using: echo -n "replacesecretValuehere..." | shasum -a 1
     */
    private static String  shahashTemplateValue(Object value) {
        String partialHashedValue = DigestUtils.sha1Hex(value.toString());
        return HASHED_PARTIAL_STRING + " " + partialHashedValue.substring(partialHashedValue.length() - 6);
    }

    //
    // Management APIs for Count
    //

    boolean isUpdated(Object newValue) {
        return newValue != null && !newValue.toString().startsWith(HASHED_PARTIAL_STRING);
    }

    @VisibleForTesting
    Object encryptedValue(Object value) throws ValidationException {

        EncryptedRecord newEncryptedRecord;

        try {
            newEncryptedRecord = encryptionManager.encrypt(value.toString());
            return newEncryptedRecord.serialize();

        } catch (EncryptionException e) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Error encrypting record");
        }
    }

    @VisibleForTesting
    Map<String, Object> replaceRedactedValues(Map<String, Object> newValues, Map<String, Object> oldValues) throws ValidationException {
        for (String key : REDACTED_CONFIG_SNIPPET_TEMPLATE_KEY_VALUES) {
            if (newValues.containsKey(key)) {
                Object newUpdatedValue = isUpdated(newValues.get(key)) ? encryptedValue(newValues.get(key)) : oldValues.get(key);
                newValues.put(key, newUpdatedValue);
            }
        }
        return newValues;
    }

