      isRadiusAccountingEnabled:
        description: Whether to enable RADIUS accounting. When this enabled, accouting port becomes required filed.
        type: boolean
      isCaseSensitive:
        description: Enable case-sensitivity or not in RADIUS authentication.
        type: boolean

