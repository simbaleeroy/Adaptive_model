    public void validateNoVcInProvisioningOrTerminatingState(String ccOrCcgId) throws ValidationException {

        Set<String> vcIds = new HashSet<>();
        if (isCrossConnectGroup(ccOrCcgId)) {
            CrossConnectGroupDo ccgDo = crossConnectGroupBl.getOrThrow(ccOrCcgId);
            vcIds.addAll(ccgDo.getVcToVlanHelper().getAssociatedIds());
        } else {
            CrossConnectDo ccDo = crossConnectBl.getOrThrow(ccOrCcgId);
            vcIds.addAll(ccDo.getVcToVlanHelper().getAssociatedIds());
        }

        if (propertiesBl.isVcToVlanMappingEnabled()) {
            try (Transaction t = beginTransaction("get associated VC")) {
                vcIds.addAll(vcToVlanMappingBl.getAssociatedVcs(t, ccOrCcgId));
            }
        }

        log.info("Checking the state for VirtualCircuits {} attached to the cross-connect/group", vcIds, ccOrCcgId);

        for (String vcId : vcIds) {
            Optional<VirtualCircuitDo> vcDoOpt = get(vcId);
            if (vcDoOpt.isPresent()) {
                VirtualCircuitDo vcDo = vcDoOpt.get();
                if (vcDo.getState() == State.PROVISIONING ||
                        vcDo.getState() == State.TERMINATING) {
                    Validation.failCcUpdateVcInInvalidState(ccOrCcgId, vcId);
                }
            } else {
                log.info("VirtualCircuit {} attached to cross-connect/group {} not found, which is unexpected", vcId, ccOrCcgId);
            }
        }
    }

    public ScanPage<VirtualCircuitDo> scanForListByProviderCompartment(
            String providerCompartmentId,
            String displayName,
            int pageSize,
            Optional<PaginationToken> token,
            Optional<ScanParamHelper.SortBy> sortBy,
            Optional<ScanParamHelper.SortOrder> sortOrder) {

        ProvCompartmentIdNameDateKey key = ProvCompartmentIdNameDateKey.builder()
                .providerCompartmentId(providerCompartmentId)
                .displayName(displayName)
                .build();

        if (token.isPresent()) {

            Index<ProvCompartmentIdNameDateKey, VirtualCircuitDo> scanIndex =
                    super.bucket.getIndex(token.get().indexName(), ProvCompartmentIdNameDateKey.class);

            return scanIndex.scan(token.get(), pageSize);

        } else {

            Index<ProvCompartmentIdNameDateKey, VirtualCircuitDo> scanIndex =
                    getScanIndex(key, sortBy);

            Bucket.Direction sortDirection =
                    ScanParamHelper.getDirection(sortBy, sortOrder);

            return scanIndex.beginPrefixScan(key, pageSize, sortDirection);
        }
    }

    private static Map<String, Mapping> getExistingCrossConnectToBgpPeers(VirtualCircuitDo virtualCircuitDo) {
        List<Mapping> currentMappings = new ArrayList<>();
        if (virtualCircuitDo.getCrossConnectMapping() != null) {
            currentMappings = Arrays.asList(virtualCircuitDo.getCrossConnectMapping().getMappings());
        }
        Map<String, Mapping> crossConnectsToBgpSubnets = new HashMap<>();

        currentMappings.stream()
                .filter(m -> (m.getCrossConnectId() != null) && (m.getOracleBgpPeeringIp() != null))
                .forEach(m -> crossConnectsToBgpSubnets.put(m.getCrossConnectId(), m));
        return crossConnectsToBgpSubnets;
    }

    /**
     * For public virtual circuit, BGP peering addresses are allocated by service itself.
     * UpdatedVirtualCircuitDo will not have any BGP peering IP addresses.
     *
     * Current virtual circuit (if present) may have BGP peering IP addresses.
     * For mappings which have the same cross connect or cross connect group as the original mapping,
     * reuse the Oracle and Customer BGP addresses.
     *
     * For mappings which have different crossconnects than the original mappings, allocate new IP addresses.
     *
     * @param t kiev transaction
     * @param updatedVirtualCircuitDo updated virtual circuit
     * @param currentVirtualCircuitOpt current virtual circuit in database
     * @return updated virtual circuit with bgp ips allocated.
     * @throws ValidationException
     */
    public VirtualCircuitDo allocateBgpPeerIps(Transaction t, VirtualCircuitDo updatedVirtualCircuitDo, Optional<VirtualCircuitDo> currentVirtualCircuitOpt, boolean whitelistedForIpv6) throws ValidationException {
        CrossConnectMappings mappings = updatedVirtualCircuitDo.getCrossConnectMapping();

        if (!updatedVirtualCircuitDo.isPublic() || (mappings == null)) {
            return updatedVirtualCircuitDo;
        }

        Optional<ProviderServiceDo> providerServiceDo = Optional.empty();
        // If provider service id or provider name is valid, this is treated as a provider VC.
        if (StringUtils.isNotBlank(updatedVirtualCircuitDo.getProviderServiceId()) || StringUtils.isNotBlank(updatedVirtualCircuitDo.getProviderServiceName())) {
            if (StringUtils.isNotBlank(updatedVirtualCircuitDo.getProviderServiceId())) {
                providerServiceDo = providerServiceBl.get(updatedVirtualCircuitDo.getProviderServiceId());
            } else {
                providerServiceDo = providerServiceBl.getProviderServiceByNameAndServiceName(
                        updatedVirtualCircuitDo.getProviderName(), updatedVirtualCircuitDo.getProviderServiceName());
            }
        }

        Map<String, Mapping> existingCrossConnectToBgpPeers = new HashMap<>();
        if (currentVirtualCircuitOpt.isPresent()) {
            existingCrossConnectToBgpPeers = getExistingCrossConnectToBgpPeers(currentVirtualCircuitOpt.get());
        }

        List<Mapping> updatedMappings = new ArrayList<>();
        // Customer without provider or customer with L3 provider.
        if (!providerServiceDo.isPresent() || providerServiceDo.get().getType().equals(ProviderServiceDo.Type.Layer3)) {
            if (providerServiceDo.isPresent() && ProviderServiceDo.FastConnectDataManagement.ProviderManaged.equals(providerServiceDo.get().getPublicPeeringBgpMgmt())) {
                // Since Public BGP Peering addressese are ProviderManaged, this provider is allowed to give public BGP IPs for peering.
                // Verify that these /30 IPs belong to prevalidated list of BGP prefixes for this provider.

                List<String> verifiedPrefixes = Optional.ofNullable(providerServiceDo.get().getVerifiedPublicPrefixes()).orElse(new LinkedList<>());

                for (Mapping mapping : mappings.getMappings()) {

                    validateBgpIpsForProviderManagedPublicVc(mapping, verifiedPrefixes, updatedVirtualCircuitDo);
                    Mapping crossConnectMapping = Mapping.builder()
                            .bgpMd5Authkey(mapping.getBgpMd5Authkey())
                            .oracleBgpPeeringIp(mapping.getOracleBgpPeeringIp())
                            .remoteBgpPeeringIp(mapping.getRemoteBgpPeeringIp())
                            .vlan(mapping.getVlan())
                            .crossConnectId(mapping.getCrossConnectId())
                            .build();

                    if(whitelistedForIpv6) {
                        validateBgpIpsForProviderManagedPublicVcIpv6(mapping, verifiedPrefixes, updatedVirtualCircuitDo);
                        crossConnectMapping = crossConnectMapping.toBuilder()
                                .oracleBgpPeeringIpv6(mapping.getOracleBgpPeeringIpv6())
                                .remoteBgpPeeringIpv6(mapping.getRemoteBgpPeeringIpv6())
                                .build();
                    }
                    updatedMappings.add(crossConnectMapping);
                }


            } else {

                log.info("Allocating BGP peering IP addresses for virtual circuit {}.", updatedVirtualCircuitDo);
                if (currentVirtualCircuitOpt.isPresent()) {
                    log.info("Current virtual circuit {}.", currentVirtualCircuitOpt.get());
                }

                for (Mapping mapping : mappings.getMappings()) {
                    String oracleBgpPeeringIp = null;
                    String remoteBgpPeeringIp = null;
                    String oracleBgpPeeringIpv6 = null;
                    String remoteBgpPeeringIpv6 = null;
                    String mappingCcId = mapping.getCrossConnectId();
                    if (existingCrossConnectToBgpPeers.containsKey(mappingCcId)) {
                        Mapping existingMapping = existingCrossConnectToBgpPeers.get(mappingCcId);
                        oracleBgpPeeringIp = existingMapping.getOracleBgpPeeringIp();
                        remoteBgpPeeringIp = existingMapping.getRemoteBgpPeeringIp();
                        oracleBgpPeeringIpv6 = existingMapping.getOracleBgpPeeringIpv6();
                        remoteBgpPeeringIpv6 = existingMapping.getRemoteBgpPeeringIpv6();
                        log.info("Reusing IP addresses, local {} and remote {} for mapping {}", oracleBgpPeeringIp, remoteBgpPeeringIp, mapping);
                        log.info("Reusing IPv6 addresses, local {} and remote {} for mapping {}", oracleBgpPeeringIpv6, remoteBgpPeeringIpv6, mapping);

                    }

                    if (oracleBgpPeeringIp == null) {
                        Optional<String> prefix = vcBgpPeeringAddressManager.allocateBgpPeeringSubnetForPublicVirtualCircuit(t, updatedVirtualCircuitDo, false);
                        if (prefix.isPresent()) {
                            oracleBgpPeeringIp = IpUtils.getNextAddress(prefix.get(), 1);
                            remoteBgpPeeringIp = IpUtils.getNextAddress(prefix.get(), 2);
                            log.info("Allocating IP address subnet {} for BGP peering for mapping {}", prefix, mapping);
                        } else {
                            throw new ValidationException(ErrorCode.InternalError, String.format("Failed to allocated BGP IP address for %s.", updatedVirtualCircuitDo));
                        }
                    }

                    if (oracleBgpPeeringIpv6 == null) {
                        if (whitelistedForIpv6) {
                            Optional<String> ipv6Prefix = vcBgpPeeringAddressManager.allocateBgpPeeringSubnetForPublicVirtualCircuit(t, updatedVirtualCircuitDo, true);
                            if (ipv6Prefix.isPresent()) {
                                oracleBgpPeeringIpv6 = IpUtils.getNextIpV6Address(ipv6Prefix.get(), 1);
                                remoteBgpPeeringIpv6 = IpUtils.getNextIpV6Address(ipv6Prefix.get(), 2);
                                log.info("Allocating IPV6 address subnet {} for BGP peering for mapping {}", ipv6Prefix, mapping);
                            } else {
                                throw new ValidationException(ErrorCode.InternalError, String.format("Failed to allocated BGP IP address for %s.", updatedVirtualCircuitDo));
                            }
                        }
                    }

                    updatedMappings.add(CrossConnectMappings.Mapping.builder()
                            .bgpMd5Authkey(mapping.getBgpMd5Authkey())
                            .oracleBgpPeeringIp(oracleBgpPeeringIp)
                            .remoteBgpPeeringIp(remoteBgpPeeringIp)
                            .oracleBgpPeeringIpv6(oracleBgpPeeringIpv6)
                            .remoteBgpPeeringIpv6(remoteBgpPeeringIpv6)
                            .vlan(mapping.getVlan())
                            .crossConnectId(mapping.getCrossConnectId())
                            .build());
                }
            }
        } else {
            // For L2 public virtual circuits, there must be exactly one crossconnect mapping.
            // Since BGP addresses are assigned by service, vlan and crossconnect ids by provider,
            // the customer only owns the bgpMd5Authkey in the crossconnect mapping. It is possible that
            // customer create request may or may not have even 1 mapping. If no mapping is present, create one
            // and asssign BGP peering addresses. If one mapping is present use the same BGP peering address.
            Mapping mapping;

            if (mappings.getMappings().length > 1) {
                PublicValidation.failL2ProviderRequiresOneCrossConnect();
            }

            if (mappings.getMappings().length == 0) {
                mapping = Mapping.builder().build();
            } else {
                mapping = mappings.getMappings()[0];
            }
            String oracleBgpPeeringIp = null;
            String remoteBgpPeeringIp = null;
            String oracleBgpPeeringIpv6 = null;
            String remoteBgpPeeringIpv6 = null;
            // L2 provider virtual circuit has only 1 crossconnect mapping. Use existing BGP peering addresses if possible.
            if (currentVirtualCircuitOpt.isPresent() &&
                    currentVirtualCircuitOpt.get().getCrossConnectMapping() != null &&
                    currentVirtualCircuitOpt.get().getCrossConnectMapping().getMappings().length == 1) {

                    oracleBgpPeeringIp = currentVirtualCircuitOpt.get().getCrossConnectMapping().getMappings()[0].getOracleBgpPeeringIp();
                    remoteBgpPeeringIp = currentVirtualCircuitOpt.get().getCrossConnectMapping().getMappings()[0].getRemoteBgpPeeringIp();
            }

            if (oracleBgpPeeringIp == null) {
                Optional<String> prefix = vcBgpPeeringAddressManager.allocateBgpPeeringSubnetForPublicVirtualCircuit(t, updatedVirtualCircuitDo, false);
                if (prefix.isPresent()) {
                    oracleBgpPeeringIp = IpUtils.getNextAddress(prefix.get(), 1);
                    remoteBgpPeeringIp = IpUtils.getNextAddress(prefix.get(), 2);
                    log.info("Allocating IP address subnet {} for BGP peering for mapping {}", prefix, mapping);
                } else {
                    throw new ValidationException(ErrorCode.InternalError, String.format("Failed to allocated BGP IP address for %s.", updatedVirtualCircuitDo));
                }

                if (whitelistedForIpv6) {
                    Optional<String> ipv6Prefix = vcBgpPeeringAddressManager.allocateBgpPeeringSubnetForPublicVirtualCircuit(t, updatedVirtualCircuitDo, true);
                    if (ipv6Prefix.isPresent()) {
                        oracleBgpPeeringIpv6 = IpUtils.getNextIpV6Address(ipv6Prefix.get(), 1);
                        remoteBgpPeeringIpv6 = IpUtils.getNextIpV6Address(ipv6Prefix.get(), 2);
                        log.info("Allocating IPV6 address subnet {} for BGP peering for mapping {}", prefix, mapping);
                    } else {
                        throw new ValidationException(ErrorCode.InternalError, String.format("Failed to allocated BGP IP address for %s.", updatedVirtualCircuitDo));
                    }
                }
            }

            updatedMappings.add(CrossConnectMappings.Mapping.builder()
                    .bgpMd5Authkey(mapping.getBgpMd5Authkey())
                    .oracleBgpPeeringIp(oracleBgpPeeringIp)
                    .remoteBgpPeeringIp(remoteBgpPeeringIp)
                    .oracleBgpPeeringIpv6(oracleBgpPeeringIpv6)
                    .remoteBgpPeeringIpv6(remoteBgpPeeringIpv6)
                    .vlan(mapping.getVlan())
                    .crossConnectId(mapping.getCrossConnectId())
                    .build());
        }
        log.info("Updated mappings for virtual circuit {} after allocating BGP peering addresses : {}.", updatedVirtualCircuitDo.getId(), updatedMappings);

        return updatedVirtualCircuitDo.toBuilder()
                .crossConnectMapping(
                        CrossConnectMappings.builder()
                                .mappings(
                                        updatedMappings.toArray(new CrossConnectMappings.Mapping[0]))
                                .build())
                .build();

    }

    private void validateBgpIpsForProviderManagedPublicVcIpv6(Mapping mapping, List<String> verifiedPrefixes, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        if (mapping.getOracleBgpPeeringIpv6() == null) {
            return;
        }

        boolean bgpPeeringSubnetValid = false;
        String bgpPeeringSubnet = IpUtils.getNetworkAddress(mapping.getOracleBgpPeeringIpv6());

        for (String verifiedPrefix : verifiedPrefixes) {
            if (IpUtils.isSubset(verifiedPrefix, bgpPeeringSubnet)) {
                log.info("Public VC {} BGP Peering subnet {} is subset of verified prefix {}.", virtualCircuitDo.getId(), bgpPeeringSubnet, verifiedPrefix);
                bgpPeeringSubnetValid = true;
                break;
            }
        }

        if (!bgpPeeringSubnetValid) {
            String errMsg = String.format("Oracle BGP IP %s Customer BGP IP %s are not part of any verified public prefixes for the provider.",
                    mapping.getOracleBgpPeeringIpv6(), mapping.getRemoteBgpPeeringIpv6());
            log.error(errMsg);
            throw new ValidationException(ErrorCode.InvalidParameter, errMsg);
        }

        List<String> bgpSubnets = new LinkedList<>();
        getVirtualCircuitByProvCompartment(virtualCircuitDo.getProviderCompartmentId()).stream()
                .filter(VirtualCircuitDo::isPublic)
                .filter(vc -> ! vc.getId().equals(virtualCircuitDo.getId()))
                .map(VirtualCircuitDo::getOracleBgpIpv6Networks)
                .filter(s -> !s.isEmpty())
                .forEach(bgpSubnets::addAll);

        for (String bgpSubnet : bgpSubnets) {
            if (IpUtils.isOverlap(bgpSubnet, bgpPeeringSubnet)) {
                PublicValidation.failIpNetworkAlreadyInUseOnOtherPublicVc(bgpPeeringSubnet);
            }
        }

    }

    private void validateBgpIpsForProviderManagedPublicVc(Mapping mapping, List<String> verifiedPrefixes, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        if (mapping.getOracleBgpPeeringIp() == null) {
            return;
        }

        boolean bgpPeeringSubnetValid = false;
        String bgpPeeringSubnet = IpUtils.getNetworkAddress(mapping.getOracleBgpPeeringIp());

        for (String verifiedPrefix : verifiedPrefixes) {
            if (IpUtils.isSubset(verifiedPrefix, bgpPeeringSubnet)) {
                log.info("Public VC {} BGP Peering subnet {} is subset of verified prefix {}.", virtualCircuitDo.getId(), bgpPeeringSubnet, verifiedPrefix);
                bgpPeeringSubnetValid = true;
                break;
            }
        }

        if (!bgpPeeringSubnetValid) {
            String errMsg = String.format("Oracle BGP IP %s Customer BGP IP %s are not part of any verified public prefixes for the provider.",
                    mapping.getOracleBgpPeeringIp(), mapping.getRemoteBgpPeeringIp());
            log.error(errMsg);
            throw new ValidationException(ErrorCode.InvalidParameter, errMsg);
        }

        List<String> bgpSubnets = new LinkedList<>();

        getVirtualCircuitByProvCompartment(virtualCircuitDo.getProviderCompartmentId()).stream()
                .filter(VirtualCircuitDo::isPublic)
                .filter(vc -> ! vc.getId().equals(virtualCircuitDo.getId()))
                .map(VirtualCircuitDo::getOracleBgpIpv4Networks)
                .filter(s -> !s.isEmpty())
                .forEach(bgpSubnets::addAll);

        for (String bgpSubnet : bgpSubnets) {
            if (IpUtils.isOverlap(bgpSubnet, bgpPeeringSubnet)) {
                PublicValidation.failIpNetworkAlreadyInUseOnOtherPublicVc(bgpPeeringSubnet);
            }
        }

    }


    /**
     * Release all the BGP Peering Ip addresses back to pool.
     * @param t kiev transaction
     * @param virtualCircuitDo virtual circuit whose BGP peer IPs are to be released.
     * @return virtual circuit
     * @throws ValidationException
     */
    public VirtualCircuitDo releaseBgpPeerIps(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        if (!virtualCircuitDo.isPublic()) {
            return virtualCircuitDo;
        }

        Optional<ProviderServiceDo> providerServiceDoOpt = providerServiceBl.getProviderServiceFromVirtualCircuit(virtualCircuitDo);
        if (providerServiceDoOpt.isPresent() && ProviderServiceDo.FastConnectDataManagement.ProviderManaged.equals(providerServiceDoOpt.get().getPublicPeeringBgpMgmt())) {
            log.info("Public BGP address for VC {} is managed by provider. Oracle doesn't allocated BGP IPs hence no need to release them.", virtualCircuitDo.getId());
            return virtualCircuitDo;
        }

        CrossConnectMappings mappings = virtualCircuitDo.getCrossConnectMapping();
        if (mappings == null) {
            return virtualCircuitDo;
        }

        // Releases all BGP peering subnets currently assigned to virtual circuits.
        log.info("Releasing allocated BGP peer IPs for virtual circuit {}.", virtualCircuitDo);
        List<String> allocatedBgpSubnets =  vcBgpPeeringAddressManager.getAssignedBgpPeeringSubnetsForPublicVirtualCircuit(virtualCircuitDo);
        for (String bgpSubnet : allocatedBgpSubnets) {
            vcBgpPeeringAddressManager.releaseBgpPeeringSubnetForPublicVirtualCircuit(t, virtualCircuitDo, bgpSubnet);
            log.info("Released BGP Peering subnet {} belonging to virtual circuit {}.", bgpSubnet, virtualCircuitDo.getId());
        }

        List<Mapping> updatedMappings = new ArrayList<>();
        for (Mapping mapping : mappings.getMappings()) {
            updatedMappings.add(mapping.toBuilder()
                    .oracleBgpPeeringIp(null)
                    .remoteBgpPeeringIp(null)
                    .build());
        }

        return virtualCircuitDo.toBuilder()
                .crossConnectMapping(
                        CrossConnectMappings.builder()
                                .mappings(
                                        updatedMappings.toArray(new CrossConnectMappings.Mapping[0]))
                                .build())
                .build();

    }

    /**
     * Release BGP peering subnets which are no longer being used by the virtual circuit.
     *
     * In cases where BGP peering subnets for crossconnect mappings are managed by the service,
     * updating a crossconnect mapping could result in a new bgp subnet allocation and the bgp subnet
     * allocated to the old mapping is no longer used and needs to be released back to the pool.
     *
     * VirtualCircuitDo will have the most updated bgp prefixes. All the currenlty assigned prefixes
     * are retrieved from the IP_PREFIX db.
     *
     * @param t kiev transaction
     * @param virtualCircuitDo virtual circuit
     * @throws ValidationException
     */
    public void releaseUnusedBgpPeeringSubnets(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        if (!virtualCircuitDo.isPublic()) {
            return;
        }

        Optional<ProviderServiceDo> providerServiceDoOpt = providerServiceBl.getProviderServiceFromVirtualCircuit(virtualCircuitDo);
        if (providerServiceDoOpt.isPresent() && ProviderServiceDo.FastConnectDataManagement.ProviderManaged.equals(providerServiceDoOpt.get().getPublicPeeringBgpMgmt())) {
            log.info("Public BGP address for VC {} is managed by provider. Oracle doesn't allocated BGP IPs hence no need to release them.", virtualCircuitDo.getId());
            return;
        }

        List<String> currentBgpPeeringSubnets = virtualCircuitDo.getOracleBgpIpv4Networks().stream()
                .collect(Collectors.toList());

        List<String> currentBgpPeeringSubnetsIpv6 = virtualCircuitDo.getOracleBgpIpv6Networks().stream()
                .collect(Collectors.toList());

        log.info("Current BGP subnets for virtual circuit {} : {}.", virtualCircuitDo.getId(), currentBgpPeeringSubnets);
        log.info("Current ipv6 BGP subnets for virtual circuit {} : {}.", virtualCircuitDo.getId(), currentBgpPeeringSubnetsIpv6);

        List<String> allocatedBgpSubnets =  vcBgpPeeringAddressManager.getAssignedBgpPeeringSubnetsForPublicVirtualCircuit(virtualCircuitDo);

        log.info("All allocated BGP subnets for virtual circuit : {}", allocatedBgpSubnets);

        // Release all allocated IPs which are not current BGP peeering subnets.
        List<String> subnetsToRelease = allocatedBgpSubnets.stream()
                .filter(subnet -> !currentBgpPeeringSubnets.contains(subnet))
                .filter(subnet -> !currentBgpPeeringSubnetsIpv6.contains(subnet))
                .collect(Collectors.toList());

        if (subnetsToRelease.isEmpty()) {
            log.info("No change in BGP subnets for virtualcircuit {}.", virtualCircuitDo.getId());
            return;
        } else {
            log.info("Releasing BGP subnets for virtual circuit : {}", subnetsToRelease);
        }

        for (String bgpSubnet : subnetsToRelease) {
            vcBgpPeeringAddressManager.releaseBgpPeeringSubnetForPublicVirtualCircuit(t, virtualCircuitDo, bgpSubnet);
        }

    }

    /*
     * Finds the correct index to use based on what fields are populated in the
     * index key and an optional sortBy parameter.
     * @param indexKey a key populated with the fields you want to scan with
     * @Param sortBy
     * @return the correct index to scan
     */
    private Index<ProvCompartmentIdNameDateKey, VirtualCircuitDo> getScanIndex(
            ProvCompartmentIdNameDateKey indexKey,
            Optional<ScanParamHelper.SortBy> sortBy) {

        if (sortBy.isPresent() &&
                sortBy.get() == ScanParamHelper.SortBy.TIME_CREATED &&
                indexKey.getDisplayName() == null) {
            return provCompIdDateIndex;
        }

        return provCompIdNameDateIndex;
    }

    /*Function to check if the SvlanNumber is leaked by providing the mappings of the VC*/
    public boolean isSvlanNumberLeaked(Transaction t, int sVlanNumber, Mapping[] mappings) throws ValidationException {

        if (mappings== null || mappings.length < 2){
            return false;
        }
        Set<String> pFabClusterIds = new HashSet<>();
        for (Mapping mapping : mappings){
            Optional<CrossConnectDo>  optionalCrossConnectDo = crossConnectBl.get(t,mapping.getCrossConnectId());
            if (optionalCrossConnectDo.isPresent()){
                String deviceId = optionalCrossConnectDo.get().getDeviceId();
                Optional<DeviceDo> optionalDeviceDo = deviceBl.get(t,deviceId);
                if (optionalDeviceDo.isPresent()) {
                    pFabClusterIds.add(optionalDeviceDo.get().getPFabClusterId());
                }

            }

        }

        List<VirtualCircuitDo> virtualCircuitDos= new ArrayList<>();
        for  (String pFabClusterId: pFabClusterIds){
            VirtualCircuitDo.SVlanAndPFabClusterIdKey key = VirtualCircuitDo.SVlanAndPFabClusterIdKey.builder()
                    .sVlanNumberForQfx(sVlanNumber)
                    .pFabClusterId(pFabClusterId)
                    .build();
            List<VirtualCircuitDo> tempVirtualCircuitDos = vcSVlanAndPFabClusterIdIndex.get(t, key, 1);
            if(!tempVirtualCircuitDos.isEmpty()){
                virtualCircuitDos.addAll(tempVirtualCircuitDos) ;
            }
        }

        if (!virtualCircuitDos.isEmpty() && virtualCircuitDos.size() > 1){
            return true;
        }
        return false;
    }
    private boolean checkUnitNumberLeak(List<VirtualCircuitDo> virtualCircuitDos, String originalPfabClusterId, Transaction t) throws ValidationException {
        if (!virtualCircuitDos.isEmpty()) {
            for (VirtualCircuitDo virtualCircuitDo : virtualCircuitDos) {
                CrossConnectMappings crossConnectMappings = virtualCircuitDo.getCrossConnectMapping();
                if (crossConnectMappings == null || crossConnectMappings.getMappings().length < 1) {
                    continue;
                }

                for (Mapping mapping : crossConnectMappings.getMappings()) {
                    boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
                    CrossConnectDo crossConnectDo;
                    // get device
                    if (isCrossConnect) {
                        crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
                    } else {
                        CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                        crossConnectDo = crossConnectBl.getOrThrow(crossConnectGroupDo.getCrossConnectIds()[0]);
                    }
                    String deviceId = crossConnectDo.getDeviceId();
                    Optional<DeviceDo> deviceDo = deviceBl.get(t, deviceId);

                    if (deviceDo.isPresent()) {
                        if (deviceDo.get().getPFabClusterId().equals(originalPfabClusterId)) {
                            return true;
                        }
                    }

                }

            }
        }
        return false;
    }


    /*Function to check if the SvlanNumber is leaked by providing the original pfabcluster on which VC is getting created*/
    public boolean isSvlanNumberLeaked(Transaction t, int sVlanNumber, String originalPfabClusterId) throws ValidationException{
        Set<String> pfabClusterIds = deviceBl.getAllPfabClusterIds();
        for (String pFabClusterId: pfabClusterIds) {
            List<VirtualCircuitDo> virtualCircuitDos = getVirtualCircuitListBySVlanAndPFabClusterId(t, sVlanNumber, pFabClusterId);
            if (checkUnitNumberLeak(virtualCircuitDos, originalPfabClusterId, t)) {
                return true;
            }
        }

        return false;
    }

    /*Function to check if the VcUnitNumber is leaked by providing the mappings of the VC*/
    public boolean isVcUnitNumberLeaked(Transaction t,Integer vcUnitNumberForQfx, Mapping[] mappings, boolean isUnitNumberFixEnabled, String originalVirtualCircuitId) throws ValidationException {
        if (mappings==null || !isUnitNumberFixEnabled){
            return false;
        }
        Set<DeviceDo> deviceDos = new HashSet<>();
        for (Mapping mapping : mappings){
            Optional<CrossConnectDo>  optionalCrossConnectDo = crossConnectBl.get(t,mapping.getCrossConnectId());
            if (optionalCrossConnectDo.isPresent()){
                String deviceId = optionalCrossConnectDo.get().getDeviceId();
                Optional<DeviceDo> optionalDeviceDo = deviceBl.get(t,deviceId);
                if (optionalDeviceDo.isPresent()) {
                    deviceDos.add(optionalDeviceDo.get());
                }

            }

        }
        for  (DeviceDo deviceDo: deviceDos){
            String pFabClusterId = deviceDo.getPFabClusterId();
            if (this.isVcUnitNumberLeaked(t, vcUnitNumberForQfx, pFabClusterId, originalVirtualCircuitId)) {
                return true;
            }
        }
        return false;
    }

    /*Function to check if the VcUnitNumber is leaked by providing the original pfabcluster on which VC is getting created*/
    public boolean isVcUnitNumberLeaked(Transaction t, int vcUnitNumberForQfx,String originalPfabClusterId, String originalVirtualVircuitId) throws ValidationException {

        //Get All PfabClusterIds in the region
        Set<String> pfabClusterIds= deviceBl.getAllPfabClusterIds();
        List<VirtualCircuitDo> virtualCircuitDos;

        for (String pFabClusterId: pfabClusterIds){
            VirtualCircuitDo.VcUnitNumberForQfxAndPFabClusterIdKey key = VirtualCircuitDo.VcUnitNumberForQfxAndPFabClusterIdKey.builder()
                    .vcUnitNumberForQfx(vcUnitNumberForQfx)
                    .pFabClusterId(pFabClusterId)
                    .build();
            virtualCircuitDos = vcUnitNumberForQfxAndPFabClusterIdIndex.get(t, key,1)
                .stream().filter(vc -> !vc.getId().equals(originalVirtualVircuitId))
                .collect(Collectors.toList());
            if (checkUnitNumberLeak(virtualCircuitDos, originalPfabClusterId, t)) {
                return true;
            }
        }
        return false;
    }


    /**
     * @return The virtual circuit DO with the given vcUnitNumberForQfx and pfabclusterid.
     */
    public Optional<VirtualCircuitDo> getVirtualCircuitByVcUnitNumberForQfxAndPFabClusterId(Transaction t, int vcUnitNumberForQfx, String pFabClusterId) {

        VirtualCircuitDo.VcUnitNumberForQfxAndPFabClusterIdKey key = VirtualCircuitDo.VcUnitNumberForQfxAndPFabClusterIdKey.builder()
                .vcUnitNumberForQfx(vcUnitNumberForQfx)
                .pFabClusterId(pFabClusterId)
                .build();
        List<VirtualCircuitDo> list = vcUnitNumberForQfxAndPFabClusterIdIndex.get(t, key,1);
        if (list == null || list.size() == 0) {
            return Optional.empty();
        }
        else {
            return Optional.of(list.get(0));
        }
    }

