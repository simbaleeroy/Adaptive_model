    @Test
    public void GIVEN_createDrgV2Attachment_WHEN_vcTransportModeIsSet_THEN_attachmentCreatedisAlsoTransportModeOnly() throws Exception {

        VirtualCircuitDo virtualCircuitDo = generateVirtualCircuitDo(VirtualCircuitDo.IpAddressType.PRIVATE, null, null);

        try (Transaction t = virtualCircuitBl.beginTransaction("update-vc")) {
            virtualCircuitDo = virtualCircuitBl.update(t, virtualCircuitBl.getOrThrow(t, virtualCircuitDo.getId()).toBuilder()
                            .enforceEncryptedTraffic(true)
                            .gatewayType(VirtualCircuitDo.GatewayType.DRG_V2)
                            .build());
            t.commit();
        }

        mockCreateC3DrgAttachment(virtualCircuitDo);
        // Mock PNP call for 404 on Get after deletion
        when(virtualNetworkClient.getC3DrgAttachment(any())).thenThrow(new BmcException(404, "", "", ""));
        when(featureController.isTenancyWhitelisted(any(), any())).thenReturn(true);

        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            createVcDrgV2AttachmentWorkflow.createDrgV2Attachment(null, t, null, virtualCircuitDo);
            t.commit();
        }

        // deleted old DrgV2Attachment and created new Attachment
        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
            assertThat(drgV2AttachmentBl.listByAttachedResourceId(t,virtualCircuitDo.getId()).size()).isEqualTo(1);
            DrgV2AttachmentDo drgV2AttachmentDo = drgV2AttachmentBl.listByAttachedResourceId(t,virtualCircuitDo.getId()).get(0);
            assertThat(drgV2AttachmentDo.getMplsLabel()).isEqualTo(TEST_MPLS_LABEL_2);
            assertThat(drgV2AttachmentDo.getId()).isEqualTo(TEST_EXISTING_DRG_ATTACHMENT_ID_2);
            assertThat(drgV2AttachmentDo.getImportEPRouteTarget()).isEqualTo(TEST_IMPORT_RT_2);
            assertThat(drgV2AttachmentDo.getExportEPRouteTarget()).isEqualTo(TEST_EXPORT_RT_2);
            assertThat(drgV2AttachmentDo.getDrgId()).isEqualTo(virtualCircuitDo.getGatewayId());
        }
    }

    private void mockGetC3DrgAttachment() {
        ArgumentMatcher<GetC3DrgAttachmentRequest> matcher1 = DrgV2TestMockHelper.getC3DrgAttachmentRequestMatcher(TEST_EXISTING_DRG_ATTACHMENT_ID);
        when(virtualNetworkClient.getC3DrgAttachment(argThat(matcher1))).thenReturn(
                GetC3DrgAttachmentResponse.builder()
                        .drgAttachment(DrgAttachment.builder()
                                .compartmentId(TEST_ORIGINAL_COMPARTMENT_ID)
                                .id(TEST_EXISTING_DRG_ATTACHMENT_ID)
                                .build())
                        .build());

        matcher1 = DrgV2TestMockHelper.getC3DrgAttachmentRequestMatcher(TEST_NON_EXISTING_DRG_ATTACHMENT_ID);
        when(virtualNetworkClient.getC3DrgAttachment(argThat(matcher1)))
                .thenThrow(new BmcException(404, "test service code", "Not found", "testOpcRequestId"));
        matcher1 = DrgV2TestMockHelper.getC3DrgAttachmentRequestMatcher(TEST_RETRY_DRG_ATTACHMENT_ID);
        when(virtualNetworkClient.getC3DrgAttachment(argThat(matcher1)))
                .thenThrow(new BmcException(409, "test service code", "Conflict", "testOpcRequestId"));
        matcher1 = DrgV2TestMockHelper.getC3DrgAttachmentRequestMatcher(TEST_INTERNAL_ERROR_ATTACHMENT_ID);
        when(virtualNetworkClient.getC3DrgAttachment(argThat(matcher1)))
                .thenThrow(new BmcException(502, "test service code", "InternalError", "testOpcRequestId"));
    }

    private void mockCreateC3DrgAttachment() {
        CreateC3DrgAttachmentRequest rpcRequest = CreateC3DrgAttachmentRequest.builder()
                .createDrgAttachmentDetails(CreateDrgAttachmentDetails.builder()
                        .networkDetails(RemotePeeringConnectionDrgAttachmentNetworkCreateDetails.builder()
                                .id(TEST_EXISTING_RPC_ID)
                                .build())
                        .build())
                .build();
        ArgumentMatcher<CreateC3DrgAttachmentRequest> matcher3 = DrgV2TestMockHelper.createC3DrgAttachmentRequestMatcher(rpcRequest);
        when(virtualNetworkClient.createC3DrgAttachment(argThat(matcher3)))
                .thenReturn(CreateC3DrgAttachmentResponse.builder()
                        .drgAttachment(DrgAttachment.builder()
                                .compartmentId(TEST_ORIGINAL_COMPARTMENT_ID)
                                .id(TEST_EXISTING_DRG_ATTACHMENT_ID)
                                .networkDetails(RemotePeeringConnectionDrgAttachmentNetworkDetails.builder()
                                        .mplsLabel(Integer.valueOf(TEST_MPLS_LABEL))
                                        .exportRouteTarget(TEST_EXPORT_RT)
                                        .importRouteTarget(TEST_IMPORT_RT)
                                        .build())
                                .build())
                        .opcRequestId(TEST_OPC_REQUEST_ID)
                        .build());


        CreateC3DrgAttachmentRequest vcRequest = CreateC3DrgAttachmentRequest.builder()
                .createDrgAttachmentDetails(CreateDrgAttachmentDetails.builder()
                        .networkDetails(VirtualCircuitDrgAttachmentNetworkCreateDetails.builder()
                                .id(TEST_EXISTING_VC_ID)
                                .build())
                        .build())
                .build();
        matcher3 = DrgV2TestMockHelper.createC3DrgAttachmentRequestMatcher(vcRequest);
        when(virtualNetworkClient.createC3DrgAttachment(argThat(matcher3)))
                .thenReturn(CreateC3DrgAttachmentResponse.builder()
                        .drgAttachment(DrgAttachment.builder()
                                .compartmentId(TEST_ORIGINAL_COMPARTMENT_ID)
                                .id(TEST_EXISTING_DRG_ATTACHMENT_ID)
                                .networkDetails(VirtualCircuitDrgAttachmentNetworkDetails.builder()
                                        .mplsLabel(Integer.valueOf(TEST_MPLS_LABEL))
                                        .exportRouteTarget(TEST_EXPORT_RT)
                                        .importRouteTarget(TEST_IMPORT_RT)
                                        .isEdgePop(false)
                                        .build())
                                .build())
                        .build());
    }

