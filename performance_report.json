public Response exportTenancyData(@PathParam("tenancyId") String tenancyId) throws ValidationException {
    Validation.OCIDValidate(tenancyId);

    javax.ws.rs.core.StreamingOutput stream = (output) -> {
        com.fasterxml.jackson.core.JsonGenerator gen = null;
        try {
            gen = mapper.getFactory().createGenerator(output, com.fasterxml.jackson.core.JsonEncoding.UTF8);
            gen.writeStartObject();

            // predicate: checks tenantId then falls back to compartment resolution
            java.util.function.Predicate<Object> belongsToTenancy = (obj) -> {
                try {
                    if (obj == null)
                        return false;
                    // Try tenantId getter
                    try {
                        java.lang.reflect.Method m = obj.getClass().getMethod("getTenantId");
                        Object objTenantId = m.invoke(obj);
                        if (objTenantId != null)
                            return tenancyId.equals(objTenantId.toString());
                    } catch (NoSuchMethodException ignore) {}
                    
                    // Try compartmentId getter
                    try {
                        java.lang.reflect.Method mc = obj.getClass().getMethod("getCompartmentId");
                        Object compartmentId = mc.invoke(obj);
                        if (compartmentId != null) {
                            String resolved = identityHelper.getTenantId(compartmentId.toString());
                            return tenancyId.equals(resolved);
                        }
                    } catch (NoSuchMethodException ignore) {}
                    
                } catch (Exception e) {
                    log.warn("Failed tenancy check for object {}", obj, e);
                }
                return false;
            };

            // directly fetch and write each resource type

            gen.writeStringField("tenancyName", getTenancyName(tenancyId));
            gen.writeStringField("homeRegion", getHomeRegion(tenancyId));
            gen.writeStringField("tenancyOcid", tenancyId);

            // CrossConnects
            gen.writeFieldName("crossConnects");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen = gen;
                crossConnectBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen, item);
                            } catch (Exception e) {
                                log.warn("Failed to write crossConnect item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get crossConnects list", e);
            }
            gen.writeEndArray();

            // CrossConnectGroups
            gen.writeFieldName("crossConnectGroups");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen1 = gen;
                crossConnectGroupBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen1, item);
                            } catch (Exception e) {
                                log.warn("Failed to write crossConnectGroup item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get crossConnectGroups list", e);
            }
            gen.writeEndArray();

            // VirtualCircuits
            gen.writeFieldName("virtualCircuits");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen2 = gen;
                virtualCircuitBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen2, item);
                            } catch (Exception e) {
                                log.warn("Failed to write virtualCircuit item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get virtualCircuits list", e);
            }
            gen.writeEndArray();

            // IPsec Connections
            gen.writeFieldName("ipsecConnections");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen3 = gen;
                iPsecConnectionBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen3, item);
                            } catch (Exception e) {
                                log.warn("Failed to write iPsecConnection item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get ipsecConnections list", e);
            }
            gen.writeEndArray();

            // Remote Peering Connections
            gen.writeFieldName("remotePeeringConnections");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen4 = gen;
                remotePeeringConnectionBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen4, item);
                            } catch (Exception e) {
                                log.warn("Failed to write remotePeeringConnection item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get remotePeeringConnections list", e);
            }
            gen.writeEndArray();

            // Tunnels
            gen.writeFieldName("tunnels");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen5 = gen;
                tunnelBl.stream()
                        .filter(item -> item != null && belongsToTenancy.test(item))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen5, item);
                            } catch (Exception e) {
                                log.warn("Failed to write tunnel item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get tunnels list", e);
            }
            gen.writeEndArray();

            // Devices
            gen.writeFieldName("devices");
            gen.writeStartArray();
            try {
                com.fasterxml.jackson.core.JsonGenerator finalGen6 = gen;
                deviceBl.stream()
                        .filter(item -> item != null )
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen6, item);
                            } catch (Exception e) {
                                log.warn("Failed to write device item", e);
                            }
                        });
            } catch (Exception e) {
                log.warn("Failed to get devices list", e);
            }
            gen.writeEndArray();

            // tenancy metadata
            gen.writeFieldName("tenancyMetadata");
            try {
                mapper.writeValue(gen, tenancyMetadataBl.get(tenancyId).orElse(null));
            } catch (Exception e) {
                log.warn("Failed to get tenancy metadata for tenancyId: {}", tenancyId, e);
                gen.writeNull();
            }

            gen.writeEndObject();
            gen.flush();
        } catch (IOException e) {
            throw new RuntimeException(e);
        } finally {
            if (gen != null)
                try {
                    gen.close();
                } catch (IOException ignored) {
                }
        }
    };

    return Response.ok(stream).type(javax.ws.rs.core.MediaType.APPLICATION_JSON).build();
}
