    @VisibleForTesting
    boolean isRouteDistinguisherInUse(Transaction t, String routeDistinguisher) {
        List<VirtualCircuitDo> listVC = routeDistinguisherIndex.get(t, routeDistinguisher, 1);
        return !listVC.isEmpty();
    }

    public boolean isLabelAllocated(Transaction t, String labelSpaceId, int label) {
        return isRouteDistinguisherInUse(t,  String.format("%s:%s", labelSpaceId, label));
    }

    public VirtualCircuitDo setRouteDistinguisherIfNeeded(Transaction t, String anyCastSetIp, String anyCastSetId, VirtualCircuitDo virtualCircuitDo)
            throws ValidationException {

        if (virtualCircuitDo.getRouteDistinguisher() != null) {
            log.info("setRouteDistinguisherIfNeeded: VirtualCircuit {} already has RD {}, no op",
                    virtualCircuitDo.getId(), virtualCircuitDo.getRouteDistinguisher());

            return virtualCircuitDo;
        }

        Optional<Integer> mplsTableLabelOpt = mplsTableLabelManager.get().findUniqueMplsLabelPerLabelSpaceId(t, anyCastSetIp, anyCastSetId);

        if (mplsTableLabelOpt.isPresent()) {
            String routeDistinguisher = String.format("%s:%s", anyCastSetId, mplsTableLabelOpt.get());
            return update(t, virtualCircuitDo.toBuilder().routeDistinguisher(routeDistinguisher).build());
        } else {
            // Supposedly, this will only happen if the allocated 16K DRG range is nearly used up,
            // which is close to impossible
            log.error("Cannot find an unused routeDistinguisher after maximum retries, VC: {}",
                    virtualCircuitDo.getId());
            throw new ValidationException(ErrorCode.QuotaExceeded,
                    "Cannot find an unused routeDistinguisher after maximum retries, VC: ",
                    virtualCircuitDo.getId());
        }
    }

    // If Ecmp is turned off, remove rd to avoid hoarding vtNumber resources
    public VirtualCircuitDo removeRouteDistinguisherIfNeeded(VirtualCircuitDo virtualCircuitDo)
            throws ValidationException {

        if (virtualCircuitDo.getRouteDistinguisher() == null) {
            return virtualCircuitDo;
        } else {
            return virtualCircuitDo.toBuilder().routeDistinguisher(null).build();
        }
    }

    // assign and set an unitNumber for the specified VC
    public UnitNumberDo assignAndSetOrGetUnitNumberForVC(Transaction t, VirtualCircuitDo virtualCircuitDo, String deviceId)
            throws ValidationException {

        UnitNumberDo unitNumberDo = unitNumberBl.assignAndSetOrGetUnitNumber(
                t, virtualCircuitDo.getGatewayId(), virtualCircuitDo.getId(), deviceId, virtualCircuitDo.isDrgV2());

        if(!virtualCircuitDo.getGatewayId().equals(unitNumberDo.getDrgId())) {
            List<UnitNumberDo> vcUnitNumbers = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitDo.getId()).stream()
                    .filter(unitNumber -> unitNumber.getDeviceId().equals(deviceId)).collect(Collectors.toList());
            for (UnitNumberDo unitNumber: vcUnitNumbers) {
                unitNumberBl.delete(t, unitNumber);
            }
            unitNumberDo = unitNumberBl.assignAndSetOrGetUnitNumber(
                    t, virtualCircuitDo.getGatewayId(), virtualCircuitDo.getId(), deviceId, virtualCircuitDo.isDrgV2());
        }

        log.info("Assigned and set unitNumber for VirtualCircuitDo {} with deviceId {} to {}",
                virtualCircuitDo.getId(),
                deviceId,
                unitNumberDo.getUnitNumber());
        return unitNumberDo;
    }

     // assign and set an unitNumber for the specified VC
    public UnitNumberDo assignAndSetOrGetUnitNumberForVC(Transaction t, VirtualCircuitDo virtualCircuitDo, String deviceId, boolean isXnetIdChanging)
            throws ValidationException {

        UnitNumberDo unitNumberDo = unitNumberBl.assignAndSetOrGetUnitNumber(
                t, virtualCircuitDo.getGatewayId(), virtualCircuitDo.getId(), deviceId, virtualCircuitDo.isDrgV2());

        if(isXnetIdChanging) {
            List<UnitNumberDo> vcUnitNumbers = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitDo.getId()).stream()
                    .filter(unitNumber -> unitNumber.getDeviceId().equals(deviceId)).collect(Collectors.toList());
            for (UnitNumberDo unitNumber: vcUnitNumbers) {
                unitNumberBl.delete(t, unitNumber);
            }
            unitNumberDo = unitNumberBl.assignAndSetOrGetUnitNumber(
                    t, virtualCircuitDo.getGatewayId(), virtualCircuitDo.getId(), deviceId, virtualCircuitDo.isDrgV2());
        }

        log.info("Assigned and set unitNumber for VirtualCircuitDo {} with deviceId {} to {}",
                virtualCircuitDo.getId(),
                deviceId,
                unitNumberDo.getUnitNumber());
        return unitNumberDo;
    }

    public UnitNumberDo setUnitNumberForEcmpVc(Transaction t, VirtualCircuitDo virtualCircuitDo, String deviceId, Integer unitNumber) throws ValidationException {
        List<UnitNumberDo> vcUnitNumberDos = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitDo.getId());
        for (UnitNumberDo vcUnitNumberDo : vcUnitNumberDos) {
            if (vcUnitNumberDo.getDeviceId().equals(deviceId) && vcUnitNumberDo.getUnitNumber().equals(unitNumber)) {
                return vcUnitNumberDo;
            }
        }
        return unitNumberBl.setUnitNumber(t, ECMP_DRGV1_ID_FOR_UNIT_NUMBER, virtualCircuitDo.getId(), deviceId, unitNumber, virtualCircuitDo.isDrgV2());
    }

    public Integer getUnitNumberForVc(Transaction t, VirtualCircuitDo virtualCircuitDo, String deviceId) throws ValidationException {
        List<UnitNumberDo> assocUnitNumber = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitDo.getId());
        for (UnitNumberDo unitNumberDo: assocUnitNumber) {
            if (unitNumberDo.getDeviceId().equals(deviceId)) {
                return unitNumberDo.getUnitNumber();
            }
        }
        return unitNumberBl.getUnusedUnitNumber(t, virtualCircuitDo.getId(), deviceId);
    }

    public VirtualCircuitDo.State getAndValidateLifecycleStateInternal(String lifecycleStateInternal) throws ValidationException {

        if (lifecycleStateInternal == null) {
            PublicValidation.failInvalidLifecycleStateInternalFilter(null, VirtualCircuitDo.State.class.getName());
        }

        VirtualCircuitDo.State state = null;
        try {
            state = VirtualCircuitDo.State.create(lifecycleStateInternal);
        } catch (RuntimeException e) {
            PublicValidation.failInvalidLifecycleStateInternalFilter(lifecycleStateInternal, VirtualCircuitDo.State.class.getName());
        }

        return state;
    }

    public ScanPage<VirtualCircuitDo> scanByState(VirtualCircuitDo.State state, int pageSize, Optional<PaginationToken> paginationToken) {
        return paginationToken.map(token -> stateIndex.scan(token, pageSize))
                .orElse(stateIndex.beginPrefixScan(state, pageSize));
    }

    public List<VirtualCircuitDo> getVcByServiceKeyName(Transaction t, String providerId, String providerServiceKeyName) {

        return getVirtualCircuitByProviderServiceId(t, providerId)
            .stream()
            .filter(vc -> vc.getProviderServiceKeyName().equals(providerServiceKeyName))
            .collect(Collectors.toList());
    }

    public Set<String> getEdgePops(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        Set<String> edgePops = new HashSet<>();

        if (virtualCircuitDo.getCrossConnectMapping() == null || virtualCircuitDo.getCrossConnectMapping().getMappings() == null) {
            return edgePops;
        }

        for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {

            if (StringUtils.isBlank(mapping.getCrossConnectId())) {
                log.info(String.format("This is PROVIDER setting virtual circuit to INACTIVE state. No crossConnect information in mappings for %s.", virtualCircuitDo));
                continue;
            }
            // CrossConnect

            boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
            CrossConnectDo crossConnectDo;
            // get device
            if (isCrossConnect) {
                crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
            } else  {
                CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                crossConnectDo = crossConnectBl.getOrThrow(crossConnectGroupDo.getCrossConnectIds()[0]);
            }

            Optional<LocationDo> optionalLocationDo = locationBl.get(crossConnectDo.getLocation());
            if (!optionalLocationDo.isPresent()) {
                // legacy crossConnectDo refer to location by name - https://jira.oci.oraclecorp.com/browse/RSC-5487.
                optionalLocationDo = locationBl.getLocation(crossConnectDo.getLocation());
            }
            LocationDo locationDo = optionalLocationDo.get();
            if (locationDo.isEdgePopLocation()) {
                edgePops.add(locationDo.getEdgePopRegion());
            }
        }
        return edgePops;
    }

    public Boolean isEdgePop(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        Set<String> edgePop = getEdgePops(virtualCircuitDo);
        return edgePop.size() != 0;
    }

    public Boolean isFfab(VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        // TODO: Check if its possible to have a VC with a mixed FFAB CC mapping and a QFX/Arista/MX mapping
        if (virtualCircuitDo.getCrossConnectMapping() != null
                && virtualCircuitDo.getCrossConnectMapping().getMappings() != null) {
            for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {
                if (mapping.getCrossConnectId() != null) {
                    boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
                    CrossConnectDo crossConnectDo;
                    // get device
                    if (isCrossConnect) {
                        crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
                    } else  {
                        CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                        crossConnectDo = crossConnectBl.getOrThrow(crossConnectGroupDo.getCrossConnectIds()[0]);
                    }
                    if (deviceBl.getOrThrow(crossConnectDo.getDeviceId()).getRoles().contains(DeviceDo.Role.Qfx5120)) {
                        return Boolean.TRUE;
                    }
                }
            }
        }
        return Boolean.FALSE;
    }

    public Set<String> getDeviceIdsForVirtualCircuit(String virtualCircuitId) {
        Set<String> deviceIds = new HashSet<>();
        try (Transaction t = beginTransaction("get devices for vc")) {
            VirtualCircuitDo virtualCircuitDo = getOrThrow(t, virtualCircuitId);
            for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {
                String ocid = mapping.getCrossConnectId();
                try {
                    if (isCrossConnect(ocid)) {
                        CrossConnectDo ccDo = crossConnectBl.getOrThrow(t, ocid);
                        DeviceDo mxDeviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(t, deviceBl.getOrThrow(t, ccDo.getDeviceId()));
                        deviceIds.add(mxDeviceDo.getId());
                    } else if (isCrossConnectGroup(ocid)) {
                        CrossConnectGroupDo ccgDo = crossConnectGroupBl.getOrThrow(t, ocid);
                        for (String crossConnectId : ccgDo.getCrossConnectIds()) {
                            CrossConnectDo ccDo = crossConnectBl.getOrThrow(t, crossConnectId);
                            DeviceDo mxDeviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(t, deviceBl.getOrThrow(t, ccDo.getDeviceId()));
                            deviceIds.add(mxDeviceDo.getId());
                        }
                    }
                } catch (Exception e) {
                    log.error("Error while fetching ocid {}, skipping", ocid);
                }
            }
        } catch (ValidationException e) {
            log.error("Error while fetching ocid {}, skipping", virtualCircuitId);
        }
        return deviceIds;
    }

    public DeviceDo getLogicalDevice(String id) throws ValidationException {
        if(id != null) {
            CrossConnectDo crossConnectDo;
            if (VirtualCircuitBl.isCrossConnect(id)) {
                crossConnectDo = crossConnectBl.getOrThrow(id);
            } else {
                CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(id);
                crossConnectDo = crossConnectBl.getOrThrow(crossConnectGroupDo.getCrossConnectIds()[0]);
            }

            DeviceDo deviceDo = deviceBl.getOrThrow(crossConnectDo.getDeviceId());
            // For CrossConnects on QFX or Arista return deviceId of MX since virtual circuit
            // config snippet is on MX device and not on QFX or Arista.
            deviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(deviceDo);

            return deviceDo;
        }
        return null;
    }
