    @Test
    public void GIVEN_listInterfacesImpactedCustomers_w_CCs_down_THEN_impacted() throws Exception {
        String CC_DISPLAY_NAME_NO_GROUP = "cc_no_group";

        String CC_ID1_1 = UUID.randomUUID().toString();
        String CC_ID1_2 = UUID.randomUUID().toString();
        String CC_ID2_1 = UUID.randomUUID().toString();
        String CC_ID2_2 = UUID.randomUUID().toString();

        String VC_ID1 = UUID.randomUUID().toString();
        String VC_ID2 = UUID.randomUUID().toString();

        String interfaceId1_1 = UUID.randomUUID().toString();
        String interfaceId1_2 = UUID.randomUUID().toString();
        String interfaceId2_1 = UUID.randomUUID().toString();
        String interfaceId2_2 = UUID.randomUUID().toString();

        // Build all required DO objects
        CrossConnectDo crossConnectDo1_1 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId1_1)
                .id(CC_ID1_1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectDo crossConnectDo1_2 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId1_2)
                .id(CC_ID1_2)
                .compartmentId(MY_COMPARTMENT)
                .build();


        CrossConnectDo crossConnectDo2_1 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId2_1)
                .id(CC_ID2_1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectDo crossConnectDo2_2 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId2_2)
                .id(CC_ID2_2)
                .compartmentId(MY_COMPARTMENT)
                .build();


        CrossConnectMappings.Mapping mapping1_1 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo1_1.getId())
                .build();

        CrossConnectMappings.Mapping mapping1_2 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo1_2.getId())
                .build();

        CrossConnectMappings.Mapping mapping2_1 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo2_1.getId())
                .build();

        CrossConnectMappings.Mapping mapping2_2 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo2_2.getId())
                .build();


        VirtualCircuitDo virtualCircuitDo1 = VirtualCircuitDo.builder()
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping1_1, mapping1_2}).build())
                .id(VC_ID1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        VirtualCircuitDo virtualCircuitDo2 = VirtualCircuitDo.builder()
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping2_1, mapping2_2}).build())
                .id(VC_ID2)
                .compartmentId(MY_COMPARTMENT)
                .build();

        // Setup mocks
        when(crossConnectBl.stream()).thenReturn(
                Arrays.asList(crossConnectDo1_1, crossConnectDo1_2, crossConnectDo2_1, crossConnectDo2_2)
                        .stream());
        when(crossConnectGroupBl.stream()).thenReturn((new ArrayList<CrossConnectGroupDo>()).stream());
        when(virtualCircuitBl.stream()).thenReturn
                (Arrays.asList(virtualCircuitDo1, virtualCircuitDo2).stream());

        // All down, 2 vcs impacted
        Response response = managementResource.listInterfacesImpactedCustomers(
                interfaceId1_1 + "," + interfaceId1_2 + "," +
                interfaceId2_1 + "," + interfaceId2_2);

        List<InterfaceCustomer> results = (List<InterfaceCustomer>) response.getEntity();

        assertEquals(2, results.size());
        Set<String> vcs = new HashSet<>();
        for (InterfaceCustomer c : results) {
            vcs.add(c.getResourceId());
            assertTrue(c.getCustomerBgpSessionUp());
        }

        assertTrue(vcs.contains(VC_ID1));
        assertTrue(vcs.contains(VC_ID2));
    }

