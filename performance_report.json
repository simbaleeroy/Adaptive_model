// Single-Type5
export const getSingleCrossConnectBody = (user: any) => {
  const formFields = user?.forms?.["intent.fast-connect.create.Step2"]?.$formFields;
  const isCCGroup = formFields?.crossConnectType === CrossConnectType.Group;

  if (isCCGroup) {
    // failsafe
    return {};
  }

  // For Single CC body
  const isMacsecEnabled = formFields?.state === true;
  const { freeformTags, definedTags } = convertTags(formFields?.tags);

  const res: Record<string, any> = {
    displayName: formFields?.displayName,
    compartmentId: formFields?.compartmentId,
    locationName: formFields?.locationName,
    portSpeedShapeName: formFields?.portSpeedShapeName,
    customerReferenceName: formFields?.customerReferenceName,
    freeformTags: freeformTags ?? {},
    definedTags: definedTags ?? {},
    macsecProperties: {
      state: isMacsecEnabled ? "ENABLED" : "DISABLED",
      primaryKey: isMacsecEnabled
        ? {
            connectivityAssociationNameSecretId: formFields?.connectivityAssociationNameSecretId,
            connectivityAssociationKeySecretId: formFields?.connectivityAssociationKeySecretId,
          }
        : null,
      encryptionCipher: isMacsecEnabled ? formFields?.encryptionCipher : null,
      isUnprotectedTrafficAllowed: isMacsecEnabled
        ? formFields?.isUnprotectedTrafficAllowed === unprotectedTrafficAllowed.failOpen
        : false,
    },
  };

  // Add router proximity conditionally
  if (formFields?.routerProximityEnabled === true) {
    if (formFields?.routerProximityNearOrFar === RouterProximityType.Near) {
      res.nearCrossConnectOrCrossConnectGroupId = formFields?.nearCrossConnectOrCrossConnectGroupId;
    } else {
      res.farCrossConnectOrCrossConnectGroupId = formFields?.farCrossConnectOrCrossConnectGroupId;
    }
  }

  //   console.log("getSingleCrossConnectBody -->", res);
  return res;
};

