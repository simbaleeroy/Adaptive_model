    /**
     * In an incident that multiple interfaces are down, this API calculates impacted customers
     *
     * @param interfaceIds - Comma separated list of down interfaces by Id, as this is to be
     *                     called by glance page, glance page should already have interface
     *                     Ids so we don't need to look up again.
     * @return Info needed by CN to contact impacted customers.
     */
    @GET
    @Path("/listInterfacesImpactedCustomers")
    @VpnSkipAuthorization
    public Response listInterfacesImpactedCustomers(
            @QueryParam("interfaceIds") String interfaceIds
    ) {
        ArrayList<InterfaceCustomer> results = new ArrayList<InterfaceCustomer>();

        // Allow null for future extension - in case we want to use different parameters to query
        if (interfaceIds == null || interfaceIds.trim().isEmpty()) {
            return Response.ok(results).build();
        }

        Set<String> affectedInterfaces = new HashSet<>(Arrays.asList(interfaceIds.split(",")));

        // as ID is GUID, put CC and CCG in one set for convenience
        Set<String> affectedCcCcgs = new HashSet<>();

        // CC is down if the interface used is down
        crossConnectBl.stream().forEach(
                (ccDo) -> {
                    if (affectedInterfaces.contains(ccDo.getInterfaceId())) {
                        affectedCcCcgs.add(ccDo.getId());
                    }
                });

        // CCG is down only if all CCs down
        crossConnectGroupBl.stream().forEach(
                (ccgDo) -> {
                    Set<String> ccIdSet = new HashSet<>(Arrays.asList(ccgDo.getCrossConnectIds()));
                    if (!ccIdSet.isEmpty() &&
                            Sets.difference(ccIdSet, affectedCcCcgs).isEmpty()) {
                        affectedCcCcgs.add(ccgDo.getId());
                    }
                }
        );

        Map<String, List<Map.Entry<String, String>>> drg2AffectedVcs = new HashMap<>();
        Map<String, List<Map.Entry<String, String>>> drg2SafeVcs = new HashMap<>();
        log.info("Fetching Drg/VC with BGP state NONE from T2");
        Set<String> pendingBgpSessionVcs = managementResourceHelper.getVcRedundancyStatus(ManagementResourceHelper.PENDING_BGP_SESSION_VC_QUERY, null, null);
        log.info("Fetching Drg/VC with BGP state PENDING from T2");
        Set<String> noBgpSessionVcs = managementResourceHelper.getVcRedundancyStatus(ManagementResourceHelper.NO_BGP_SESSION_VC_QUERY, null, null);
        log.info("Drg/Vcs with NO BGP session{}", noBgpSessionVcs);
        log.info("Drg/Vcs with PENDING BGP session{}", pendingBgpSessionVcs);


        Map<String, Boolean> redundancyMap = new HashMap<>();
        virtualCircuitBl.stream().forEach(
                (vcDo) -> {
                    // For Redundancy Calculations
                    Boolean customerBgpSessionUp = null;
                    if (noBgpSessionVcs != null && pendingBgpSessionVcs != null) {
                        customerBgpSessionUp = managementResourceHelper.isBgpSessionRedundant(vcDo, noBgpSessionVcs, pendingBgpSessionVcs);
                    }
                    redundancyMap.put(vcDo.getId(), customerBgpSessionUp);
                    Set<String> ccCcgIds = new HashSet<>();
                    for (CrossConnectMappings.Mapping mapping : vcDo.getCrossConnectMapping().getMappings()) {
                        ccCcgIds.add(mapping.getCrossConnectId());
                    }

                    if (!ccCcgIds.isEmpty()) {
                        if (Sets.difference(ccCcgIds, affectedCcCcgs).isEmpty()) {
                            if (!drg2AffectedVcs.containsKey(vcDo.getGatewayId())) {
                                drg2AffectedVcs.put(vcDo.getGatewayId(), new ArrayList<>());
                            }

                            drg2AffectedVcs.get(vcDo.getGatewayId()).add(new AbstractMap.SimpleEntry<>(vcDo.getId(), vcDo.getCompartmentId()));
                        } else {
                            if (!drg2SafeVcs.containsKey(vcDo.getGatewayId())) {
                                drg2SafeVcs.put(vcDo.getGatewayId(), new ArrayList<>());
                            }

                            drg2SafeVcs.get(vcDo.getGatewayId()).add(new AbstractMap.SimpleEntry<>(vcDo.getId(), vcDo.getCompartmentId()));
                        }
                    }
                });

        // If a DRG only have bad VC, no good VC, then the customer is affected
        for (String drgId : Sets.difference(drg2AffectedVcs.keySet(), drg2SafeVcs.keySet())) {
            List<Map.Entry<String, String>> drgVcs = drg2AffectedVcs.get(drgId);
            for (Map.Entry<String, String> vc : drgVcs) {

                results.add(InterfaceCustomer.builder()
                        .compartmentId(vc.getValue())
                        .drgId(drgId)
                        .resourceId(vc.getKey())
                        .customerType(FastConnectCustomerType.builder().customerType(
                                FastConnectCustomerType.CustomerType.Customer
                        ).build())
                        .customerBgpSessionUp(redundancyMap.get(vc.getKey()))
                        .build());
            }
        }

        return Response.ok(results).build();
    }

    /**
     * Check if a interface is stable during the past interval at a specific timestamp.
     *
     * @param deviceId The device id.
     * @param interfaceId The interface id.
     * @param timestamp The unix timestamp in seconds to check. Ex. 1620946174
     * @param interval Interval in minutes. Will check if interface is stable from [timestamp - interval, timestamp]
     * @param isLag True if the interface is a LAG (CCG) interface. CCG interfaceId is the interface name. Ex. ae517
     * @return Return false if in the past interval at the timestamp, the interface is ever down.
     * i.e. Return false if at any instant interface status == 2 from [timestamp - interval, timestamp],
     * Return true if all instant in [timestamp - interval, timestamp] interface status == 1.
     *
     * Also return false if any error occurs, i.e. interface not found, no data returned, etc.
     */
    public boolean isInterfaceStable(String deviceId, String interfaceId, String timestamp, int interval, boolean isLag) {
        try {
            String deviceName = deviceBl.getOrThrow(deviceId).getName();
            String interfaceName = isLag ? interfaceId : interfaceBl.getOrThrow(interfaceId).getName(); // ccgDo.interfaceId is the interface name, Ex. ae517

            String query = String.format(INTERFACE_STATUS_STABLE_QUERY_FORMAT, deviceName, interfaceName, interval);
            log.info("Querying from Prometheus with query: {}, timestamp: {}", query, timestamp);
            List<PrometheusQueryResponse.Result> prometheusResult = prometheusClient.getImpactedCustomers(query, timestamp);
            log.info("Got result from Prometheus: {}", prometheusResult);

            // should only return 1 result entry, and 1 data point
            if (prometheusResult.size() > 0 && prometheusResult.get(0) != null) {
                List<PrometheusQueryResponse.DataPoint> values = prometheusResult.get(0).getValues();
                if (values.size() > 0 && values.get(0) != null) {
                    return values.get(0).getValue() == 1;
                }
            }
        } catch (Exception e) {
            StringWriter sw = new StringWriter();
            e.printStackTrace(new PrintWriter(sw));
            log.error(e.getMessage());
            log.error(sw.toString());
            log.info("Error occurred during fetching for interface information on device {}, interface {}. Marking this interface as unstable", deviceId, interfaceId);
            return false;
        }

        return false;
    }

    private List<InterfaceCustomer> generateInterfaceCustomer(Collection<String> vcIds, Set<String> noBgpSessionVcs, Set<String> pendingBgpSessionVcs) {
        List<InterfaceCustomer> results = new ArrayList<>();
        vcIds.forEach(vcId -> {
            Optional<VirtualCircuitDo> vcDoOptional = virtualCircuitBl.get(vcId);
            if (vcDoOptional.isPresent()) {

                // For Redundancy Calculations
                Boolean customerBgpSessionUp = null;
                if (noBgpSessionVcs != null && pendingBgpSessionVcs != null) {
                    customerBgpSessionUp = managementResourceHelper.isBgpSessionRedundant(vcDoOptional.get(), noBgpSessionVcs, pendingBgpSessionVcs);
                }
                results.add(InterfaceCustomer.builder()
                        .resourceId(vcId)
                        .compartmentId(vcDoOptional.get().getCompartmentId())
                        .customerType(
                                FastConnectCustomerType.builder()
                                        .customerType(FastConnectCustomerType.CustomerType.Customer)
                                        .build())
                        .customerBgpSessionUp(customerBgpSessionUp)
                        .build());
            }
        });
        return results;
    }

    /**
     * Given a down interface on the specific device, find its impacted VC by cross checking
     * the status of its related interfaces.
     *
     * 1. get InterfaceDo from InterfaceBl with matching interfaceName and deviceName
     * 2. get CrossConnectDo that is on the interface.
     * Note that the interface might be a LAG interface, indicating has CCG on it instead of CC
     * so in that case, we'll need to look it up in CrossConnectGroupBl
     * 3. From CC/CCG, try get it's provider if any from ProviderBl.
     * If the provider type is type 3
     * 4. From CcDo / CcgDo, get all VCs that is on the CC/CCG. i.e. ccDo.getVcsToVlans().getKeys()
     * 5. Get the First VC, go through its CrossConnectMapping. For each CC or CCG in the CrossConnectMapping
     * if it's the original CC/CCG (the CC/CCG we got at step 2 & 3), skip and continue
     * if it's a CCG,
     * 6. Check if the non-LAG/LAG interface of the CC/CCG and see if the non-LAg/LAG interface is up using deviceConnector
     * If haven't been up for 15min, mark it as bad
     * if it's a CC
     * do step 6
     * 7. If all CC/CCG in the CrossConnectMapping is bad, this VC is impacted
     * If the provider type is type 2, or provider not found
     * 8. Get CCG to which the CC belongs
     * do step 6
     * 9. if LAG is up then all good. Otherwise, all VCs on this CCG/CC are impacted
     *
     * @param deviceName The device name. Ex. sea1-vpn1, iad4-j1-vpn1
     * @param interfaceName The interface name. Ex. xe-0/0/1,  ae52.0001
     * @return List of impacted customer's VC and its compartmentId
     * @throws FatalDeviceException
     * @throws ValidationException
     */
    @GET
    @Path("/listInterfacesImpactedCustomersV2")
    @VpnSkipAuthorization
    public Response listInterfacesImpactedCustomersV2(
            @QueryParam("deviceName")    String deviceName,
            @QueryParam("interfaceName") String interfaceName,
            @DefaultValue(TIMESTAMP_NOW) @QueryParam("timestamp") String timestamp,
            @DefaultValue(INTERVAL_15M)  @QueryParam("interval")  int interval) throws ValidationException {

        log.info("ListInterfaceImpactedCustomersV2 deviceName:{}, interfaceName:{}, timestamp:{}, interval:{}",
                deviceName, interfaceName, timestamp, interval);

        List<InterfaceCustomer> results = new ArrayList<>();

        String unixTimestamp = DateUtil.convertTimestamp(timestamp);
        log.info("Converted timestamp {} to unix epoch seconds: {}", timestamp, unixTimestamp);
        if (unixTimestamp == null) {
            return Response.status(400).entity(String.format("Timestamp format error : %s", timestamp)).build();
        }

        if (interval <= 0) {
            return Response.status(400).entity(String.format("Interval should be a positive value : %s", interval)).build();
        }
        Set<String> pendingBgpSessionVcs = managementResourceHelper.getVcRedundancyStatus(ManagementResourceHelper.PENDING_BGP_SESSION_VC_QUERY,
                null, unixTimestamp);
        Set<String> noBgpSessionVcList = managementResourceHelper.getVcRedundancyStatus(ManagementResourceHelper.NO_BGP_SESSION_VC_QUERY, null, unixTimestamp);

        try (Transaction t = interfaceBl.beginTransaction("check-customer-impact")) {

            // 1. get InterfaceDo from InterfaceBl with matching interfaceName and deviceName
            // 2. get CrossConnectDo that is on the interface.

            DeviceDo deviceDo = deviceBl.getDeviceDoByDeviceName(t, deviceName);

            if (deviceDo == null) {
                log.info("Input device {} is not found", deviceName);
                return Response.status(400).entity(String.format("Input device is not found %s", deviceName)).build();
            }
            log.info("Found DeviceDo: {}", deviceDo);

            Optional<InterfaceDo> interfaceDoOptional = interfaceBl.getInterfaceByName(t, interfaceName, deviceDo.getId());

            if (!interfaceDoOptional.isPresent()) {
                log.info("Input interface {} on device {} is not found", interfaceName, deviceName);
                return Response.status(400).entity(String.format("Input interface is not found. %s on %s", interfaceName, deviceName)).build();
            }

            InterfaceDo interfaceDo = interfaceDoOptional.get();
            log.info("Found InterfaceDo: {}", interfaceDo);

            CrossConnectGroupDo inputCcgDo = null;
            CrossConnectDo inputCcDo = null;
            Optional<CrossConnectGroupDo> crossConnectGroupDoOpt = crossConnectGroupBl.stream()
                    .filter(ccg -> ccg.getInterfaceId() != null && ccg.getInterfaceId().equals(interfaceDo.getId())).findFirst();
            if (crossConnectGroupDoOpt.isPresent()) {
                inputCcgDo = crossConnectGroupDoOpt.get();
                log.info("Found CCG {} on interface {} device {}", inputCcgDo.getId(), interfaceName, deviceName);
            }
            Optional<CrossConnectDo> crossConnectDoOpt = crossConnectBl.stream()
                    .filter(cc -> cc.getInterfaceId() != null && cc.getInterfaceId().equals(interfaceDo.getId())).findFirst();
            if (crossConnectDoOpt.isPresent()) {
                inputCcDo = crossConnectDoOpt.get();
                log.info("Found CC {} on interface {} device {}", inputCcDo.getId(), interfaceName, deviceName);
            }

            if (inputCcDo == null && inputCcgDo == null) {
                log.info("No cc / ccg on the provided interface {}", interfaceDo.getId());
                return Response.ok(results).build();
            }

            // 3. From CC/CCG, try get it's provider if any from ProviderBl. Interface is on either a ccg or cc
            Set<ProviderServiceDo> providerServiceDos = new HashSet<>(providerBl.getProviderServicesByCompartment(
                    inputCcDo != null ? inputCcDo.getCompartmentId() : inputCcgDo.getCompartmentId()));
            log.info("ProviderServiceDos: {}", providerServiceDos);

            // Check the provider's type
            boolean isLayer3 = false;
            if (providerServiceDos.size() > 0) {
                ProviderServiceDo providerServiceDo = providerServiceDos.stream().findFirst().get();
                isLayer3 = providerServiceDo.getType().equals(ProviderServiceDo.Type.Layer3);
                log.info("Provider {} is {}", providerServiceDo.getProviderName(), providerServiceDo.getType());

                // impacted partner details in impacted customer list
                if (inputCcDo != null) {
                    results.add(InterfaceCustomer.builder()
                            .compartmentId(providerServiceDo.getCompartmentId())
                            .resourceId(inputCcDo.getId())
                            .customerType(FastConnectCustomerType.builder().customerType(
                                    FastConnectCustomerType.CustomerType.Provider).build())
                            .build());
                }

                if (inputCcgDo != null) {
                    results.add(InterfaceCustomer.builder()
                            .compartmentId(providerServiceDo.getCompartmentId())
                            .resourceId(inputCcgDo.getId())
                            .customerType(FastConnectCustomerType.builder().customerType(
                                    FastConnectCustomerType.CustomerType.Provider).build()).
                            build());
                }

            } else {
                log.info("No provider found for inputCC:{} or inputCCG:{}", inputCcDo, inputCcgDo);
            }

            if (isLayer3) {
                // Layer3 provider
                // 4. From CcDo / CcgDo, get all VCs that is on the CC/CCG. i.e. ccDo.getVcsToVlans().getKeys()
                log.info("Layer3 Provider");
                Set<String> vcIds = new HashSet<>();

                if (inputCcDo != null && inputCcDo.getCrossConnectGroupId() != null) {
                    // find related ccg for the input cc
                    Optional<CrossConnectGroupDo> optCcgDo = crossConnectGroupBl.get(inputCcDo.getCrossConnectGroupId());
                    if (optCcgDo.isPresent()) {
                        inputCcgDo = optCcgDo.get();
                        log.info("Found related CCG {}", inputCcgDo);
                    }
                }

                if (inputCcgDo != null) {
                    vcIds.addAll(inputCcgDo.getVcsToVlans() != null ? inputCcgDo.getVcsToVlans().keySet() : ImmutableList.of());
                    log.info("Appended related vcIds on inputCCG: {}, vcIds: {}", inputCcgDo, vcIds);
                }
                if (inputCcDo != null) {
                    vcIds.addAll(inputCcDo.getVcsToVlans() != null ? inputCcDo.getVcsToVlans().keySet() : ImmutableList.of());
                    log.info("Appended related vcIds on inputCC: {}, vcIds: {}", inputCcDo, vcIds);
                }
                log.info("Related vcIds on inputCC/CCG: {}", vcIds);

                Set<CrossConnectDo> crossConnectDoList = new HashSet<>();
                Set<CrossConnectGroupDo> crossConnectGroupDoList = new HashSet<>();

                vcIds.stream().forEach(vcId -> {
                    Optional<VirtualCircuitDo> vcDoOpt = virtualCircuitBl.get(vcId);
                    if (vcDoOpt.isPresent()) {
                        Arrays.stream(vcDoOpt.get().getCrossConnectMapping().getMappings()).forEach(mapping -> {
                            String id = mapping.getCrossConnectId();
                            Optional<CrossConnectDo> optionalCrossConnectDo = crossConnectBl.get(t, id);
                            if (optionalCrossConnectDo.isPresent()) {
                                crossConnectDoList.add(optionalCrossConnectDo.get());
                            }
                            Optional<CrossConnectGroupDo> optionalCrossConnectGroupDo = crossConnectGroupBl.get(t, id);
                            if (optionalCrossConnectGroupDo.isPresent()) {
                                crossConnectGroupDoList.add(optionalCrossConnectGroupDo.get());
                            }
                        });
                    }
                });

                log.info("Related CCs on VC: {}", crossConnectDoList);
                log.info("Related CCGs on VC: {}", crossConnectGroupDoList);

                // 6. Check if the non-LAG/LAG interface of the CC/CCG and see if the non-LAg/LAG interface is up using deviceConnector
                boolean stable = false;
                for(CrossConnectGroupDo crossConnectGroupDo : crossConnectGroupDoList) {
                    // interfaceId on ccg is
                    stable |= isInterfaceStable(crossConnectBl.getDeviceId(crossConnectGroupDo), crossConnectGroupDo.getInterfaceId(), unixTimestamp, interval, true);
                    log.info("CCG {} interface {} is stable: {}", crossConnectGroupDo.getId(), crossConnectGroupDo.getInterfaceId(), stable);
                    if (stable) {
                        break;
                    }
                }
                if (!stable) {
                    for(CrossConnectDo crossConnectDo : crossConnectDoList) {
                        stable |= isInterfaceStable(crossConnectDo.getDeviceId(), crossConnectDo.getInterfaceId(), unixTimestamp, interval, false);
                        log.info("CC {} interface {} is stable: {}", crossConnectDo.getId(), crossConnectDo.getInterfaceId(), stable);
                        if (stable) {
                            break;
                        }
                    }
                } else {
                    log.info("At least one of the CCGs is stable. Skip checking for individual CC");
                }

                if (!stable) {
                    log.info("Discovered {} impacted VCs", vcIds.size());
                    results.addAll(generateInterfaceCustomer(vcIds, noBgpSessionVcList, pendingBgpSessionVcs));
                    return Response.ok(results).build();
                }

            } else {
                // Layer2 provider or co-location
                // 8. Get CCG to which the CC belongs
                log.info("Layer2 Provider or Co-location");
                if (inputCcgDo == null) {
                    log.info("inputCcgDo is null, looking for correlated CCG of CC:{}", inputCcDo);
                    if (StringUtils.isBlank(inputCcDo.getCrossConnectGroupId())) {
                        // calculate all VC that are on this ccdo
                        log.info("No related CCG found for CC {}. Customers are impacted.", inputCcDo);
                        results.addAll(generateInterfaceCustomer(inputCcDo.getVcsToVlans() != null ? inputCcDo.getVcsToVlans().keySet() : ImmutableList.of(), noBgpSessionVcList, pendingBgpSessionVcs));
                        log.info("Discovered {} impacted VC", results.size());
                        return Response.ok(results).build();
                    }
                    inputCcgDo = crossConnectGroupBl.getOrThrow(inputCcDo.getCrossConnectGroupId());
                    log.info("Found related CCG {}", inputCcgDo);
                }

                // 9. Check if the non-LAG/LAG interface of the CC/CCG and see if the non-LAg/LAG interface is up using deviceConnector
                boolean isInterfaceStable = isInterfaceStable(crossConnectBl.getDeviceId(inputCcgDo), inputCcgDo.getInterfaceId(), unixTimestamp, interval, true);
                log.info("CCG {} interface {} is stable: {}", inputCcgDo.getId(), inputCcgDo.getInterfaceId(), isInterfaceStable);

                // 10. if LAG is up then all good. Otherwise, all VCs on this CCG/CC are impacted
                if (!isInterfaceStable) {
                    results.addAll(generateInterfaceCustomer(inputCcgDo.getVcsToVlans() != null ? inputCcgDo.getVcsToVlans().keySet() : ImmutableList.of(), noBgpSessionVcList, pendingBgpSessionVcs));

                    for(String ccid : inputCcgDo.getCrossConnectIds()) {
                        CrossConnectDo ccDoUnderCcg = crossConnectBl.getOrThrow(ccid);
                        results.addAll(generateInterfaceCustomer(ccDoUnderCcg.getVcsToVlans() != null ? ccDoUnderCcg.getVcsToVlans().keySet() : ImmutableList.of(), noBgpSessionVcList, pendingBgpSessionVcs));
                    }
                    results = results.stream().distinct().collect(Collectors.toList());
                    log.info("Discovered {} impacted VC", results.size());
                    return Response.ok(results).build();
                }
            }
        }

        return Response.ok(results).build();
    }

    /**
     * Refer to:
     * https://confluence.oci.oraclecorp.com/pages/viewpage.action?pageId=257192868
     *
     * Using prometheus, we can easily identify VCs/IPSecs (on an device) impacted by an incident.
     * However, using this to send notification to customers tend to contain false positives,
     *     1. VCs/IPSecs are across multiple devices, it is really impacted only if all devices are impacted
     *     2. DRGs have multiple VCs/IPSecs, it is really impacted only if all VCs/IPSecs are impacted
     * This API produces a mapping of: DRG <-> VC/IPSEC <-> Device, it can be passed to "promdiff" as an
     * optional parameters, to filter out DRGS which are not really impacted - due to having
     * redundancy.
     * @return A report regarding DRG
     */
    @GET
    @Path("/getDrgRedundancyMap")
    @VpnSkipAuthorization
    public Response getDrgRedundancyMap() {

        Map<String, String> deviceMap =  deviceBl.stream().collect(Collectors.toMap(DeviceDo::getId, DeviceDo::getName));
        Map<String, Set<String>> ccOccg2Devices = new HashMap<>();
        Map<String, Set<String>> vcOipsec2Device = new HashMap<>();
        Map<String, Set<String>> drg2VcIpSec = new HashMap<>();

        crossConnectBl.stream().forEach( cc -> {
            ccOccg2Devices.put(cc.getId(), new HashSet<>());
            ccOccg2Devices.get(cc.getId()).add(deviceMap.get(cc.getDeviceId()));
        });

        crossConnectGroupBl.stream().forEach( ccg -> {
            ccOccg2Devices.put(ccg.getId(), new HashSet<>());
            for (String ccid : ccg.getCrossConnectIds()) {
                ccOccg2Devices.get(ccg.getId()).add(ccOccg2Devices.get(ccid).iterator().next());
            }
        });

        virtualCircuitBl.stream()
                .filter( vc -> vc.getState() == VirtualCircuitDo.State.PROVISIONED &&
                        vc.getGatewayId() != null &&
                        !vc.getGatewayId().trim().isEmpty() &&
                        (vc.getGatewayType() == VirtualCircuitDo.GatewayType.DRG ||
                                // DRG V2 - We will no longer have DrgDo but DRG OCID still valid
                                vc.getGatewayType() == VirtualCircuitDo.GatewayType.DRG_V2)
                        && vc.getCrossConnectMapping() != null)
                .forEach(vc -> {
                    vcOipsec2Device.put(vc.getId(), new HashSet<>());
                    for (CrossConnectMappings.Mapping mapping : vc.getCrossConnectMapping().getMappings()) {
                        String ccOccgId = mapping.getCrossConnectId(); // cc id or ccg id
                        if (ccOccgId != null) {
                            vcOipsec2Device.get(vc.getId()).addAll(ccOccg2Devices.get(ccOccgId));
                        }
                    }

                    String drgId = vc.getGatewayId();
                    if(!drg2VcIpSec.containsKey(vc.getGatewayId())) {
                        drg2VcIpSec.put(vc.getGatewayId(), new HashSet<>());
                    }

                    drg2VcIpSec.get(vc.getGatewayId()).add(vc.getId());
                });

        tunnelBl.stream().forEach( t -> {
            if (!vcOipsec2Device.containsKey(t.getIpsecId())) {
                vcOipsec2Device.put(t.getIpsecId(), new HashSet<>());
            }

            if (t.getVpnTeSetId()!= null || !deviceMap.containsKey(t.getDeviceId())) {
                // If device is not one that Prometheus monitors then assume it good
                vcOipsec2Device.get(t.getIpsecId()).add("unknownDevice");
            }
            else {
                vcOipsec2Device.get(t.getIpsecId()).add(deviceMap.get(t.getDeviceId()));
            }
        });

        iPsecConnectionBl.stream()
                .filter( i -> i.getState() == IPsecConnectionDo.State.Provisioned &&
                        i.getDrgId() != null &&
                        !i.getDrgId().trim().isEmpty())
                .forEach( i -> {
                    if(!drg2VcIpSec.containsKey(i.getDrgId())) {
                        drg2VcIpSec.put(i.getDrgId(), new HashSet<>());
                    }
                    drg2VcIpSec.get(i.getDrgId()).add(i.getId());
                });

        ArrayList<DrgRedundancyRecord> results = new ArrayList<>();

        for (Map.Entry<String, Set<String>> drgEntry : drg2VcIpSec.entrySet()) {
            for (String vcIpsecId : drgEntry.getValue()) {
                for (String deviceName : vcOipsec2Device.get(vcIpsecId)) {
                    results.add(DrgRedundancyRecord.builder()
                            .drgid(drgEntry.getKey())
                            .vcipsecid(vcIpsecId)
                            .deviceName(deviceName)
                            .build());
                }
            }
        }

        return Response.ok(results).build();
    }

    @GET
    @Timed(name = "listRedundancyStatus")
    @Path("/listRedundancyStatus")
    @VpnSkipAuthorization
    public PaginatedResponse<DrgRedundancyStatus> listRedundancyStatus() {

        List<DrgRedundancyStatus> result = new ArrayList();
        Map<String, DrgDo> drgDoMap = drgBl.listDrg();
        drgStatusBl.stream().forEach(drgStatusDo -> {
            String drgId = drgStatusDo.getId();
            String compartmentId = drgDoMap.containsKey(drgId) ? drgDoMap.get(drgId).getCompartmentId() : "";
            if(compartmentId.equals("")) {
                Optional<Drg> drgV2 = drgV2Helper.getDrgV2(drgId);
                compartmentId = (drgV2.isPresent())?drgV2.get().getCompartmentId():"";
            }
            result.add(
                    DrgRedundancyStatus.builder()
                            .id(drgId)
                            .compartmentId(compartmentId)
                            .status(DrgStatusDo.toClientStatus(drgStatusDo.getStatus())).build());
        });
        return new PaginatedResponse(result);
    }

    // Pass in an IPSEC or Virtual Circuit ID, return a set of device ID that the connection go through.
    // For IPSEC connection, return the device list for all active tunnels
    // For Virtual circuit, return the device list for all CrossConnects
    // different devices
    private Set<String> getConnectionDeviceList(
            String connectionId,
            Map<String, Set<String>> ipsecDevices,
            Map<String, Set<String>> allEstablishedBgp,
            Map<String, String> drgs) throws ValidationException {

        String INTERNET_VRF_NAME = "INTERNET";
        Set<String> devices = new HashSet<>();

        if (connectionId.toLowerCase().contains("ipsecconnection")) {
            if (ipsecDevices.containsKey(connectionId)) {
                devices.addAll(ipsecDevices.get(connectionId));
            }
        } else if (connectionId.toLowerCase().contains("virtualcircuit")) {
            VirtualCircuitDo vcDo = virtualCircuitBl.get(connectionId).get();
            if (vcDo != null && vcDo.getCrossConnectMapping() != null) {
                // get vrf name
                String xnetId = "";
                if (vcDo.isPublic()) {
                    xnetId = INTERNET_VRF_NAME;
                } else {
                    if (vcDo.getGatewayId() != null && drgs.containsKey(vcDo.getGatewayId())) {
                        if (vcDo.getRouteDistinguisher() == null) {
                            // VC not using ECMP
                            xnetId = drgs.get(vcDo.getGatewayId());
                        } else {
                            // VC using ECMP
                            xnetId = vcDo.getGroupId();
                        }
                    }
                }

                for (String remoteBgpPeeringIp : vcDo.getRemoteBgpIpsWithNoCidr()) {
                    if (remoteBgpPeeringIp == null) {
                        continue;
                    }

                    String key = String.format("%s.%s", xnetId, remoteBgpPeeringIp);
                    if (allEstablishedBgp.containsKey(key)) {
                        devices.addAll(allEstablishedBgp.get(key));
                    }
                }
            }
        }

        log.info("Connection {} has active tunnels / BGP sessions terminated on {} devices", connectionId, devices.size());
        return devices;
    }

