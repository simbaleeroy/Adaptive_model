@Test
        public void GIVEN_createOrUpdateDrgV2Attachment_WHEN_BmcExceptionDuringCreate_THEN_VcStateSetToFailed()
                        throws Exception {

                // Use the existing generateVirtualCircuitDo method that works
                VirtualCircuitDo virtualCircuitDo = generateVirtualCircuitDo(VirtualCircuitDo.IpAddressType.PUBLIC,
                                null, null);

                // Ensure VC was created successfully and has an ID
                assertThat(virtualCircuitDo).isNotNull();
                assertThat(virtualCircuitDo.getId()).isNotNull();

                // Debug: Print the ID to see what we're working with
                System.out.println("VC ID: " + virtualCircuitDo.getId());

                try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {
                        // Mock the underlying BMC client calls that drgV2Helper uses
                        DrgAttachment mockDrgAttachment = DrgAttachment.builder()
                                        .id("test-drg-attachment-id")
                                        .drgId(TEST_DRG_ID)
                                        .compartmentId("test-compartment-id")
                                        .displayName("Test DRG Attachment")
                                        .lifecycleState(DrgAttachment.LifecycleState.Available)
                                        .build();

                        when(virtualNetworkClient.createC3DrgAttachment(any(CreateC3DrgAttachmentRequest.class)))
                                        .thenReturn(CreateC3DrgAttachmentResponse.builder()
                                                        .opcRequestId("testOpcRequestId")
                                                        .drgAttachment(mockDrgAttachment)
                                                        .build());

                        // Mock BMC exception during DRG V2 attachment creation via drgV2Helper
                        when(drgV2Helper.createDrgV2AttachmentAndDo(eq(t), eq(virtualCircuitDo),
                                        any(Boolean.class)))
                                        .thenAnswer(invocation -> {
                                                System.out.println("*** MOCK TRIGGERED! ***");
                                                System.out.println("Transaction: " + invocation.getArgument(0));
                                                System.out.println("VC: " + invocation.getArgument(1));
                                                System.out.println("Boolean: " + invocation.getArgument(2));
                                                throw new BmcException(500, "test service code",
                                                                "Internal Server Error",
                                                                "testOpcRequestId");
                                        });

                        // Mock no existing DRG V2 attachments (so it goes to create path)
                        when(drgV2AttachmentBl.listByAttachedResourceId(eq(t), eq(virtualCircuitDo.getId())))
                                        .thenReturn(Collections.emptyList());

                        try {
                                // Debug: Print the VC ID before calling the method
                                System.out.println("Before method call - VC ID: " + virtualCircuitDo.getId());
                                System.out.println("About to call createDrgV2Attachment...");
                                createVcDrgV2AttachmentWorkflow.createDrgV2Attachment(null, t, null, virtualCircuitDo);
                                System.out.println("Method call completed without exception");
                                fail("Expected BmcException to be thrown");
                        } catch (BmcException e) {
                                // Expected exception - this is what we want
                                System.out.println("Caught expected BmcException: " + e.getMessage());
                                assertThat(e.getMessage()).contains("Internal Server Error");
                        }
                        t.commit();
                }

                // Verify VC state is set to FAILED
                try (Transaction t = virtualCircuitBl.beginTransaction("test")) {
                        VirtualCircuitDo updatedVc = virtualCircuitBl.getOrThrow(t, virtualCircuitDo.getId());
                        assertThat(updatedVc.getState()).isEqualTo(VirtualCircuitDo.State.FAILED);
                        System.out.println("VC state: " + updatedVc.getState());
                        System.out.println("VC last updated: " + updatedVc.getLastUpdated());
                }
        }
