        $onCloseAction: CrossConnectDetailsActions.toggleCakSecretView,
        $secretOCID: mauiExpression(
          CoreServicesApi.GetCrossConnect.response()?.data?.macsecProperties?.primaryKey
            ?.connectivityAssociationNameSecretId,
        ),
      },
    },
    CoreServicesApi.ListVirtualCircuits.action.withProperties({
      queryParams: {
        compartmentId: mauiExpression($app.consoleState?.compartmentId),
        sortBy: mauiExpression(
          ["displayName", "timeCreated"].includes(String($user?.sort?.sortBy))
            ? $user?.sort?.sortBy
            : undefined,
        ),
        sortOrder: mauiExpression(
          ["displayName", "timeCreated"].includes(String($user?.sort?.sortBy))
            ? $user?.sort?.sortOrder
            : undefined,
        ),
      },
      bind: [
        mauiExpression($app.consoleState?.compartmentId),
        mauiExpression($app.consoleState?.regionName),
      ],
      paginationOptions: {
        pagination: "client",
        preFetchRecords: "all",
      },
    }),
  ],
  triggers: [
    {
      type: "OnLoadTrigger",
      action: CoreServicesApi.GetCrossConnect.action.id,
    },
    {
      type: "OnLoadTrigger",
      action: CrossConnectDetailsActions.triggerGetCknKey,
    },
    {
      type: "OnLoadTrigger",
      action: CrossConnectDetailsActions.triggerGetCakKey,
    },
    {
      type: "TimerTrigger",
      action: CoreServicesApi.GetCrossConnect.action.id,
      interval: TimeInterval.md,
      args: {
        operation: "refresh",
      },
    },
  ],
  apiClients,
};

export default CrossConnectDetailsPage;
