            },
            {
              type: "Select",
              name: VirtualCircuitFieldNames.IgwPeerType,
              label: Messages.VirtualCircuit.form.igwPeerType,
              options: [
                { label: "TRANSIT", value: "TRANSIT" },
                { label: "PEER", value: "PEER" },
              ],
              validators: [
                {
                  type: "required",
                  message: Messages.VirtualCircuit.form.ipMissingError,
                },
              ],
            },
          ],
        },
