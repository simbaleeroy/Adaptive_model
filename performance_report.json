        POST /20160918/images
        {
          "instanceId": "ocid1.instance.oc1.phx.<var>&lt;unique_ID&gt;</var>",
          "compartmentId": "ocid1.compartment.oc1..<var>&lt;unique_ID&gt;</var>",
