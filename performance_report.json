    @Test
    public void testCreateOrUpdateDrgV2Attachment_BmcExceptionAndVC_put_in_FailedState() throws Exception {
        // Arrange
        VirtualCircuitDo virtualCircuitDo = VirtualCircuitDo.builder()
                .id(TEST_EXISTING_VC_ID)
                .gatewayId(TEST_DRG_ID)
                .state(VirtualCircuitDo.State.PROVISIONING)
                .build();

        // Mock the helper to throw BmcException
        VpnRegion vpnRegion = mock(VpnRegion.class);

        // Act and Assert - Test that BmcException is thrown and VC state is updated
        try (Transaction t = drgV2AttachmentBl.beginTransaction("test")) {

            when(drgV2Helper.createDrgV2AttachmentAndDo(t, virtualCircuitDo, anyBoolean()))
                    .thenThrow(new BmcException(500, "test", "test", "test"));


            Method method = VirtualCircuitWorkflowBase.class.getDeclaredMethod("createOrUpdateDrgV2Attachment", Transaction.class, VirtualCircuitDo.class, VpnRegion.class);
            method.setAccessible(true);
            assertThrows(BmcException.class, () -> {
                method.invoke(createVcDrgV2AttachmentWorkflow, t, virtualCircuitDo, vpnRegion);
            });

            t.commit();
            VirtualCircuitDo updatedVc = virtualCircuitBl.getOrThrow(virtualCircuitDo.getId());
            assertThat(updatedVc.getId()).isEqualTo(virtualCircuitDo.getId());
            assertThat(updatedVc.getState()).isEqualTo(VirtualCircuitDo.State.FAILED);
        }
    }
