    @Override
    public CrossConnectDo updateDataObject(CrossConnectDo crossConnectDo, String id,
            Date lastUpdated, String stateComment) {

        return crossConnectDo.toBuilder()
                .id(id)
                .lastUpdated(lastUpdated)
                .stateComment(stateComment)
                .build();
    }

    @Override
    public ArchiveDo delete(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        updateCrossConnectGroupOnDelete(t, crossConnectDo);
        validateNoVirtualCircuitExists(t, crossConnectDo);
        rqsHelper.delete(CrossConnectRqsModel.TYPE, crossConnectDo.getCompartmentId(), crossConnectDo.getId(), t);
        return super.delete(t, crossConnectDo);
    }

    public Optional<CrossConnectGroupDo> deleteAndReturnCcg(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {

        Optional<CrossConnectGroupDo> ccg = updateCrossConnectGroupOnDelete(t, crossConnectDo);
        validateNoVirtualCircuitExists(t, crossConnectDo);

        rqsHelper.delete(CrossConnectRqsModel.TYPE, crossConnectDo.getCompartmentId(), crossConnectDo.getId(), t);
        super.delete(t, crossConnectDo);

        return ccg;
    }

    public CrossConnectDo markForTerminating(
            Transaction t,
            CrossConnectDo crossConnectDo) throws ValidationException {

        return update(t, crossConnectDo.toBuilder()
                .state(State.TERMINATING)
                .lastStateChanged(new Date())
                .build());

    }

    public void validateNoVirtualCircuitExists(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        if (!crossConnectDo.getVcToVlanHelper().getAssociatedIds().isEmpty()) {
            Validation.failCcDeleteExistingVcs(crossConnectDo.getId());
        }

        if (propertiesBl.isVcToVlanMappingEnabled()) {
            if(!vcToVlanMappingBl.getAssociatedVcs(t, crossConnectDo.getId()).isEmpty()){
                Validation.failCcgDeleteExistingVcs(crossConnectDo.getId());
            }
        }
    }

    public Set<String> getAssociatedVirtualCircuits(Transaction t, CrossConnectDo crossConnectDo) {

        Set<String> allAssociatedVirtualCircuits = new HashSet<>();
        // Collect associated VCs from crossConnectDo.getVcsToVlans()
        Map<String, Set<Integer>> crossConnectDoVcsToVlans = crossConnectDo.getVcsToVlans();
        if (crossConnectDoVcsToVlans != null) {
            allAssociatedVirtualCircuits.addAll(crossConnectDoVcsToVlans.keySet());
        }

        // Collect associated VCs from vcToVlanMappingBl
        Set<String> vcToVlanMappingBlAssociatedVcs = this.vcToVlanMappingBl.getAssociatedVcs(t, crossConnectDo.getId());

        // merge both sets of associated VCs
        allAssociatedVirtualCircuits.addAll(vcToVlanMappingBlAssociatedVcs);
        return allAssociatedVirtualCircuits;
    }

    protected void updateCrossConnectGroupOnUpdate(Transaction t, CrossConnectDo updated)
        throws ValidationException {

        CrossConnectDo original = getOrThrow(t, updated.getId());
        if (original.getCrossConnectGroupId() != null
                && !original.getCrossConnectGroupId().equals(updated.getCrossConnectGroupId())) {

            remoteCrossConnectFromCrossConnectGroup(t, original);
        }

        if (updated.getCrossConnectGroupId() != null
            && (original.getCrossConnectGroupId() == null
                || !updated.getCrossConnectGroupId().equals(original.getCrossConnectGroupId()))) {

            addCrossConnectToCrossConnectGroup(t, updated);
        }
    }

    public Optional<CrossConnectGroupDo> updateCrossConnectGroupOnCreate(Transaction t,
            CrossConnectDo crossConnectDo) throws ValidationException {

        if (crossConnectDo.getCrossConnectGroupId() != null) {
            return Optional.of(addCrossConnectToCrossConnectGroup(t, crossConnectDo));
        }

        return Optional.empty();
    }

    protected Optional<CrossConnectGroupDo> updateCrossConnectGroupOnDelete(Transaction t, CrossConnectDo crossConnectDo)
            throws ValidationException {

        if (crossConnectDo.getCrossConnectGroupId() != null) {
            return remoteCrossConnectFromCrossConnectGroup(t, crossConnectDo);
        }

        return Optional.empty();
    }

    private CrossConnectGroupDo addCrossConnectToCrossConnectGroup(Transaction t, CrossConnectDo crossConnectDo) throws ValidationException {
        CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(t,
                crossConnectDo.getCrossConnectGroupId());
        Set<String> ccIdList = new HashSet<>();
        ccIdList.addAll(Arrays.asList(crossConnectGroupDo.getCrossConnectIds()));

        if(ccIdList.size() == 0) {
            if (!CrossConnectUtils.isMacsecCapableDevice(crossConnectDo.getDeviceId(), deviceBl)) {
                crossConnectGroupDo =  crossConnectGroupDo.toBuilder()
                        .macsecEnabled(null)
                        .encryptionCipher(null)
                        .macsecKey(null)
                        .build();
            } else if (crossConnectGroupDo.getMacsecEnabled() == null) {
                crossConnectGroupDo =  crossConnectGroupDo.toBuilder()
                        .macsecEnabled(Boolean.FALSE)
                        .build();
            }
        }

        ccIdList.add(crossConnectDo.getId());
        return crossConnectGroupBl.update(t, crossConnectGroupDo
                .toBuilder()
                .crossConnectIds(ccIdList.toArray(new String[0]))
                .build());
    }

    private Optional<CrossConnectGroupDo> remoteCrossConnectFromCrossConnectGroup(Transaction t, CrossConnectDo original) throws ValidationException {
        CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(t,
                original.getCrossConnectGroupId());
        Set<String> newList = new HashSet<>();
        newList.addAll(Arrays.asList(crossConnectGroupDo.getCrossConnectIds()));
        newList.remove(original.getId());
        crossConnectGroupDo = crossConnectGroupDo
                .toBuilder()
                .crossConnectIds(newList.toArray(new String[]{}))
                .build();
        return Optional.of(crossConnectGroupBl.update(t, crossConnectGroupDo));
    }

    public List<CrossConnectDo>
        getProvisionedCrossConnects(CrossConnectGroupDo crossConnectGroupDo) throws ValidationException {

        List<CrossConnectDo> crossConnectDos = new ArrayList<>();
        for (String id : crossConnectGroupDo.getCrossConnectIds()) {
            CrossConnectDo crossConnectDo = getOrThrow(id);
            if (crossConnectDo.getState() == CrossConnectDo.State.PROVISIONED) {
                crossConnectDos.add(crossConnectDo);
            }
        }

        return crossConnectDos;
    }

    public String getDeviceIdFromCrossConnectOrGroup(String id) throws ValidationException {

        if (VirtualCircuitBl.isCrossConnectGroup(id)) {
            CrossConnectGroupDo ccgDo = crossConnectGroupBl.getOrThrow(id);
            if (ccgDo.getCrossConnectIds().length != 0) {
                CrossConnectDo ccDo = getOrThrow(ccgDo.getCrossConnectIds()[0]);
                return ccDo.getDeviceId();
            }
        } else {
            CrossConnectDo ccDo = getOrThrow(id);
            return ccDo.getDeviceId();
        }

        return null;
    }

    public DeviceDo getDeviceDoFromCrossConnectOrGroupId(String ccOrCcgId) throws ValidationException {
        String deviceId = getDeviceIdFromCrossConnectOrGroup(ccOrCcgId);
        DeviceDo deviceDo = deviceBl.getOrThrow(deviceId);
        return deviceDo;
    }
    
    /**
     * @return The cross connect DO with the given svlan and pfabclusterid.
     */
    public Optional<CrossConnectDo> getCrossConnectBySVlanAndPFabClusterId(Transaction t, int sVlanNumberForQfx, String pFabClusterId) {

        CrossConnectDo.SVlanAndPFabClusterIdKey key = CrossConnectDo.SVlanAndPFabClusterIdKey.builder()
                .sVlanNumberForQfx(sVlanNumberForQfx)
                .pFabClusterId(pFabClusterId)
                .build();
        List<CrossConnectDo> list = ccSVlanAndPFabClusterIdIndex.get(t, key, 1);
        if (list == null || list.size() == 0) {
            return Optional.empty();
        }
        else {
            return Optional.of(list.get(0));
        }
    }

    /**
     * @return The cross connect DO with the given device Id.
     */
    public List<CrossConnectDo> getCrossConnectByDeviceId(String deviceId) {

        Preconditions.checkNotNull(deviceId, "deviceId should not be null");
        return ScanAllIterable.from(this::list)
                .stream()
                .filter(cc -> {
                    String ccDeviceId = cc.getDeviceId();
                    return (ccDeviceId != null && (ccDeviceId.equals(deviceId)));
                })
                .collect(Collectors.toList());
    }

    public List<CrossConnectDo> getCrossConnectByDeviceId(Transaction t, String deviceId) {

        Preconditions.checkNotNull(deviceId, "deviceId should not be null");
        return deviceIdIndex.get(t, deviceId, getTransactionMaxReads());
    }

    public List<CrossConnectDo> getImpactedCrossConnectsByDeviceId(String deviceId) {

        Preconditions.checkNotNull(deviceId, "deviceId should not be null");

        Map<String, String> deviceIdToLogicalDeviceIdMapping = new HashMap<>();
        return ScanAllIterable.from(this::list)
                .stream()
                .filter(crossConnectDo -> {
                    String physicalDeviceId = crossConnectDo.getDeviceId();
                    String logicalDeviceId = null;

                    if (physicalDeviceId != null) {
                        // Check if the logicalDeviceId is already in the map
                        if (!deviceIdToLogicalDeviceIdMapping.containsKey(physicalDeviceId)) {
                            try {
                                DeviceDo deviceDo = deviceBl.getOrThrow(physicalDeviceId);
                                logicalDeviceId = deviceBl.getMxDeviceFromCrossConnectDevice(deviceDo).getId();
                                deviceIdToLogicalDeviceIdMapping.put(physicalDeviceId, logicalDeviceId);
                            } catch (ValidationException e) {
                                log.error("Failed to fetch logical device for crossConnect : {} on device : {}",
                                        crossConnectDo.getId(), physicalDeviceId);
                                e.printStackTrace();
                                deviceIdToLogicalDeviceIdMapping.put(physicalDeviceId, null); // Avoid repeated lookups for invalid devices
                            }
                        } else {
                            logicalDeviceId = deviceIdToLogicalDeviceIdMapping.get(physicalDeviceId);
                        }
                    }

                    return ((physicalDeviceId != null && physicalDeviceId.equals(deviceId)) ||
                            (logicalDeviceId != null && logicalDeviceId.equals(deviceId)));
                })
                .collect(Collectors.toList());
    }

    public CrossConnectDo.State getAndValidateLifecycleStateInternal(String lifecycleStateInternal) throws ValidationException {

        if (lifecycleStateInternal == null) {
            PublicValidation.failInvalidLifecycleStateInternalFilter(null, CrossConnectDo.State.class.getName());
        }

        CrossConnectDo.State state = null;
        try {
            state = CrossConnectDo.State.create(lifecycleStateInternal);
        } catch (RuntimeException e) {
            PublicValidation.failInvalidLifecycleStateInternalFilter(lifecycleStateInternal, CrossConnectDo.State.class.getName());
        }

        return state;
    }

    public ScanPage<CrossConnectDo> scanByState(CrossConnectDo.State state, int pageSize, Optional<PaginationToken> paginationToken) {
        return paginationToken.map(token -> stateIndex.scan(token, pageSize))
                .orElse(stateIndex.beginPrefixScan(state, pageSize));
    }

    public Optional<FFabQfxCanaryConfig> getFfabQfxCanaryConfig(CrossConnectDo crossConnectDo) throws JsonProcessingException {
        if (crossConnectDo.isFfabQfxCanary()) {
            return Optional.of(mapper.readValue(crossConnectDo.getProperties().get(CrossConnectDo.CC_FFAB_QFX_CANARY_PROPERTY), FFabQfxCanaryConfig.class));
        } else {
            return Optional.empty();
        }
    }

    public Optional<FCAggForFCCanaryConfig> getFcStaticCanaryConfig(CrossConnectDo crossConnectDo) throws JsonProcessingException {
        if (crossConnectDo.isFcStaticCanary()) {
            return Optional.of(mapper.readValue(crossConnectDo.getProperties().get(CrossConnectDo.CC_FC_STATIC_CANARY_PROPERTY), FCAggForFCCanaryConfig.class));
        } else {
            return Optional.empty();
        }
    }
    
    public Boolean isInEdgePop(CrossConnectDo crossConnectDo) {
        LocationDo locationDo = getCrossConnectLocation(crossConnectDo);
        if (locationDo.isEdgePopLocation()) {
            return  Boolean.TRUE;
        }
        
        return  Boolean.FALSE;
    }

    public LocationDo getCrossConnectLocation(CrossConnectDo crossConnectDo) {
        Optional<LocationDo> optionalLocationDo = locationBl.get(crossConnectDo.getLocation());
        if (!optionalLocationDo.isPresent()) {
            // legacy crossConnectDo refer to location by name - https://jira.oci.oraclecorp.com/browse/RSC-5487.
            optionalLocationDo = locationBl.getLocation(crossConnectDo.getLocation());
        }
        LocationDo locationDo = optionalLocationDo.get();
        return locationDo;
    }

    public String getDeviceId(CrossConnectGroupDo crossConnectGroupDo) {
        if (crossConnectGroupDo.getDeviceId() != null ) {
            return crossConnectGroupDo.getDeviceId();
        }

        log.info("Unable to retrieve deviceId from CCgDo with id {}, attempting to retrieve deviceId from associated " +
                "CCs if any", crossConnectGroupDo.getId());

        if( crossConnectGroupDo.getCrossConnectIds().length > 0 ) {
            List<CrossConnectDo> provisionedCrossConnectList = Arrays.stream(crossConnectGroupDo.getCrossConnectIds())
                    .map(this::get)
                    .filter(Optional::isPresent)
                    .map(Optional::get)
                    .filter(ccDo -> ccDo.getState().equals(State.PROVISIONED))
                    .collect(Collectors.toList());
            if (!provisionedCrossConnectList.isEmpty()) {
                log.info("Returning deviceId {} for CCG with Id {} associated to CC with id {}",
                        provisionedCrossConnectList.get(0).getDeviceId(),
                        crossConnectGroupDo.getId(),
                        provisionedCrossConnectList.get(0).getId());
                return provisionedCrossConnectList.get(0).getDeviceId();
            }
        }
        return null;
    }

    public CrossConnectDo backfillTenantId(String ccId, String tenantId, CrossConnectDo _crossConnectDo) throws ValidationException {

        if (tenantId == null) {
            try {
                tenantId = identityMetadataHelper.getTenantId(_crossConnectDo.getCompartmentId());
            } catch (Exception e) {
                log.error("Failed to find the tenantId for compartment {}", _crossConnectDo.getCompartmentId(), e);
                return null;
            }
        }

        if (tenantId == null) {
            return getOrThrow(ccId);
        }
        else {

            try (Transaction t = beginTransaction("backfill-tenantId")) {
                CrossConnectDo cc = getOrThrow(t, ccId);
                if (cc.getTenantId() != null) {
                    return cc;
                } else {
                    CrossConnectDo updatedCc = cc.toBuilder().tenantId(tenantId).build();
                    updatedCc = update(t, updatedCc);
                    t.commit();
                    return updatedCc;
                }

            } catch (CommitConflictException e) {
                throw new RuntimeException("Commit conflict while backfilling tenantId for ccId: " + ccId, e);
            }

        }

    }
}

