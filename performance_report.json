    public static CrossConnectInternal toModel(PatchPanelPortPairBl patchPanelPortPairBl,
                                               LocationBl locationBl,
                                               CrossConnectDo crossConnectDo,
                                               EncryptionManager encryptionManager,
                                               CrossConnectGroupBl crossConnectGroupBl,
                                               DeviceBl deviceBl) {

        String portName = null;
        String locationName = null;
        if (crossConnectDo.getGlobalPopCcMetadata() != null) {
            locationName = crossConnectDo.getGlobalPopCcMetadata().getLocationName();
            portName = crossConnectDo.getGlobalPopCcMetadata().getPortName();
        } else {
            try (Transaction t = patchPanelPortPairBl.beginTransaction("get-interface")) {
                Optional<PatchPanelPortPairDo> pppDo = patchPanelPortPairBl.getPortPairByInterface(t, crossConnectDo.getInterfaceId());
                if (pppDo.isPresent()) {
                    portName = pppDo.get().getCustomerPatchPanelPort();
                }
            }

            try (Transaction t = locationBl.beginTransaction("get-location")) {

                Optional<LocationDo> locDo = locationBl.get(t, crossConnectDo.getLocation());
                if (locDo.isPresent()) {
                    locationName = locDo.get().getName();
                } else {
                    // This should never happen but log in case
                    log.error("CC {} is referring to location {} which doesn't exist",
                            crossConnectDo.getId(), crossConnectDo.getLocation());
                    throw new RenderableException(ErrorCode.InternalError,
                            "Error finding location of CrossConnect");
                }
            }
        }

        String vcsToVlans;
        try {
            vcsToVlans = new ObjectMapper().registerModule(new Jdk8Module()).writeValueAsString(crossConnectDo.getVcsToVlans());
        } catch (JsonProcessingException e) {
            String errorMessage = "Error converting vcsToVlans map to JSON:" + e;
            throw new RenderableException(ErrorCode.InternalError, errorMessage);
        }

        MacsecProperties macsecProperties = null;

        if(CrossConnectUtils.isMacsecCapableDevice(crossConnectDo.getDeviceId(), deviceBl)) {

            MacsecProperties.State state = crossConnectDo.isMacsecEnabled() ? MacsecProperties.State.Enabled : MacsecProperties.State.Disabled;

            MacsecKeyInternal macsecKeyInternal = crossConnectDo.getMacsecKey();
            MacsecPropertiesInternal macsecPropertiesInternal = crossConnectDo.getMacsecPropertiesInternal();
            DeviceDo.EncryptionCipher encryptionCipher = crossConnectDo.getEncryptionCipher();

            if(crossConnectDo.getCrossConnectGroupId() != null) {
                Optional<CrossConnectGroupDo> crossConnectGroupDos = crossConnectGroupBl.get(crossConnectDo.getCrossConnectGroupId());

                if(crossConnectGroupDos.isPresent()) {
                    CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupDos.get();

                    state = crossConnectGroupDo.isMacsecEnabled() ? MacsecProperties.State.Enabled : MacsecProperties.State.Disabled;
                    macsecKeyInternal = crossConnectGroupDo.getMacsecKey();
                    encryptionCipher = crossConnectGroupDo.getEncryptionCipher();
                    macsecPropertiesInternal = crossConnectGroupDo.getMacsecPropertiesInternal();
                }
            }

            MacsecKey macsecKey = null;
            if(macsecKeyInternal != null) {
                macsecKey = MacsecKey.builder()
                        .connectivityAssociationNameSecretId(macsecKeyInternal.getCustomerCknSecretOcid())
                        .connectivityAssociationNameSecretVersion(macsecKeyInternal.getCustomerCknSecretVersion())
                        .connectivityAssociationKeySecretId(macsecKeyInternal.getCustomerCakSecretOcid())
                        .connectivityAssociationKeySecretVersion(macsecKeyInternal.getCustomerCakSecretVersion())
                        .serviceSecretOcid(macsecKeyInternal.getServiceSecretOcid())
                        .build();
            }

            macsecProperties = MacsecProperties.builder()
                    .state(state)
                    .primaryKey(macsecKey)
                    .encryptionCipher(encryptionCipher != null ? MacsecProperties.EncryptionCipher.create(encryptionCipher.name()) : null)
                    .bypassLldp(macsecPropertiesInternal != null?  macsecPropertiesInternal.getBypassLldp() : false)
                    .rekeyPeriod(macsecPropertiesInternal != null? macsecPropertiesInternal.getRekeyPeriod() : 3600)
                    .replayProtectionWindow(macsecPropertiesInternal != null? macsecPropertiesInternal.getReplayProtectionWindow() : 0L)
                    .mkaServerPriority(macsecPropertiesInternal != null? macsecPropertiesInternal.getMkaServerPriority() : 0)
                    .allowUnprotectedTraffic(Optional.ofNullable(macsecPropertiesInternal).map(MacsecPropertiesInternal::getAllowUnprotectedTraffic).orElse(false))
                    .build();
        }

        com.oracle.pic.vpn.model.GlobalPopCcMetadata globalPopCcMetadata = null;
        com.oracle.pic.vpn.db.model.GlobalPopCcMetadata globalPop = crossConnectDo.getGlobalPopCcMetadata();

        if (globalPop != null) {
            globalPopCcMetadata = globalPopCcMetadata.builder()
                    .agentDirectRegion(globalPop.getAgentDirectRegion() != null? globalPop.getAgentDirectRegion().getName() : null)
                    .agentTargetRegion(globalPop.getAgentTargetRegion() != null? globalPop.getAgentTargetRegion().getName() : null)
                    .agentTargetCcId(globalPop.getAgentTargetCcId() != null? globalPop.getAgentTargetCcId() : null)
                    .status(globalPop.getStatus() != null? globalPop.getStatus().toString() : null)
                    .portName(globalPop.getPortName() != null ? globalPop.getPortName() : null)
                    .locationName(globalPop.getLocationName() != null ? globalPop.getLocationName() : null)
                    .build();
        }


        CrossConnectInternal.LifecycleState effectiveState = CrossConnectInternal.LifecycleState.create(crossConnectDo.getState().name());
        TagUtils.Tags tagSet = TagUtils.decodeTags(crossConnectDo.getTags());

        String tenantId = crossConnectDo.getTenantId();

        try {
            return CrossConnectInternal.builder()
                    .id(crossConnectDo.getId())
                    .compartmentId(crossConnectDo.getCompartmentId())
                    .tenancyId(tenantId)
                    .portId(crossConnectDo.getPortId())
                    .deviceId(crossConnectDo.getDeviceId())
                    .interfaceId(crossConnectDo.getInterfaceId())
                    .vcsToVlans(vcsToVlans)
                    .portName(portName)
                    .locationName(locationName)
                    .portSpeedShapeName(crossConnectDo.getPortSpeed())
                    .lifecycleState(effectiveState)
                    .crossConnectGroupId(crossConnectDo.getCrossConnectGroupId())
                    .displayName(crossConnectDo.getDisplayName())
                    .customerReferenceId(crossConnectDo.getCustomerReferenceId())
                    .timeCreated(crossConnectDo.getDateCreated())
                    .freeformTags(tagSet.getFreeformTags())
                    .definedTags(tagSet.getDefinedTags())
                    .interfaceDescr(crossConnectDo.getInterfaceDescr())
                    .macsecProperties(macsecProperties)
                    .globalPopCcMetadata(globalPopCcMetadata)
                    .ociPhysicalDeviceName(CrossConnectUtils.getPhysicalDeviceName(crossConnectDo.getDeviceId(), deviceBl))
                    .ociLogicalDeviceName(CrossConnectUtils.getLogicalDeviceName(crossConnectDo.getDeviceId(), deviceBl))
                    .build();
        } catch (ValidationException e) {
            e.printStackTrace();
            log.error("Failed to read DeviceName.", e);
            throw new RuntimeException("Unexpected ValidationError", e);
        }
    }

    public static CrossConnectStatusInternal crossConnectStatusToModel(CrossConnectStatus status) {

        CrossConnectStatusInternal.EncryptionStatus encryptionStatus = null;
        if (status.getEncryptionStatus() != null) {
            encryptionStatus = CrossConnectStatusInternal.EncryptionStatus.create(status.getEncryptionStatus().getValue());
        }

        return CrossConnectStatusInternal.builder()
                .id(status.getCrossConnectId())
                .interfaceState(CrossConnectStatusInternal.InterfaceState.create(status.getInterfaceState().getValue()))
                .lightLevelIndBm(status.getLightLevelIndBm())
                .lightLevelIndicator(CrossConnectStatusInternal.LightLevelIndicator.create(status.getLightLevelIndicator().getValue()))
                .encryptionStatus(encryptionStatus)
                .build();
    }

    private void validateInterfaceHoldTimerRequest(
            Boolean enableInterfaceHoldTimer,
            Integer interfaceDownTimerValue) throws ValidationException{

        if (enableInterfaceHoldTimer != null && enableInterfaceHoldTimer) {
            if (interfaceDownTimerValue == null || interfaceDownTimerValue < 0 || interfaceDownTimerValue > 3000 || interfaceDownTimerValue%500 != 0){
                PublicValidation.failInvalidDownTimerValue();
            }
        }
    }

    private void validateManagementCreateCrossConnectRequest(
            CreateCrossConnectInternalDetails request,
            String deviceId) throws ValidationException {

        // Make sure near/far fields are not provided.
        if (request.getFarCrossConnectOrCrossConnectGroupId() != null ||
                request.getNearCrossConnectOrCrossConnectGroupId() != null) {
            PublicValidation.failInvalidCreateRequestForCrossConnect();
        }

        // If CC is part of a group make sure group deviceId is same as deviceId passed in
        if (StringUtils.isNotBlank(request.getCrossConnectGroupId())) {

            String ccgDeviceId =
                    crossConnectBl.getDeviceIdFromCrossConnectOrGroup(request.getCrossConnectGroupId());
            if (ccgDeviceId != null && !ccgDeviceId.equals(deviceId)) {
                PublicValidation.failInvalidCreateRequestForCrossConnect();
            }
        }
    }

    @POST
    @Timed(name = "create-crossconnect")
    @VpnSkipAuthorization
    public Response createCrossConnect(
            @NonNull @HeaderParam("deviceId") String deviceId,
            @HeaderParam("interfaceName") String interfaceName,
            @HeaderParam("isQinQ") String isQinQ,
            @Valid @NonNull CreateCrossConnectInternalDetails requestInternal) throws Exception {

        validateManagementCreateCrossConnectRequest(requestInternal, deviceId);
        TagUtils.validateTags(requestInternal.getFreeformTags(), requestInternal.getDefinedTags());

        CreateCrossConnectDetails request = convert(requestInternal);

        try (MetricsScope scope = MetricsScope.parent(MetricConstants.CrossConnect.API_CREATE_CROSSCONNECT, true, false);
             Transaction t = crossConnectBl.beginTransaction("create-CrossConnect")) {

            Optional<InterfaceDo> interfaceDoOpt = interfaceBl.getInterfaceByName(t, interfaceName, deviceId);
            if (!interfaceDoOpt.isPresent()) {
                PublicValidation.failInvalidCreateRequestForCrossConnect();
            }

            boolean enableQinQ = false;

            if (isQinQ != null) {
                enableQinQ = Boolean.parseBoolean(isQinQ);
            }
            String tenantId = identityHelper.getTenantId(requestInternal.getCompartmentId());
            InterfaceDo interfaceDo = interfaceDoOpt.get();
            InterfaceDo.PortSpeed portSpeed = CrossConnectResource.validateAndReturnPortSpeed(request, tenantId, tenancyMetadataBl);
            Optional<LocationDo> optionalLocationDo = locationBl.getLocation(t, requestInternal.getLocationName());
            if (!optionalLocationDo.isPresent()) {
                PublicValidation.failInvalidLocation(requestInternal.getLocationName());
            }

            DeviceDo deviceDo = deviceBl.getOrThrow(interfaceDo.getDeviceId());
            if (enableQinQ) {
                // QinQ supported only on QFX devices.
                if (!deviceBl.isQfxSwitchRole(deviceDo)) {
                    throw new ValidationException(ErrorCode.InvalidParameter, "CrossConnect with QinQ is supported only on QFX devices.");
                }

                if (requestInternal.getCrossConnectGroupId() != null) {
                    throw new ValidationException(ErrorCode.InvalidParameter,
                            "Crossconnect with QinQ is not supported for crossconnects which are part of CrossConnectGroup.");
                }
            }

            MacsecProperties macsecProperties = requestInternal.getMacsecProperties();
            MacsecPropertiesInternal macsecPropertiesInternal = null;

            if(macsecProperties != null && macsecProperties.getState().equals(MacsecProperties.State.Enabled)){
                if(request.getCrossConnectGroupId() != null) {
                    PublicValidation.failInvalidCrossConnectUpdateRequest();
                }

                if(macsecProperties.getEncryptionCipher() == null) {
                    PublicValidation.failNullEncryptionCipher();
                }
                macsecPropertiesInternal = MacsecPropertiesInternal.builder()
                        .bypassLldp(macsecProperties.getBypassLldp() != null? macsecProperties.getBypassLldp() : false)
                        .mkaServerPriority(macsecProperties.getMkaServerPriority() != null? macsecProperties.getMkaServerPriority() : 0)
                        .replayProtectionWindow(macsecProperties.getReplayProtectionWindow() != null ? macsecProperties.getReplayProtectionWindow() : 0L)
                        .rekeyPeriod(macsecProperties.getRekeyPeriod() != null ? macsecProperties.getRekeyPeriod() : 3600)
                        .allowUnprotectedTraffic(Optional.ofNullable(macsecProperties).map(MacsecProperties::getAllowUnprotectedTraffic).orElse(false))
                        .build();
            }
            if (StringUtils.isNotBlank(requestInternal.getCrossConnectGroupId())) {
                CrossConnectResource.validateCrossConnectGroup(
                        crossConnectBl,
                        crossConnectGroupBl,
                        virtualCircuitBl,
                        requestInternal.getCrossConnectGroupId(),
                        portSpeed);
            }

            Map<String, String> properties = new HashMap<>();

            Boolean isFcStaticCanary = requestInternal.getCreateQfxStaticCanarySnippetDetails() != null;
            Boolean isFcMx10kStaticCanary = propertiesBl.isTenantWhitelistedForFastConnectStaticCanary(identityHelper.getTenantId(requestInternal.getCompartmentId()))
                    && requestInternal.getFreeformTags() !=null  && requestInternal.getFreeformTags().get(PublicValidation.IS_FC_MX10K_STATIC_CANARY) != null
                    && requestInternal.getFreeformTags().get(PublicValidation.IS_FC_MX10K_STATIC_CANARY_LOOPBACK)!=null;

            if (isFcStaticCanary) {
                // FC static canary supported only on QFX Switches currently
                if (!deviceBl.isCanarySupportedRole(deviceDo)) {
                    throw new ValidationException(ErrorCode.InvalidParameter, "CrossConnect with FC static canary is supported only on QFX Switch devices.");
                }
                // FC static canary supported only on single crossconnects.
                if (StringUtils.isNotEmpty(requestInternal.getCrossConnectGroupId())) {
                    throw new ValidationException(ErrorCode.InvalidParameter, "CrossConnect with FC static canary is supported only on non LAG crossconnects.");
                }

                ObjectMapper mapper = new ObjectMapper().registerModule(new Jdk8Module());
                FCAggForFCCanaryConfig fcAggForFCCanaryConfig = FastConnectCanaryUtils.createFcStaticCanaryConfig(
                        requestInternal.getCreateQfxStaticCanarySnippetDetails(),
                        deviceDo,
                        interfaceDo,
                        regionBgpAsn,
                        vpnApiServiceConfiguration.getFastConnectCanaryBootstrapConfiguration()
                );

                properties.put(CrossConnectDo.CC_FC_STATIC_CANARY_PROPERTY, mapper.writeValueAsString(fcAggForFCCanaryConfig));
            }

            if (requestInternal.getQfx5120CanaryConfigDetails() != null) {
                // FFAB Qfx5120 canary supported only on QFX 5120 devices.
                if (!deviceDo.getRoles().contains(DeviceDo.Role.Qfx5120)) {
                    throw new ValidationException(ErrorCode.InvalidParameter, "CrossConnect with Qfx5120 canary is supported only on QFX 5120 devices.");
                }
                // FFAB Qfx5120 canary supported only on single crossconnects.
                if (StringUtils.isNotEmpty(requestInternal.getCrossConnectGroupId())) {
                    throw new ValidationException(ErrorCode.InvalidParameter, "CrossConnect with Qfx5120 canary is supported only on non LAG crossconnects.");
                }

                ObjectMapper mapper = new ObjectMapper().registerModule(new Jdk8Module()).enable(SerializationFeature.INDENT_OUTPUT);
                FFabQfxCanaryConfig fFabQfxCanaryConfig = createCanaryConfig(requestInternal.getQfx5120CanaryConfigDetails());

                properties.put(CrossConnectDo.CC_FFAB_QFX_CANARY_PROPERTY, mapper.writeValueAsString(fFabQfxCanaryConfig));
            }


            CrossConnectDo crossConnectDo = CrossConnectResource.processCreateCrossConnectRequest(
                    t,
                    request,
                    patchPanelBl,
                    patchPanelPortPairBl,
                    interfaceBl,
                    crossConnectBl,
                    crossConnectGroupBl,
                    eventBl,
                    loaBl,
                    optionalLocationDo.get(),
                    portSpeed,
                    identityHelper.getTenantId(requestInternal.getCompartmentId()),
                    identityHelper.getTenantName(requestInternal.getCompartmentId()),
                    Collections.singletonList(deviceId),
                    true,
                    interfaceDo.getId(),
                    limitsHelper,
                    TagUtils.encodeTags(requestInternal.getFreeformTags(),
                            requestInternal.getDefinedTags()),
                    enableQinQ,
                    propertiesBl,
                    properties,
                    MacsecState.Disabled,
                    null,
                    null,
                    macsecPropertiesInternal,
                    deviceBl,
                    featureController,
                    workRequestBl,
                    vpnRegion,
                    tenancyMetadataBl,
                    request.getDisplayName());

            if (isFcStaticCanary) {
                log.info("Activating the FC static canary CrossConnect. Triggering the workflow");
                crossConnectDo = CrossConnectResource.processUpdateCrossConnectRequest(
                        crossConnectBl,
                        crossConnectGroupBl,
                        eventBl,
                        workRequestBl,
                        deviceBl,
                        t,
                        crossConnectDo,
                        vpnMetering,
                        false,
                        false,
                        false);
            }

            if (isFcMx10kStaticCanary) {
                log.info("Moving the MX10K Static Canary CC into Provisioned");
                CrossConnectDo updated = crossConnectDo.toBuilder()
                        .state(CrossConnectDo.State.PROVISIONED)
                        .dateCreated(new Date())
                        .build();
                crossConnectBl.update(t,updated);
                crossConnectDo = updated;
            }

            validateInterfaceHoldTimerRequest(requestInternal.getEnableInterfaceHoldTimer(), requestInternal.getInterfaceDownTimerValue());
            if (requestInternal.getEnableInterfaceHoldTimer() != null && requestInternal.getEnableInterfaceHoldTimer()){
                log.info("Activating the interface hold timer while creating the crossconnect %s.", crossConnectDo.getId());
                crossConnectDo = crossConnectDo.toBuilder()
                        .enableInterfaceHoldTimer(requestInternal.getEnableInterfaceHoldTimer())
                        .interfaceDownTimeValue(requestInternal.getInterfaceDownTimerValue())
                        .build();
                crossConnectBl.update(t,crossConnectDo);
            }

            if (requestInternal.getInterfaceDescr()!= null) {
                log.info("Adding interface description while creating the crossconnect {}.", crossConnectDo.getId());
                crossConnectDo = crossConnectDo.toBuilder()
                        .interfaceDescr(requestInternal.getInterfaceDescr())
                        .build();
                crossConnectBl.update(t,crossConnectDo);
            }

            Boolean isFakeDevice = deviceDo.isFakeDevice();
            perfMetric.setupScopeDimensions(scope, null, isFakeDevice, null);

            t.commit();
            scope.emit(MetricConstants.SUCCESS, 1);

            CrossConnectInternal.builder()
                    .compartmentId(crossConnectDo.getCompartmentId());

            return Response.ok(toModel(patchPanelPortPairBl, locationBl, crossConnectDo, encryptionManager, crossConnectGroupBl, deviceBl)).build();
        }
    }

    @GET
    @Timed(name = "list-crossConnects")
    @VpnSkipAuthorization
    public PaginatedResponse<CrossConnectInternal> listCrossConnects(
            @DefaultValue("16") @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken,
            @QueryParam(CustomParams.COMPARTMENT_ID) String compartmentId,
            @QueryParam(CustomParams.CROSSCONNECT_GROUP_ID) String crossConnectGroupId,
            @QueryParam(CustomParams.LIFECYCLE_STATE_INTERNAL) String lifecycleStateInternal) throws ValidationException {

        Supplier<ScanPage<CrossConnectDo>> initial = null;
        Function<PaginationToken, ScanPage<CrossConnectDo>> fromToken = null;

        if (compartmentId != null) {
            initial = () -> crossConnectBl.scanForList(compartmentId, null, limit, Optional.empty(), Optional.empty(), Optional.empty());
            fromToken = (PaginationToken p) -> crossConnectBl.scanForList(compartmentId, null, limit,
                    PaginationTokenUtils.deserializeAndValidate(opaqueToken, crossConnectBl.getMappedDataStore()), Optional.empty(), Optional.empty());

        } else if (lifecycleStateInternal != null) {
            CrossConnectDo.State effectiveState = crossConnectBl.getAndValidateLifecycleStateInternal(lifecycleStateInternal);
            initial = () -> crossConnectBl.scanByState(effectiveState, limit, Optional.empty());
            fromToken = (PaginationToken p) -> crossConnectBl.scanByState(effectiveState, limit,
                    PaginationTokenUtils.deserializeAndValidate(opaqueToken, crossConnectBl.getMappedDataStore()));
        }

        if (initial != null) {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    initial,
                    fromToken,
                    CrossConnectResource.filterCrossConnect(crossConnectGroupId, Optional.empty()),
                    crossConnectDo -> toModel(patchPanelPortPairBl, locationBl, crossConnectDo, encryptionManager, crossConnectGroupBl, deviceBl),
                    crossConnectBl.getMappedDataStore()
            );
        }

        return PaginationUtils.getScanPage(
                opaqueToken,
                limit,
                crossConnectBl,
                (crossConnectDo) -> toModel(patchPanelPortPairBl, locationBl, crossConnectDo, encryptionManager, crossConnectGroupBl, deviceBl));

    }

