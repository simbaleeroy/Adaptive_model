          information about NSGs, see
          [NetworkSecurityGroup](#/en/iaas/latest/NetworkSecurityGroup/).
        items:
          type: string
          minLength: 1
          maxLength: 255
        maxItems: 5
        type: array
        uniqueItems: true
      vlanTag:
        description: |
