export const analyzeBulkCrossConnectResults = (
  data: any,
): any /*{ successIds: string[]; failureCount: number }*/ => {
  if (!data || !Array.isArray(data.aggregatedResults)) {
    return { successIds: [], failureCount: 0 };
  }

  const successIds: string[] = [];
  let failureCount = 0;

  data.aggregatedResults.forEach((item: any) => {
    if (item?.id) {
      // success case → has crossConnect id
      successIds.push(item.id);
    } else {
      // failure case → no id but has status/error
      failureCount++;
    }
  });

  return successIds;
  // return { successIds, failureCount };
};

export const getBulkCrossConnectStatus = (
  data: any,
  totalNumberOfCrossConnects: number | "1" | "2" | "3",
  t: MauiTranslate,
): string => {
  const total = Number(totalNumberOfCrossConnects) as 1 | 2 | 3;

  if (!data || !Array.isArray(data.aggregatedResults)) {
    // default state: assume all are in-progress
    return `(${total} of ${total})`;
  }

  let successCount = 0;

  data.aggregatedResults.forEach((item: any) => {
    if (item?.id) {
      successCount++;
    }
  });
  return t("FastConnect.numXOfNumY", [successCount.toString(), total.toString()]);
  // return `(${successCount} of ${total})`;
};

export const convertTags = (
  tagsWrapper: any[] = [],
): {
  freeformTags: Record<string, string>;
  definedTags: Record<string, Record<string, string>>;
} => {
  const freeformTags: Record<string, string> = {};
  const definedTags: Record<string, Record<string, string>> = {};

  // Flatten out all rows from tags -> tags-subForm -> tag-row
  const tagRows = tagsWrapper?.[0]?.["tags-subForm"]?.["tag-row"] ?? [];

  for (const tag of tagRows) {
    const { tagNameSpace, tagKey, tagValue } = tag || {};

    if (!tagKey || !tagValue) continue; // skip invalid or empty

    if (tagNameSpace === "FREEFORM_TAG") {
      // Freeform tag
      freeformTags[tagKey] = tagValue;
    } else {
      // Defined tag
      if (!definedTags[tagNameSpace]) {
        definedTags[tagNameSpace] = {};
      }
      definedTags[tagNameSpace][tagKey] = tagValue;
    }
  }

  return { freeformTags, definedTags };
};

export const getType1Body = (
  user: any,
  vcNumber: number,
  vcList: DEFINITION_CoreServicesApi_FastConnectProviderService[] = [],
) => {
  const formFields = user?.forms?.["intent.fast-connect.create.Step2"]?.$formFields;

  if (vcNumber === 1) {
    const { freeformTags, definedTags } = convertTags(formFields?.tags);
    const providerService = vcList.find(vc => vc.id === formFields?.providerServiceId);
    const res: any = {
      displayName: formFields?.displayName,
      compartmentId: formFields?.compartmentId,
      providerServiceId: formFields?.providerServiceId,
      type: formFields?.type,
      ipMtu: formFields?.ipMtu,
      isBfdEnabled: formFields?.isBfdEnabled,
      bandwidthShapeName: formFields?.bandwidthShapeName,
      customerAsn: formFields?.customerAsn,

      // Default: single mapping with all values
      crossConnectMappings: [
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-0"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-0"],
          customerBgpPeeringIpv6: formFields?.["customerBgpPeeringIpv6-0"],
          oracleBgpPeeringIpv6: formFields?.["oracleBgpPeeringIpv6-0"],
          bgpMd5AuthKey: formFields?.["bgpMd5AuthKey-0"],
        },
      ],

      // Conditionally add PUBLIC props
      ...(formFields?.type === VCTypeEnum.Public && {
        publicPrefixes:
          formFields?.publicPrefixes !== "" ? [{ cidrBlock: formFields?.publicPrefixes }] : [],
        routingPolicy: [formFields?.routingPolicy],
      }),

      // Conditionally add PRIVATE props
      ...(formFields?.type === VCTypeEnum.Private && {
        isTransportMode: formFields?.isTransportMode === TransportTrafficType.ipsecTraffic,
        gatewayId: formFields?.gatewayId,
      }),
       // Conditionally add Internet props
      ...(formFields?.type === VCTypeEnum.Internet && {
        isTransportMode: formFields?.isTransportMode === TransportTrafficType.ipsecTraffic,
        gatewayId: formFields?.gatewayId,
      }),

      freeformTags: freeformTags ?? {},
      definedTags: definedTags ?? {},
    };

    // Case: providerServiceKeyName
    if (shouldShowProviderServiceKeyInput(providerService)) {
      res.providerServiceKeyName = formFields?.providerServiceKeyName;
    }

    // Special case: provider with requiredTotalCrossConnects = 2
    if (providerService && hasTwoCrossConnects(providerService)) {
      res.crossConnectMappings = [
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-0"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-0"],
        },
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-4"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-4"],
        },
      ];
    }

    // Cleanup: remove any mapping where all values undefined
    if (res.crossConnectMappings?.length) {
      res.crossConnectMappings = res.crossConnectMappings.filter(
        (m: any) => !Object.values(m ?? {}).every(v => v === undefined),
      );

      if (res.crossConnectMappings.length === 0) {
        delete res.crossConnectMappings;
      }
    }

    return res;
  } else if (vcNumber === 2) {
    const { freeformTags, definedTags } = convertTags(formFields?.tags1);
    const providerService = vcList.find(vc => vc.id === formFields?.["providerServiceId-1"]);

    const res: any = {
      displayName: formFields?.["displayName-1"],
      compartmentId: formFields?.["compartmentId-1"],
      providerServiceId: formFields?.["providerServiceId-1"],
      type: formFields?.type,
      ipMtu: formFields?.["ipMtu-1"],
      isBfdEnabled: formFields?.["isBfdEnabled-1"],
      bandwidthShapeName: formFields?.["bandwidthShapeName-1"],
      customerAsn: formFields?.["customerAsn-1"],

      // Default: single mapping with all values
      crossConnectMappings: [
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-1"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-1"],
          customerBgpPeeringIpv6: formFields?.["customerBgpPeeringIpv6-1"],
          oracleBgpPeeringIpv6: formFields?.["oracleBgpPeeringIpv6-1"],
          bgpMd5AuthKey: formFields?.["bgpMd5AuthKey-1"],
        },
      ],
      // Conditionally add PUBLIC props
      ...(formFields?.type === VCTypeEnum.Public && {
        publicPrefixes:
          formFields?.["publicPrefixes-1"] !== ""
            ? [{ cidrBlock: formFields?.["publicPrefixes-1"] }]
            : [],
        routingPolicy: [formFields?.["routingPolicy-1"]],
      }),

      // Conditionally add PRIVATE props
      ...(formFields?.type === VCTypeEnum.Private && {
        isTransportMode: formFields?.isTransportMode === TransportTrafficType.ipsecTraffic,
        gatewayId: formFields?.gatewayId,
      }),

       // Conditionally add Internet props
      ...(formFields?.type === VCTypeEnum.Internet && {
        isTransportMode: formFields?.isTransportMode === TransportTrafficType.ipsecTraffic,
        gatewayId: formFields?.gatewayId,
      }),

      freeformTags: freeformTags ?? {},
      definedTags: definedTags ?? {},
    };

    // Case: providerServiceKeyName
    if (shouldShowProviderServiceKeyInput(providerService)) {
      res.providerServiceKeyName = formFields?.["providerServiceKeyName-1"];
    }

    // Special case: provider with requiredTotalCrossConnects = 2
    if (providerService && hasTwoCrossConnects(providerService)) {
      res.crossConnectMappings = [
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-2"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-2"],
        },
        {
          customerBgpPeeringIp: formFields?.["customerBgpPeeringIp-3"],
          oracleBgpPeeringIp: formFields?.["oracleBgpPeeringIp-3"],
        },
      ];
    }

    // Cleanup: remove any mapping where all values undefined
    if (res.crossConnectMappings?.length) {
      res.crossConnectMappings = res.crossConnectMappings.filter(
        (m: any) => !Object.values(m ?? {}).every(v => v === undefined),
      );

      if (res.crossConnectMappings.length === 0) {
        delete res.crossConnectMappings;
      }
    }

    return res;
  }
};
