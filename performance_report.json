    @PUT
    @Timed(name = "UpdateConfigSnippet")
    @Path("/configSnippets/{configsnippet-id}")
    @VpnSkipAuthorization
    public ConfigSnippet updateConfigSnippet(@Valid @NonNull UpdateConfigSnippetRequestDetails request,
                                             @NonNull @PathParam("configsnippet-id") String configSnippetId)
            throws CommitConflictException, IOException, ValidationException {
        ConfigSnippetDo configSnippetDo = configSnippetBl.getOrThrow(configSnippetId);
        ConfigSnippetDo.State requestedState = request.getState() != null
                ? ConfigSnippetDo.State.valueOf(request.getState().toString())
                : ConfigSnippetDo.State.PendingUpdate;
        if (requestedState.toString().equals("PendingDelete")) {
            try (Transaction t = configSnippetBl.beginTransaction("request configSnippet Delete")) {
                configSnippetDo = configSnippetBl.markAsDeleting(t, configSnippetId);
                t.commit();
            }
            return toModel(configSnippetDo);
        }
        String deviceId = request.getDeviceId() != null ? request.getDeviceId() : configSnippetDo.getDeviceId();
        String groupName = request.getGroupName() != null ? request.getGroupName() : configSnippetDo.getGroupName();
        Map<String, Object> newTemplateValues = request.getTemplateValues() == null
                ? configSnippetDo.getTemplateValues()
                : replaceRedactedValues(ResourceUtils.parseStringifyiedJson(
                request.getTemplateValues()), configSnippetDo.getTemplateValues());
        Boolean isActive = request.getIsActive() != null ? request.getIsActive() : configSnippetDo.getIsActive();

        deviceBl.getOrThrow(deviceId);

        configSnippetDo = configSnippetDo.toBuilder()
                .deviceId(deviceId)
                .groupName(groupName)
                .templateValues(newTemplateValues)
                .templateName(request.getTemplateName())
                .overrideTemplate(request.getOverrideTemplate())
                .isActive(isActive)
                .state(requestedState)
                .build();

        try (Transaction t = configSnippetBl.beginTransaction("update an existing config snippet")) {
            configSnippetDo = configSnippetBl.update(t, configSnippetDo);
            log.info("Updating snippet for object {}", request);
            t.commit();
        }
        return toModel(configSnippetDo);
    }

