    private void setUpTenancyMetadata() throws Exception{

        try(Transaction t = tenancyMetadataBl.beginTransaction("add-test-tenant")) {
            TenancyMetadataDo tenancyMetadataDo = tenancyMetadataBl.getOrCreateDefaultTenantMetadata(t,
                    FAKE_CUSTOMER_TENANCY_ID, FAKE_CUSTOMER_TENANCY_ID);
            tenancyMetadataDo = tenancyMetadataDo.toBuilder()
                    .whiteListProperties(new HashMap<String, Boolean>() {{
                        put("ipv6_public_vc_whitelisted", true);
                    }})
                    .build();
            tenancyMetadataBl.update(t, tenancyMetadataDo);
            t.commit();
        }
    }


    private void validateBgpPeerIpsForPublicVc(CrossConnectMapping mapping) throws ValidationException {
        String oracleBgpPeeringIp = mapping.getOracleBgpPeeringIp();
        String customerBgpPeeringIp = mapping.getCustomerBgpPeeringIp();

        assertTrue(Validation.validatePrefixInRange(oracleBgpPeeringIp, "169.254.0.0/16"));
        assertTrue(Validation.validatePrefixInRange(customerBgpPeeringIp, "169.254.0.0/16"));

        // If BGP subnet is 169.254.0.0/30 then next address is Oracle IP (169.254.0.1/30) and next one is Customer IP (169.254.0.2/30).
        String bgpPeeringSubnet = IpUtils.getNetworkAddress(oracleBgpPeeringIp);
        assertEquals(IpUtils.getNextAddress(bgpPeeringSubnet, 1), oracleBgpPeeringIp);
        assertEquals(IpUtils.getNextAddress(bgpPeeringSubnet, 2), customerBgpPeeringIp);
    }

