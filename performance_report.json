            WorkflowInfo info) throws InterruptedException {
        final VirtualCircuitWorkflowArgs arg = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope scope = MetricsScope.parent("createVirtualCircuit.CallVCNControlPlane");
             MetricsScope wfStepScope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arg.getOperationType()), false, false)) {
            perfMetric.setupScopeDimensions(wfStepScope, arg.getOperationType(), arg.getIsFakeDevice(), arg.getIsCustomer());
            return vcWorkflowHelper.withRowValidation(args,
                            state,
                            (trans, ar, row) -> this.createRouteAttachments(scope, trans, ar, row, wfStepScope),
                            (ar, obj, timestamp) -> nextStep(ar, obj, timestamp, Steps.CALL_VCN_CONTROL_PLANE),
                            wfStepScope);
        }
    }

    public VirtualCircuitDo createRouteAttachments(
            MetricsScope scope,
            Transaction t,
            VirtualCircuitWorkflowArgs args,
            VirtualCircuitDo virtualCircuitDo,
            MetricsScope wfStepScope) {

        log.info("Create routing attachment Step.");
        try {

            if (virtualCircuitDo.isPublic()) {
                String msg = String.format("No routing attachments as virtual circuit %s is public.", virtualCircuitDo.getId());

                log.info(msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }

            // Mark existing routing attachments as DETACHED.
            List<RoutingAttachmentDo> existingRoutingAttachments = routingAttachmentBl.getDosByAttachmentIdType(t,
                    virtualCircuitDo.getId(), RoutingAttachmentDo.Type.EdgePopVirtualCircuit);

            for (RoutingAttachmentDo existingRoutingAttachment : existingRoutingAttachments) {
                routingAttachmentBl.update(t, existingRoutingAttachment.toBuilder().state(RoutingAttachmentDo.State.Detached).build());
            }

            boolean isEdgePop = virtualCircuitBl.isEdgePop(virtualCircuitDo);

            // For DRG_V2 transit hub, virtual circuits create DRG attachments by calling PNP to either create or update drg attachment
            // Skip creating RoutingAttachmentDo part as drg v2 does not need it for VCN request
            if (virtualCircuitDo.isDrgV2()) {
                String msg = String.format("Virtual circuit %s is enabled for drg v2, create drg v2 attachment", virtualCircuitDo.getId());
                log.info(msg);

                if (!isEdgePop) {
                    virtualCircuitDo = createOrUpdateDrgV2Attachment(t, virtualCircuitDo);
                } else {
                    VpnRegion edgePop = VpnRegion.fromName(virtualCircuitBl.getEdgePops(virtualCircuitDo).stream().findFirst().get());
                    virtualCircuitDo = createOrUpdateDrgV2Attachment(t, virtualCircuitDo, edgePop);
                }
                eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }

            // For Drg V1, clean up DrgV2Attachment if they exist
            deleteDrgV2Attachment(t, virtualCircuitDo);

            // For Drg V1, create RouteAttachment if edge pop, otherwise skip this step
            if (!isEdgePop) {
                String msg = String.format("No routing attachments as virtual circuit %s is not in edge pop location.", virtualCircuitDo.getId());
                log.info(msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            } else {

                DrgDo drgDo = drgBl.getOrThrow(virtualCircuitDo.getGatewayId());
                List<RoutingAttachmentDo> currentRoutingAttachments = new ArrayList<>();

                Set<String> edgePops = virtualCircuitBl.getEdgePops(virtualCircuitDo);
                VpnRegion vpnRegion = VpnRegion.fromName(edgePops.stream().findFirst().get());
                String edgePopRouteTarget = DrgBl.getEdgePopRouteTarget(vpnRegion, drgDo);

                RoutingAttachmentDo routingAttachmentDo = RoutingAttachmentDo.builder()
                        .id(UUID.randomUUID().toString())
                        .resourceId(virtualCircuitDo.getGatewayId())
                        .attachmentId(virtualCircuitDo.getId())
                        .regionName(vpnRegion.getName())
                        .routeTarget(edgePopRouteTarget)
                        .type(RoutingAttachmentDo.Type.EdgePopVirtualCircuit)
                        .state(RoutingAttachmentDo.State.Attached)
                        .build();

                // log that these edge pops attachments were created.
                routingAttachmentDo = routingAttachmentBl.create(t, routingAttachmentDo);
                currentRoutingAttachments.add(routingAttachmentDo);

                String msg = String.format("Created routing attachments %s for virtual circuit %s in edge pops %s.", currentRoutingAttachments, virtualCircuitDo.getId(), edgePops);
                log.info(msg);
                eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                perfMetric.emitTillNowTimeInMs(wfStepScope, MetricConstants.waitCompleteTime(Steps.CREATE_ROUTING_ATTACHMENTS), args.getInitialTimeEpochMs());
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }
        } catch (ValidationException | AuthServerUnavailableException e) {
            if (virtualCircuitDo != null) {
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
                String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                throw vcWorkflowHelper.terminateRRWorkflow("Failed to create routing attachments",
                    e, CreateVirtualCircuitFailures.ValidationFailure, virtualCircuitDo, portSpeed, drgV2AttachmentDo);
            }
            // Exit workflow, dont commit anything intermediate.
            // Exit workflow, dont commit anything intermediate.
            throw vcWorkflowHelper.terminateRRWorkflow("Failed to create routing attachments",
                    e, CreateVirtualCircuitFailures.ValidationFailure);
        }
    }

    /////////////////////////////////////////////////////////////////////////////////////
    //// Call VCN Control Plane - Only if virtual circuit is at an edge pop location ////
    ////////////////////////////////////////////////////////////////////////////////////

    @Step(name = Steps.CALL_VCN_CONTROL_PLANE,
            numAssignmentsBeforeFailure = DEFAULT_NUMBER_OF_ALLOWED_ASSIGNMENTS,
            assignmentTTLMillis = DEFAULT_ASSIGNMENT_TIME_MILLIS,
            leaseTTLMillis = DEFAULT_LEASE_TIME_MILLIS)
    public StepResult<BasicWorkflowState> callVCNControlPlane(
            RowRevisionSensitiveWorkflowArgs<VirtualCircuitWorkflowArgs> args,
            BasicWorkflowState state,
            WorkflowInfo info) throws InterruptedException {
        final VirtualCircuitWorkflowArgs arg = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope scope = MetricsScope.parent("createVirtualCircuit.CallVCNControlPlane");
             MetricsScope wfStepScope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arg.getOperationType()), false, false)) {
            perfMetric.setupScopeDimensions(wfStepScope, arg.getOperationType(), arg.getIsFakeDevice(), arg.getIsCustomer());
            return vcWorkflowHelper.withRowValidation(args,
                            state,
                            (a, b, c) -> this.callVCNControlPlane(scope, a, b, c, wfStepScope),
                            (ar, obj, timestamp) -> nextStep(ar, obj, timestamp, Steps.CREATE_DEVICE_CONFIG),
                            wfStepScope);
        }
    }

    public VirtualCircuitDo callVCNControlPlane(
            MetricsScope scope,
            Transaction t,
            VirtualCircuitWorkflowArgs args,
            VirtualCircuitDo virtualCircuitDo,
            MetricsScope wfStepScope) {

        log.info("Call VCN control plane Step.");
        try {

            if (virtualCircuitDo.isPublic()) {
                String msg;

                msg = String.format("Skipping calling VCN control plane as virtual circuit %s is public.", virtualCircuitDo.getId());

                log.info(msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }

            if (virtualCircuitDo.isDrgV2()) {
                String msg = String.format("Skipping calling VCN control plane as virtual circuit %s is drg v2.", virtualCircuitDo.getId());

                log.info(msg);
                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }

            String drgId = virtualCircuitDo.getGatewayId();
            Preconditions.checkNotNull(drgId);

            List<RoutingAttachmentDo> existingRoutingAttachments = routingAttachmentBl.getDosByAttachmentIdType(t,
                    virtualCircuitDo.getId(), RoutingAttachmentDo.Type.EdgePopVirtualCircuit);

            Set<String> drgsToUpdate = existingRoutingAttachments.stream()
                    .filter(r -> r.getType().equals(RoutingAttachmentDo.Type.EdgePopVirtualCircuit))
                    .map(RoutingAttachmentDo::getResourceId)
                    .collect(Collectors.toSet());

            if (drgsToUpdate.isEmpty()) {
                String msg = String.format("Skipping calling VCN control plane as no DRGs need to be updated for virtual circuit %s.", virtualCircuitDo.getId());
                log.info(msg);

                MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
                emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
                return virtualCircuitDo;
            }

            boolean rpcToOnPremEnabled = WorkflowHelper.isrpcToOnPremEnabled(identityMetadataHelper, propertiesBl, tenancyMetadataBl, featureController, virtualCircuitDo.getCompartmentId());

            for (String updateDrg : drgsToUpdate) {
                Map<String, Set<String>> peerDrgRTsByPeerRegion = GatewayRouteTargetsManager.getPeerRTsByPeerRegionForGateway(t, remotePeeringConnectionBl,
                        routingAttachmentBl, updateDrg);

                SetDrgRouteDataDetails drgRouteDataDetails = GatewayRouteTargetsManager.createRouteDetails(peerDrgRTsByPeerRegion, rpcToOnPremEnabled);

                SetDrgRouteDataRequest setDrgRouteDataRequest=  SetDrgRouteDataRequest.builder()
                        .setDrgRouteDataDetails(drgRouteDataDetails)
                        .drgId(updateDrg)
                        .build();
                vcnInternalClientHelper.getVcnInternalService().setDrgRouteData(setDrgRouteDataRequest);

                String msg = String.format("Calling VCN control plane for DRG %s route data %s.", updateDrg, drgRouteDataDetails.getRouteData());
                log.info(msg);
                eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, msg);
            }

            // Also delete detached routing attachments.
            List<RoutingAttachmentDo> detachedRoutingAttachments = routingAttachmentBl.getDosByAttachmentIdType(t,
                    virtualCircuitDo.getId(), RoutingAttachmentDo.Type.EdgePopVirtualCircuit).stream()
                    .filter(r -> r.getState().equals(RoutingAttachmentDo.State.Detached))
                    .collect(Collectors.toList());

            for (RoutingAttachmentDo routingAttachmentDo : detachedRoutingAttachments) {
                routingAttachmentBl.delete(t, routingAttachmentDo);
            }

            MetricsUtil.emitOnePositive(scope, WorkflowResult.WorkflowSuccess);
            emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
            perfMetric.emitTillNowTimeInMs(wfStepScope, MetricConstants.waitCompleteTime(Steps.CALL_VCN_CONTROL_PLANE), args.getInitialTimeEpochMs());
            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);
            return virtualCircuitDo;
        } catch (IOException | ValidationException e) {
            // Exit workflow, dont commit anything intermediate.
            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
            String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
            DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
            throw vcWorkflowHelper.terminateRRWorkflow("Failed to call VCN control plane.",
                    e, CreateVirtualCircuitFailures.ValidationFailure, virtualCircuitDo, portSpeed, drgV2AttachmentDo);
        }

    }

    ////////////////////////////////////////////////////////////////////////////////
    //// Provisioning - Create Config
    ////////////////////////////////////////////////////////////////////////////////

    @Step(name = Steps.CREATE_DEVICE_CONFIG,
            numAssignmentsBeforeFailure = DEFAULT_NUMBER_OF_ALLOWED_ASSIGNMENTS,
            assignmentTTLMillis = DEFAULT_ASSIGNMENT_TIME_MILLIS,
            leaseTTLMillis = DEFAULT_LEASE_TIME_MILLIS)
    public StepResult<BasicWorkflowState> createDeviceConfigStep(
            RowRevisionSensitiveWorkflowArgs<VirtualCircuitWorkflowArgs> args,
            BasicWorkflowState state,
            WorkflowInfo info) {
        final VirtualCircuitWorkflowArgs arg = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope scope = MetricsScope.parent("createVirtualCircuit.CreateDeviceConfig");
             MetricsScope wfStepScope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arg.getOperationType()), false, false)) {
            perfMetric.setupScopeDimensions(wfStepScope, arg.getOperationType(), arg.getIsFakeDevice(), arg.getIsCustomer());
            return vcWorkflowHelper.withRowValidation(args,
                            state,
                            (a, b, c) -> this.createDeviceConfig(scope, a, b, c, wfStepScope, new SecureRandom()),
                            (ar, obj, timestamp) -> nextStep(ar, obj, timestamp, Steps.WAIT_FOR_DEVICE_SYNC),
                            wfStepScope);
        }
    }

    public VirtualCircuitDo createDeviceConfig(
            MetricsScope scope,
            Transaction t,
            VirtualCircuitWorkflowArgs args,
            VirtualCircuitDo virtualCircuitDo,
            MetricsScope wfStepScope,
            SecureRandom random) {

        log.info("Create Device Config Step");

        try {
            if (virtualCircuitDo.getProviderState() != null &&
                    (virtualCircuitDo.getProviderState().equals(ProviderState.INACTIVE))) {

                log.info("Not provisioning because provider state INACTIVE");
                // Remove association to DRGS, CCS, VLANS, IPs that are no longer valid.
                virtualCircuitDo = virtualCircuitBl.makeAssociationsCurrent(t, virtualCircuitDo);

                // When provider state is INACTIVE, release BGP peer subnets no longer used by public virtual circuits.
                if (virtualCircuitDo.isPublic()) {
                    virtualCircuitBl.releaseUnusedBgpPeeringSubnets(t, virtualCircuitDo);
                }

                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);

                return virtualCircuitDo.toBuilder()
                        .state(State.PROVISIONED)
                        .lastStateChanged(new Date())
                        .build();
            }

            // Note this increments the transaction count.

            virtualCircuitBl.validateNetworkingForWorkflow(virtualCircuitDo, t);
            Optional<PropertiesDo> internalVcCompartmentIdOptional = propertiesBl.get(t, IPNetworkVCNConnectionBl.OCI_CLASSIC_INTEGRATION_TENANT_COMPARTMENT);
            String tenantId = identityMetadataHelper.getTenantId(virtualCircuitDo.getCompartmentId());

            List<UnitNumberDo> assocUnitNumberDos = unitNumberBl.getUnitNumbersByAssocObj(t, virtualCircuitDo.getId());
            Map<String, UnitNumberDo> deviceIdUnitNumberMap = new HashMap<>();

            for(UnitNumberDo unitNumberDo : assocUnitNumberDos) {
                deviceIdUnitNumberMap.put(unitNumberDo.getDeviceId(), unitNumberDo);
            }

            List<String> deviceIds = new ArrayList<>();

            //release the associated unitNumber from each device that we are deprovisioning the VC from.
            if(deviceIdUnitNumberMap != null  && deviceIdUnitNumberMap.size() > 0) {

                for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {

                    boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
                    CrossConnectGroupDo crossConnectGroupDo = null;
                    CrossConnectDo crossConnectDo;
                    DeviceDo crossConnectDeviceDo;
                    DeviceDo mxDeviceDo;
                    // get deviceId
                    if (isCrossConnect) {
                        crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
                    } else {
                        crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                        crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectGroupDo.getCrossConnectIds()[0]);
                    }
                    crossConnectDeviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
                    mxDeviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(t, crossConnectDeviceDo);
                    deviceIds.add(mxDeviceDo.getId());
                }

                for(String deviceId : deviceIds) {
                    if(deviceIdUnitNumberMap.containsKey(deviceId)) {
                        deviceIdUnitNumberMap.remove(deviceId);
                    }
                }

                if(deviceIdUnitNumberMap.size() > 0) {
                    unitNumberBl.deleteUnitNumbers(t, new ArrayList(deviceIdUnitNumberMap.values()), virtualCircuitDo.getId());
                }
            }

            for (Mapping mapping : virtualCircuitDo.getCrossConnectMapping().getMappings()) {
                // CrossConnect
                DeviceDo ccOrCcgdeviceDo;

                boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
                CrossConnectGroupDo crossConnectGroupDo = null;
                CrossConnectDo crossConnectDo;
                // get device
                if (isCrossConnect) {
                    crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
                    ccOrCcgdeviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
                } else  {
                    crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                    crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectGroupDo.getCrossConnectIds()[0]);
                    ccOrCcgdeviceDo = deviceBl.getOrThrow(t, crossConnectDo.getDeviceId());
                }

                // get interface name like xe10 or ae40 etc.
                String interfaceName;
                Integer sVlan = null;
                if (deviceBl.isSwitchRole(ccOrCcgdeviceDo)) {
                    if (deviceBl.isQfxSwitchRole(ccOrCcgdeviceDo)) {
                        validateQfxDeviceConfig(ccOrCcgdeviceDo, virtualCircuitDo);
                        interfaceName = ccOrCcgdeviceDo.getCcgsBetweenMxAndQfx().get(0).getConnectToDeviceInterfaceId();
                    } else{
                        validateAristaFcAggDeviceConfig(ccOrCcgdeviceDo, virtualCircuitDo);
                        interfaceName = ccOrCcgdeviceDo.getDeviceConfig().getConnectionToMxList().get(0).getConnectToDeviceInterfaceId();
                    }
                    if (isCrossConnect) {
                        sVlan = crossConnectDo.getSVlanNumberForQfx();
                    } else {
                        sVlan = crossConnectGroupDo.getSVlanNumberForQfx();
                    }

                    // FastConnect Static Canary virtual circuit, we hard code last two digits of displayname to be its sVlan
                    // The reason we are doing this is we have two virtual circuits provisioning on same CC with two different sVlan
                    // e.g. Two displaynames of the VC: "FCStaticCanary-ConnectingRemotefcagg-20", "FCStaticCanary-ConnectingLocalfcagg-20"
                    Boolean svlanInTags = false;
                    if (propertiesBl.isTenantWhitelistedForFastConnectStaticCanary(tenantId)) {
                        if (virtualCircuitDo.getTags() != null) {
                            TagUtils.Tags tags = TagUtils.decodeTags(virtualCircuitDo.getTags());
                            if (tags != null) {
                                Map<String, String> freeFormTags = tags.getFreeformTags();
                                if (!freeFormTags.isEmpty() && freeFormTags.containsKey(SVLAN)) {
                                    svlanInTags = true;
                                    sVlan = Integer.parseInt(freeFormTags.get(SVLAN));
                                }
                            }
                        }
                        if (!svlanInTags && virtualCircuitDo.getDisplayName().startsWith(FC_STATIC_CANARY_PREFIX)) {
                            try {
                                sVlan = Integer.parseInt(virtualCircuitDo.getDisplayName().substring(virtualCircuitDo.getDisplayName().length() - 2));
                            } catch (Exception e) {
                                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                                throw new NonRetryableException(
                                        String.format("For FC static canary VC, missing svlan for virtualCircuitDo %s.", virtualCircuitDo.getId()));
                            }
                        }
                    }

                    if (sVlan == null) {
                        serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                        throw new ValidationException(ErrorCode.InternalError,
                                String.format("Missing svlan for virtualCircuitDo %s.", virtualCircuitDo.getId()),
                                CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
                    }
                } else {
                    if (isCrossConnect) {
                        interfaceName = crossConnectDo.getInterfaceId();
                        if (!StringUtils.startsWith(interfaceName, VPN_FC_INTF_PREFIX)) {
                            InterfaceDo interfaceDo = interfaceBl.getOrThrow(interfaceName);
                            interfaceName = interfaceDo.getName();
                        }
                        log.info("Virtual Circuit {} will be configured on the cross-connect {} on interface {}",
                                virtualCircuitDo.getId(), crossConnectDo.getId(), interfaceName);
                    } else {
                        interfaceName = crossConnectGroupDo.getInterfaceId();
                        log.info("Virtual Circuit {} will be configured on the cross-connect group {} on interface {}",
                                virtualCircuitDo.getId(), crossConnectGroupDo.getId(), interfaceName);
                    }
                }

                VirtualCircuitConfig.Builder vcConfigBuilder = VirtualCircuitConfig.builder()
                        .ocid(virtualCircuitDo.getId())
                        .groupId(virtualCircuitDo.getGroupId())
                        .compartmentId(virtualCircuitDo.getCompartmentId())
                        .crossConnectOrCcGroupInterfaceName(interfaceName)
                        .sVlanNumber(sVlan);

                if (internalVcCompartmentIdOptional.isPresent() && virtualCircuitDo.getCompartmentId().equals(internalVcCompartmentIdOptional.get().getValue())) {
                    List<VirtualCircuitDo> customerVcDos = virtualCircuitBl.getVirtualCircuitByInternalVcId(t, virtualCircuitDo.getId());
                    if (customerVcDos.size() == 1) {
                        // this is an internal Vc for oci-classic, overwrite with customer VcId
                        VirtualCircuitDo customerVcDo = customerVcDos.get(0);
                        vcConfigBuilder = vcConfigBuilder
                                .ocid(customerVcDo.getId())
                                .groupId(customerVcDo.getGroupId())
                                .compartmentId(customerVcDo.getCompartmentId());
                    }
                }

                String oracleBgpPeeringIp = mapping.getOracleBgpPeeringIp();
                String remoteBgpPeeringIp = mapping.getRemoteBgpPeeringIp();

                String oracleBgpIp = new SubnetUtils(oracleBgpPeeringIp)
                        .getInfo().getAddress();
                Integer ipv4SubnetMask = Integer.parseInt(mapping.getOracleBgpPeeringIp().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[1]);
                String remoteBgpIp = new SubnetUtils(remoteBgpPeeringIp)
                        .getInfo().getAddress();

                vcConfigBuilder = vcConfigBuilder
                        .oracleBgpIpv4(oracleBgpIp)
                        .remoteBgpIpv4(remoteBgpIp)
                        .ipv4SubnetMask(ipv4SubnetMask)
                        .maxIPv4Prefix(virtualCircuitDo.getMaxPrefix())
                        .bfdEnabled(WorkflowHelper.isBfdEnabled(virtualCircuitDo, propertiesBl));

                DeviceDo mxDeviceDo;
                mxDeviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(t, ccOrCcgdeviceDo);

                //By now all Juniper devices are version 19 and above
                boolean isBgpDisabled = WorkflowHelper.isBgpDisabled(virtualCircuitDo, propertiesBl);
                if (isBgpDisabled) {
                    log.info("Shutting down the virtual circuit as BGP is disabled");
                    vcConfigBuilder = vcConfigBuilder.isBgpDisabled(true);
                }

                if(StringUtils.isNotBlank(mapping.getRemoteBgpPeeringIpv6()) &&
                        StringUtils.isNotBlank(mapping.getOracleBgpPeeringIpv6())) {
                    //TODO [IPV6]: Change the below parameters to get it from IpUtils, once it is updated

                    vcConfigBuilder = vcConfigBuilder
                            .oracleBgpPeeringIpv6(mapping.getOracleBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[0])
                            .remoteBgpPeeringIpv6(mapping.getRemoteBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[0])
                            .ipv6SubnetMask(Integer.valueOf(mapping.getOracleBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[1]))
                            .maxIPv6Prefix(virtualCircuitDo.getMaxIPv6Prefix());
                }

                Integer vcUnitNumberForQfx = null;
                if (deviceBl.isSwitchRole(ccOrCcgdeviceDo)) {
                    vcUnitNumberForQfx = virtualCircuitDo.getVcUnitNumberForQfx();
                    // assign vcUnitNumber if there isn't any null or 0
                    if (vcUnitNumberForQfx == null) {
                        virtualCircuitDo = generateVcUnitNumberForQfx(virtualCircuitBl, virtualCircuitDo, crossConnectBl, crossConnectGroupBl, deviceBl, t, propertiesBl.isUnitNumberFixEnabled(), random);
                        vcUnitNumberForQfx = virtualCircuitDo.getVcUnitNumberForQfx();
                    } else {
                        if (virtualCircuitDo.getCrossConnectMapping() != null){
                            boolean isUnitNumberLeaked =  virtualCircuitBl.isVcUnitNumberLeaked(t,vcUnitNumberForQfx, virtualCircuitDo.getCrossConnectMapping().getMappings(),
                                propertiesBl.isUnitNumberFixEnabled(), virtualCircuitDo.getId());
                            if(isUnitNumberLeaked){
                                log.info("Recovered from vcUnitNumberForQfx Leak");
                                scope.emit("vcUnitNumberForQfxLeak", 1);
                                virtualCircuitDo = generateVcUnitNumberForQfx(virtualCircuitBl, virtualCircuitDo, crossConnectBl, crossConnectGroupBl, deviceBl, t, propertiesBl.isUnitNumberFixEnabled(), random);
                                vcUnitNumberForQfx = virtualCircuitDo.getVcUnitNumberForQfx();
                            }
                        }
                    }
                }

                ConfigPair configPair = null;

                vcConfigBuilder = vcConfigBuilder
                        .vcUnitNumberForQfx(vcUnitNumberForQfx)
                        .sVlanNumber(sVlan)
                        .cVlanNumber(mapping.getVlan());

                String bgpAdSpecifier = mxDeviceDo.getDeviceConfig().getBgpAdSpecifier();

                // Adding local DRG RT as well.
                String localRegionNetworkingName = bgpAdSpecifier.substring(0, 3).toUpperCase(); // Ex PHX, IAD, LHR etc.
                String localAd = JuniperConfigHelper.formatAD(bgpAdSpecifier);
                VpnRegion localRegion = getVpnRegionFromDeviceDo(mxDeviceDo);

                vcConfigBuilder = vcConfigBuilder
                        .localAd(localAd)
                        .localRegion(localRegionNetworkingName)
                        .regionBgpAsn(virtualCircuitDo.getOracleBgpAsn())
                        .remoteBgpAsn(virtualCircuitDo.getRemoteBgpAsn())
                        .remoteAsn(virtualCircuitDo.getRemoteAsn())
                        .ipMTU(virtualCircuitDo.getIpMtu())
                        .bgpMd5AuthKey(mapping.getBgpMd5Authkey());

                if (virtualCircuitDo.getTrafficDrain() != null) {
                    vcConfigBuilder = vcConfigBuilder
                            .trafficDrain(virtualCircuitDo.getTrafficDrain());
                }

                if (propertiesBl.isBandWidthPolicerEnabled() && mxDeviceDo.getDeviceType().equals(DeviceDo.DeviceType.Juniper)){
                        Optional<Boolean> vcBandWidth = Optional.ofNullable(virtualCircuitDo.getEnableBandwidthPolicer());

                        if (vcBandWidth.isPresent() && vcBandWidth.get()){
                            if (virtualCircuitDo.getBandwidthInMbps()== null){
                                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                                throw new ValidationException(ErrorCode.InternalError,
                                        "Bandwidth Policer value not present when trying to enable BandWidth Policer");
                            }

                            vcConfigBuilder = vcConfigBuilder
                                    .enableVCPolicer(virtualCircuitDo.getEnableBandwidthPolicer())
                                    .vcPolicerBandwidthValue(virtualCircuitDo.getBandwidthInMbps().toString());
                        }
                }

                // if this Virtual Circuit is Overlay Bridge Virtual Circuit, add additional parameters to the config
                // API should have already validated the tenancy is whitelisted
                if (virtualCircuitDo.isOverlayBridgeVirtualCircuit()) {
                    log.info("This is Overlay Bridge Virtual Circuit, adding additional parameters to config");

                    vcConfigBuilder = vcConfigBuilder.isOverlayBridgeVC(true);
                    Map<String, Object> overlayBridgeVirtualCircuitParameters = new HashMap<>();
                    TagUtils.Tags tagSet = TagUtils.decodeTags(virtualCircuitDo.getTags());
                    if (tagSet.getFreeformTags().containsKey(VXLAN_PEER_IPADDRESS)
                        && tagSet.getFreeformTags().containsKey(VXLAN_SELF_IPADDRESS)) {
                        overlayBridgeVirtualCircuitParameters.put(VXLAN_PEER_IPADDRESS, tagSet.getFreeformTags().get(VXLAN_PEER_IPADDRESS));
                        overlayBridgeVirtualCircuitParameters.put(VXLAN_SELF_IPADDRESS, tagSet.getFreeformTags().get(VXLAN_SELF_IPADDRESS));
                        overlayBridgeVirtualCircuitParameters.put(VXLAN_INTERFACE_NAME,
                            tagSet.getFreeformTags().getOrDefault(VXLAN_INTERFACE_NAME, VXLAN_INTERFACE_NAME_AE_99).toLowerCase());
                        vcConfigBuilder.overlayBridgeVirtualCircuitParameters(overlayBridgeVirtualCircuitParameters);
                    } else {
                        log.info("P2P address are not found in Freeform tag");
                        // TODO: get point to point address from plan service
                    }
                    log.info("overlayBridgeVirtualCircuitParameters: {}", overlayBridgeVirtualCircuitParameters);
                }

                if (virtualCircuitDo.isPublic()) {

                    vcConfigBuilder = vcConfigBuilder
                            .verifiedIPv4Prefixes(virtualCircuitDo.getVerifiedPublicPrefixes())
                            .verifiedIPv6Prefixes(virtualCircuitDo.getVerifiedIpv6PublicPrefixes());


                    // Public Virtual Circuit.
                    if (!propertiesBl.isMarketPublicPeeringEnabled()) {
                        // If Market Public Peering is set to false, then use the template V2.
                        configPair = new JuniperConfigHelper()
                                .publicVirtualCircuitWithQfx(vcConfigBuilder.build());
                    }
                    else if(propertiesBl.isMarketPublicPeeringEnabled() &&
                            !ALLOWED_MARKET_ROUTES_BY_DEFAULT.contains(localRegion.getOciRealm())) {
                        // If Market Public Peering is enabled and the realm is OC2 and above then use the template V3.
                        // OC2 and above right now does not support Route filtering for public for now
                        // NOTE: This behaviour might change in future.
                        vcConfigBuilder = vcConfigBuilder
                                .exportMarketsForPublic(Collections.singletonList(localRegion.getMarket().getNetworkingName()))
                                .exportRegionsForPublic(VpnRegion.getMarketRegionNetworkingNames(localRegion.getName()))
                                .exportOCICRegionsForPublic(VpnRegion.getMarketOciCNetworkingNames(localRegion.getName()));

                        configPair = new JuniperConfigHelper()
                                    .publicVirtualCircuitV3AtMarketAndOcic(vcConfigBuilder.build());
                    }
                    else {
                        // By default we will use public template V4 for R1 and OC1
                        List<String> exportOCICRegions = Collections.emptyList();

                        // This parameter is only used in V4 for Market level or Global route scope.
                        List<String> marketOrGlobalscope = Collections.emptyList();

                        Map<String, String> regionScope;
                        if (localRegion.isEdgePop()) {
                            VpnRegion homeRegion = localRegion.getEdgePop().getHomeRegion();
                            regionScope = new ImmutableMap.Builder<String,String>()
                                    .put(homeRegion.getNetworkingName(), homeRegion.getMarket().getNetworkingName())
                                    .build();
                        } else {
                            regionScope = new ImmutableMap.Builder<String,String>()
                                    .put(localRegion.getNetworkingName(), localRegion.getMarket().getNetworkingName())
                                    .build();
                        }

                        if(virtualCircuitDo.getRoutingPolicies().isEmpty()
                                || virtualCircuitDo.getRoutingPolicies().contains(RoutingPolicy.MARKET_LEVEL)) {

                            // If the routingPolicy is not set the default policy is Market_LEVEL.
                            // The template supports the route scope for multiple markets, but Route filtering feature is restricting the support for current market.
                            marketOrGlobalscope = Collections.singletonList(localRegion.getMarket().getNetworkingName());

                        } else if(virtualCircuitDo.getRoutingPolicies().contains(RoutingPolicy.GLOBAL)) {
                            marketOrGlobalscope = Collections.singletonList(GLOBAL_ROUTE_SCOPE);
                        }

                        if(virtualCircuitDo.getRoutingPolicies().contains(RoutingPolicy.REGIONAL)
                                && VpnRegion.OCIC_REGION_SCOPE.containsKey(localRegionNetworkingName)) {
                            exportOCICRegions = VpnRegion.OCIC_REGION_SCOPE.get(localRegionNetworkingName);
                        }
                        boolean whitelistedForIpv6 = tenancyMetadataBl.isIpv6PublicVcWhitelisted(tenantId);
                        Integer ipv6SubnetMask = null;
                        if(mapping.getOracleBgpPeeringIpv6() != null){
                            ipv6SubnetMask = Integer.valueOf(mapping.getOracleBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[1]);
                        }

                        vcConfigBuilder = applyDynamicQos(virtualCircuitDo, vcConfigBuilder,
                                false, mxDeviceDo, ccOrCcgdeviceDo,  wfStepScope, t);

                        vcConfigBuilder = vcConfigBuilder
                                .isOsnRoute(virtualCircuitDo.getRoutingPolicies().contains(
                                        RoutingPolicy.ORACLE_SERVICE_NETWORK))
                                .isRegionalRoute(virtualCircuitDo.getRoutingPolicies().contains(
                                        RoutingPolicy.REGIONAL))
                                .regionScope(regionScope)
                                .marketOrGlobalscope(marketOrGlobalscope)
                                .oracleBgpPeeringIpv6(mapping.getOracleBgpPeeringIpv6() != null ? mapping.getOracleBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[0] : null)
                                .verifiedIPv4Prefixes(virtualCircuitDo.getVerifiedPublicPrefixes() != null ? virtualCircuitDo.getVerifiedPublicPrefixes() : null)
                                .verifiedIPv6Prefixes(virtualCircuitDo.getVerifiedIpv6PublicPrefixes() != null ? virtualCircuitDo.getVerifiedIpv6PublicPrefixes() : null)
                                .maxIPv6Prefix(virtualCircuitDo.getMaxIPv6Prefix() != null ? virtualCircuitDo.getMaxIPv6Prefix() : null)
                                .ipv6SubnetMask(ipv6SubnetMask)
                                .remoteBgpPeeringIpv6(mapping.getRemoteBgpPeeringIpv6() != null ? mapping.getRemoteBgpPeeringIpv6().split(IpUtils.IP_ADDRESS_PREFIX_SEPARATOR)[0] : null)
                                .exportOCICRegionsForPublic(exportOCICRegions);

                        if ((whitelistedForIpv6 ||
                                featureController.isTenancyWhitelisted(VpnLimitsClient.VpnProperty.FEATURE_PUBLIC_VC_V6, tenantId)) &&
                                propertiesBl.isPeriodicPublicPrefixRefreshWorkflowEnabled()) {
                            configPair = new JuniperConfigHelper().publicVirtualCircuitV6AtMarketAndOcic(vcConfigBuilder.build());
                        } else {
                            configPair = featureController.isTenancyWhitelisted(VpnLimitsClient.VpnProperty.FEATURE_PUBLIC_VC_V5, tenantId) ?
                                    new JuniperConfigHelper().publicVirtualCircuitV5AtMarketAndOcic(vcConfigBuilder.build()) :
                                    new JuniperConfigHelper().publicVirtualCircuitV4AtMarketAndOcic(vcConfigBuilder.build());
                        }

                    }

                } else {
                    // Private Virtual Circuit.
                    Integer unitNumber;
                    String routeTarget;
                    String routeDistinguisher;
                    String xnetId;

                    if (virtualCircuitDo.isDrg()) {
                        // Drg V1
                        DrgDo drg = drgBl.getOrThrow(virtualCircuitDo.getGatewayId());
                        routeTarget = drg.getRouteTarget();

                        // https://confluence.oci.oraclecorp.com/pages/viewpage.action?spaceKey=RSC&title=ECMP+for+GAP+Use+Case+-+Low+Level+Design
                        if (useEqualCostMultiPath(virtualCircuitDo)) {
                            Optional<Integer> optionalSetId = drg.getSetId();
                            if (!optionalSetId.isPresent()) {
                                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                                throw new ValidationException(ErrorCode.IncorrectState,
                                        "SetId not present for DRG {}", drg.getId());
                            }
                            String anyCaseSetIp = drg.getAnycastSetIp();
                            if (anyCaseSetIp == null || anyCaseSetIp.isEmpty()) {
                                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                                throw new ValidationException(ErrorCode.IncorrectState,
                                        "SetIp not present for DRG {}", drg.getId());
                            }
                            virtualCircuitDo = setOrGetRouteDistinguisher(t, anyCaseSetIp, optionalSetId.get(), virtualCircuitDo);
                            routeDistinguisher = virtualCircuitDo.getRouteDistinguisher();
                            if (!propertiesBl.isDynamicUnitNumberAllocationEnabled()) {
                                String[] rdAsArray = routeDistinguisher.split(":");
                                int rdValue = Integer.parseInt(rdAsArray[1]);
                                unitNumber = MplsTableLabelManager.getUniquePortionForUnits(rdValue);
                            } else {
                                // Assign unitNumber for this VC
                                unitNumber = virtualCircuitBl.getUnitNumberForVc(t, virtualCircuitDo, mxDeviceDo.getId());
                            }
                            virtualCircuitBl.setUnitNumberForEcmpVc(t, virtualCircuitDo, mxDeviceDo.getId(), unitNumber);
                            xnetId = virtualCircuitDo.getGroupId();
                            log.info("FEATURE_EQUAL_COST_MULTI_PATH enabled for VC {}, using RD {}",
                                    virtualCircuitDo.getId(), routeDistinguisher);
                        } else {
                            // Assign unitNumber for this VC
                            UnitNumberDo unitNumberDo = virtualCircuitBl.assignAndSetOrGetUnitNumberForVC(t, virtualCircuitDo, mxDeviceDo.getId());
                            unitNumber = unitNumberDo.getUnitNumber();

                            routeDistinguisher = routeTarget;
                            virtualCircuitDo = virtualCircuitBl.removeRouteDistinguisherIfNeeded(virtualCircuitDo);
                            xnetId = drg.getGroupId();
                            log.info("FEATURE_EQUAL_COST_MULTI_PATH disabled for VC {}, using RD {}",
                                    virtualCircuitDo.getId(), routeDistinguisher);
                        }

                    } else if (virtualCircuitDo.isDrgV2()) {
                        // Drg V2
                        List<DrgV2AttachmentDo> drgV2AttachmentDos = drgV2AttachmentBl.listByAttachedResourceId(t, virtualCircuitDo.getId());
                        if (drgV2AttachmentDos.size() != 1) {
                            String msg = String.format("Failed to create snippets for provisioning due to" +
                                    " not single drg v2 attachment for VC: %s", virtualCircuitDo.getId());
                            log.error(msg);
                            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                            String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                            Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, null);
                            throw vcWorkflowHelper.terminateRRWorkflow(msg, CreateVirtualCircuitFailures.MultipleDrgV2Attachments, dimensions);
                        }

                        routeTarget = null;
                        String importEpRouteTarget = drgV2AttachmentDos.get(0).getImportEPRouteTarget();
                        String exportEpRouteTarget = drgV2AttachmentDos.get(0).getExportEPRouteTarget();

                        // All new RD should use import RT, existing ones can keep using its original one (exportRT)
                        // but if new RT arrives, we should use importRT as RD
                        if (virtualCircuitDo.getRouteDistinguisher() == null) {
                            routeDistinguisher = importEpRouteTarget;
                        } else {
                            routeDistinguisher = virtualCircuitDo.getRouteDistinguisher();
                        }

                        // And create a new group id when RD changes to prevent hitting the juniper bug
                        // (Juniper has a bug when we update the RouteDistinguisher for an existing VRF.)
                        boolean isXnetIdChanging = false;
                        if (virtualCircuitDo.getRouteDistinguisher() != null
                                && !virtualCircuitDo.getRouteDistinguisher().equals(importEpRouteTarget)
                                && !virtualCircuitDo.getRouteDistinguisher().equals(exportEpRouteTarget)) {
                            String newGroupId = UUID.randomUUID().toString();
                            virtualCircuitDo = virtualCircuitDo.toBuilder().groupId(newGroupId).build();
                            vcConfigBuilder = vcConfigBuilder.groupId(newGroupId);
                            routeDistinguisher = importEpRouteTarget;
                            isXnetIdChanging = true;
                        }
                        virtualCircuitDo = virtualCircuitDo.toBuilder().routeDistinguisher(routeDistinguisher).build();

                        // Assign unitNumber for this VC
                        UnitNumberDo unitNumberDo = virtualCircuitBl.assignAndSetOrGetUnitNumberForVC(t, virtualCircuitDo, mxDeviceDo.getId(), isXnetIdChanging);
                        unitNumber = unitNumberDo.getUnitNumber();
                        xnetId = virtualCircuitDo.getGroupId();

                        // import and export are opposite for JUniper and El Paso
                        vcConfigBuilder = vcConfigBuilder
                                .importRouteTargets(Arrays.asList(exportEpRouteTarget))
                                .exportRouteTargets(Arrays.asList(importEpRouteTarget));

                        String commonRT = drgV2AttachmentDos.get(0).getCommonExportRT();
                        boolean isRouteUnificationEnabled = drgV2AttachmentDos.get(0).isRouteUnificationEnabled();
                        boolean enabledTelesisAqua = virtualCircuitDo.isTelesisAqua() && (mxDeviceDo.getRoles().contains(DeviceDo.Role.FastConnectMx10k4) || mxDeviceDo.getRoles().contains(DeviceDo.Role.FastConnectMx304));
                        boolean enabledIngressDisintermediation = isIngressDisintermediationEnabled(mxDeviceDo, virtualCircuitDo);
                        boolean enabledIngressDisintermediationPnpFlag = drgV2AttachmentDos.get(0).isIngressDisintermediation();

                        //set common rt in the vc config if:
                        // 1. vc is enabled for telesis Aqua and landing on mx10k4/mx304 device
                        // 2. device has ingressDisintermediation feature flag and is mx304 device
                        if (enabledIngressDisintermediation || enabledTelesisAqua) {

                            log.info("IngressDisintermediation {}, IsTelesisAqua {} ", enabledIngressDisintermediation, enabledTelesisAqua);
                            vcConfigBuilder = setCommonRtDetailsForIngressDisintermediation(vcConfigBuilder, commonRT, scope, args, virtualCircuitDo, drgV2AttachmentDos.get(0));

                        } else if (enabledIngressDisintermediationPnpFlag) {
                            if (isRouteUnificationEnabled) {
                                log.info("IngressDisintermediation enabled VC");
                                vcConfigBuilder = setCommonRtDetailsForIngressDisintermediation(vcConfigBuilder, commonRT, scope, args, virtualCircuitDo, drgV2AttachmentDos.get(0));
                            } else {
                                serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                                String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                                Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, drgV2AttachmentDos.get(0));
                                String msg = String.format("Failed to create snippets for provisioning due to" +
                                    " RouteUnification should be true for Ingress Disintermediated VCs : %s", virtualCircuitDo.getId());
                                log.error(msg);
                                throw vcWorkflowHelper.terminateRRWorkflow(msg, CreateVirtualCircuitFailures.ValidationFailure, dimensions);
                            }
                        } else if (isRouteUnificationEnabled) {
                            log.info("RouteUnification Enabled VC");
                            vcConfigBuilder = vcConfigBuilder.enablePrivateFCRouteUnification(true);
                            vcConfigBuilder = vcConfigBuilder.commonRouteTarget(commonRT);
                        }
                        if (enabledTelesisAqua) {
                            vcConfigBuilder = vcConfigBuilder.isTelesisAqua(true);
                            if (mxDeviceDo.isStaticQosEnabled()){
                                vcConfigBuilder = vcConfigBuilder.telesisStaticEgressQOSEnabled(true);
                            }
                        } else if (enabledIngressDisintermediation || enabledIngressDisintermediationPnpFlag) {
                            vcConfigBuilder = vcConfigBuilder.ingressDisintermediation(true);
                        }

                        if (mxDeviceDo.getRoles().contains(DeviceDo.Role.Qfx5120) ||mxDeviceDo.getRoles().contains(DeviceDo.Role.AristaFfabT1)  ) {

                            Integer ipMTU = Optional.ofNullable(virtualCircuitDo.getIpMtu())
                                    .orElse(VirtualCircuitBl.IP_MTU_9000);

                            virtualCircuitDo = virtualCircuitDo.toBuilder().ipMtu(VirtualCircuitBl.IP_MTU_9000).build();

                            vcConfigBuilder = vcConfigBuilder
                                    .isTelesis(true)
                                    .ipMTU(ipMTU)
                                    .vniNumber(Integer.parseInt(drgV2AttachmentDos.get(0).getMplsLabel()));

                            //enableQoS if the device has the Qfx5120 device has the flag RSC16346
                            //Also, if there is an override for QoS on a Qfx5120 device which has the flag RSC16346 then set the override value to be enableQoS
                            vcConfigBuilder = applyQoS(virtualCircuitDo, mxDeviceDo, vcConfigBuilder, wfStepScope);
                        }

                        //Enable Dynamic QoS if conditions met
                        vcConfigBuilder = applyDynamicQos(virtualCircuitDo, vcConfigBuilder, enabledTelesisAqua,
                                mxDeviceDo, ccOrCcgdeviceDo, wfStepScope, t);

                        if (virtualCircuitDo.enableReservedBgp()) {
                            vcConfigBuilder = vcConfigBuilder.enableReservedBgp(true);
                        }

                    } else if (virtualCircuitDo.isPrivateIpsecGateway()) {
                        // Assign unitNumber for this VC
                        UnitNumberDo unitNumberDo = virtualCircuitBl.assignAndSetOrGetUnitNumberForVC(t, virtualCircuitDo, mxDeviceDo.getId());
                        unitNumber = unitNumberDo.getUnitNumber();

                        PrivateIPSecGatewayDo privateIPSecGatewayDo = privateIPSecGatewayBl.getOrThrow(virtualCircuitDo.getGatewayId());
                        routeTarget = privateIPSecGatewayDo.getRouteTarget();
                        routeDistinguisher = routeTarget;
                        xnetId = privateIPSecGatewayDo.getGroupId();
                    } else {
                        serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
                        String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                        Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, null);
                        throw vcWorkflowHelper.terminateRRWorkflow(String.format("Failed to create snippets for provisioning due to" +
                                " unknown gateway type %s", virtualCircuitDo.getGatewayType()), CreateVirtualCircuitFailures.ValidationFailure, dimensions);
                    }

                    vcConfigBuilder = vcConfigBuilder
                            .xnetId(xnetId)
                            .unitNumber(unitNumber)
                            .vtUnitNumber(unitNumber)
                            .routeTarget(routeTarget)
                            .routeDistinguisher(routeDistinguisher);

                    if (mxDeviceDo.getRoles().contains(DeviceDo.Role.AristaFfabT1) ){
                        if (virtualCircuitDo.getBgpAdminState()!=null){
                            vcConfigBuilder = vcConfigBuilder.isBgpDisabled(virtualCircuitDo.getBgpAdminState().equals(VirtualCircuitDo.BgpAdminState.DISABLED));
                        }
                        configPair = new AristaConfigHelper().aristaFfabT1virtualCircuitConfig(vcConfigBuilder
                                 .ffabIBgpAsn(RegionUtil.getffabIBGPAsn(Region.fromAirportCode(localRegionNetworkingName)))
                                        .xnetId(xnetId.substring(0,Math.min(xnetId.length(),20)))
                                .build());
                    } else {
                        configPair =  generateConfigPairForDrgVirtualCircuit(t, virtualCircuitDo, vcConfigBuilder, localRegion, tenantId);
                    }
                }

                log.info("Creating config snippet for configPair: {}", configPair);

                List<ConfigSnippetDo> existingSnippets = deviceSynchronizerBl.listSnippetsForDomainObject(t,
                        virtualCircuitDo.getId());

                final String mxDeviceId = mxDeviceDo.getId();
                Optional<ConfigSnippetDo> existingSnippet = existingSnippets
                        .stream().filter(snippet -> snippet.getDeviceId().equals(mxDeviceId))
                        .findAny();

                ConfigSnippetDo configSnippet;
                if (existingSnippet.isPresent()) {
                    configSnippet = deviceSynchronizerBl.updateExistingSnippet(t, existingSnippet.get().getId(),
                            configPair.getTemplateName(), configPair.getProperties());

                } else {
                    configSnippet = deviceSynchronizerBl.pushNewSnippet(t,
                            Optional.empty(), mxDeviceDo.getId(), virtualCircuitDo.getId(), configPair.getGroupName(),
                            configPair.getTemplateName(), configPair.getProperties());
                }

                String msg = String.format("Created config snippet: %s", configSnippet);
                log.info(msg);
                eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, msg);
            }

            String msg = "Finished creating config snippets";
            log.info(msg);
            eventBl.create(t, virtualCircuitDo.getId(), Component.WORKER, msg);
            vcWorkflowHelper.startOrUpdateMetering(t, virtualCircuitDo, vpnMetering);

            // Remove association to DRGS, CCS, VLANS, IPs that are no longer valid.
            virtualCircuitDo = virtualCircuitBl.makeAssociationsCurrent(t, virtualCircuitDo);
            // Release BGP subnets which are no longer being used.
            if (virtualCircuitDo.isPublic()) {
                virtualCircuitBl.releaseUnusedBgpPeeringSubnets(t, virtualCircuitDo);
            }

            MetricsUtil.emitNegative(scope, WorkflowResult.values());
            emitSuccessfulStepDurationMetric(scope, virtualCircuitDo);
            perfMetric.emitTillNowTimeInMs(wfStepScope, MetricConstants.waitCompleteTime(Steps.CREATE_DEVICE_CONFIG), args.getInitialTimeEpochMs());
            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, true);

        } catch (ValidationException e) {
            // Exit workflow, dont commit anything intermediate.
            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
            String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
            DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
            throw vcWorkflowHelper.terminateRRWorkflow("Failed to create snippets for provisioning",
                    e, CreateVirtualCircuitFailures.ValidationFailure, virtualCircuitDo, portSpeed, drgV2AttachmentDo);
        } catch (AuthServerUnavailableException e) {
            serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
            String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
            DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
            throw vcWorkflowHelper.terminateRRWorkflow("Failed to create snippets for provisioning",
                    e, CreateVirtualCircuitFailures.AuthServerUnavailable, virtualCircuitDo, portSpeed, drgV2AttachmentDo);
        }

        return virtualCircuitDo;
    }

    private VirtualCircuitConfig.Builder setCommonRtDetailsForIngressDisintermediation(VirtualCircuitConfig.Builder vcConfigBuilder, String commonRT, MetricsScope scope, VirtualCircuitWorkflowArgs args, VirtualCircuitDo virtualCircuitDo, DrgV2AttachmentDo drgV2AttachmentDo) {
        if (commonRT != null) {
            vcConfigBuilder = vcConfigBuilder
                .commonRouteTarget(commonRT)
                .xnetCommonId(UUID.nameUUIDFromBytes(commonRT.getBytes(StandardCharsets.UTF_8)).toString());
        } else {
             throwTerminalExceptionIfCommonRTNull(scope, args, virtualCircuitDo, drgV2AttachmentDo);
        }
        return vcConfigBuilder;
    }

    private VirtualCircuitConfig.Builder applyQoS(VirtualCircuitDo virtualCircuitDo, DeviceDo qosDevice, VirtualCircuitConfig.Builder vcConfigBuilder, MetricsScope wfStepScope) throws ValidationException {
        if (enableQoSByDefault(virtualCircuitDo, qosDevice)) {
            log.info("Preconditions for Qos are satisfied, setting the enableQos flag to be true");
            vcConfigBuilder = vcConfigBuilder.enableQos(true);
            emitMetricsForQoSSet(virtualCircuitDo, wfStepScope);
        } else if (qosOverrideSet(virtualCircuitDo, qosDevice)) {
            log.info("Preconditions for Qos are satisfied, setting the enableQos flag to be {}", virtualCircuitDo.isEnabledQos());
            vcConfigBuilder = vcConfigBuilder.enableQos(virtualCircuitDo.isEnabledQos());
            if (virtualCircuitDo.isEnabledQos()) {
                emitMetricsForQoSSet(virtualCircuitDo, wfStepScope);
            }
        }
        return vcConfigBuilder;
    }

    private static boolean enableQoSByDefault(VirtualCircuitDo virtualCircuitDo, DeviceDo deviceDoForVc) {
        boolean isQfx5120 = deviceDoForVc.getRoles().contains(DeviceDo.Role.Qfx5120);
        boolean deviceFeatureFlagActive = deviceDoForVc.isEnabledQoS();
        return (qosPropertyNotSet(virtualCircuitDo) && (isQfx5120 && deviceFeatureFlagActive));
    }

    private static boolean qosPropertyNotSet(VirtualCircuitDo virtualCircuitDo) {
        return (virtualCircuitDo.getProperties() == null || !virtualCircuitDo.getProperties().containsKey(VirtualCircuitDo.ENABLE_QOS));
    }

    private static boolean qosOverrideSet(VirtualCircuitDo virtualCircuitDo, DeviceDo deviceDoForQos) throws ValidationException {
        log.info("Checking if the preconditions for setting Qos are right");
        boolean deviceFeatureFlagActive = deviceDoForQos.isEnabledQoS();
        if (virtualCircuitDo.isEnabledQos() && (!deviceDoForQos.getRoles().contains(DeviceDo.Role.Qfx5120) || !(deviceFeatureFlagActive))) {
            PublicValidation.failInvalidQoSRequestForVc();
        }
        return (virtualCircuitDo.getProperties()!= null && virtualCircuitDo.getProperties().containsKey(VirtualCircuitDo.ENABLE_QOS) && deviceDoForQos.getRoles().contains(DeviceDo.Role.Qfx5120));
    }

    private VirtualCircuitConfig.Builder applyDynamicQos(VirtualCircuitDo virtualCircuitDo,
                                                         VirtualCircuitConfig.Builder vcConfigBuilder,
                                                         Boolean isStaticQosEnabledOnTelesisAquaVc,
                                                         DeviceDo mxDeviceDo,
                                                         DeviceDo ccOrCcgDeviceDo,
                                                         MetricsScope wfStepScope,
                                                         Transaction t) throws ValidationException {
        boolean enableDynamicQos = virtualCircuitDo.isDynamicQosEnabled();

        if(propertiesBl.isFcDynamicQosEnabled() && enableDynamicQos &&
                VirtualCircuitValidationHelper.canDynamicQosBeEnabled(virtualCircuitDo,
                        qosBandwidthReservationTemplateBl, ccOrCcgDeviceDo, isStaticQosEnabledOnTelesisAquaVc)) {

            //Remove this section once all Telesis Aqua VCs are migrated from Static to Dynamic QoS
            if(isStaticQosEnabledOnTelesisAquaVc) {
                migrateTelesisAquaFromStaticToDynamicQos(t, mxDeviceDo, virtualCircuitDo.getId());
            }

            log.info("Preconditions for Dynamic QoS are satisfied, generating config to enable Dynamic QoS for VC : {}", virtualCircuitDo.getId());
            vcConfigBuilder = generateConfigToEnableDynamicQos(virtualCircuitDo, vcConfigBuilder);
            emitMetricsForSuccessfulDynamicQosApply(virtualCircuitDo, wfStepScope);

        }else if(enableDynamicQos && !propertiesBl.isFcDynamicQosEnabled()) {
            log.error("VC: {} has Dynamic QoS enabled but region does not have Dynamic QoS property set, so Dynamic QoS cannot be enabled", virtualCircuitDo.getId());
        }

        return vcConfigBuilder;
    }

    private void migrateTelesisAquaFromStaticToDynamicQos(Transaction t, DeviceDo deviceDo, String virtualCircuitId) throws ValidationException {
        // If Static QoS enabled on VC, update device feature flags
        // to migrate VC from static to dynamic QoS
        List<String> featureFlags = deviceDo.getListOfEnabledFeatureFlags();
        log.info("Migrating VC : {} to Dynamic QoS on Device : {} with feature flags : {}", virtualCircuitId, deviceDo.getName(), SerialisationUtils.toJsonString(featureFlags));
        if(featureFlags.contains(DeviceDo.TELESIS_STATIC_EGRESS_QOS_FEATURE_FLAG)) {
            featureFlags.remove(DeviceDo.TELESIS_STATIC_EGRESS_QOS_FEATURE_FLAG);
            featureFlags.add(DeviceDo.DYNAMIC_QOS_FEATURE_FLAG);
        }
        deviceBl.update(t,  deviceDo.toBuilder().listOfEnabledFeatureFlags(featureFlags).build());
        log.info("Migrated VC : {} to Dynamic QoS on Device : {} with feature flags : {}", virtualCircuitId, deviceDo.getName(), SerialisationUtils.toJsonString(featureFlags));
    }

    private VirtualCircuitConfig.Builder generateConfigToEnableDynamicQos(VirtualCircuitDo virtualCircuitDo,
                                                                          VirtualCircuitConfig.Builder vcConfigBuilder) {

        QosBandwidthReservationTemplateDo qosBandwidthReservationTemplateDo =
                qosBandwidthReservationTemplateBl.getTemplateDoByTemplateDisplayName(virtualCircuitDo.getDynamicQosTemplateName());

        List<QosBandwidthReservationTemplateDo.QueueBandwidthAllocationDetail> queueBandwidthAllocationDetailList =
                qosBandwidthReservationTemplateDo.getQueueBandwidthAllocations();

        Map<String, Integer> dynamicQosQueueBandwidthPercentageAllocationMap =
                queueBandwidthAllocationDetailList.stream()
                        .collect(Collectors.toMap(queueBandwidthAllocationDetail -> queueBandwidthAllocationDetail.getQueueName().toLowerCase(),
                                QosBandwidthReservationTemplateDo.QueueBandwidthAllocationDetail::getPercentageAllocation));

        String vcBandwidth = virtualCircuitDo.getBandwidthInMbps() >= 1000 ?
                virtualCircuitDo.getBandwidthInMbps()/1000 + "g" : virtualCircuitDo.getBandwidthInMbps() + "m";
        log.info("Config for Dynamic Qos , dynamicQOSEnabled : {}, qosInterfaceShapingRate : {}, qosTemplateRateMap : {}",
                virtualCircuitDo.getIsDynamicQosEnabled(), vcBandwidth, SerialisationUtils.toJsonString(dynamicQosQueueBandwidthPercentageAllocationMap));
        return vcConfigBuilder.dynamicQOSEnabled(virtualCircuitDo.getIsDynamicQosEnabled())
                .qosInterfaceShapingRate(vcBandwidth)
                .qosTemplateRateMap(dynamicQosQueueBandwidthPercentageAllocationMap);
    }

    private ConfigPair generateConfigPairForDrgVirtualCircuit(Transaction t, VirtualCircuitDo virtualCircuitDo,
                                                              VirtualCircuitConfig.Builder vcConfigBuilder, VpnRegion localRegion, String tenantId) throws ValidationException, AuthServerUnavailableException {

        boolean isEdgePop = virtualCircuitBl.isEdgePop(virtualCircuitDo);

        List<RemotePeeringConnectionDo> remotePeeringConnectionDos = RemotePeeringConnectionHelper
                .fetchPeeringConnectionsToUpdate(remotePeeringConnectionBl, virtualCircuitDo.getGatewayId());

        boolean rpcToOnPremEnabled = WorkflowHelper.isrpcToOnPremEnabled(identityMetadataHelper, propertiesBl, tenancyMetadataBl, featureController, virtualCircuitDo.getCompartmentId());

        // Check OCIC whitelisted tenancy for Lift & Shift
        if(tenancyMetadataBl.isOcicTenancy(tenantId)) {
            TagUtils.Tags tags = TagUtils.decodeTags(virtualCircuitDo.getTags());
            if(tags != null) {
                Map<String, String> freeFormTags = tags.getFreeformTags();
                if(!freeFormTags.isEmpty() && freeFormTags.containsKey(HIGGS_ASN_PREFIX)) {
                    vcConfigBuilder = vcConfigBuilder
                            .higgsAsn(Integer.parseInt(freeFormTags.get(HIGGS_ASN_PREFIX)))
                            .vrfBgpPeeringIp(freeFormTags.getOrDefault(VRF_BGP_PEERING_PREFIX, null))
                            .remoteBgpPeeringIps(Arrays.asList(freeFormTags.get(REMOTE_BGP_PEERING_PREFIX).split(REMOTE_BGP_PEERING_SPEERATOR)))
                            .vrfBgpAsn(OCI_CLASSIC_BGP_ASN);
                }
            }
        }
        // FastConnect Static Canary virtual circuit
        if (propertiesBl.isTenantWhitelistedForFastConnectStaticCanary(tenantId) && virtualCircuitDo.getDisplayName().startsWith(FC_STATIC_CANARY_PREFIX)) {
            vcConfigBuilder = vcConfigBuilder
                    .fcCanary(true)
                    .fcCanaryConnectingRemotefcagg(virtualCircuitDo.getDisplayName().contains(FC_STATIC_CANARY_REMOTE_FCAGG));
        }

        if (virtualCircuitDo.hasTransitCommunityPrefix()) {
            vcConfigBuilder = vcConfigBuilder
                    .enableVCTransit(true)
                    .customerPublicTwoByteBgpASNs(virtualCircuitDo.getTransitCommunityPrefix().get());
        }

        if (propertiesBl.isTenantWhitelistedForFastConnectStaticCanary(tenantId)
                && (virtualCircuitDo.getTags() !=null)){

            TagUtils.Tags tags = TagUtils.decodeTags(virtualCircuitDo.getTags());
            Map<String,String> freeFormTags = tags.getFreeformTags();
            Boolean isFcMx10kCanary =  Boolean.parseBoolean(freeFormTags.getOrDefault("isFcMx10kCanary",Boolean.toString(Boolean.FALSE)));
            Boolean isFcMx10kStaticCanary =  Boolean.parseBoolean(freeFormTags.getOrDefault(FC_MX10k_STATIC_CANARY,Boolean.toString(Boolean.FALSE)));
            Boolean onlyLoopBackCanaryConfig =  Boolean.parseBoolean(freeFormTags.getOrDefault(FC_CANARY_ONLY_LOOPBACK_CONFIG,Boolean.toString(Boolean.FALSE)));

            if (isFcMx10kCanary.equals(Boolean.TRUE)) {
                try {
                    PublicValidation.validateMx10KCanaryDetails(freeFormTags);
                } catch (ValidationException e) {
                    // Exit workflow for failure
                    String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                    DrgV2AttachmentDo drgV2AttachmentDo = VirtualCircuitHelper.getDrgV2AttachmentDo(virtualCircuitDo.getId(), drgV2AttachmentBl);
                    throw vcWorkflowHelper.terminateRRWorkflow("Incorrect on Incomplete Freeform Tags provided for FCCanary",
                            e, CreateVirtualCircuitFailures.ValidationFailure, virtualCircuitDo, portSpeed, drgV2AttachmentDo);
                }
                vcConfigBuilder.mx10KFcCanary(freeFormTags);
            }

            if (isFcMx10kStaticCanary.equals(Boolean.TRUE)) {
                vcConfigBuilder.isFcMx10kStaticCanary(isFcMx10kStaticCanary);
                if (Optional.ofNullable(freeFormTags.get(FC_CANARY_BGP_ASN)).isPresent()) {
                    vcConfigBuilder.fcCanaryBgpAsn(Integer.parseInt(freeFormTags.get(FC_CANARY_BGP_ASN)));
                }
                if (Optional.ofNullable(freeFormTags.get(FC_CANARY_REMOTE_VCN_SUBNET)).isPresent() ) {
                    vcConfigBuilder.fcCanaryRemoteVcnSubnet(freeFormTags.get(FC_CANARY_REMOTE_VCN_SUBNET));
                }
                if (onlyLoopBackCanaryConfig.equals(Boolean.TRUE)){
                    vcConfigBuilder.fcCanaryonlyLoopbackConfig(Boolean.TRUE);
                }
                if (Optional.ofNullable(freeFormTags.get(FC_LOOPBACK_IPV6)).isPresent()) {
                    vcConfigBuilder.fcCanaryLoopbackIPv6(freeFormTags.get(FC_LOOPBACK_IPV6));
                }
                if (Optional.ofNullable(freeFormTags.get(FC_LOOPBACK_IPV4)).isPresent()) {
                    vcConfigBuilder.fcCanaryLoopbackIPv4(freeFormTags.get(FC_LOOPBACK_IPV4));
                }
                if (Optional.ofNullable(freeFormTags.get(FC_CANARY_REMOTE_VCN_SUBNET_IPV6)).isPresent()) {
                    vcConfigBuilder.fcCanaryRemoteVcnSubnetIpv6(freeFormTags.get(FC_CANARY_REMOTE_VCN_SUBNET_IPV6));
                }

            }
        }


        // Not an edge pop virtual circuit or Transit RPC enabled.

        if (!rpcToOnPremEnabled && !isEdgePop) {

            // Check if MacSec enabled for the tenancy
            if(tenancyMetadataBl.isMacSecEnabledForTenancy(tenantId)) {
                vcConfigBuilder = vcConfigBuilder
                        .macSecPortEnabled(true)
                        .cVlanNumber(0);
            }

            if (virtualCircuitDo.isDrg()) {
                return new JuniperConfigHelper().virtualCircuitWithVrfAndQfx(vcConfigBuilder.build());
            } else if (virtualCircuitDo.isDrgV2()) {
                // Add the vtInterface for DrgV2 VCs
                vcConfigBuilder = vcConfigBuilder.addVtiInterface(true);

                if (virtualCircuitDo.hasAddVrfTableLabel()) {
                    vcConfigBuilder = vcConfigBuilder.addVrfTableLabel(true);
                }

                if ((vcConfigBuilder.build().getIsFcMx10kStaticCanary() != null  && vcConfigBuilder.build().getIsFcMx10kStaticCanary())  ||
                        (vcConfigBuilder.build().getMx10KFcCanary()!= null && vcConfigBuilder.build().getMx10KFcCanary().size() == 10) ){
                    return new JuniperConfigHelper().virtualCircuitWithVrfAndDrgV2V9(vcConfigBuilder.build());
                }
                return new JuniperConfigHelper().virtualCircuitWithVrfAndDrgV2(vcConfigBuilder.build());
            } else {
                String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, null);
                throw vcWorkflowHelper.terminateRRWorkflow(String.format("Failed to create snippets for" +
                        " gateway type %s", virtualCircuitDo.getGatewayType()), CreateVirtualCircuitFailures.ValidationFailure, dimensions);
            }

        } else {
            // Edge Pop usecase or Transit RPC enabled.
            if (!rpcToOnPremEnabled) {
                remotePeeringConnectionDos = Collections.emptyList();
            }

            Set<String> exportRTs = new HashSet<>();
            Set<String> importRTs = new HashSet<>();
            Set<String> exportRegionsSet = new HashSet<>();

            VpnRegion homeRegion = null;
            String localRouteTarget;

            if (virtualCircuitDo.isDrg()) {
                // Drg V1
                // List of export RTs from RPC.
                List<RoutingAttachmentDo> attachedRoutingAttachmentDos = routingAttachmentBl.getDosByResourceIdType(t, virtualCircuitDo.getGatewayId(),
                        RoutingAttachmentDo.Type.EdgePopVirtualCircuit, RoutingAttachmentDo.State.Attached);
                Map<String, Set<String>> peerDrgRTSByPeerRegion = GatewayRouteTargetsManager.getPeerRTsByPeerRegionForGateway(remotePeeringConnectionDos, attachedRoutingAttachmentDos);
                peerDrgRTSByPeerRegion.values().forEach(exportRTs::addAll);
                DrgDo drg = drgBl.getOrThrow(t, virtualCircuitDo.getGatewayId());
                if (localRegion.isEdgePop()) {
                    localRouteTarget = DrgBl.getEdgePopRouteTarget(localRegion, drg);
                    homeRegion = localRegion.getEdgePop().getHomeRegion();
                } else {
                    localRouteTarget = drg.getRouteTarget();
                    homeRegion = localRegion;
                }

                exportRTs.add(drg.getRouteTarget());
                exportRTs.add(localRouteTarget);

                vcConfigBuilder = vcConfigBuilder.routeTarget(localRouteTarget);

                if (virtualCircuitDo.getRouteDistinguisher() == null) {
                    // Make sure ECMP is off before doing this
                    vcConfigBuilder = vcConfigBuilder.routeDistinguisher(localRouteTarget);
                }

                exportRegionsSet = peerDrgRTSByPeerRegion.keySet().stream()
                        .map(VpnRegion::fromName)
                        .map(VpnRegion::getNetworkingName)
                        .collect(Collectors.toSet());

            } else if (virtualCircuitDo.isDrgV2()) {
                // Drg V2

                if (localRegion.isEdgePop()) {
                    homeRegion = localRegion.getEdgePop().getHomeRegion();
                } else {
                    homeRegion = localRegion;
                }

                List<DrgV2AttachmentDo> drgV2AttachmentDos = drgV2AttachmentBl.listByAttachedResourceId(t, virtualCircuitDo.getId());
                // Per PNP team, these route targets should start with home region asn
                drgV2AttachmentDos.stream().map(DrgV2AttachmentDo::getImportEPRouteTarget).forEach(exportRTs::add);
                drgV2AttachmentDos.stream().map(DrgV2AttachmentDo::getExportEPRouteTarget).forEach(importRTs::add);

                for (RemotePeeringConnectionDo remotePeeringConnectionDo: remotePeeringConnectionDos) {
                    log.info("RPC={}", remotePeeringConnectionDo.getId());
                    if (remotePeeringConnectionDo.getPeerGfcRouteTargets() != null && !remotePeeringConnectionDo.getPeerGfcRouteTargets().isEmpty()) {
                        List<GfcRouteTarget> peerGfcRTList = remotePeeringConnectionDo.getPeerGfcRouteTargets();

                        Optional<GfcRouteTarget> optionalPeerGfcRT = peerGfcRTList.stream()
                                .filter(gfcRT -> gfcRT.getRegionName().equals(localRegion.getInternalName()))
                                .findFirst();

                        if (optionalPeerGfcRT.isPresent()) {
                            importRTs.add(optionalPeerGfcRT.get().getImportRouteTarget());
                            exportRTs.add(optionalPeerGfcRT.get().getExportRouteTarget());
                            log.info("adding exportRT {}", optionalPeerGfcRT.get().getExportRouteTarget());
                        } else {
                            log.error("RpcToOnPrem: No peer GFC RT found for region {} on RPC {}",
                                    localRegion.getName(), remotePeeringConnectionDo);

                            // If we reach here,
                            // it probably means that this localRegion is a new EdgePOP and did not exist when the RPC was initially peered

                            throw vcWorkflowHelper.terminateRRWorkflow(String.format("Error: RpcToOnPrem: localRegion %s not found in PeerGfcRouteTargetMap" +
                                    " for RPC %s", localRegion.getName(), remotePeeringConnectionDo.toString()), CreateVirtualCircuitFailures.ValidationFailure);
                        }

                        // add peerRegion to exportRegionSet
                        exportRegionsSet.add(VpnRegion.fromName(remotePeeringConnectionDo.getPeerRegionName()).getNetworkingName());
                    } else {

                        log.info("RpcToOnPrem: Assuming peerRpcId {} to be on a DRGv1", remotePeeringConnectionDo.getPeerRpcId());

                        List<DrgV2AttachmentDo> rpcDrgV2AttachmentDo = drgV2AttachmentBl.listByAttachedResourceId(t, remotePeeringConnectionDo.getId());

                        // ensure we have 1 RPC attachment
                        if (rpcDrgV2AttachmentDo.size() != 1) {
                            throw vcWorkflowHelper.terminateRRWorkflow(String.format("Error: RpcToOnPrem: DrgV2 RPC has %s DrgV2Attachments" +
                                    " for RPC %s", rpcDrgV2AttachmentDo.size(), remotePeeringConnectionDo.toString()), CreateVirtualCircuitFailures.ValidationFailure);
                        }

                        // add local RPC's importEPRouteTarget to the VC's importRTs
                        importRTs.add(rpcDrgV2AttachmentDo.get(0).getImportEPRouteTarget());

                        // add RPC's peerDrgRT to the VC's exportRTs
                        exportRTs.add(remotePeeringConnectionDo.getPeerDrgRouteTarget());

                        // add peerRegion to exportRegionSet
                        exportRegionsSet.add(VpnRegion.fromName(remotePeeringConnectionDo.getPeerRegionName()).getNetworkingName());
                    }
                }

                // add localRegion and homeRegion if edgePOP
                exportRegionsSet.add(localRegion.getNetworkingName());
                if (localRegion.isEdgePop()) {
                    exportRegionsSet.add(localRegion.getEdgePop().getHomeRegion().getNetworkingName());
                }

                vcConfigBuilder = vcConfigBuilder.routeTarget(null);
                vcConfigBuilder = vcConfigBuilder.importRouteTargets(importRTs.stream().sorted().collect(Collectors.toList()));
            } else {
                String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
                Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, null);
                throw vcWorkflowHelper.terminateRRWorkflow(String.format("Failed to create snippets for" +
                        " gateway type %s", virtualCircuitDo.getGatewayType()), CreateVirtualCircuitFailures.ValidationFailure, dimensions);
            }

            log.info("exportRTs={}",exportRTs.toString());
            List<String> exportRTsList = exportRTs.stream().sorted().collect(Collectors.toList());

            // Adding local region as well.
            exportRegionsSet.add(localRegion.getNetworkingName());
            exportRegionsSet.add(homeRegion.getNetworkingName());

            List<String> exportRegions = exportRegionsSet.stream().sorted().collect(Collectors.toList());

            List<String> exportMarketRegions = exportRegions.stream()
                    // Setting isEdgePOP null in fromNetworkingName here is fine since we are only fetching the market's networking name
                    // for ORD edgePOP and region, the market's networkingName are the same. Setting null here will always result in getting
                    // the ORD region
                    // TODO: 
                    //  this will only work if both the edgePOP and the region that overlap have the same market networking name
                    //  will need to rework the logic if the edgePOP and region market names are different
                    .map(r -> String.format("%s_%s", VpnRegion.fromNetworkingName(r, null).getMarket().getNetworkingName(), r))
                    .sorted()
                    .collect(Collectors.toList());

            vcConfigBuilder = vcConfigBuilder
                    .exportRouteTargets(exportRTsList)
                    .exportMarketRegions(exportMarketRegions);

            // Check if MacSec enabled for the tenancy
            if(tenancyMetadataBl.isMacSecEnabledForTenancy(tenantId)) {
                vcConfigBuilder = vcConfigBuilder
                        .macSecPortEnabled(true)
                        .cVlanNumber(0);
            }

            // Check if Transport is enabled for the tenancy
            if(tenancyMetadataBl.isTransportEnabledForTenancy(tenantId)) {
                vcConfigBuilder = vcConfigBuilder
                        .isTransportEnabled(true);
            }

            if (virtualCircuitDo.hasAddVrfTableLabel()) {
                vcConfigBuilder = vcConfigBuilder.addVrfTableLabel(true);
            }

            return virtualCircuitDo.isDrg() ?
                    new JuniperConfigHelper().virtualCircuitForGlobalFastConnect(vcConfigBuilder.build()) :
                    new JuniperConfigHelper().virtualCircuitForGlobalFastConnectDRGv2(vcConfigBuilder.build());
        }
    }


    private void validateQfxDeviceConfig(DeviceDo deviceDo, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        // Get qfx to mx interface ids
        List<CrossConnectGroupBetweenMxAndQfx> ccgsBetweenMxAndQfx = deviceDo.getCcgsBetweenMxAndQfx();
        if (ccgsBetweenMxAndQfx == null || ccgsBetweenMxAndQfx.size() == 0 || ccgsBetweenMxAndQfx.size() > 2) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("deviceId %s has no or more than two ccgsBetweenMxAndQfx - virtualCircuitDo %s.",
                            deviceDo.getId(), virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }
        if (StringUtils.isBlank(ccgsBetweenMxAndQfx.get(0).getDeviceInterfaceId())) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("deviceId %s has no deviceInterfaceId in first ccgsBetweenMxAndQfx - virtualCircuitDo %s.",
                            deviceDo.getId(), virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }

    }

    private void validateAristaFcAggDeviceConfig(DeviceDo deviceDo, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        // Get arista fc agg to mx interface ids
        List<DeviceConfig.ConnectionToPeerDevice> ccgsBetweenMxAndArista = deviceDo.getDeviceConfig().getConnectionToMxList();
        if (ccgsBetweenMxAndArista.size() == 0 || ccgsBetweenMxAndArista.size() > 2) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("deviceId %s has no or more than two ccgsBetweenMxAndArista - virtualCircuitDo %s.",
                            deviceDo.getId(), virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }
        if (StringUtils.isBlank(ccgsBetweenMxAndArista.get(0).getDeviceInterfaceId())) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("deviceId %s has no deviceInterfaceId in first ccgsBetweenMxAndArista - virtualCircuitDo %s.",
                            deviceDo.getId(), virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }

    }

    
    // finding VpnRegion from device name
    // this is necessary since we cannot 
    private VpnRegion getVpnRegionFromDeviceDo(DeviceDo deviceDo) {
        Pattern MY_PATTERN = Pattern.compile("bb-....-");
        Matcher matcher = MY_PATTERN.matcher(deviceDo.getName());
        Optional<String> optionalRegion = Optional.empty();
        if (matcher.find()) {
            optionalRegion = Optional.of(matcher.group(0).split("-")[1].substring(0, 3).toUpperCase());
        }
        if (optionalRegion.isPresent()) {
            // at this point the device is guaranteed to be in an edgePOP
            return VpnRegion.fromNetworkingName(optionalRegion.get(), Boolean.TRUE);
        }
        
        // fallback to the original logic
        String bgpAdSpecifier = deviceDo.getDeviceConfig().getBgpAdSpecifier();
        return VpnRegion.fromNetworkingName(bgpAdSpecifier.substring(0, 3).toUpperCase(), Boolean.FALSE);
    }


    public static VirtualCircuitDo generateVcUnitNumberForQfx(VirtualCircuitBl virtualCircuitBl, VirtualCircuitDo virtualCircuitDo, CrossConnectBl crossConnectBl, CrossConnectGroupBl crossConnectGroupBl, DeviceBl deviceBl, Transaction t,boolean isUnitNumberFixEnabled, SecureRandom random)
            throws ValidationException {
        int vcUnitNumberForQfx = 0;

        List<DeviceDo> deviceDos = new ArrayList<>();
        for (Mapping mapping: virtualCircuitDo.getCrossConnectMapping().getMappings()) {
            boolean isCrossConnect = VirtualCircuitBl.isCrossConnect(mapping.getCrossConnectId());
            CrossConnectGroupDo crossConnectGroupDo;
            CrossConnectDo crossConnectDo;
            // get device
            if (isCrossConnect) {
                crossConnectDo = crossConnectBl.getOrThrow(mapping.getCrossConnectId());
            } else  {
                crossConnectGroupDo = crossConnectGroupBl.getOrThrow(mapping.getCrossConnectId());
                crossConnectDo = crossConnectBl.getOrThrow(t, crossConnectGroupDo.getCrossConnectIds()[0]);
            }
            deviceDos.add(deviceBl.getOrThrow(t, crossConnectDo.getDeviceId()));

        }

        for (int attempt = 0; attempt <= RETRY_COUNT; attempt++) {
            vcUnitNumberForQfx = random.nextInt(VC_QFX_UNIT_NUM_RAND_GEN_UPPER_RANGE) + VC_QFX_UNIT_NUM_RAND_GEN_START_RANGE;

            boolean isUnique = true;
            boolean isUnitNumberLeaked = false;
            for (DeviceDo deviceDo: deviceDos) {
                Optional<VirtualCircuitDo> existVcUnitNumberForQfx =
                        virtualCircuitBl.getVirtualCircuitByVcUnitNumberForQfxAndPFabClusterId(t, vcUnitNumberForQfx, deviceDo.getPFabClusterId());

                if (isUnitNumberFixEnabled){
                        isUnitNumberLeaked =
                            virtualCircuitBl.isVcUnitNumberLeaked(t, vcUnitNumberForQfx, deviceDo.getPFabClusterId(), virtualCircuitDo.getId());
                }

                if (existVcUnitNumberForQfx.isPresent()|| isUnitNumberLeaked) {
                    isUnique = false;
                }
            }

            if (!isUnique) {
                continue;
            }

            virtualCircuitDo = virtualCircuitDo.toBuilder()
                    .pFabClusterId(deviceDos.get(0).getPFabClusterId())
                    .vcUnitNumberForQfx(vcUnitNumberForQfx)
                    .build();
            break;
        }
        if (vcUnitNumberForQfx == 0) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("Failed to allocate vcUnitNumberForQfx for virtualCircuitDo %s.",
                            virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }

        return virtualCircuitDo;
    }

    private Boolean isIngressDisintermediationEnabled (DeviceDo deviceDo, VirtualCircuitDo virtualCircuitDo) {
        return virtualCircuitDo.isIngressDisintermediationEnabled()
            && deviceBl.validatedDeviceRoleAndFeatureFlag(deviceDo, DeviceDo.Role.FastConnectMx304, Arrays.asList(INGRESS_DISINTERMEDIATION_DEVICE_FEATURE_FLAG));
    }

     public void throwTerminalExceptionIfCommonRTNull(MetricsScope scope, VirtualCircuitWorkflowArgs args, VirtualCircuitDo virtualCircuitDo, DrgV2AttachmentDo drgV2AttachmentDo) {

        serviceLogHelper.emitServiceLog(scope.getPrefix(), args.getInitialTimeEpochMs(), args.getOpcRequestId(), virtualCircuitDo.getCompartmentId(), WORKFLOW_NAME, false);
        String portSpeed = VirtualCircuitHelper.getVcPortSpeed(virtualCircuitDo,crossConnectBl, crossConnectGroupBl);
        Map<String, String> dimensions =  VirtualCircuitWorkflowHelper.getDimensions(virtualCircuitDo, portSpeed, drgV2AttachmentDo);
        String msg = String.format("Failed to create snippets for provisioning due to" +
                                    " CommonRT should not be null for ingress disintermediated VC : %s", virtualCircuitDo.getId());
        log.error(msg);
        throw vcWorkflowHelper.terminateRRWorkflow(msg, CreateVirtualCircuitFailures.ValidationFailure, dimensions);
    }

    public static VirtualCircuitDo generateVcUnitNumberForQfx(VirtualCircuitBl virtualCircuitBl, VirtualCircuitDo virtualCircuitDo, DeviceDo deviceDo, Transaction t)
            throws ValidationException {
        SecureRandom random = new SecureRandom();
        int vcUnitNumberForQfx = 0;

        for (int attempt = 0; attempt <= RETRY_COUNT; attempt++) {
            vcUnitNumberForQfx = random.nextInt(VC_QFX_UNIT_NUM_RAND_GEN_UPPER_RANGE) + VC_QFX_UNIT_NUM_RAND_GEN_START_RANGE;
            Optional<VirtualCircuitDo> existVcUnitNumberForQfx =
                    virtualCircuitBl.getVirtualCircuitByVcUnitNumberForQfxAndPFabClusterId(t, vcUnitNumberForQfx, deviceDo.getPFabClusterId());
            if (existVcUnitNumberForQfx.isPresent()) {
                continue;
            }
            virtualCircuitDo = virtualCircuitDo.toBuilder()
                    .pFabClusterId(deviceDo.getPFabClusterId())
                    .vcUnitNumberForQfx(vcUnitNumberForQfx)
                    .build();
        }
        if (vcUnitNumberForQfx == 0) {
            throw new ValidationException(ErrorCode.InternalError,
                    String.format("Failed to allocate vcUnitNumberForQfx for virtualCircuitDo %s.",
                            virtualCircuitDo.getId()),
                    CreateVirtualCircuitFailures.InvalidSnippetAttributesFailure);
        }

        return virtualCircuitDo;
    }

    ////////////////////////////////////////////////////////////////////////////////
    //// Provisioning - Wait
    ////////////////////////////////////////////////////////////////////////////////

    @Step(name = Steps.WAIT_FOR_DEVICE_SYNC,
            numAssignmentsBeforeFailure = DEFAULT_NUMBER_OF_ALLOWED_ASSIGNMENTS,
            assignmentTTLMillis = DEFAULT_ASSIGNMENT_TIME_MILLIS,
            leaseTTLMillis = DEFAULT_LEASE_TIME_MILLIS)
    public StepResult<BasicWorkflowState> waitForDeviceSyncStep(
            RowRevisionSensitiveWorkflowArgs<VirtualCircuitWorkflowArgs> args,
            BasicWorkflowState state,
            WorkflowInfo info) {

        final VirtualCircuitWorkflowArgs arg = vcWorkflowHelper.deserializeWrappedArgs(args);
        try (MetricsScope scope = MetricsScope.parent("createVirtualCircuit.WaitForDeviceSync");
            MetricsScope wfStepScope = MetricsScope.parent(MetricConstants.getWorkflowScopePrefix(MetricConstants.ObjectName.VIRTUALCIRCUIT, arg.getOperationType()), false, false)) {
            perfMetric.setupScopeDimensions(wfStepScope, arg.getOperationType(), arg.getIsFakeDevice(), arg.getIsCustomer());
            // Protect this execution w/ row revision
            return vcWorkflowHelper.withRowValidation(args,
                            state,
                            (a, b, c) -> waitForProvision(scope, wfStepScope, Steps.WAIT_FOR_DEVICE_SYNC, info.getAssignmentId().getStepInstanceId().getSequenceNumber(), a, b, c, serviceLogHelper),
                            (ar, obj, timestamp) -> nextStepWaitProvision(obj, timestamp),
                            wfStepScope);
        }
    }

    /**
     * Next step or fail workflow.
     * @return
     */
    @VisibleForTesting StepResult<BasicWorkflowState> nextStep(VirtualCircuitWorkflowArgs args,
                                                               VirtualCircuitDo modelObject, Long nextTxTimestamp, String nextStep) {

        switch (modelObject.getState()) {
            case PROVISIONING:
                log.info("State is Provisioning, waiting for sync");
                return Results.completeStep(nextStep,
                        new BasicWorkflowState(nextTxTimestamp));
            case PROVISIONED:
                log.info("State is Provisioned, ending workflow.");
                return Results.terminateAsSuccess("State is Provisioned",
                        new BasicWorkflowState(nextTxTimestamp));
            default:
                log.error("Got failure or unexpected state: {}", modelObject.getState());
                return Results.terminateAsFailure("Got failure or unexpected state: " + modelObject.getState(),
                        new BasicWorkflowState(nextTxTimestamp));
        }
    }

    /**
     * Next step or fail workflow.
     * @return
     */
    @VisibleForTesting StepResult<BasicWorkflowState> nextStepWaitProvision(VirtualCircuitDo modelObject, Long nextTxTimestamp) {

        switch (modelObject.getState()) {
            case PROVISIONED:
                log.info("Provisioned, completing workflow.");
                return Results.terminateAsSuccess("Sync Complete",
                        new BasicWorkflowState(nextTxTimestamp));
            case PROVISIONING:
                log.info("State is Provisioning, waiting for sync");
                return Results.completeStep(Steps.WAIT_FOR_DEVICE_SYNC,
                        new BasicWorkflowState(nextTxTimestamp));
            default:
                log.error("Got failure or unexpected state: {}", modelObject.getState());
                return Results.terminateAsFailure("Got failure or unexpected state: " + modelObject.getState(),
                        new BasicWorkflowState(nextTxTimestamp));
        }
    }

}
