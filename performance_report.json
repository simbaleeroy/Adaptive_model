@Test
    public void GIVEN_toModel_WHEN_virtualCircuitDoHasNoTenantId_THEN_backfillTenancyId() throws Exception {
        setupVcDependencies();

        CreateVirtualCircuitDetails createDetails =
                getCreateL2ProviderDetailsWithId(l2ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(
                CreateVirtualCircuitRequest.builder()
                        .createVirtualCircuitDetails(createDetails)
                        .build()
        ).getVirtualCircuit();

        VirtualCircuitDo realDo = virtualCircuitBl.getOrThrow(vc.getId());

        VirtualCircuitDo doSpy = org.mockito.Mockito.spy(realDo);
        doReturn(null).when(doSpy).getTenantId();
        doReturn(realDo.getId()).when(doSpy).getId();
        doReturn(realDo.getCompartmentId()).when(doSpy).getCompartmentId();

        com.oracle.pic.vpn.model.VirtualCircuit apiVc =
                virtualCircuitManagementResourceV1.toModel(vc, doSpy);

        assertEquals(vc.getProviderName(), apiVc.getProviderName());
        assertEquals(vc.getBandwidthShapeName(), apiVc.getBandwidthShapeName());
        assertEquals(vc.getCompartmentId(), apiVc.getCompartmentId());
        assertNull(apiVc.getVirtualCircuitRedundancyMetadata());
        assertEquals(false, apiVc.getIsDrgV2());
        assertEquals(vc.getBgpAdminState().toString(), apiVc.getBgpAdminState().toString());
        assertNotNull(realDo.getTenantId());
    }
