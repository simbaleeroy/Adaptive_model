    def test_ocid_type_parsing(self):
        """Test parsing of OCID types from the ocids list."""
        test_cases = [
            ('ocid1.virtualcircuit.region1.sea.test', 'virtualcircuit'),
            ('ocid1.crossconnect.region1.sea.test', 'crossconnect'),
            ('ocid1.crossconnectgroup.region1.sea.test', 'crossconnectgroup')
        ]
        
        for ocid, expected_type in test_cases:
            # This simulates the logic: ocid_type in ocids loop
            ocids = ['virtualcircuit', 'crossconnect', 'crossconnectgroup']
            
            # The function extracts type from OCID and checks if it's in the ocids list
            ocid_parts = ocid.split('.')
            if len(ocid_parts) >= 2:
                ocid_type = ocid_parts[1]
                self.assertIn(ocid_type, ocids)
                self.assertEqual(ocid_type, expected_type)

