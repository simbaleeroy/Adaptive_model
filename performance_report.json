    def _check_optical_thresholds(self, content: str, ocid: str) -> List[Issue]:
        # Check optical diagnostic thresholds for power levels, temperature, and bias current
        issues = []
        lines = content.split('\n')
        
        current_interface = None
        current_lane = None
        in_optical_section = False
        
        for i, line in enumerate(lines):
            # Detect optical diagnostics section
            if 'show interfaces diagnostics optics' in line:
                in_optical_section = True
                interface_match = re.search(r'show interfaces diagnostics optics ([\w/-]+)', line)
                if interface_match:
                    current_interface = interface_match.group(1)
                continue
            
            # Exit optical section
            if in_optical_section and (line.startswith('<') and line.endswith('>')):
                in_optical_section = False
                current_interface = None
                current_lane = None
                continue
            
            if not in_optical_section or not current_interface:
                continue
            
            # Track current lane
            lane_match = re.search(r'Lane (\d+)', line)
            if lane_match:
                current_lane = lane_match.group(1)
                continue
            
            # Check module temperature (applies to entire interface)
            temp_match = re.search(r'Module temperature\s+:\s+(\d+) degrees C', line)
            if temp_match:
                temp = int(temp_match.group(1))
                if temp >= 70:  # High warning threshold typically 70C
                    severity = "HIGH" if temp >= 75 else "MEDIUM"
                    issues.append(Issue(
                        category="Optical",
                        severity=severity,
                        component=current_interface,
                        description="High module temperature detected",
                        details=f"Module temperature: {temp}°C on {current_interface}",
                        recommendation="Check ventilation and ambient temperature. Clean optical module if necessary.",
                        ocid=ocid
                    ))
                elif temp <= 0:  # Low warning threshold typically 0C
                    issues.append(Issue(
                        category="Optical",
                        severity="MEDIUM",
                        component=current_interface,
                        description="Low module temperature detected",
                        details=f"Module temperature: {temp}°C on {current_interface}",
                        recommendation="Check environmental conditions and heating.",
                        ocid=ocid
                    ))
            
            # Check module voltage
            voltage_match = re.search(r'Module voltage\s+:\s+([\d.]+) V', line)
            if voltage_match:
                voltage = float(voltage_match.group(1))
                if voltage > 3.45:  # High warning threshold typically 3.45V
                    severity = "HIGH" if voltage > 3.46 else "MEDIUM"
                    issues.append(Issue(
                        category="Optical",
                        severity=severity,
                        component=current_interface,
                        description="High module voltage detected",
                        details=f"Module voltage: {voltage}V on {current_interface}",
                        recommendation="Check power supply stability and module health.",
                        ocid=ocid
                    ))
                elif voltage < 3.15:  # Low warning threshold typically 3.15V
                    severity = "HIGH" if voltage < 3.13 else "MEDIUM"
                    issues.append(Issue(
                        category="Optical",
                        severity=severity,
                        component=current_interface,
                        description="Low module voltage detected",
                        details=f"Module voltage: {voltage}V on {current_interface}",
                        recommendation="Check power supply and module connections.",
                        ocid=ocid
                    ))
            
            # Check laser bias current per lane
            if current_lane:
                bias_match = re.search(r'Laser bias current\s+:\s+([\d.]+) mA', line)
                if bias_match:
                    bias = float(bias_match.group(1))
                    if bias > 11.0:  # High warning threshold typically 11mA
                        severity = "HIGH" if bias > 13.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="High laser bias current detected",
                            details=f"Laser bias current: {bias}mA on {current_interface} Lane {current_lane}",
                            recommendation="Check laser health and fiber connection quality.",
                            ocid=ocid
                        ))
                    elif bias < 5.0:  # Low warning threshold typically 5mA
                        severity = "HIGH" if bias < 3.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="Low laser bias current detected",
                            details=f"Laser bias current: {bias}mA on {current_interface} Lane {current_lane}",
                            recommendation="Check laser functionality and power supply.",
                            ocid=ocid
                        ))
                
                # Check laser output power per lane (in dBm)
                output_power_match = re.search(r'Laser output power\s+:\s+[\d.]+\s+mW\s+/\s+([-\d.]+)\s+dBm', line)
                if output_power_match:
                    power_dbm = float(output_power_match.group(1))
                    if power_dbm > 3.0:  # High warning threshold typically 3dBm
                        severity = "HIGH" if power_dbm > 5.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="High laser output power detected",
                            details=f"Laser output power: {power_dbm}dBm on {current_interface} Lane {current_lane}",
                            recommendation="Check for overdrive conditions and laser health.",
                            ocid=ocid
                        ))
                    elif power_dbm < -8.0:  # Low warning threshold typically -8dBm
                        severity = "HIGH" if power_dbm < -10.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="Low laser output power detected",
                            details=f"Laser output power: {power_dbm}dBm on {current_interface} Lane {current_lane}",
                            recommendation="Check laser health, fiber connections, and attenuation.",
                            ocid=ocid
                        ))
                
                # Check laser receiver power per lane (in dBm)
                rx_power_match = re.search(r'Laser receiver power\s+:\s+[\d.]+\s+mW\s+/\s+([-\d.]+)\s+dBm', line)
                if rx_power_match:
                    rx_power_dbm = float(rx_power_match.group(1))
                    if rx_power_dbm > 4.0:  # High warning threshold typically 4dBm
                        severity = "HIGH" if rx_power_dbm > 5.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="High laser receiver power detected",
                            details=f"Laser receiver power: {rx_power_dbm}dBm on {current_interface} Lane {current_lane}",
                            recommendation="Check for excessive input power from remote end.",
                            ocid=ocid
                        ))
                    elif rx_power_dbm < -11.0:  # Low warning threshold typically -11dBm
                        severity = "HIGH" if rx_power_dbm < -14.0 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="Low laser receiver power detected",
                            details=f"Laser receiver power: {rx_power_dbm}dBm on {current_interface} Lane {current_lane}",
                            recommendation="Check fiber connections, cleanliness, and remote transmit power.",
                            ocid=ocid
                        ))
                
                # Check for loss of signal alarms per lane
                if 'Rx loss of signal alarm' in line and ': On' in line:
                    issues.append(Issue(
                        category="Optical",
                        severity="HIGH",
                        component=f"{current_interface} Lane {current_lane}",
                        description="Receiver loss of signal alarm",
                        details=f"Rx loss of signal alarm active on {current_interface} Lane {current_lane}",
                        recommendation="Check fiber connections and remote transmitter.",
                        ocid=ocid
                    ))
                
                if 'Tx loss of signal functionality alarm' in line and ': On' in line:
                    issues.append(Issue(
                        category="Optical",
                        severity="HIGH", 
                        component=f"{current_interface} Lane {current_lane}",
                        description="Transmitter loss of signal alarm",
                        details=f"Tx loss of signal alarm active on {current_interface} Lane {current_lane}",
                        recommendation="Check transmitter functionality and power supply.",
                        ocid=ocid
                    ))
                
                if 'Tx laser disabled alarm' in line and ': On' in line:
                    issues.append(Issue(
                        category="Optical",
                        severity="HIGH",
                        component=f"{current_interface} Lane {current_lane}",
                        description="Transmitter laser disabled alarm",
                        details=f"Tx laser disabled alarm active on {current_interface} Lane {current_lane}",
                        recommendation="Check laser enable status and safety interlocks.",
                        ocid=ocid
                    ))
                
                # Check for laser output power alarms per lane
                if 'Laser output power high alarm' in line and ': On' in line:
                    issues.append(Issue(
                        category="Optical",
                        severity="HIGH",
                        component=f"{current_interface} Lane {current_lane}",
                        description="Laser output power high alarm",
                        details=f"Laser output power high alarm active on {current_interface} Lane {current_lane}",
                        recommendation="Check for overdrive conditions and reduce output power.",
                        ocid=ocid
                    ))
                
                if 'Laser output power low alarm' in line and ': On' in line:
                    issues.append(Issue(
                        category="Optical",
                        severity="HIGH",
                        component=f"{current_interface} Lane {current_lane}",
                        description="Laser output power low alarm", 
                        details=f"Laser output power low alarm active on {current_interface} Lane {current_lane}",
                        recommendation="Check laser health and drive current.",
                        ocid=ocid
                    ))
                
                # Check for warning states (less severe than alarms)
                warning_checks = [
                    ('Laser bias current high warning', 'Laser bias current approaching high limit'),
                    ('Laser bias current low warning', 'Laser bias current approaching low limit'),
                    ('Laser receiver power high warning', 'Laser receiver power approaching high limit'),
                    ('Laser receiver power low warning', 'Laser receiver power approaching low limit'),
                    ('Laser output power high warning', 'Laser output power approaching high limit'),
                    ('Laser output power low warning', 'Laser output power approaching low limit')
                ]
                
                for warning_pattern, description in warning_checks:
                    if warning_pattern in line and ': On' in line:
                        issues.append(Issue(
                            category="Optical",
                            severity="MEDIUM",  # Warnings are medium severity
                            component=f"{current_interface} Lane {current_lane}",
                            description=description,
                            details=f"{warning_pattern} active on {current_interface} Lane {current_lane}",
                            recommendation="Monitor closely - parameter approaching threshold limits.",
                            ocid=ocid
                        ))
                
                # Check for laser temperature per lane (if present in log)
                laser_temp_match = re.search(r'Laser temperature\s+:\s+(\d+) degrees C', line)
                if laser_temp_match:
                    laser_temp = int(laser_temp_match.group(1))
                    if laser_temp >= 70:  # High warning threshold typically 70C
                        severity = "HIGH" if laser_temp >= 75 else "MEDIUM"
                        issues.append(Issue(
                            category="Optical",
                            severity=severity,
                            component=f"{current_interface} Lane {current_lane}",
                            description="High laser temperature detected",
                            details=f"Laser temperature: {laser_temp}°C on {current_interface} Lane {current_lane}",
                            recommendation="Check laser cooling and ambient temperature.",
                            ocid=ocid
                        ))
                    elif laser_temp <= 0:  # Low warning threshold typically 0C
                        issues.append(Issue(
                            category="Optical",
                            severity="MEDIUM",
                            component=f"{current_interface} Lane {current_lane}",
                            description="Low laser temperature detected",
                            details=f"Laser temperature: {laser_temp}°C on {current_interface} Lane {current_lane}",
                            recommendation="Check environmental conditions and laser heating.",
                            ocid=ocid
                        ))
            
            # Check for hardware alarm states (outside lane context)
            if not current_lane:
                # Module level alarms
                for alarm_type in ['temperature high alarm', 'temperature low alarm', 
                                   'voltage high alarm', 'voltage low alarm']:
                    if f'Module {alarm_type}' in line.lower() and ': On' in line:
                        issues.append(Issue(
                            category="Optical",
                            severity="HIGH",
                            component=current_interface,
                            description=f"Module {alarm_type.replace('alarm', '').strip()} alarm active",
                            details=f"Module {alarm_type} detected on {current_interface}",
                            recommendation="Check module environmental conditions and power supply.",
                            ocid=ocid
                        ))
                
                # Module level warnings
                for warning_type in ['temperature high warning', 'temperature low warning',
                                    'voltage high warning', 'voltage low warning']:
                    if f'Module {warning_type}' in line.lower() and ': On' in line:
                        issues.append(Issue(
                            category="Optical",
                            severity="MEDIUM",  # Warnings are medium severity
                            component=current_interface,
                            description=f"Module {warning_type.replace('warning', '').strip()} warning active",
                            details=f"Module {warning_type} detected on {current_interface}",
                            recommendation="Monitor closely - module parameter approaching limits.",
                            ocid=ocid
                        ))
                
                # Per-lane power alarms (when we see them outside lane context)
                for power_alarm in ['bias current high alarm', 'bias current low alarm',
                                   'receiver power high alarm', 'receiver power low alarm']:
                    if f'Laser {power_alarm}' in line.lower() and ': On' in line:
                        # Try to find which lane this belongs to by looking backwards
                        lane_context = "Unknown"
                        for j in range(max(0, i-10), i):
                            if 'Lane' in lines[j]:
                                lane_match = re.search(r'Lane (\d+)', lines[j])
                                if lane_match:
                                    lane_context = f"Lane {lane_match.group(1)}"
                                    break
                        
                        issues.append(Issue(
                            category="Optical",
                            severity="HIGH",
                            component=f"{current_interface} {lane_context}",
                            description=f"Laser {power_alarm.replace('alarm', '').strip()} alarm active",
                            details=f"Laser {power_alarm} detected on {current_interface} {lane_context}",
                            recommendation="Check laser parameters and thresholds.",
                            ocid=ocid
                        ))
        
        return issues

    def _generate_optical_status_summary(self, content: str, ocid: str) -> Issue:
        # Generate optical status summary - always reports light levels
        lines = content.split('\n')
        
        optical_interfaces = {}
        current_interface = None
        in_optical_section = False
        
        for i, line in enumerate(lines):
            # Detect optical diagnostics section
            if 'show interfaces diagnostics optics' in line:
                in_optical_section = True
                interface_match = re.search(r'show interfaces diagnostics optics ([\w/-]+)', line)
                if interface_match:
                    current_interface = interface_match.group(1)
                    optical_interfaces[current_interface] = {
                        'temperature': None,
                        'voltage': None,
                        'lanes': {},
                        'healthy': True
                    }
                continue
            
            # Exit optical section
            if in_optical_section and (line.startswith('<') and line.endswith('>')):
                in_optical_section = False
                current_interface = None
                continue
            
            if not in_optical_section or not current_interface:
                continue
            
            # Collect optical parameters
            temp_match = re.search(r'Module temperature\s+:\s+(\d+) degrees C', line)
            if temp_match:
                temp = int(temp_match.group(1))
                optical_interfaces[current_interface]['temperature'] = temp
                if temp >= 70 or temp <= 0:
                    optical_interfaces[current_interface]['healthy'] = False
            
            voltage_match = re.search(r'Module voltage\s+:\s+([\d.]+) V', line)
            if voltage_match:
                voltage = float(voltage_match.group(1))
                optical_interfaces[current_interface]['voltage'] = voltage
                if voltage > 3.45 or voltage < 3.15:
                    optical_interfaces[current_interface]['healthy'] = False
            
            # Track lane data
            lane_match = re.search(r'Lane (\d+)', line)
            current_lane = None
            if lane_match:
                current_lane = lane_match.group(1)
                optical_interfaces[current_interface]['lanes'][current_lane] = {
                    'bias_current': None,
                    'output_power': None,
                    'rx_power': None
                }
                continue
            
            # Check if we're in a lane section and collect data
            if current_lane and current_lane in optical_interfaces[current_interface]['lanes']:
                bias_match = re.search(r'Laser bias current\s+:\s+([\d.]+) mA', line)
                if bias_match:
                    bias = float(bias_match.group(1))
                    optical_interfaces[current_interface]['lanes'][current_lane]['bias_current'] = bias
                    if bias > 11.0 or bias < 5.0:
                        optical_interfaces[current_interface]['healthy'] = False
                
                output_power_match = re.search(r'Laser output power\s+:\s+[\d.]+\s+mW\s+/\s+([-\d.]+)\s+dBm', line)
                if output_power_match:
                    power_dbm = float(output_power_match.group(1))
                    optical_interfaces[current_interface]['lanes'][current_lane]['output_power'] = power_dbm
                    if power_dbm > 3.0 or power_dbm < -8.0:
                        optical_interfaces[current_interface]['healthy'] = False
                
                rx_power_match = re.search(r'Laser receiver power\s+:\s+[\d.]+\s+mW\s+/\s+([-\d.]+)\s+dBm', line)
                if rx_power_match:
                    rx_power_dbm = float(rx_power_match.group(1))
                    optical_interfaces[current_interface]['lanes'][current_lane]['rx_power'] = rx_power_dbm
                    if rx_power_dbm > 4.0 or rx_power_dbm < -11.0:
                        optical_interfaces[current_interface]['healthy'] = False
        
        if not optical_interfaces:
            return None
        
        # Build status summary
        overall_healthy = all(data['healthy'] for data in optical_interfaces.values())
        
        if overall_healthy:
            # All interfaces healthy
            interface_summaries = []
            for interface, data in optical_interfaces.items():
                lane_count = len(data['lanes'])
                temp = data['temperature']
                voltage = data['voltage']
                interface_summaries.append(f"{interface}: {temp}°C, {voltage}V, {lane_count} lanes")
            
            details = f"Optical parameters within normal ranges:\n" + "\n".join([f"  • {summary}" for summary in interface_summaries])
            
            return Issue(
                category="Optical",
                severity="INFO",
                component="Light Levels",
                description="All optical light levels OK",
                details=details,
                recommendation="Optical performance is healthy. Continue monitoring.",
                ocid=ocid
            )
        else:
            # Some issues found - let the specific threshold issues handle details
            # But still provide a summary
            healthy_count = sum(1 for data in optical_interfaces.values() if data['healthy'])
            total_count = len(optical_interfaces)
            
            return Issue(
                category="Optical",
                severity="INFO", 
                component="Light Levels",
                description=f"Optical status: {healthy_count}/{total_count} interfaces healthy",
                details=f"See specific optical issues above for details on problematic interfaces.",
                recommendation="Address specific optical threshold violations listed above.",
                ocid=ocid
            )

    def _deduplicate_issues(self, issues: List[Issue]) -> List[Issue]:
        # Remove duplicate issues based on component, description, and severity"""
        seen_issues = set()
        deduplicated = []
        
        for issue in issues:
            # Create a unique key for each issue
            key = (
                issue.ocid.strip() if issue.ocid else "",
                issue.category.strip(),
                issue.severity.strip(),
                issue.component.strip(),
                issue.description.strip()
            )
            
            if key not in seen_issues:
                seen_issues.add(key)
                deduplicated.append(issue)
        
        return deduplicated

    def generate_summary_table(self, issues: List[Issue]) -> str:
        # Generate a neat summary table of all issues grouped by OCID"""
        if not issues:
            return "No issues detected! All networks appear healthy."
            
        # Group issues by OCID
        issues_by_ocid = {}
        for issue in issues:
            ocid = issue.ocid if issue.ocid and issue.ocid != "unknown" else "Unknown Network"
            if ocid not in issues_by_ocid:
                issues_by_ocid[ocid] = []
            issues_by_ocid[ocid].append(issue)
        
        # Sort by severity within each OCID group
        severity_order = {"HIGH": 0, "MEDIUM": 1, "LOW": 2, "INFO": 4}
        for ocid in issues_by_ocid:
            issues_by_ocid[ocid].sort(key=lambda x: (severity_order.get(x.severity, 5), x.category))
        
        # Calculate overall statistics
        total_severity_counts = {}
        total_category_counts = {}
        
        for issue in issues:
            total_severity_counts[issue.severity] = total_severity_counts.get(issue.severity, 0) + 1
            total_category_counts[issue.category] = total_category_counts.get(issue.category, 0) + 1
        
        # ANSI color codes for terminal formatting
        COLORS = {
            'RED': '\033[1;31m',      # Bold red
            'ORANGE': '\033[1;33m',   # Bold yellow/orange
            'GREEN': '\033[1;32m',    # Bold green
            'BLUE': '\033[1;34m',     # Bold blue for OCID headers
            'RESET': '\033[0m'        # Reset color
        }
        
        def format_severity(severity):
            if severity == "HIGH":
                return f"{COLORS['RED']}{severity}{COLORS['RESET']}"
            elif severity == "MEDIUM":
                return f"{COLORS['ORANGE']}{severity}{COLORS['RESET']}"
            elif severity == "LOW":
                return f"{COLORS['GREEN']}{severity}{COLORS['RESET']}"
            elif severity == "INFO":
                return f"{COLORS['GREEN']}{severity}{COLORS['RESET']}"
            return severity
        
        def truncate_ocid(ocid):
            """Truncate OCID for display"""
            if ocid == "Unknown Network":
                return ocid
            if len(ocid) > 50:
                return ocid[:25] + "..." + ocid[-20:]
            return ocid
        
        # Build summary
        summary = f"""
MULTI-NETWORK ANALYSIS SUMMARY
{'='*90}
Total Networks Analyzed: {len(issues_by_ocid)}
Total Issues Found: {len(issues)}

Overall Severity Distribution:
{chr(10).join([f"  {format_severity(sev)}: {count}" for sev, count in total_severity_counts.items()])}

Overall Category Distribution:
{chr(10).join([f"  {cat}: {count}" for cat, count in total_category_counts.items()])}

{'='*90}
"""
        
        # Add issues grouped by OCID
        for ocid, ocid_issues in issues_by_ocid.items():
            # OCID-specific statistics
            ocid_severity_counts = {}
            for issue in ocid_issues:
                ocid_severity_counts[issue.severity] = ocid_severity_counts.get(issue.severity, 0) + 1
            
            truncated_ocid = truncate_ocid(ocid)
            summary += f"""
{COLORS['BLUE']}NETWORK: {truncated_ocid}{COLORS['RESET']}
Issues: {len(ocid_issues)} | Severity: {' '.join([f"{format_severity(sev)}({count})" for sev, count in ocid_severity_counts.items()])}
{'-'*90}"""
            
            # List issues for this OCID
            for i, issue in enumerate(ocid_issues, 1):
                formatted_severity = format_severity(issue.severity)
                
                # Special formatting for optical OK status
                if issue.description == "All optical light levels OK":
                    formatted_description = f"All optical light levels {COLORS['GREEN']}OK{COLORS['RESET']}"
                else:
                    formatted_description = issue.description
                
                summary += f"""
{i}. {formatted_severity} - {issue.category}
   Component: {issue.component}
   Issue: {formatted_description}
   Details: {issue.details}
   Action: {issue.recommendation}
   {'-' * 80}"""
            
            summary += "\n"  # Extra space between OCIDs
        
        return summary

    def save_analysis_report(self, issues: List[Issue], output_file: str):
        """Save detailed analysis report to JSON file"""
        report = {
            "timestamp": datetime.now().isoformat(),
            "analyzer_version": "1.0",
            "model_used": self.ollama.model,
            "total_issues": len(issues),
            "summary": {
                "high_severity": len([i for i in issues if i.severity == "HIGH"]),
                "medium_severity": len([i for i in issues if i.severity == "MEDIUM"]),
                "low_severity": len([i for i in issues if i.severity == "LOW"])
            },
            "issues": [
                {
                    "category": issue.category,
                    "severity": issue.severity,
                    "component": issue.component,
                    "description": issue.description,
                    "details": issue.details,
                    "recommendation": issue.recommendation
                }
                for issue in issues
            ]
        }
        
        with open(output_file, 'w') as f:
            json.dump(report, f, indent=2)
        
        print(f"Detailed analysis report saved to: {output_file}")


def main():
    parser = argparse.ArgumentParser(description="Network Log Analyzer with Ollama")
    parser.add_argument("--ocid", help="OCID(s) for the monitoring script as space-separated string: \"ocid1 ocid2 ocid3\"")
    parser.add_argument("--script", default="script.py", help="Path to monitoring script")
    parser.add_argument("--output", help="Output log file name")
    parser.add_argument("--model", default="llama3.2:3b", help="Ollama model to use")
    parser.add_argument("--analyze-only", help="Analyze existing log file (skip script execution)")
    parser.add_argument("--save-report", help="Save detailed JSON report to file")
    parser.add_argument("--list-models", action="store_true", help="List available Ollama models")
    parser.add_argument("--typewriter", action="store_true", help="Enable ChatGPT-style character-by-character output")
    parser.add_argument("--region", help = "Region for the script")
    parser.add_argument("--realm", help = "Realm for the script")
    
    args = parser.parse_args()
    
    analyzer = NetworkLogAnalyzer(model_name=args.model, typewriter_mode=args.typewriter)
    
    # Parse space-separated OCIDs if provided
    ocids = []
    if args.ocid:
        ocids = args.ocid.strip().split()
    
    print("Network Analysis Tool with Ollama")
    print("=" * 50)
    
    if args.list_models:
        print("Available Ollama models:")
        models = analyzer.ollama.get_available_models()
        for model in models:
            print(f"  • {model}")
        return
    
    if not args.ocid:
        parser.error("--ocid is required unless using --list-models")
    
    if args.analyze_only:
        log_file = args.analyze_only
        print(f"Analyzing existing log file: {log_file}")
    else:
        # Execute monitoring script with parsed OCIDs
        log_file = analyzer.run_monitoring_script(args.script, ocids, args.realm, args.region, args.output)
        
    # Analyze the log with LLM
    print("Analyzing network data with AI...")
    issues = analyzer.analyze_log_with_llm(log_file, ocids)
    
    # Generate and display summary
    summary = analyzer.generate_summary_table(issues)
    
    if args.typewriter:
        # Print with fast but impressive typewriter effect
        print("\n[AI] Multi-network analysis streaming...", flush=True)
        time.sleep(0.5)  # Quick pause
        print(">>> Processing complete!", flush=True)
        time.sleep(0.2)
        print("\n" + "="*50, flush=True)
        time.sleep(0.1)
        typewriter_print(summary, delay=0.008)  # Fast but visible
    else:
        print(summary)
    
    # Save detailed report if requested
    if args.save_report:
        analyzer.save_analysis_report(issues, args.save_report)
    
    # Return appropriate exit code
    COLORS = {
        'RED': '\033[1;31m',      # Bold red
        'ORANGE': '\033[1;33m',   # Bold yellow/orange  
        'GREEN': '\033[1;32m',    # Bold green
        'RESET': '\033[0m'        # Reset color
    }
    
    if any(issue.severity == "HIGH" for issue in issues):
        message = f"\n{COLORS['RED']}[CRITICAL] High severity issues detected across networks!{COLORS['RESET']}"
        if args.typewriter:
            typewriter_print(message, delay=0.02)
        else:
            print(message)
        sys.exit(2)
    elif any(issue.severity == "MEDIUM" for issue in issues):
        message = f"\n{COLORS['ORANGE']}[WARNING] Medium severity issues detected across networks.{COLORS['RESET']}"
        if args.typewriter:
            typewriter_print(message, delay=0.02)
        else:
            print(message)
        sys.exit(1)
    else:
        message = f"\n{COLORS['GREEN']}[OK] No critical issues found across all networks.{COLORS['RESET']}"
        if args.typewriter:
            typewriter_print(message, delay=0.02)
        else:
            print(message)
        sys.exit(0)


if __name__ == "__main__":
    main()
