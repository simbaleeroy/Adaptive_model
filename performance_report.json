  InstancePool:
    description: |
      An instance pool is a set of instances within the same region that are managed as a group.
      For more information about instance pools and instance configurations, see
      [Managing Compute Instances](/iaas/Content/Compute/Concepts/instancemanagement.htm).
    properties:
      id:
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the instance pool.
