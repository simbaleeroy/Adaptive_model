    private static String validateEdgePopRegion(String edgePop, String currentValue) throws ValidationException {
        if (edgePop == null) {
            edgePop = currentValue;
        } else if (StringUtils.isEmpty(edgePop)) {
            edgePop = null;
        } else {
            try {
                if (!VpnRegion.fromName(edgePop).isEdgePop()) {
                    PublicValidation.failInvalidEdgePop(edgePop);
                }
            } catch (IllegalArgumentException e) {
                PublicValidation.failInvalidEdgePop(edgePop);
            }
        }
        return edgePop;
    }

    private List<PatchPanelPortPairDo> getPatchPanelPortPairsByPatchPanelId(String patchPanelId) {
        return ScanAllIterable.from(patchPanelPortPairBl::list, 100)
                                .stream()
                                .filter(p -> patchPanelId.equals(p.getCustomerPatchPanelId()) || patchPanelId.equals(p.getLocalPatchPanelId()))
                                .collect(Collectors.toList());
    }

    @GET
    @Timed(name = "listConfigSnippets")
    @Produces({"application/json", "application/x-json-stream"})
    @Path("/configSnippets")
    @VpnSkipAuthorization
    public PaginatedResponse<ConfigSnippet> listConfigSnippets(
            @DefaultValue(LIST_LIMIT) @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken,
            @QueryParam(CustomParams.CONFIG_SNIPPET_REFERENCE_ID) String referenceId,
            @QueryParam(CustomParams.CONFIG_SNIPPET_DEVICE_ID) String deviceId,
            @QueryParam(CustomParams.CONFIG_SNIPPET_STATE) String state) throws ValidationException {
        ConfigSnippetDo.State querySnippetState = state != null ? ConfigSnippetDo.State.valueOf(state) : null;
        Predicate<ConfigSnippetDo> filterByDevice = configSnippetDo -> ((deviceId == null || configSnippetDo.getDeviceId().equals(deviceId)));
        Predicate<ConfigSnippetDo> filterByState = configSnippetDo -> ((querySnippetState == null || configSnippetDo.getState() == querySnippetState));


        if (referenceId != null) {
            return new PaginatedResponse<>(configSnippetBl.listSnippetsForDomainObject(referenceId).stream()
                    .filter(filterByDevice).filter(filterByState)
                    .map(ManagementResourceV1::toModel).collect(Collectors.toList()));
        } else if (deviceId != null) {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    () -> configSnippetBl.listSnippetsForDevice(deviceId, Optional.empty(), limit),
                    (PaginationToken p) -> configSnippetBl.listSnippetsForDevice(
                            deviceId, PaginationTokenUtils.deserializeAndValidate(opaqueToken, configSnippetBl.getMappedDataStore()), limit),
                    filterByState,
                    ManagementResourceV1::toModel,
                    configSnippetBl.getMappedDataStore()
            );
        } else if (querySnippetState != null) {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    () -> configSnippetBl.listSnippetsForState(querySnippetState, Optional.empty(), limit),
                    (PaginationToken p) -> configSnippetBl.listSnippetsForState(
                            querySnippetState, PaginationTokenUtils.deserializeAndValidate(opaqueToken, configSnippetBl.getMappedDataStore()), limit),
                    ManagementResourceV1::toModel,
                    configSnippetBl.getMappedDataStore()
            );
        } else {
            return PaginationUtils.getScanPage(opaqueToken, limit, configSnippetBl, ManagementResourceV1::toModel);
        }
    }

