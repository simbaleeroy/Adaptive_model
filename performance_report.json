                    () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update1).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("QoS bandwidth reservation template display name can not be empty");

        UpdateVirtualCircuitDetails update2 = UpdateVirtualCircuitDetails.builder()
                .isQosBandwidthReservationEnabled(true)
                .qosBandwidthReservationTemplateShapeName("template-1")
                .build();

        Assertions.assertThatThrownBy(
                        () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update2).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("Invalid QoS bandwidth reservation template name provided");

        List<Integer> percentageAllocations = Arrays.asList(25, 25, 25, 20);
        String DISPLAY_NAME = setupQosBRTemplate(percentageAllocations, qosBandwidthReservationTemplateBl).getDisplayName();

        UpdateVirtualCircuitDetails update3 = UpdateVirtualCircuitDetails.builder()
                .isQosBandwidthReservationEnabled(Boolean.TRUE)
