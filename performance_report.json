  ChangeImageCompartmentDetails:
    description: The configuration details for the move operation.
    properties:
      compartmentId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the compartment to move the image to.
        maxLength: 255
