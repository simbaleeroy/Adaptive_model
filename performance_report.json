    @Test
    public void GIVEN_ociClassicl3ProviderVirtualCircuit_WHEN_updateVirtualCircuit_THEN_correctUpdateWorkflowCreated() throws Exception {

        setupVcDependencies();

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateL3ProviderDetails(ociClassicL3ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        // This will create a work request. Delete the existing work request.
        deleteAllWorkrequests(workRequestBl);

        UpdateVirtualCircuitDetails update = UpdateVirtualCircuitDetails.builder()
                .providerState(UpdateVirtualCircuitDetails.ProviderState.Active)
                .build();

        Response response = virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), null, null, null,false,null, null,false, null, null, null, null, null, null, update);
        com.oracle.pic.vpn.model.VirtualCircuit mgmtVc = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();

        assertEquals(mgmtVc.getProviderState(), com.oracle.pic.vpn.model.VirtualCircuit.ProviderState.Active);

        List<WorkRequestDo> workRequestDos = workRequestBl.list(Optional.empty(), 10).results();
        assertThat(workRequestDos.size()).isEqualTo(1);

        assertThat(workRequestDos.get(0).getWorkflowDefinitionId()).isEqualTo(VirtualCircuitHelper.provisionOciClassicVirtualCircuitWorkflowId);

        // Delete the existing work requests.
        deleteAllWorkrequests(workRequestBl);

        update = UpdateVirtualCircuitDetails.builder()
                .displayName("change-name")
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuit(mgmtVc.getId(), null, null, null,false,null, null,false, null, null, null, null, null, null, update);
        mgmtVc = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();

        assertEquals(mgmtVc.getProviderState(), com.oracle.pic.vpn.model.VirtualCircuit.ProviderState.Active);

        workRequestDos = workRequestBl.list(Optional.empty(), 10).results();
        assertThat(workRequestDos.size()).isEqualTo(1);

        assertThat(workRequestDos.get(0).getWorkflowDefinitionId()).isEqualTo(VirtualCircuitHelper.createUpdateOciClassicVirtualCircuitWorkflowId);
    }

