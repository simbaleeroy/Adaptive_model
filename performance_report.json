    @Test
    public void GIVEN_listVirtualCircuits_WHEN_lifecycleState_THEN_ReturnVcsWithSpecifiedState()
            throws Exception {

        setupVcDependencies();

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateL3ProviderDetails(l3ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        VirtualCircuitDo.State[] states = VirtualCircuitDo.State.values();
        List<VirtualCircuitDo.State> deprecatedStates = new ArrayList<>();

        deprecatedStates.add(VirtualCircuitDo.State.PROVISIONING_FAILED);
        deprecatedStates.add(VirtualCircuitDo.State.TERMINATION_FAILED);

        for (VirtualCircuitDo.State state : states) {
            if (deprecatedStates.contains(state)) {
                continue;
            }
            Transaction t = virtualCircuitBl.beginTransaction("set-vc-state");
            virtualCircuitBl.update(t, virtualCircuitBl.getOrThrow(t, vc.getId()).toBuilder()
                    .state(state)
                    .build());
            t.commit();

            PaginatedResponse<com.oracle.pic.vpn.model.VirtualCircuit> vcs = virtualCircuitManagementResourceV1.listVirtualCircuits(
                    500, null, null, null, state.getValue());
            assertEquals(1, vcs.getResults().size());
            assertEquals(false, vcs.getResults().get(0).getIsDrgV2());
            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(vcs.getResults().get(0).getId());
            assertEquals(state, vcDo.getState());
        }
    }


