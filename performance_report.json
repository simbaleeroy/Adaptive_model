    @Test
    public void GIVEN_exportTenancyData_WHEN_objectsBelongToTenancy_THEN_includedInJson() throws Exception {
        String tenancyId = "ocid1.tenancy.oc1..aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";

        // Create sample DOs: one with tenantId set, one with compartmentId that
        // resolves to tenancyId, and one that doesn't belong
        CrossConnectDo ccBelongs = CrossConnectDo.builder()
                .id(UUID.randomUUID().toString())
                .compartmentId("comp1")
                .tenantId(tenancyId)
                .build();

        CrossConnectDo ccNotBelong = CrossConnectDo.builder()
                .id(UUID.randomUUID().toString())
                .compartmentId("comp_not")
                .tenantId("otherTenant")
                .build();

        VirtualCircuitDo vcBelongsByComp = VirtualCircuitDo.builder()
                .id(UUID.randomUUID().toString())
                .compartmentId("comp2")
                .build();

        IPsecConnectionDo ipsecNot = IPsecConnectionDo.builder()
                .id(UUID.randomUUID().toString())
                .compartmentId("comp_x")
                .build();

        // Devices should always be included
        DeviceDo device1 = DeviceDo.builder()
                .id("dev1")
                .name("dev1")
                .build();

        // Mock BL list methods - return List objects (as expected by the
        // implementation)

        when(crossConnectBl.stream()).thenReturn(Arrays.asList(ccBelongs, ccNotBelong).stream());
        when(crossConnectGroupBl.stream()).thenReturn((new ArrayList<CrossConnectGroupDo>()).stream());
        when(virtualCircuitBl.stream()).thenReturn(Arrays.asList(vcBelongsByComp).stream());
        when(iPsecConnectionBl.stream()).thenReturn(Arrays.asList(ipsecNot).stream());
        //when(remotePeeringConnectionBl.stream()).thenReturn(java.util.Collections.<RemotePeeringConnectionDo>emptyList().stream());
        when(tunnelBl.stream()).thenReturn(java.util.Collections.<TunnelDo>emptyList().stream());
        when(deviceBl.stream()).thenReturn(Arrays.asList(device1).stream());
        // identityHelper resolves compartments comp2 -> tenancyId, comp1 already has
        // tenantId
        when(identityHelper.getTenantId(eq("comp2"))).thenReturn(tenancyId);
        when(identityHelper.getTenantId(eq("comp1"))).thenReturn(tenancyId); // THIS IS THE KEY FIX!
        when(identityHelper.getTenantId(matches("comp_not|comp_x"))).thenReturn("otherTenant");


        try {
            java.lang.reflect.Method getTenantIdMethod = ccBelongs.getClass().getMethod("getTenantId");
            Object tenantIdValue = getTenantIdMethod.invoke(ccBelongs);

        } catch (Exception e) {
            log.error("DEBUG TEST: ccBelongs.getTenantId() method not found or failed: " + e.getMessage());
        }

        try {
            java.lang.reflect.Method getCompartmentIdMethod = ccBelongs.getClass().getMethod("getCompartmentId");
            Object compartmentIdValue = getCompartmentIdMethod.invoke(ccBelongs);

        } catch (Exception e) {
            log.error("DEBUG TEST: ccBelongs.getCompartmentId() method not found or failed: "
                    + e.getMessage());
        }

        // tenancy metadata
        TenancyMetadataDo tmd = TenancyMetadataDo.builder().id(tenancyId).build();
        when(tenancyMetadataBl.get(eq(tenancyId))).thenReturn(Optional.of(tmd));

        // Debug: Test Jackson serialization
        try {
            ObjectMapper testMapper = new ObjectMapper();
            String ccBelongsJson = testMapper.writeValueAsString(ccBelongs);
        } catch (Exception e) {
            log.error("DEBUG TEST: Jackson serialization failed: " + e.getMessage());
        }

        // Call API and capture StreamingOutput
        Response resp = managementResource.exportTenancyData(tenancyId);
        assertEquals(200, resp.getStatus());

        javax.ws.rs.core.StreamingOutput stream = (javax.ws.rs.core.StreamingOutput) resp.getEntity();
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        // Debug: Check if stream is null

        try {
            stream.write(baos);
        } catch (Exception e) {
            log.error("DEBUG TEST: Stream write failed: " + e.getMessage());
            e.printStackTrace();
        }

        // Debug: Check what's in the stream
        byte[] streamBytes = baos.toByteArray();
        String streamContent = new String(streamBytes);

        // Parse JSON
        ObjectMapper om = new ObjectMapper();
        JsonNode root = om.readTree(baos.toByteArray());

        // Debug: Print crossConnects array specifically
        JsonNode ccArray = root.get("crossConnects");
        // crossConnects should include only ccBelongs
        assertEquals(1, ccArray.size());
        assertEquals(ccBelongs.getId(), ccArray.get(0).get("id").asText());

        // virtualCircuits should include vcBelongsByComp
        JsonNode vcArray = root.get("virtualCircuits");
        assertEquals(1, vcArray.size());
        assertEquals(vcBelongsByComp.getId(), vcArray.get(0).get("id").asText());

        // ipsecConnections should be empty (comp_x resolves to otherTenant)
        JsonNode ipsecArray = root.get("ipsecConnections");
        assertEquals(0, ipsecArray.size());

        // devices should include device1 regardless of tenancy
        JsonNode devArray = root.get("devices");
        assertEquals(1, devArray.size());
        assertEquals("dev1", devArray.get(0).get("id").asText());

        // tenancyMetadata present
        JsonNode tMeta = root.get("tenancyMetadata");
        assertEquals(tenancyId, tMeta.get("id").asText());
    }

    @Test
    public void GIVEN_exportTenancyData_WHEN_noMatchingResources_THEN_arraysAreEmptyButDevicesIncluded() throws Exception {
        String tenancyId = "ocid1.tenancy.oc1..aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";

        when(crossConnectBl.stream()).thenReturn(java.util.Collections.<CrossConnectDo>emptyList().stream());
        when(crossConnectGroupBl.stream()).thenReturn(java.util.Collections.<CrossConnectGroupDo>emptyList().stream());
        when(virtualCircuitBl.stream()).thenReturn(java.util.Collections.<VirtualCircuitDo>emptyList().stream());
        when(iPsecConnectionBl.stream()).thenReturn(java.util.Collections.<IPsecConnectionDo>emptyList().stream());
        when(remotePeeringConnectionBl.stream())
                .thenReturn(java.util.Collections.<RemotePeeringConnectionDo>emptyList().stream());
        when(tunnelBl.stream()).thenReturn(java.util.Collections.<TunnelDo>emptyList().stream());

        DeviceDo device1 = DeviceDo.builder().id("devA").name("devA").build();
        when(deviceBl.stream()).thenReturn(Arrays.asList(device1).stream());

        when(tenancyMetadataBl.get(eq(tenancyId))).thenReturn(Optional.empty());

        Response resp = managementResource.exportTenancyData(tenancyId);
        javax.ws.rs.core.StreamingOutput stream = (javax.ws.rs.core.StreamingOutput) resp.getEntity();
        java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
        stream.write(baos);

        com.fasterxml.jackson.databind.ObjectMapper om = new com.fasterxml.jackson.databind.ObjectMapper();
        com.fasterxml.jackson.databind.JsonNode root = om.readTree(baos.toByteArray());

        assertEquals(0, root.get("crossConnects").size());
        assertEquals(0, root.get("virtualCircuits").size());
        assertEquals(1, root.get("devices").size());
        assertTrue(root.get("tenancyMetadata").isNull());
    }




    /**
     * Tests the deletion of events for resources that exceed the configured limit of events.
     *
     * @throws Exception if there is an error during the deletion process
     */
    @Test
    public void GIVEN_Events_Over_ThresHold_WHEN_deleted_IsSuccessful() throws Exception {
        when(propertiesBl.getEventLimit()).thenReturn(EVENT_LIMIT);
        RuntimeException runtimeException = assertThrows(RuntimeException.class, () -> managementResource.deleteOldEvents(null));
        assertEquals("Please enable ENABLE_EVENT_LIMIT Property to use this API.", runtimeException.getMessage());
        when(propertiesBl.isEventLimitEnabled()).thenReturn(Boolean.TRUE);
        Response response = managementResource.deleteOldEvents("Test");
        assertEquals(response.getStatus(), 202);
    }

    @Test
    public void GIVEN_getDeviceCustomerObjects_WHEN_Initialized_THEN_OperationsSuccessful() throws Exception {
        String CC_DISPLAY_NAME_NO_GROUP = "cc_no_group";
        String CC_DISPLAY_NAME_WITH_GROUP = "cc_with_group";
        String CCG_DISPLAY_NAME = "ccg_valid_device_id";

        String CC_ID1 = UUID.randomUUID().toString();
        String CC_ID2 = UUID.randomUUID().toString();
        String CCG_ID = UUID.randomUUID().toString();

        String TUNNEL_ID1 = UUID.randomUUID().toString();
        String TUNNEL_ID2 = UUID.randomUUID().toString();
        String IPSEC_ID = UUID.randomUUID().toString();
        String IPSEC_DISPLAY_NAME = "ipsec_name";

        String VC_ID1 = UUID.randomUUID().toString();
        String VC_ID2 = UUID.randomUUID().toString();
        String VC_ID3 = UUID.randomUUID().toString();

        String interfaceId = UUID.randomUUID().toString();

        String VIRTUAL_CIRCUIT_MATCH_CC = "virtual_circuit_match_cc";
        String VIRTUAL_CIRCUIT_MATCH_CCG = "virtual_circuit_match_ccg";
        String VIRTUAL_CIRCUIT_MATCH_NONE = "virtual_circuit_match_none";

        // Build all required DO objects
        CrossConnectDo crossConnectDo1 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId)
                .id(CC_ID1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectDo crossConnectDo2 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_WITH_GROUP)
                .crossConnectGroupId(CCG_ID)
                .interfaceId("00000000-0000-0000-0000-0000000000")
                .id(CC_ID2)
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectGroupDo crossConnectGroupDo = CrossConnectGroupDo.builder()
                .displayName(CCG_DISPLAY_NAME)
                .id(CCG_ID)
                .crossConnectIds(new String[]{CC_ID1, CC_ID2})
                .compartmentId(MY_COMPARTMENT)
                .build();

        TunnelDo tunnelDo1 = TunnelDo.builder()
                .ipsecId(IPSEC_ID)
                .id(TUNNEL_ID1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        TunnelDo tunnelDo2 = TunnelDo.builder()
                .ipsecId(UUID.randomUUID().toString())
                .id(TUNNEL_ID2)
                .compartmentId(MY_COMPARTMENT)
                .build();

        IPsecConnectionDo ipsecConnectionDo = IPsecConnectionDo.builder()
                .id(IPSEC_ID)
                .displayName(IPSEC_DISPLAY_NAME)
                .build();

        VirtualCircuitDo virtualCircuitDo1 = VirtualCircuitDo.builder()
                .associatedCcs(new HashSet<>(Arrays.asList(CC_ID1)))
                .displayName(VIRTUAL_CIRCUIT_MATCH_CC)
                .id(VC_ID1)
                .compartmentId(MY_COMPARTMENT)
                .build();

        VirtualCircuitDo virtualCircuitDo2 = VirtualCircuitDo.builder()
                .associatedCcs(new HashSet<>(Arrays.asList(CC_ID2)))
                .displayName(VIRTUAL_CIRCUIT_MATCH_NONE)
                .id(VC_ID2)
                .compartmentId(MY_COMPARTMENT)
                .build();

        VirtualCircuitDo virtualCircuitDo3 = VirtualCircuitDo.builder()
                .associatedCcgs(new HashSet<>(Arrays.asList(CCG_ID)))
                .displayName(VIRTUAL_CIRCUIT_MATCH_CCG)
                .id(VC_ID3)
                .compartmentId(MY_COMPARTMENT)
                .build();

        InterfaceDo interfaceDo = InterfaceDo.builder().id(interfaceId).state(InterfaceDo.State.Assigned).build();

        // Setup mocks
        when(interfaceBl.stream()).thenReturn(Arrays.asList(interfaceDo).stream());
        when(crossConnectBl.getImpactedCrossConnectsByDeviceId(any(String.class))).thenReturn(Arrays.asList(crossConnectDo1, crossConnectDo2));
        when(crossConnectGroupBl.getImpactedCrossConnectGroupsByDeviceId(any(String.class), any())).thenReturn(Arrays.asList(crossConnectGroupDo));
        when(tunnelBl.getTunnelByDeviceId(any(String.class))).thenReturn(Arrays.asList(tunnelDo1, tunnelDo2));
        when(iPsecConnectionBl.get(eq(IPSEC_ID))).thenReturn(Optional.of(ipsecConnectionDo));
        when(iPsecConnectionBl.get(AdditionalMatchers.not(eq(IPSEC_ID)))).thenReturn(Optional.empty());
        when(virtualCircuitBl.stream()).thenReturn
                (Arrays.asList(virtualCircuitDo1, virtualCircuitDo2, virtualCircuitDo3).stream());
        Mockito.when(impactedCustomersT2.getVcRedundancyStatus(eq(ManagementResourceHelper.NO_BGP_SESSION_VC_QUERY), any(), any(), any(), any(), any()))
                .thenReturn(new HashSet<>(Arrays.asList(virtualCircuitDo1.getId())));
        Mockito.when(impactedCustomersT2.getVcRedundancyStatus(eq(ManagementResourceHelper.PENDING_BGP_SESSION_VC_QUERY), any(), any(), any(), any(), any()))
                .thenReturn(new HashSet<>());

        // Run test and validate the result
        CustomerList customerList = managementResource.getDeviceCustomerObjects(MY_DEVICE_ID);

        assertTrue(customerList.getProviders().size() == 0);

        assertTrue(customerList.getFastConnectCustomers().size() == 4);
        List<String> expectedObjectId = new ArrayList<>(Arrays.asList(CC_ID1, CCG_ID, VC_ID1, VC_ID3));

        customerList.getFastConnectCustomers().forEach(fastConnectCustomer -> {
            String objectId = fastConnectCustomer.getObjectId();
            assertTrue(expectedObjectId.contains(objectId));
            expectedObjectId.remove(objectId);

            if (objectId.equals(virtualCircuitDo1.getId())) {
                assertFalse(fastConnectCustomer.getCustomerBgpSessionUp());
            } else if (fastConnectCustomer.getCustomerBgpSessionUp()!= null){
                assertTrue(fastConnectCustomer.getCustomerBgpSessionUp());
            }
        });
        assertTrue(expectedObjectId.isEmpty());
    }

