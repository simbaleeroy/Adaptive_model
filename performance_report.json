export function getFilteredCrossConnectOptions(
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[],
) {
  return crossConnects
    ?.filter(cc => !cc?.crossConnectGroupId)
    ?.map(crossConnect => ({
      label: crossConnect.displayName,
      value: crossConnect.id,
    }));
}

export const getRedundantCrossConnectOptions = (
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[],
  crossConnectGroups?: DEFINITION_CoreServicesApi_CrossConnectGroup[],
) => {
  if (crossConnectGroups && crossConnectGroups.length > 0) {
    if (!crossConnects || crossConnectGroups?.length === 0) return [];
    const crossConnectGroupsByCompartment = new Map<string, string>(
      crossConnectGroups
        ?.filter(ccg => ccg.lifecycleState === CrossConnectGroupLifecycleStateEnum.Provisioned)
        ?.map(ccg => [ccg.id, ccg.displayName]),
    );

    return crossConnects.map(crossConnect => {
      const { displayName, id, crossConnectGroupId } =
        crossConnect as DEFINITION_CoreServicesApi_CrossConnect & { displayName: string };
      const groupName = crossConnectGroupsByCompartment?.get(crossConnectGroupId);
      return groupName
        ? { label: groupName, value: crossConnectGroupId }
        : { label: displayName, value: id };
    });
  }
  return getFilteredCrossConnectOptions(crossConnects);
};

export function getDefaultTags(virtualCircuit: VirtualCircuit) {
  const { definedTags, freeformTags } = virtualCircuit;
  return [
    ...(definedTags
      ? Object.entries(definedTags).flatMap(([space, tags]) =>
          Object.entries(tags).map(([key, value]) => ({
            tagNameSpace: space,
            tagKey: key,
            tagValue: value,
          })),
        )
      : []),
    ...(freeformTags
      ? Object.entries(freeformTags).map(([key, value]) => ({
          tagNameSpace: "FREEFORM_TAG",
          tagKey: key,
          tagValue: value,
        }))
      : []),
  ];
}
