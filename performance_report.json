    /**
     * Return virtual circuits with given gatewayId.
     * @return  list of virtual circuit DOs with the given gatewayId.
     */
    public ScanPage<VirtualCircuitDo> getVirtualCircuitByGatewayId(
            String gatewayId,
            Optional<PaginationToken> paginationToken,
            int limit
    ) {
        VirtualCircuitDo.VcGatewayIdKey key = VirtualCircuitDo.VcGatewayIdKey.builder()
                .gatewayId(gatewayId)
                .build();

        return paginationToken.map(token -> vcGatewayIdVirtualCircuitDoIndex.scan(token, limit))
                .orElse(vcGatewayIdVirtualCircuitDoIndex.beginPrefixScan(key, limit));
    }

    /**
     * Return virtual circuits with given gatewayId.
     * @return  list of virtual circuit DOs with the given gatewayId.
     */
    public List<VirtualCircuitDo> getVirtualCircuitByGatewayId(String gatewayId) {
        return getVirtualCircuitByGatewayId(gatewayId, Optional.empty(), null);
    }

    private List<VirtualCircuitDo> getVirtualCircuitByGatewayId(
            String gatewayId,
            Optional<PaginationToken> token,
            List<VirtualCircuitDo> currentVcList
    ) {
        ScanPage<VirtualCircuitDo> vcScanPage = getVirtualCircuitByGatewayId(
                gatewayId,
                token,
                SCAN_LIMIT);
        List<VirtualCircuitDo> updatedList = vcScanPage.results();
        if (currentVcList != null) {
            updatedList.addAll(currentVcList);
        }
        if (vcScanPage.hasNext()) {
            getVirtualCircuitByGatewayId(gatewayId, Optional.of(vcScanPage.paginationToken()), updatedList);
        }
        return updatedList;
    }

    public List<VirtualCircuitDo> getVirtualCircuitByInternalVcId(Transaction t, String internalVcId) {
        return internalVcIndex.get(t, internalVcId, 1);
    }

    public List<VirtualCircuitDo> getVirtualCircuitByProvCompartment(String provCompId) {
        VirtualCircuitDo.ProvCompartmentIdNameDateKey key = VirtualCircuitDo.ProvCompartmentIdNameDateKey.builder()
                .providerCompartmentId(provCompId)
                .build();

        return provCompIdDateIndex.streamOf(provCompIdDateIndex.scanBuilder().prefix(key).build())
                .collect(Collectors.toList());
    }

    public List<VirtualCircuitDo> getVirtualCircuitByProviderServiceId(Transaction t, String providerServiceId) {

        List<VirtualCircuitDo> result = new ArrayList<>();
        for (ScanPage<VirtualCircuitDo> page = providerServiceIndex.beginPrefixScan(providerServiceId, 2);
             page.hasNext();
             page = providerServiceIndex.scan(page.paginationToken())) {
            result.addAll(page.results());
        }
        return result;
    }

    public List<VirtualCircuitDo> getVirtualCircuitByPfabClusterId(Transaction t, String pFabClusterId) {

        return vcPFabClusterIdIndex.streamOf(vcPFabClusterIdIndex.scanBuilder().prefix(pFabClusterId).build())
                .collect(Collectors.toList());
    }

    /**
     * For Oci Classic Provider Virtual Circuit, workflow is launched to create Oci Classic Virtual circuit.
     * Similarly for Azure Provider Virtual Circuit, workflow is launched.
     * Hence initial state is PROVISIONING which is transitioned to PENDING_PROVIDER at the end of the workflow.
     */
    private static VirtualCircuitDo.State getInitialStateForCreateWithProvider(
            VirtualCircuitDo virtualCircuitDo,
            ProviderServiceBl providerServiceBl,
            PropertiesBl propertiesBl) {

        if (virtualCircuitDo.isOciClassicProviderVirtualCircuit() ||
                virtualCircuitDo.isOciClassicIPNWVcnVirtualCircuit()) {
            return State.PROVISIONING;
        } else if (providerServiceBl.isMicrosoftPeered(virtualCircuitDo.getProviderServiceId())) {
            return State.PROVISIONING;
        } else if (providerServiceBl.isGCPPeered(virtualCircuitDo.getProviderServiceId())) {
            return State.PROVISIONING;
        } else {
            return State.PENDING_PROVIDER;
        }
    }

    /**
     * For Azure Provider Virtual Circuit, workflow is launched, so setting the provider state as ACTIVE.
     */
    public static VirtualCircuitDo.ProviderState getInitialProviderState(
            VirtualCircuitDo virtualCircuitDo,
            ProviderServiceBl providerServiceBl,
            PropertiesBl propertiesBl) {
        if (providerServiceBl.isMicrosoftPeered(virtualCircuitDo.getProviderServiceId()) || providerServiceBl.isGCPPeered(virtualCircuitDo.getProviderServiceId())) {
            return VirtualCircuitDo.ProviderState.ACTIVE;
        } else {
            return VirtualCircuitDo.ProviderState.INACTIVE;
        }
    }

    /**
     * Retrieves a unique BGP prefix for the DRG.
     *
     * Generates a random prefix from the cidr (for the prefix length) and checks against currently
     * assigned IPs on the drg. Repeats this for MAX_VLAN_BGP_TRIES until it finds one that is not
     * currently used.
     *
     * @param drgDo - Drg for which the BGP prefix should be unique, it would be null if it is DrgV2
     * @param cidr - cidr from which bgp prefix should be selected
     * @param prefixLength - 30 or 31
     * @throws ValidationException
     */
    public static Optional<String> getUniqueBgpPrefix(DrgDo drgDo, String cidr, int prefixLength) throws ValidationException {

        for (int i = 0; i < MAX_VLAN_BGP_TRIES; i++) {

            String prefix = IpUtils.getRandomPrefixFromPool(cidr, prefixLength);
            if (drgDo != null
                    && (drgDo.getVcToIpHelper().getTargetFromReservation(IpUtils.getNextAddress(prefix, 1)).isPresent()
                    || drgDo.getVcToIpHelper().getTargetFromReservation(IpUtils.getNextAddress(prefix, 2)).isPresent())) {

                continue;
            }

            return Optional.of(prefix);
        }

        return Optional.empty();
    }

    /**
     * Generates a unique vlan to be assigned to the VC on the cross-connect group.
     *
     * Generates a random number between MIN and MAX vlan and checks to see if it is already
     * assigned to any VC on the cross-connect group. Tries to pick an unique vlan number
     * that can be used by both groups. Repeats this for MAX_VLAN_BGP_TRIE until it
     * finds one that is not used. If not able to find one, it will pick two numbers that
     * can be used by each groups seperately.
     *
     * @param ccgDo1 - primary cross-connect group for which the vlan should be unique
     * @param ccgDo2 - secondary cross-connect group for which the vlan should be unique
     * @param minVlan - minimal value of vlan number that we can pick
     * @param maxVlan - maximal value of vlan number that we can pick
     * @return Two unique vlan numbers for primary and secondary cross-connect groups, ideally they will be identical
     */
    public static List<Integer> getUniqueVlans(CrossConnectGroupDo ccgDo1, CrossConnectGroupDo ccgDo2, int minVlan, int maxVlan, PropertiesBl propertiesBl, VcToVlanMappingBl vcToVlanMappingBl) {

        List<Integer> vlans = new ArrayList<>(Arrays.asList(null, null));
        SecureRandom random = new SecureRandom();
        for (int i = 0; i < MAX_VLAN_BGP_TRIES; i++) {
            Integer vlan = random.nextInt((maxVlan - minVlan) + 1) + minVlan;
            if (propertiesBl.isVcToVlanMappingEnabled()) {
                try (Transaction t = vcToVlanMappingBl.beginTransaction("get mapping")) {
                    if (!ccgDo1.getVcToVlanHelper().getTargetFromReservation(vlan).isPresent() &&
                            !vcToVlanMappingBl.getMappingByCcOrCcgPlusVlan(t, ccgDo1.getId(), vlan).isPresent()){
                        vlans.set(0, vlan);
                    }

                    if (!ccgDo2.getVcToVlanHelper().getTargetFromReservation(vlan).isPresent() &&
                            !vcToVlanMappingBl.getMappingByCcOrCcgPlusVlan(t, ccgDo2.getId(), vlan).isPresent()){
                        vlans.set(1, vlan);
                    }
                }
            } else {
                if (!ccgDo1.getVcToVlanHelper().getTargetFromReservation(vlan).isPresent()) {
                    vlans.set(0, vlan);
                }

                if (!ccgDo2.getVcToVlanHelper().getTargetFromReservation(vlan).isPresent()) {
                    vlans.set(1, vlan);
                }
            }

            if (vlans.get(0) != null && vlans.get(0).equals(vlans.get(1))) {
                break;
            }
        }

        return vlans;
    }

    public List<VirtualCircuitDo> getVirtualCircuitListBySVlanAndPFabClusterId(Transaction t, int sVlanNumberForQfx, String pFabClusterId) {

        VirtualCircuitDo.SVlanAndPFabClusterIdKey key = VirtualCircuitDo.SVlanAndPFabClusterIdKey.builder()
                .sVlanNumberForQfx(sVlanNumberForQfx)
                .pFabClusterId(pFabClusterId)
                .build();

        return  vcSVlanAndPFabClusterIdIndex.get(t, key, 1);
    }


    /**
     * @return The VirtualCircuit DO with the given svlan and pfabclusterid.
     */
    public Optional<VirtualCircuitDo> getVirtualCircuitBySVlanAndPFabClusterId(Transaction t, int sVlanNumberForQfx, String pFabClusterId) {

        VirtualCircuitDo.SVlanAndPFabClusterIdKey key = VirtualCircuitDo.SVlanAndPFabClusterIdKey.builder()
                .sVlanNumberForQfx(sVlanNumberForQfx)
                .pFabClusterId(pFabClusterId)
                .build();


        List<VirtualCircuitDo> list = vcSVlanAndPFabClusterIdIndex.get(t, key, 1);
        if (list == null || list.size() == 0) {
            return Optional.empty();
        }
        else {
            return Optional.of(list.get(0));
        }
    }

