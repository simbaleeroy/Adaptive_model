    @PUT
    @Timed(name = "updatePatchPanelPortPair")
    @Path("/patchPanelPortPair/{patch-panel-port-pair-id}")
    @VpnSkipAuthorization
    public PatchPanelPortPair updatePatchPanelPortPair(
            @PathParam("patch-panel-port-pair-id") String patchPanelPortPairId,
            @Valid @NonNull UpdatePatchPanelPortPairDetails request) throws Exception {


        try (Transaction t = patchPanelPortPairBl.beginTransaction("update-patch-panel-port-pair")) {

            PatchPanelPortPairDo patchPanelPortPairDo = patchPanelPortPairBl.getOrThrow(t, patchPanelPortPairId);

            String localPatchPanelId = patchPanelPortPairDo.getLocalPatchPanelId();
            String localPatchPanelName = patchPanelPortPairDo.getLocalPatchPanelName();
            if (request.getLocalPatchPanelId() != null) {
                localPatchPanelId = request.getLocalPatchPanelId();
                localPatchPanelName = patchPanelBl.getOrThrow(localPatchPanelId).getName();
            }

            String customerPatchPanelId = patchPanelPortPairDo.getCustomerPatchPanelId();
            String customerPatchPanelName = patchPanelPortPairDo.getCustomerPatchPanelName();
            if (request.getCustomerPatchPanelId() != null) {
                customerPatchPanelId = request.getCustomerPatchPanelId();
                customerPatchPanelName = patchPanelBl.getOrThrow(customerPatchPanelId).getName();
            }

            String interfaceId = patchPanelPortPairDo.getInterfaceId();
            String deviceId = patchPanelPortPairDo.getDeviceId();
            InterfaceDo.PortSpeed portSpeed = patchPanelPortPairDo.getPortSpeed();
            if (request.getInterfaceId() != null) {
                interfaceId = request.getInterfaceId();
                InterfaceDo deviceInterface = interfaceBl.getOrThrow(interfaceId);
                deviceId = deviceInterface.getDeviceId();
                portSpeed = deviceInterface.getCurrentPortSpeed();
            }

            PatchPanelPortPairDo.PortStatus status = patchPanelPortPairDo.getStatus();
            if (request.getStatus() != null) {
                status = PatchPanelPortPairDo.PortStatus.valueOf(request.getStatus().getValue());
            }

            patchPanelPortPairDo = patchPanelPortPairDo.builder()
                    .id(patchPanelPortPairDo.getId())
                    .localPatchPanelId(localPatchPanelId)
                    .localPatchPanelName(localPatchPanelName)
                    .localPatchPanelPort(Optional.ofNullable(request.getLocalPatchPanelPort())
                            .orElseGet(patchPanelPortPairDo::getCustomerPatchPanelId))
                    .customerPatchPanelId(customerPatchPanelId)
                    .customerPatchPanelName(customerPatchPanelName)
                    .customerPatchPanelPort(Optional.ofNullable(request.getCustomerPatchPanelPort())
                            .orElseGet(patchPanelPortPairDo::getCustomerPatchPanelPort))
                    .status(status)
                    .interfaceId(interfaceId)
                    .portSpeed(portSpeed)
                    .deviceId(deviceId)
                    .build();

            Optional<PatchPanelPortPairDo> existingPortPair = patchPanelPortPairBl.checkForConflict(patchPanelPortPairDo);
            if (existingPortPair.isPresent()) {
                // In case of update, it is a conflict only if the returned portPair has a different id.
                if (!existingPortPair.get().getId().equals(patchPanelPortPairDo.getId())) {
                    String errMesg = String.format("Failed to update PatchPanelPortPair for (request=%s,do=%s) " +
                            "since the local and customer patch (id, name, port) conflict with existing  portPair %s.", request, patchPanelPortPairDo, existingPortPair.get());
                    log.error(errMesg);
                    throw new ValidationException(ErrorCode.InternalError, errMesg);
                }
            }

            patchPanelPortPairDo = patchPanelPortPairBl.update(t, patchPanelPortPairDo);

            log.info("Updated patchPanelPortPair(request={},do={})", request, patchPanelPortPairDo);

            t.commit();

            return toModel(patchPanelPortPairDo);
        }
    }

    @POST
    @Timed(name = "createFakePatchPanelPortPairAutogenInterface")
    @Path("/patchPanelPortPair/actions/addFake")
    @VpnSkipAuthorization
    public PatchPanelPortPair createFakePatchPanelPortPairAutogenInterface(@Valid @NonNull CreateFakePatchPanelPortPairAutogenInterfaceDetails request) throws Exception {
        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = patchPanelPortPairBl.beginTransaction("create-fake-pppairPort-with-interface")) {
                // Create Interface
                InterfaceDo.State interfaceState = InterfaceDo.State.Available;
                // Get interface device info
                DeviceDo device = deviceBl.getOrThrow(request.getDeviceId());
                if (!device.isFakeDevice()) {
                    throw new ValidationException(ErrorCode.InvalidParameter,
                            "Create Fake PP Pair Port with Interface failed. The given device is not fake.");
                }

                List<PortSpeed> portSpeedList = Arrays.asList(PortSpeed.ONE_GIGS, PortSpeed.TEN_GIGS);
                PortSpeed currentPortSpeed = DeviceManagementResourceV1.validateCurrentPortSpeeds(request.getCurrentPortSpeedShapeName(), portSpeedList);

                String interfaceId = UUID.randomUUID().toString();

                // Attempt to auto gen an interface name without conflict.
                Random r = new Random();
                int retryCount = 0;
                String interfaceName = "xe-0/0/" + r.nextInt(MAX_INTERFACE_AMOUNT);
                while (interfaceBl.getInterfaceByName(t, interfaceName, request.getDeviceId()).isPresent() && retryCount < NAMING_RETRY_MAX) {
                    interfaceName = "xe-0/0/" + r.nextInt(MAX_INTERFACE_AMOUNT);
                    retryCount++;
                }
                if (retryCount == NAMING_RETRY_MAX) {
                    // if error thrown in the future, please increase NAMING_RETRY_MAX to allow larger naming range.
                    String errMesg = String.format("Failed to create PatchPanelPortPair for (request=%s) " +
                            "since internal attempts to auto-name interface failed. Please retry", request);
                    log.error(errMesg);
                    throw new ValidationException(ErrorCode.InternalError, errMesg);
                }

                InterfaceDo interfaceDo = InterfaceDo.builder()
                        .id(interfaceId)
                        .name(interfaceName)
                        .description("Auto-generated fake interface " + interfaceName)
                        .deviceId(request.getDeviceId())
                        .capablePortSpeeds(portSpeedList)
                        .currentPortSpeed(currentPortSpeed)
                        .state(interfaceState)
                        .build();

                interfaceDo = interfaceBl.create(t, interfaceDo);
                log.info("Auto created interface for fake port (request={},do={})", request, interfaceDo);

                // Create PatchPanelPortPair
                String localPatchPanelId = request.getLocalPatchPanelId();
                String localPatchPanelName = null;

                if (localPatchPanelId != null) {
                    PatchPanelDo localPatchPanel = patchPanelBl.getOrThrow(localPatchPanelId);
                    localPatchPanelName = localPatchPanel.getName();
                    validateFakePatchPanelName(localPatchPanelName);
                }

                String customerPatchPanelId = request.getCustomerPatchPanelId();
                PatchPanelDo customerPatchPanel = patchPanelBl.getOrThrow(customerPatchPanelId);
                String customerPatchPanelName = customerPatchPanel.getName();
                validateFakePatchPanelName(customerPatchPanelName);
                String portName = "Port " + interfaceName;

                PatchPanelPortPairDo portPairDo = PatchPanelPortPairDo.builder()
                        .id(UUID.randomUUID().toString())
                        .localPatchPanelId(localPatchPanelId)
                        .localPatchPanelName(localPatchPanelName)
                        .localPatchPanelPort(portName)
                        .customerPatchPanelId(customerPatchPanelId)
                        .customerPatchPanelName(customerPatchPanelName)
                        .customerPatchPanelPort(portName)
                        .status(PatchPanelPortPairDo.PortStatus.Available)
                        .interfaceId(interfaceId)
                        .portSpeed(currentPortSpeed)
                        .deviceId(request.getDeviceId())
                        .build();

                Optional<PatchPanelPortPairDo> existingPortPair = patchPanelPortPairBl.checkForConflict(portPairDo);
                if (existingPortPair.isPresent()) {
                    String errMesg = String.format("Failed to create PatchPanelPortPair for (request=%s,do=%s) " +
                            "since the local and customer patch (id, name, port) conflict with existing  portPair %s.", request, portPairDo, existingPortPair.get());
                    log.error(errMesg);
                    throw new ValidationException(ErrorCode.InternalError, errMesg);
                }

                portPairDo = patchPanelPortPairBl.create(t, portPairDo);

                log.info("Created patchPanelPortPair(request={},do={})", request, portPairDo);
                t.commit();
                return toModel(portPairDo);
            }
        });
    }

    private void validateFakePatchPanelName(String name) throws ValidationException {
        if (!name.toLowerCase().contains("fake")) {
            String errMesg = String.format("Fail to create PatchPanelPortPair since PatchPanel %s is not fake", name);
            log.error(errMesg);
            throw new ValidationException(ErrorCode.InternalError, errMesg);
        }
    }

