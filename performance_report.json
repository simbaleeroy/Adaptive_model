    /**
     * Given a virtualCircuitDo, find the CC/CCGs that we should remove the VC from, and return
     * the device Ids for those CC/CCGs
     *
     * @param t the transaction to use to read
     * @param virtualCircuitDo the VirtualCircuit
     * @return the set of DeviceIds for the CC/CCGs to remove
     * @throws ValidationException
     */
    public Set<String> getDeviceIdsToRemoveSnippetsFrom(Transaction t, VirtualCircuitDo virtualCircuitDo)
            throws ValidationException {

        Set<String> crossConnectsToRemove = virtualCircuitDo.getCcAndCcgsToRemove();
        return getDeviceIdsToRemoveSnippetsFrom(t, crossConnectsToRemove);
    }

    /**
     * Given a list of CC/CCG ids, find the corresponding device ids.
     *
     * @param t the transactino to use to read
     * @param crossConnectsToRemove the CrossConnect
     * @return
     * @throws ValidationException
     */
    public Set<String> getDeviceIdsToRemoveSnippetsFrom(Transaction t, Set<String> crossConnectsToRemove)
            throws ValidationException {

        log.info("Found these CC/CCGs to remove {}", crossConnectsToRemove);
        Set<String> deviceIds = new HashSet<>();
        for (String connect : crossConnectsToRemove) {
            CrossConnectDo crossConnectDo;
            if (VirtualCircuitBl.isCrossConnect(connect)) {
                crossConnectDo = crossConnectBl.getOrThrow(connect);
            } else {
                CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(connect);
                crossConnectDo = crossConnectBl.getOrThrow(t,
                        crossConnectGroupDo.getCrossConnectIds()[0]);
            }

            DeviceDo deviceDo = deviceBl.getOrThrow(crossConnectDo.getDeviceId());
            // For CrossConnects on QFX return deviceId of MX since virtual circuit
            // config snippet is on MX device and not on QFX.
            deviceDo = deviceBl.getMxDeviceFromCrossConnectDevice(t, deviceDo);
            deviceIds.add(deviceDo.getId());
        }

        log.info("Found these corresponding devices to remove the snippets on {}", deviceIds);
        return deviceIds;
    }

