        String remoteIp = createVirtualCircuitDetails.getCrossConnectMappings().get(0).getCustomerBgpPeeringIpv6().split("/")[0];
        String localIp = createVirtualCircuitDetails.getCrossConnectMappings().get(0).getOracleBgpPeeringIpv6().split("/")[0];


