    @Test
    public void listCrossConnects_GIVEN_lifecycleState_THEN_ReturnCcsInSpecifiedState() throws Exception {
        CrossConnectDo.State[] states = CrossConnectDo.State.values();
        int index = 0;
        for (CrossConnectDo.State state : states) {
            Transaction t = crossConnectBl.beginTransaction("add-CrossConnects");
            CrossConnectDo newCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                    .displayName(String.format("testCC_%s", index))
                    .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                    .location(ManagementResourceTestHelper.LOCATION_ID)
                    .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                    .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                    .state(CrossConnectDo.State.PROVISIONING)
                    .connectionHintsNear(new String[]{})
                    .connectionHintsFar(new String[]{})
                    .deviceId("test_dev")
                    .build());
            t.commit();

            t = crossConnectBl.beginTransaction("set-CrossConnect-state");
            crossConnectBl.update(t, newCcDo.toBuilder()
                    .state(state)
                    .build());
            t.commit();
        }

        PaginatedResponse<CrossConnectInternal> cc = crossConnectManagementResource.listCrossConnects(
                500, null, null, null, null);
        log.info(cc.getResults().toString());
        assertEquals(cc.getResults().size(), states.length);

        for (CrossConnectDo.State state : states) {
            cc = crossConnectManagementResource.listCrossConnects(
                    500, null, null, null, state.getValue());
            log.info(cc.getResults().toString());
            assertEquals(1, cc.getResults().size());
            CrossConnectDo ccDo = crossConnectBl.getOrThrow(cc.getResults().get(0).getId());
            assertEquals(state, ccDo.getState());
        }
    }
}
