private Stream<?> getStreamFromBl(Object blObj) {
    if (blObj instanceof CrossConnectBl) {
        return ((CrossConnectBl) blObj).stream();
    } else if (blObj instanceof CrossConnectGroupBl) {
        return ((CrossConnectGroupBl) blObj).stream();
    } else if (blObj instanceof VirtualCircuitBl) {
        return ((VirtualCircuitBl) blObj).stream();
    } else if (blObj instanceof IPsecConnectionBl) {
        return ((IPsecConnectionBl) blObj).stream();
    } else if (blObj instanceof RemotePeeringConnectionBl) {
        return ((RemotePeeringConnectionBl) blObj).stream();
    } else if (blObj instanceof TunnelBl) {
        return ((TunnelBl) blObj).stream();
    } else if (blObj instanceof DeviceBl) {
        return ((DeviceBl) blObj).stream();
    }
    throw new IllegalArgumentException("Unknown BL type: " + blObj.getClass());
}
