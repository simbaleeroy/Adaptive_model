    properties:
      serverIp:
        description: |
          The IP address of the RADIUS server.
        minLength: 4
        maxLength: 50
        type: string
      sharedSecret:
        description: |
          The password is used for RADIUS authentication.
        maxLength: 255
        minLength: 1
        type: string
        format: password
      authenticationPort:
        description: |
          The port for the authentication of RADIUS service. Default is 1812.
        minimum: 0
        maximum: 65535
        type: integer
        default: 1812
      accountingPort:
        description:
          The accounting port is used to access RADIUS service.
          Moreover, the Accounting Port is only required when RADIUS Accounting is enabled.
        minimum: 0
        maximum: 65535
        default: 1646
        type: integer

  LdapConfigDetails:
    description: |
      The detail of LDAP's authentication configuration.
    properties:
      primaryServer:
        description: |
          The IP address of primary LDAP server.
        minLength: 4
        maxLength: 50
        type: string
      secondaryServer:
        description: |
          The IP address of secondary LDAP server.
        minLength: 4
        maxLength: 50
        type: string
      useSsl:
        description: |
          Option for LDAP SSL once customer enables SSL for certain ClientVpn.
          Allowed values:
          * `NEVER`: Do not use SSL (the default setting).

          * `ADAPTIVE`: Try using SSL, if that fails, use plain-text to get through authentication.

          * `ALWAYS`: Always use SSL.
        enum:
          - NEVER
          - ADAPTIVE
          - ALWAYS
        type: string
        default: NEVER
      verifySsl:
        description: |
          Choose the authentication method once useSSL enabled.
          Allowed values:
          * `NEVER`: No peer certificate is required.

          * `ALLOW`: Request a peer certificate, but session will not be aborted if certificate cannot be validated.

          * `DEMAND`: A valid peer certificate is required, then session will be aborted if one is not provided.
        enum:
          - NEVER
          - ALLOW
          - DEMAND
        type: string
        default: NEVER
      isCaseSensitive:
        description: |
          Enable case-sensitivity or not in LDAP authentication.
        type: boolean
      isBindAnon:
        description: |
          Whether to apply Anonymous bind or not.
        type: boolean
      bindDN:
        description: |
          The bind DN (Distinguished Name) includes the user and location of the
          user in LDAP directory tree
        maxLength: 255
        minLength: 1
        type: string
      bindPW:
        description: |
          The bind password is used to log in the LDAP server.
        maxLength: 255
        minLength: 1
        type: string
        format: password
      baseDN:
        description: |
          The starting point element helps LDAP service to navigate search scope.
        maxLength: 255
        minLength: 1
        type: string
      clientUsername:
        description: |
          The username of client at attribute level.
        maxLength: 255
        minLength: 1
        type: string
      additionalRequirements:
        description: |
          This additional requirement uses LDAP query syntax. E.g., to require that the user be a member of a particular LDAP group (specified by DN) use this filter:
          memberOf=CN=VPN Users, CN=Users, DC=example, DC=net
        maxLength: 255
        minLength: 0
        type: string

  ClientVpn:
    description: |
      The ClientVPNEnpoint is a server endpoint that allow customer get access to openVPN service.
    required:
      - compartmentId
      - id
      - subnetId
      - ipAddressInAttachedSubnet
      - accessibleSubnetCidrs
      - isRerouteEnabled
      - dnsConfig
    properties:
      compartmentId:
        description: The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the compartment that user sent request.
        maxLength: 255
        minLength: 1
        type: string
      id:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of clientVPNEndpoint.
        maxLength: 255
        minLength: 1
        type: string
      displayName: *ref-displayName
      lifecycleState:
        description: The current state of the ClientVPNenpoint.
        enum:
          - CREATING
          - ACTIVE
          - INACTIVE
          - FAILED
          - DELETED
          - DELETING
          - UPDATING
        type: string
      maxConnections:
        description: |
          A limit that allows the maximum number of VPN concurrent connections.
        type: integer
        format: int32
        minimum: 0
      clientSubnetCidr:
        description: |
          A subnet for openVPN clients to access servers.
        maxLength: 255
        minLength: 1
        type: string
      subnetId:
        description: |
          The [OCID](/iaas/Content/General/Concepts/identifiers.htm) of the attachedSubnet (VNIC) in customer tenancy.
        minLength: 1
        type: string
      ipAddressInAttachedSubnet:
        description: |
          The IP address in attached subnet.
        minLength: 4
        maxLength: 50
        type: string
      isRerouteEnabled:
        description: |
          Whether re-route Internet traffic or not.
        type: boolean
      accessibleSubnetCidrs:
        description: |
          A list of accessible subnets from this clientVPNEndpoint.
        items:
          maxLength: 255
          minLength: 1
          type: string
        type: array
      dnsConfig:
        $ref: "#/definitions/DnsConfigDetails"
      addressingMode:
        description: |
          Allowed values:

            * `NAT`: NAT mode supports the one-way access. In NAT mode, client can access the Internet from server endpoint
            but server endpoint cannot access the Internet from client.

            * `ROUTING`: ROUTING mode supports the two-way access. In ROUTING mode, client and server endpoint can access the
            Internet to each other.
        enum:
          - NAT
          - ROUTING
        type: string
        default: NAT
      authenticationMode:
        description: |
          Allowed values:

            * `LOCAL`: Local authentication mode that applies users and password to get authentication through the server.

            * `RADIUS`: RADIUS authentication mode applies users and password to get authentication through the RADIUS server.

            * `LDAP`: LDAP authentication mode that applies users and passwords to get authentication through the LDAP server.
        enum:
          - LOCAL
          - RADIUS
          - LDAP
        type: string
        default: LOCAL
      timeCreated:
        description: |
          The time ClientVpn was created, in the format defined by [RFC3339](https://tools.ietf.org/html/rfc3339).

          Example: `2016-08-25T21:10:29.600Z`
        format: date-time
        type: string
      radiusConfig:
        $ref: "#/definitions/RadiusConfigDetails"
      ldapConfig:
        $ref: '#/definitions/LdapConfigDetails'
      definedTags: *ref-definedTags
      freeformTags: *ref-freeformTags

  DnsConfigDetails:
    description:
      The config of DNS server for ClientVPN in detail.
    properties:
      isOverrideDns:
        description: |
          Whether to override assigned DNS server to private DNS server.
        type: boolean
      dnsServers:
        description: |
          List of IP address of DNS
        type: array
        items:
          minLength: 4
          maxLength: 50
          type: string

  CreateClientVpnUserDetails:
    description: |
