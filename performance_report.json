export const getDrgLinkHref = (drgId: string) => {
  if (!drgId) return "";
  return `/networking/drgs/${drgId}`;
};

export const getDrgAttachmentLinkHref = (drgId: string, attachmentId: string) => {
  if (!drgId || !attachmentId) return "";
  return `/networking/drgs/${drgId}/drg-attachment/${attachmentId}`;
};

export const getDrgAttachmentLifeCycleStateColor = (state: string): string => {
  switch (state) {
    case DrgAttachmentLifecycleState.Attaching:
    case DrgAttachmentLifecycleState.Detaching:
      return "warning";
    case DrgAttachmentLifecycleState.Detached:
    case DrgAttachmentLifecycleState.Updating:
      return "mute";
    case DrgAttachmentLifecycleState.Attached:
      return "active";
    default:
      return "mute";
  }
};

export const getDrgAttachmentLifeCycleState = (
  lifeCycleState: string,
  t: MauiTranslate,
): string => {
  let statusText: string;
  switch (lifeCycleState) {
    case DrgAttachmentLifecycleState.Attaching:
      statusText = MessagesKeys.DrgAttachmentList.statusLabels.attaching;
      break;
    case DrgAttachmentLifecycleState.Detaching:
      statusText = MessagesKeys.DrgAttachmentList.statusLabels.detaching;
      break;
    case DrgAttachmentLifecycleState.Detached:
      statusText = MessagesKeys.DrgAttachmentList.statusLabels.detached;
      break;
    case DrgAttachmentLifecycleState.Updating:
      statusText = MessagesKeys.DrgAttachmentList.statusLabels.updating;
      break;
    case DrgAttachmentLifecycleState.Attached:
      statusText = MessagesKeys.DrgAttachmentList.statusLabels.attached;
      break;
    default:
      statusText = MessagesKeys.FastConnect.lifecycleState.unknown;
  }
  return t(statusText);
};

