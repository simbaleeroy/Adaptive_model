    @Test
    public void ccConvert_GIVEN_ProvisionedCcId_THEN_ReturnError() throws Exception {
        Transaction t = crossConnectBl.beginTransaction("add-CrossConnect");
        CrossConnectDo pendingCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                .displayName("provisionedCc")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .location(ManagementResourceTestHelper.LOCATION_ID)
                .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                .state(CrossConnectDo.State.PROVISIONED)
                .connectionHintsNear(new String[]{})
                .connectionHintsFar(new String[]{})
                .deviceId("test_dev")
                .build());
        String provisionedCcId = pendingCcDo.getId();
        t.commit();

        t = crossConnectGroupBl.beginTransaction("add-CrossConnectGroup");
        String inactiveCcgWithProvisionedCcId = crossConnectGroupBl.create(t, CrossConnectGroupDo.builder()
                .displayName("inactiveCcgWithProvisionedCc")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .crossConnectIds(new String[]{})
                .state(CrossConnectGroupDo.State.INACTIVE)
                .deviceId("test_dev")
                .build()).getId();
        t.commit();

        assertThatThrownBy(() -> crossConnectManagementResource.ccConvert(provisionedCcId,
                ConvertCrossConnectDetails.builder()
                        .type(ConvertCrossConnectDetails.Type.ConvertToCcGroup)
                        .ccgId(inactiveCcgWithProvisionedCcId)
                        .build()))
                .isInstanceOf(ValidationException.class)
                .hasMessage("CCtoCCG: CC must be in PENDING_CUSTOMER state");

        t = crossConnectBl.beginTransaction("update-CrossConnect");
        crossConnectBl.update(t, pendingCcDo.toBuilder()
                .crossConnectGroupId(inactiveCcgWithProvisionedCcId).build());
        t.commit();

        assertThatThrownBy(() -> crossConnectManagementResource.ccConvert(provisionedCcId,
                ConvertCrossConnectDetails.builder()
                        .type(ConvertCrossConnectDetails.Type.ConvertToCcNoGroup)
                        .build()))
                .isInstanceOf(ValidationException.class)
                .hasMessage("CCtoNoCCG: CC must be in PENDING_CUSTOMER state");
    }

