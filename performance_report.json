    @Test
    public void GIVEN_customerVirtualCircuit_WHEN_propertyCRUD_THEN_succeed()
            throws Exception {

        setupVcDependencies();
        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);

        // create property
        String transit_comm_prefix = Integer.toString(12345);

        UpdatePropertyRequest update = UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX)
                .value(transit_comm_prefix)
                .build();
        
        Response response = virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), update);
        assertThat(response.getStatus()).isEqualTo(202);

        List<Property> properties = virtualCircuitManagementResourceV1.listVirtualCircuitProperties(vc.getId());

        assertEquals(1, properties.size());
        assertEquals(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX, properties.get(0).getKey());
        assertEquals(transit_comm_prefix, properties.get(0).getValue());

        // update property
        transit_comm_prefix = Integer.toString(0);
        
        update = UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX)
                .value(transit_comm_prefix)
                .build();
        
        response = virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), update);
        properties = virtualCircuitManagementResourceV1.listVirtualCircuitProperties(vc.getId());

        assertEquals(1, properties.size());
        assertEquals(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX, properties.get(0).getKey());
        assertEquals(transit_comm_prefix, properties.get(0).getValue());

        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());

        assertThat(response.getStatus()).isEqualTo(202);
        assertFalse(virtualCircuitDo.hasTransitCommunityPrefix());
        assertEquals(transit_comm_prefix, virtualCircuitDo.getTransitCommunityPrefix().get());

        // delete property
        response = virtualCircuitManagementResourceV1.deleteVirtualCircuitProperty(vc.getId(), VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX);
        assertThat(response.getStatus()).isEqualTo(202);
        
        properties = virtualCircuitManagementResourceV1.listVirtualCircuitProperties(vc.getId());
        assertEquals(0, properties.size());
        virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());
        assertFalse(virtualCircuitDo.hasTransitCommunityPrefix());
        assertFalse(virtualCircuitDo.getTransitCommunityPrefix().isPresent());
        
        // null property value
        update = UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX)
                .value(null)
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), update);
        properties = virtualCircuitManagementResourceV1.listVirtualCircuitProperties(vc.getId());

        assertEquals(1, properties.size());
        assertEquals(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX, properties.get(0).getKey());
        assertNull(properties.get(0).getValue());

        virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());

        assertThat(response.getStatus()).isEqualTo(202);
        assertFalse(virtualCircuitDo.hasTransitCommunityPrefix());
        assertFalse(virtualCircuitDo.getTransitCommunityPrefix().isPresent());
    }

