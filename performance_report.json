        DeleteC3DrgAttachmentRequest deleteC3DrgAttachmentRequest = DeleteC3DrgAttachmentRequest.builder().drgAttachmentId(drgAttachmentId).build();
        ArgumentMatcher<DeleteC3DrgAttachmentRequest> matcher = DrgV2TestMockHelper.deleteC3DrgAttachmentRequestMatcher(drgAttachmentId);
