        setupVcDependencies();

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        CpeDo cpe = CpeBlTest.generateCpeDO(cpeBl);
        DrgDo drg = DrgBlTest.generateDrgDO(drgBl);
        IPsecConnectionDo ipsecDo = IPsecConnectionBlTest.createIPsecConnection(ipsecBl, drg, cpe);

        try (Transaction t = vcTunnelAssociationBl.beginTransaction("create-association")) {
            VcTunnelAssociationDo vcTunnelAssociationDo1 = VcTunnelAssociationDo.builder()
                    .id("vctunnel1")
                    .tunnelOcid(TUNNEL_1_OCID)
                    .vcOcid(vc.getId())
                    .build();
            VcTunnelAssociationDo vcTunnelAssociationDo2 = VcTunnelAssociationDo.builder()
                    .id("vctunnel2")
                    .tunnelOcid(TUNNEL_2_OCID)
                    .vcOcid(vc.getId())
                    .build();
            TunnelDo tunnelDo1 = createTunnel(ipsecDo, TUNNEL_1_OCID, "10.0.0.0", "10.0.0.1");
            TunnelDo tunnelDo2 = createTunnel(ipsecDo, TUNNEL_2_OCID, "11.0.0.0", "11.0.0.1");
            vcTunnelAssociationBl.create(t, vcTunnelAssociationDo1);
            vcTunnelAssociationBl.create(t, vcTunnelAssociationDo2);
            tunnelBl.create(t, tunnelDo1);
            tunnelBl.create(t, tunnelDo2);
            t.commit();
        }
        List<VirtualCircuitAssociatedTunnelDetails> virtualCircuitAssociatedTunnelDetails =
                virtualCircuitManagementResourceV1.listVirtualCircuitAssociatedTunnelDetails(vc.getId(), 10, null).getResults();
        assertEquals(virtualCircuitAssociatedTunnelDetails.size(), 2);
        List<String> tunnelOcids = new ArrayList<>();
        for (VirtualCircuitAssociatedTunnelDetails details : virtualCircuitAssociatedTunnelDetails) {
            tunnelOcids.add(details.getTunnelId());
        }
        assertTrue(tunnelOcids.contains(TUNNEL_1_OCID));
        assertTrue(tunnelOcids.contains(TUNNEL_2_OCID));
    }

    private TunnelDo createTunnel(IPsecConnectionDo ipsecDo, String tunnelId, String vpnIp, String cpeIp) throws EncryptionException {
        TunnelDo tunnelDo1 = TunnelDo.builder()
                .id(tunnelId)
                .lifeCycleState(TunnelDo.LifeCycleState.Available)
                .ipsecId(ipsecDo.getId())
                .vpnIp(vpnIp)
                .cpeIp(cpeIp)
                .deviceId("DUMMY")
                .ipsecPolicy("DUMMY")
                .state(TunnelDo.State.Up)
                .psk(encryptionManager.encrypt("foo"))
                .vpnTeSetId("DUMMY")
                .vpnTeId("0")
                .lastStateChange(new Date())
                .tags(ipsecDo.getTags())
                .lifeCycleState(TunnelDo.LifeCycleState.Available)
                .insideTunnelUnit(1)
                .msInterface("1")
                .build();
        return tunnelDo1;
    }

