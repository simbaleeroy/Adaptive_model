export function getAggregateBandwidthShape(
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[] | undefined,
  portSpeedShapes: DEFINITION_CoreServicesApi_CrossConnectPortSpeedShape[],
): { name: string; bandwidthInMbps: number } {
  if (!crossConnects || crossConnects.length === 0 || crossConnects.includes(undefined)) {
    return undefined;
  }
  let sum = 0;
  for (const crossConnect of crossConnects) {
    const shape = portSpeedShapes?.find(shape => shape.name === crossConnect.portSpeedShapeName);
    if (shape === undefined) {
      return undefined;
    }
    if (crossConnect.lifecycleState === CrossConnectLifecycleStateEnum.Provisioned) {
      sum = sum + shape.portSpeedInGbps;
    }
  }
  return { name: sum.toString().concat(" Gbps"), bandwidthInMbps: sum * 1000 };
}

export function getMaxBandwidthShape(
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[] | undefined,
  portSpeedShapes: DEFINITION_CoreServicesApi_CrossConnectPortSpeedShape[],
  providerServiceId: string,
) {
  const defaultProviderMaxBandwidth = { bandwidthInMbps: 100000, name: "100 Gbps" };

  return providerServiceId
    ? defaultProviderMaxBandwidth
    : getAggregateBandwidthShape(crossConnects, portSpeedShapes);
}

export const getFilteredBandwidthOptions = (
  bandwidthShapes: DEFINITION_CoreServicesApi_VirtualCircuitBandwidthShape[],
  crossConnect: DEFINITION_CoreServicesApi_CrossConnect | undefined,
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[] | undefined,
  portSpeedShapes?: DEFINITION_CoreServicesApi_CrossConnectPortSpeedShape[],
  providerServiceId?: string,
) => {
  const crossConnectList = crossConnect ? [crossConnect] : crossConnects;
  const maxBandwidthInMbps = getMaxBandwidthShape(
    crossConnectList,
    portSpeedShapes,
    providerServiceId,
  )?.bandwidthInMbps;

  return maxBandwidthInMbps
    ? getBandwidthOptions(
        bandwidthShapes?.filter(shape => shape.bandwidthInMbps <= maxBandwidthInMbps),
      )
    : [];
};

export const getDefaultBandwidth = (
  defaultBandwidthInMbps: string,
  bandwidthShapes: DEFINITION_CoreServicesApi_VirtualCircuitBandwidthShape[],
  crossConnect: DEFINITION_CoreServicesApi_CrossConnect | undefined,
  crossConnects: DEFINITION_CoreServicesApi_CrossConnect[] | undefined,
  portSpeedShapes?: DEFINITION_CoreServicesApi_CrossConnectPortSpeedShape[],
  providerServiceId?: string,
) =>
  getFilteredBandwidthOptions(
    bandwidthShapes,
    crossConnect,
    crossConnects,
    portSpeedShapes,
    providerServiceId,
  )?.some(shape => shape.value === defaultBandwidthInMbps)
    ? defaultBandwidthInMbps
    : undefined;

export const getBandwidthOptionsPlaceHolder = (
  t: MauiTranslate,
  bandwidthShapeOptionsLoading: boolean,
  bandwidthShapeOptionsErroring: boolean,
  portSpeedShapeLoading: boolean,
  portSpeedShapeErroring: boolean,
  bandwidthShapes: DEFINITION_CoreServicesApi_VirtualCircuitBandwidthShape[] | undefined,
  portSpeedShapes: DEFINITION_CoreServicesApi_CrossConnectPortSpeedShape[] | undefined,
  crossConnect: DEFINITION_CoreServicesApi_CrossConnect | undefined,
  crossConnectList: DEFINITION_CoreServicesApi_CrossConnect[] | undefined,
  providerServiceId?: string,
  connectionType?: string,
) => {
  const crossConnects = crossConnect ? [crossConnect] : crossConnectList;
  const shapeOptions = getFilteredBandwidthOptions(
    bandwidthShapes,
    crossConnect,
    crossConnectList,
    portSpeedShapes,
    providerServiceId,
  );
  const maxBandwidthInMbps = getMaxBandwidthShape(
    crossConnects,
    portSpeedShapes,
    providerServiceId,
  )?.bandwidthInMbps;
  let hasError = !!portSpeedShapeErroring || !!bandwidthShapeOptionsErroring || !maxBandwidthInMbps;
  if (!crossConnects || crossConnects.length === 0 || crossConnects.includes(undefined)) {
    hasError = true;
  }

  let placeholderText = MessagesKeys.VirtualCircuit.form.selectAValue;
  if (!!connectionType && connectionType === ConnectionType.Provider && !providerServiceId) {
    placeholderText = MessagesKeys.VirtualCircuit.partnerSelect;
  } else if (bandwidthShapeOptionsLoading || portSpeedShapeLoading) {
    placeholderText = MessagesKeys.VirtualCircuit.loading;
  } else if (hasError) {
    placeholderText = MessagesKeys.VirtualCircuit.error;
  } else if (shapeOptions.length === 0) {
    placeholderText = MessagesKeys.VirtualCircuit.noData;
  }
  return t(placeholderText);
};

