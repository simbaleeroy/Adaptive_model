                                .networkDetails(VirtualCircuitDrgAttachmentNetworkDetails.builder()
                                        .mplsLabel(Integer.valueOf(TEST_MPLS_LABEL_2))
                                        .exportRouteTarget(TEST_EXPORT_RT_2)
                                        .importRouteTarget(TEST_IMPORT_RT_2)
                                        .isEdgePop(false)
                                        .build())
                                .build())
                        .build());
    }

