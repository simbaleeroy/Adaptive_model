    @GET
    @Path("/tenancy/{tenancyId}/export")
    @Produces({ "application/json" })
    @Timed(name = "export-tenancy-data")
    @VpnSkipAuthorization
    public Response exportTenancyData(@PathParam("tenancyId") String tenancyId) throws ValidationException {
        Validation.OCIDValidate(tenancyId);

        javax.ws.rs.core.StreamingOutput stream = (output) -> {
            com.fasterxml.jackson.core.JsonGenerator gen = null;
            try {
                gen = mapper.getFactory().createGenerator(output, com.fasterxml.jackson.core.JsonEncoding.UTF8);
                gen.writeStartObject();

                // predicate: checks tenantId then falls back to compartment resolution
                java.util.function.Predicate<Object> belongsToTenancy = (obj) -> {
                    try {
                        if (obj == null)
                            return false;
                        // Try tenantId getter
                        try {
                            java.lang.reflect.Method m = obj.getClass().getMethod("getTenantId");
                            Object tenantId = m.invoke(obj);
                            if (tenantId != null)
                                return tenancyId.equals(tenantId.toString());
                        } catch (NoSuchMethodException ignore) {
                        }
                        // Try compartmentId getter
                        try {
                            java.lang.reflect.Method mc = obj.getClass().getMethod("getCompartmentId");
                            Object compartmentId = mc.invoke(obj);
                            if (compartmentId != null) {
                                String resolved = identityHelper.getTenantId(compartmentId.toString());
                                return tenancyId.equals(resolved);
                            }
                        } catch (NoSuchMethodException ignore) {
                        }
                    } catch (Exception e) {
                        log.warn("Failed tenancy check for object {}", obj, e);
                    }
                    return false;
                };

                // Helper that writes an array field by streaming items from a ScanAllIterable
                com.fasterxml.jackson.core.JsonGenerator finalGen = gen;
                java.util.function.BiConsumer<String, java.util.function.Supplier<java.util.stream.Stream<?>>> writeArray = (
                        fieldName, streamSupplier) -> {
                    try {
                        finalGen.writeFieldName(fieldName);
                        finalGen.writeStartArray();
                        java.util.stream.Stream<?> s = streamSupplier.get();
                        java.util.Iterator<?> it = s.iterator();
                        while (it.hasNext()) {
                            Object item = it.next();
                            if (belongsToTenancy.test(item)) {
                                mapper.writeValue(finalGen, item);
                            }
                        }
                        finalGen.writeEndArray();
                    } catch (IOException e) {
                        throw new RuntimeException(e);
                    }
                };

                // CrossConnects
                writeArray.accept("crossConnects", () -> ScanAllIterable.from(crossConnectBl::list, 200).stream());

                // CrossConnectGroups
                writeArray.accept("crossConnectGroups",
                        () -> ScanAllIterable.from(crossConnectGroupBl::list, 200).stream());

                // VirtualCircuits
                writeArray.accept("virtualCircuits", () -> ScanAllIterable.from(virtualCircuitBl::list, 200).stream());

                // IPsec Connections
                writeArray.accept("ipsecConnections",
                        () -> ScanAllIterable.from(iPsecConnectionBl::list, 200).stream());

                // Remote Peering Connections
                writeArray.accept("remotePeeringConnections",
                        () -> ScanAllIterable.from(remotePeeringConnectionBl::list, 200).stream());

                // Tunnels
                writeArray.accept("tunnels", () -> ScanAllIterable.from(tunnelBl::list, 200).stream());

                // Devices (filtered by tenancy like other resources)
                writeArray.accept("devices", () -> ScanAllIterable.from(deviceBl::list, 200).stream());

                // tenancy metadata
                gen.writeFieldName("tenancyMetadata");
                mapper.writeValue(gen, tenancyMetadataBl.get(tenancyId).orElse(null));

                gen.writeEndObject();
                gen.flush();
            } catch (IOException e) {
                throw new RuntimeException(e);
            } finally {
                if (gen != null)
                    try {
                        gen.close();
                    } catch (IOException ignored) {
                    }
            }
        };

        return Response.ok(stream).type(javax.ws.rs.core.MediaType.APPLICATION_JSON).build();
    }

