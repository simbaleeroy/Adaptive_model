  ConsoleHistory:
    x-obmcs-splat:
      resourceKind: ConsoleHistory
      adLocality: ad-local
      activeLifecycleStates: ['SUCCEEDED']
      deletedLifecycleStates: ['FAILED']
      getOperationId: GetConsoleHistory
      listResourcesOperationId: ListConsoleHistories
      ocidEntityType: consolehistory
