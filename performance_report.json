    @PUT
    @Timed(name = "updateTenantMetadata")
    @Path("/tenantMetadata/{tenant-id}")
    @VpnSkipAuthorization
    public TenantMetadata updateTenantMetadata(
            @PathParam("tenant-id") String tenantId,
            @Valid @NonNull UpdateTenantMetadataDetails request) throws Exception {

        try (Transaction t = tenancyMetadataBl.beginTransaction("update-tm")) {
            Optional<TenancyMetadataDo> tenantMetadataDoOpt = tenancyMetadataBl.get(t, tenantId);
            String legalEntityName = tenantMetadataDoOpt.map(TenancyMetadataDo::getLegalEntityName).orElse(null);

            Map<String, Boolean> updateWhiteListProperties = tenantMetadataDoOpt.map(TenancyMetadataDo::getWhiteListProperties).orElseGet(HashMap::new);
            if (request.getWhitelistedProperties() != null) {
                updateWhiteListProperties = new HashMap<>();
                updateWhiteListProperties.putAll(request.getWhitelistedProperties());
            }
            if (request.getIsFastConnectWhitelisted() != null) {// need to follow IsFastConnectWhitelisted if have conflict
                updateWhiteListProperties.put(TenancyMetadataBl.FAST_CONNECT_INTERNAL_WHITELIST_KEY, request.getIsFastConnectWhitelisted());
            }

            List<String> verifiedPublicPrefixes = tenantMetadataDoOpt.map(TenancyMetadataDo::getVerifiedPublicPrefixes).orElse(null);
            List<Integer> verifiedPublicAsns = tenantMetadataDoOpt.map(TenancyMetadataDo::getVerifiedPublicAsns).orElse(null);
            List<Integer> whitelistedIpSecSetIds = tenantMetadataDoOpt.map(TenancyMetadataDo::getWhitelistedIpSecSetIds).orElse(null);
            List<String> whitelistedLocations = tenantMetadataDoOpt.map(TenancyMetadataDo::getWhitelistedLocations).orElse(null);
            List<String> whitelistedVpnTeSetIds = tenantMetadataDoOpt.map(TenancyMetadataDo::getWhitelistedVpnTeSetIds).orElse(null);
            List<String> virtualCircuitIds = tenantMetadataDoOpt.map(TenancyMetadataDo::getVcIdList).orElse(null);


            Map<String, Map<String, String>> compartmentSettings = null;
            if (StringUtils.isNotBlank(request.getCompSettings())) {
                JavaType inner = mapper.getTypeFactory().constructMapType(Map.class, String.class, String.class);
                JavaType stringType = mapper.getTypeFactory().constructType(String.class);
                JavaType type = mapper.getTypeFactory().constructMapType(Map.class, stringType, inner);
                compartmentSettings = mapper.readValue(request.getCompSettings(), type);
            }

            // verify publicPrefixes from request before updating database
            List<String> verifiedPublicPrefixesFromRequest = request.getVerifiedPublicPrefixes();
            if (verifiedPublicPrefixesFromRequest != null && !verifiedPublicPrefixesFromRequest.isEmpty()) {
                for (String prefix : verifiedPublicPrefixesFromRequest) {
                    PublicValidation.validatePrefixForPublicPeering(prefix);
                }
            }
            TenancyMetadataDo tenancyMetadataDo = TenancyMetadataDo.builder()
                    .id(tenantId)
                    .legalEntityName(Optional.ofNullable(request.getLegalEntityName())
                            .orElse(legalEntityName))
                    .lastUpdated(new Date())
                    .whiteListProperties(updateWhiteListProperties)
                    .verifiedPublicPrefixes(Optional.ofNullable(request.getVerifiedPublicPrefixes())
                            .orElse(verifiedPublicPrefixes))
                    .verifiedPublicAsns(Optional.ofNullable(request.getVerifiedPublicAsns())
                            .orElse(verifiedPublicAsns))
                    .whitelistedIpSecSetIds(Optional.ofNullable(request.getWhitelistedIpSecSetIds())
                            .orElse(whitelistedIpSecSetIds))
                    .whitelistedVpnTeSetIds(Optional.ofNullable(request.getWhitelistedVpnTeSetIds())
                            .orElse(whitelistedVpnTeSetIds))
                    .whitelistedLocations(Optional.ofNullable(request.getWhitelistedLocations())
                            .orElse(whitelistedLocations))
                    .compSettings(compartmentSettings)
                    .vcIdList(Optional.ofNullable(request.getVirtualCircuitIdList())
                            .orElse(virtualCircuitIds))
                    .build();

            tenancyMetadataDo = tenancyMetadataBl.update(t, tenancyMetadataDo);

            log.info("Updated tenant metadata(request={},do={})", request, tenancyMetadataDo);

            t.commit();

            return toModel(tenancyMetadataDo);
        }
    }

    private TenantMetadata toModel(TenancyMetadataDo tenancyMetadataDo) {

        Boolean isFastConnectWhitelisted = tenancyMetadataBl.getFastConnectInternalWhitelist(tenancyMetadataDo.getId());
        String compSetting = null;
        if (tenancyMetadataDo.getCompSettings() != null) {
            try {
                compSetting = mapper.writeValueAsString(tenancyMetadataDo.getCompSettings());
            } catch (JsonProcessingException e) {
                throw new RuntimeException("Failed to serialize compartment mappings.", e);
            }
        }

        return TenantMetadata.builder()
                .tenantName(tenancyMetadataDo.getId())
                .legalEntityName(tenancyMetadataDo.getLegalEntityName())
                .isFastConnectWhitelisted(isFastConnectWhitelisted)
                .whitelistedIpSecSetIds(tenancyMetadataDo.getWhitelistedIpSecSetIds())
                .whitelistedVpnTeSetIds(tenancyMetadataDo.getWhitelistedVpnTeSetIds())
                .whitelistedLocations(tenancyMetadataDo.getWhitelistedLocations())
                .whitelistedProperties(tenancyMetadataDo.getWhiteListProperties())
                .verifiedPublicPrefixes(tenancyMetadataDo.getVerifiedPublicPrefixes())
                .verifiedPublicAsns(tenancyMetadataDo.getVerifiedPublicAsns())
                .compSettings(compSetting)
                .virtualCircuitIdList(tenancyMetadataDo.getVcIdList())
                .build();
    }


