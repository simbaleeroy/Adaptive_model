    @GET
    @Timed(name = "list-virtualCircuit")
    @NetworkBasedAccessControl
    @AuthorizationPermission(Permissions.VIRTUAL_CIRCUIT_READ)
    @VariableOperationName(Operations.ListVirtualCircuits)
    @ResourceAssociationReviewed
    @AuthorizeReadOnly
    @ApiPerf(sla = ApiSLA.ListVirtualCircuits)
    public PaginatedResponse<VirtualCircuit> listVirtualCircuit(
            @PrincipalContext Principal principal,
            @NbacRequestContext NbacRequest nbacRequest,
            @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
            @DefaultValue("16") @QueryParam(Params.LIMIT) int limit,
            @QueryParam(Params.PAGE) String opaqueToken,
            @NotNull @QueryParam(CustomParams.COMPARTMENT_ID) String compartmentId,
            @QueryParam(CustomParams.DISPLAY_NAME) String displayName,
            @QueryParam(CustomParams.LIFECYCLE_STATE) String lifecycleState,
            @QueryParam(CustomParams.SORT_BY) String sortBy,
            @QueryParam(CustomParams.SORT_ORDER) String sortOrder,
            @AuditContext AuditPayloadAppender auditPayloadAppender) throws ValidationException {

        Validation.limitParamValidate(limit);

        Validation.OCIDValidateTenancyOrCompartmentEntity(compartmentId);
        auditPayloadAppender.setEventName("listVirtualCircuit", OperationSynchronousType.Synchronous);
        List<String> permissions = ImmutableList.of(Permissions.VIRTUAL_CIRCUIT_READ);

        authorizationHelper.authorize(
                nbacRequest, authorizationRequest, compartmentId, permissions,
                Operations.ListVirtualCircuits, principal, vcContextVariable);

        Optional<ScanParamHelper.SortBy> sortByOpt = getAndValidateSortBy(sortBy);
        Optional<ScanParamHelper.SortOrder> sortOrderOpt = getAndValidateSortOrder(sortOrder);
        Optional<VirtualCircuitDo.State> vcState = getAndValidateModelState(lifecycleState);

        List<ProviderServiceDo> providers = providerBl.getProviderServicesByCompartment(compartmentId);

        BgpStateMap bgpStateMap = bgpBl.prepareBgpStateMap();

        if (providers.size() > 0) {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    () -> virtualCircuitBl.scanForListByProviderCompartment(compartmentId, displayName, limit, Optional.empty(), sortByOpt, sortOrderOpt),
                    (PaginationToken p) -> virtualCircuitBl.scanForListByProviderCompartment(compartmentId, displayName, limit,
                            PaginationTokenUtils.deserializeAndValidate(opaqueToken, virtualCircuitBl.getMappedDataStore()), sortByOpt, sortOrderOpt),
                    filterVirtualCircuit(vcState),
                    (virtualCircuitDo) -> virtualCircuitDo.toModel(providerBl, bgpBl, bgpStateMap, vcTunnelAssociationBl, tenancyMetadataBl, identityMetadataHelper, null, null, null),
                    virtualCircuitBl.getMappedDataStore()
            );
        } else {
            return PaginationUtils.getScanPage(
                    opaqueToken,
                    () -> virtualCircuitBl.scanForList(compartmentId, displayName, limit, Optional.empty(), sortByOpt, sortOrderOpt),
                    (PaginationToken p) -> virtualCircuitBl.scanForList(compartmentId, displayName, limit,
                            PaginationTokenUtils.deserializeAndValidate(opaqueToken, virtualCircuitBl.getMappedDataStore()), sortByOpt, sortOrderOpt),
                    filterVirtualCircuit(vcState),
                    (virtualCircuitDo) -> virtualCircuitDo.toModel(providerBl, bgpBl, bgpStateMap, vcTunnelAssociationBl, tenancyMetadataBl, identityMetadataHelper, null, null, null),
                    virtualCircuitBl.getMappedDataStore()
            );
        }
    }

    private static Predicate<VirtualCircuitDo> filterVirtualCircuit(Optional<VirtualCircuitDo.State> vcState) {

        return c ->  (!vcState.isPresent() ||
                c.getState().equals(vcState.get()));
    }

    private Optional<VirtualCircuitDo.State> getAndValidateModelState(String lifeCycleState) throws ValidationException {

        if (lifeCycleState == null) {
            return Optional.empty();
        }

        for (VirtualCircuitDo.State s : VirtualCircuitDo.State.values()) {
            if (s.getValue().equalsIgnoreCase(lifeCycleState)) {
                return Optional.of(s);
            }
        }

        PublicValidation.failInvalidLifeCycleStateFilter(lifeCycleState);

        return Optional.empty();
    }

    @GET
    @Path("/{virtualCircuitId}/publicPrefixes")
    @Timed(name = "list-virtualCircuit-publicPrefixes")
    @NetworkBasedAccessControl
    @AuthorizationPermission(Permissions.VIRTUAL_CIRCUIT_READ)
    @VariableOperationName(Operations.ListVirtualCircuits)
    @ResourceAssociationReviewed
    @AuthorizeReadOnly
    @ApiPerf(sla = ApiSLA.ListVirtualCircuitPublicPrefixes)
    public PaginatedResponse<VirtualCircuitPublicPrefix> listVirtualCircuitPublicPrefixes(
            @PrincipalContext Principal principal,
            @NbacRequestContext NbacRequest nbacRequest,
            @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
            @QueryParam(CustomParams.PREFIX_VERIFICATION_STATE) String prefixVerificationState,
            @PathParam("virtualCircuitId") String id,
            @AuditContext AuditPayloadAppender auditPayloadAppender) throws ValidationException, InvalidOCIDException, AuthServerUnavailableException {

        Validation.OCIDValidate(id);

        auditPayloadAppender.setEventName("listVirtualCircuitPublicPrefixes", OperationSynchronousType.Synchronous);
        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrowForAuth(id);

        Optional<VirtualCircuitDo.PublicPrefix.VerificationState> prefixState =
                getAndValidatePrefixVerificationState(prefixVerificationState);

        boolean isProviderVirtualCircuit = StringUtils.isNotBlank(virtualCircuitDo.getProviderName());

        String compartmentId = virtualCircuitDo.getCompartmentId();
        auditPayloadAppender.overrideCompartmentId(compartmentId);
        List<String> permissions = ImmutableList.of(Permissions.VIRTUAL_CIRCUIT_READ);

        try {
            authorizationHelper.authorize(
                    nbacRequest, authorizationRequest, compartmentId, permissions,
                    Operations.ListVirtualCircuits, principal, vcContextVariable);
        } catch (RenderableException ex) {
            if (ex.getErrorCode() == ErrorCode.NotAuthorizedOrNotFound && isProviderVirtualCircuit) {

                // authorize against provider compartment.
                compartmentId = virtualCircuitDo.getProviderCompartmentId();
                authorizationHelper.authorize(
                        nbacRequest, authorizationRequest, compartmentId, permissions,
                        Operations.ListVirtualCircuits, principal, vcContextVariable);
            } else {
                throw ex;
            }
        }
        List<VirtualCircuitDo.PublicPrefix> prefixList;

        if(tenancyMetadataBl.isIpv6PublicVcWhitelisted(identityMetadataHelper.getTenantId(compartmentId))) {
            prefixList= virtualCircuitDo.getPublicPrefixes();
        } else {
            prefixList= virtualCircuitDo.getPublicPrefixes().
                    stream().filter(prefix -> IpUtils.isIpv4Address(prefix.getCidrBlock()))
                    .collect(Collectors.toList());
        }

        return new PaginatedResponse<>
                (prefixList
                        .stream()
                        .filter(prefix -> filterPublicPrefix(prefix, prefixState))
                        .map(prefix -> VirtualCircuitPublicPrefix
                                .builder()
                                .cidrBlock(prefix.getCidrBlock())
                                .verificationState(getVerificationStateFromDoState(prefix.getVerificationState()))
                                .build())
                        .collect(Collectors.toList()));

    }

    public static boolean filterPublicPrefix(VirtualCircuitDo.PublicPrefix prefix, Optional<VirtualCircuitDo.PublicPrefix.VerificationState> prefixState) {

        return !prefixState.isPresent() ||
                prefix.getVerificationState().equals(prefixState.get());

    }

    public static Optional<VirtualCircuitDo.PublicPrefix.VerificationState> getAndValidatePrefixVerificationState(String prefixVerificationState) throws ValidationException {

        if (prefixVerificationState == null) {
            return Optional.empty();
        }

        for (VirtualCircuitDo.PublicPrefix.VerificationState s : VirtualCircuitDo.PublicPrefix.VerificationState.values()) {
            if (s.getValue().equalsIgnoreCase(prefixVerificationState)) {
                return Optional.of(s);
            }
        }

        PublicValidation.failInvalidVerificationStateFilter(prefixVerificationState);

        return Optional.empty();
    }

    private static VirtualCircuitPublicPrefix.VerificationState getVerificationStateFromDoState(VirtualCircuitDo.PublicPrefix.VerificationState prefixState) {

        switch(prefixState) {
            case IN_PROGRESS:
            case IN_PROGRESS_TICKETED:
                return VirtualCircuitPublicPrefix.VerificationState.InProgress;

            case COMPLETED:
                return VirtualCircuitPublicPrefix.VerificationState.Completed;

            case FAILED:
                return VirtualCircuitPublicPrefix.VerificationState.Failed;

            default:
                return VirtualCircuitPublicPrefix.VerificationState.InProgress;
        }
    }

    @GET
    @Path("/{virtualCircuitId}/crossConnectMappings")
    @Timed(name = "list-crossConnectMappings")
    @NetworkBasedAccessControl
    @AuthorizationPermission(Permissions.VIRTUAL_CIRCUIT_READ)
