    @Test
    public void Given_getCrossConnectGroup_then_backfills_tenantId() throws Exception {
        // Arrange
        ManagementResourceV1 managementResource = mock(ManagementResourceV1.class);

        String ccgID = UUID.randomUUID().toString();
        String tenantID = "newTenantID";
        CrossConnectGroupDo ccgDo = CrossConnectGroupDo.builder().id(ccgID).tenantId(null).state(CrossConnectGroupDo.State.PROVISIONING).build();
        CrossConnectGroupDo updatedCcg = ccgDo.toBuilder().tenantId(tenantID).build();
        CrossConnectGroupBl crossConnectGroupBl = mock(CrossConnectGroupBl.class);

        assertNotNull(ccgDo);
        assertNotNull(updatedCcg);
        assertEquals(ccgDo.getId(), updatedCcg.getId());
        assertNull("tenantId is null before backfill", ccgDo.getTenantId());

        when(identityHelper.getTenantId(anyString())).thenReturn(tenantID);
        when(crossConnectGroupBl.backfillTenantId(ccgID, tenantID)).thenReturn(updatedCcg);
        when(crossConnectGroupBl.getOrThrow(any(), eq(ccgID))).thenReturn(ccgDo);

        // Act
        //CrossConnectGroupDo result = crossConnectGroupBl.backfillTenantId(ccgID, tenantID);

        CrossConnectGroup response = managementResource.crossConnectGroupToModel(ccgDo);
       // CrossConnectGroup crossConnectGroup = (CrossConnectGroup) response.getEntity();

        // Assert
        assertEquals(ccgID, response.getId());
        assertEquals(tenantID, response.getTenancyId());

    }
