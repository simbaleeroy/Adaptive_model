    @DELETE
    @Timed(name = "deletePatchPanel")
    @Path("/patchPanel/{patch-panel-id}")
    @VpnSkipAuthorization
    public Response deletePatchPanel(@PathParam("patch-panel-id") String patchPanelId) throws Exception {

        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = patchPanelBl.beginTransaction("delete-patch-panel")) {
                PatchPanelDo patchPanelDo = patchPanelBl.getOrThrow(t, patchPanelId);

                // Validating that there are no PatchPanelPortPairs associated with this PatchPanel.
                List<PatchPanelPortPairDo> portPairs =
                        ScanAllIterable.from(patchPanelPortPairBl::list, 100)
                                .stream()
                                .filter(p -> patchPanelId.equals(p.getCustomerPatchPanelId()) || patchPanelId.equals(p.getLocalPatchPanelId()))
                                .collect(Collectors.toList());

                if (!portPairs.isEmpty()) {
                    log.error("Can't delete PatchPanel do={} since it is associated with portPairs {}.", patchPanelDo, portPairs);
                    throw new ValidationException(ErrorCode.InternalError, String.format("Failure deleting PatchPanel{do=%s} since it is associated with portPairs %s.", patchPanelDo, portPairs));
                }

                log.info("Deleting patchPanel(do={})", patchPanelDo);
                eventBl.tryBatchDeleteEventsForReferenceId(patchPanelId);
                patchPanelBl.delete(t, patchPanelDo);
                t.commit();
            }
            return Response.accepted().build();
        });
    }

    @PUT
    @Timed(name = "updatePatchPanel")
    @Path("/patchPanel/{patch-panel-id}")
    @VpnSkipAuthorization
    public PatchPanel updatePatchPanel(
            @PathParam("patch-panel-id") String patchPanelId,
            @Valid @NonNull UpdatePatchPanelDetails request) throws Exception {

        try (Transaction t = patchPanelBl.beginTransaction("update-patch-panel")) {
            PatchPanelDo patchPanelDo = patchPanelBl.getOrThrow(t, patchPanelId);

            PatchPanelDo.CircuitType circuitType = patchPanelDo.getCircuitType();
            if (request.getCircuitType() != null) {
                circuitType = PatchPanelDo.CircuitType.valueOf(request.getCircuitType().getValue());
            }

            String updatedPatchPanelName;
            boolean requiresPatchPanelPortPairsUpdate = false;
            if (request.getName() != null) {
                updatedPatchPanelName = request.getName();
                if (!patchPanelDo.getName().equals(updatedPatchPanelName)) {
                    Optional<PatchPanelDo> existing = patchPanelBl.getPatchPanel(t, updatedPatchPanelName);
                    if (existing.isPresent()) {
                        throw new ValidationException(ErrorCode.InvalidParameter,
                                "PatchPanel already exists for name %s.", updatedPatchPanelName);
                    }
                    requiresPatchPanelPortPairsUpdate = true;
                }
            } else {
                updatedPatchPanelName = patchPanelDo.getName();
            }

            // Validate location exists.
            if (request.getLocationId() != null) {
                locationBl.getOrThrow(request.getLocationId());
            }

            patchPanelDo = patchPanelDo.builder()
                    .id(patchPanelDo.getId())
                    .name(updatedPatchPanelName)
                    .description(Optional.ofNullable(request.getDescription())
                            .orElseGet(patchPanelDo::getDescription))
                    .locationId(Optional.ofNullable(request.getLocationId())
                            .orElseGet(patchPanelDo::getLocationId))
                    .circuitType(circuitType)
                    .build();

            patchPanelDo = patchPanelBl.update(t, patchPanelDo);

            log.info("Updated patchPanel(request={},do={})", request, patchPanelDo);

            if (requiresPatchPanelPortPairsUpdate) {
                List<PatchPanelPortPairDo> portPairsFiltered = getPatchPanelPortPairsByPatchPanelId(patchPanelId);

                for (PatchPanelPortPairDo portPairDo : portPairsFiltered) {
                    if (portPairDo.getLocalPatchPanelId().equals(patchPanelId)) {
                        patchPanelPortPairBl.update(t, portPairDo.toBuilder().localPatchPanelName(updatedPatchPanelName).build());
                        log.info("Updated patchPanelPortPair(localPatchPanelName={},do={})", updatedPatchPanelName, portPairDo);
                    } else {
                        patchPanelPortPairBl.update(t, portPairDo.toBuilder().customerPatchPanelName(updatedPatchPanelName).build());
                        log.info("Updated patchPanelPortPair(customerPatchPanelName={},do={})", updatedPatchPanelName, portPairDo);
                    }
                }
            }

            t.commit();

            return toModel(patchPanelDo);
        }
    }

