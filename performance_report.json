x-obmcs-client-circuit-breaker-table:
  # dummy entry to prevent empty table
  dummy:
    enabled: false

x-obmcs-use-shared-work-requests-service: true

x-anchors:
  x-headers:
    displayName: &ref-displayName
      description: |
        A user-friendly name. Does not have to be unique, and it's changeable.
        Avoid entering confidential information.
      maxLength: 255
      minLength: 1
      type: string
    location: &ref-location
      description: |
        Location of the resource.
      type: string
    etag: &ref-etag
      description: |
        For optimistic concurrency control. See `if-match`.
      type: string
    opc-next-page: &ref-opc-next-page
      description: |
        For list pagination. When this header appears in the response, additional pages
        of results remain. For important details about how pagination works, see
        [List Pagination](/iaas/Content/API/Concepts/usingapi.htm#nine).
      type: string
    opc-request-id: &ref-opc-request-id
      description: |
        Unique Oracle-assigned identifier for the request. If you need to contact
        Oracle about a particular request, please provide the request ID.
      type: string
    opc-work-request-id: &ref-opc-work-request-id
      description: |
        The [OCID](/Content/General/Concepts/identifiers.htm) of the work request. Use [GetWorkRequest](/api/#/en/workrequests/20160918/WorkRequest/GetWorkRequest)
        with this ID to track the status of the request.
      type: string
    opc-total-items: &ref-opc-total-items
      description: |
        For list pagination. A pagination token to get the total number of results available.
      type: integer
  x-properties:
    freeformTags: &ref-freeformTags
      description: |
        Free-form tags for this resource. Each tag is a simple key-value pair with no
        predefined name, type, or namespace. For more information, see [Resource Tags](/iaas/Content/General/Concepts/resourcetags.htm).

        Example: `{"Department": "Finance"}`
      type: object
      additionalProperties:
        type: string
    definedTags: &ref-definedTags
      description: |
        Defined tags for this resource. Each key is predefined and scoped to a
        namespace. For more information, see [Resource Tags](/iaas/Content/General/Concepts/resourcetags.htm).

        Example: `{"Operations": {"CostCenter": "42"}}`
      type: object
      additionalProperties:
        description: |
          Key-value pair representing a defined tag key and value, scoped to a namespace.

          Example: `{"CostCenter": "42"}`
        type: object
        additionalProperties:
          description: |
            The value of the tag. Only the String type is supported.
          type: object

paths:
  # IMPORTANT: This file is exactly included in another spec file, so the two space indentation must be maintained.

  /bootVolumeAttachments/:
    x-obmcs-issue-routing-tag: computeSharedOwnershipVmAndBm
    get:
      x-obmcs-splat:
        routing:
          strategy: paginate-across-ads
        audit:
          mode: automated
        resources:
          BootVolumeAttachment:
            serviceResourceName: BootVolumeAttachment
            actionKind: LIST
            targetCompartmentId: splat.getOrThrow(request.parameter.compartmentId,'MissingParameter','compartmentId is required.')
        throttling:
          spectreLimitKey: list-boot-volume-attachments
        serviceList: ['compute']
      tags: ['compute']
      description: |
        Lists the boot volume attachments in the specified compartment. You can filter the
        list by specifying an instance OCID, boot volume OCID, or both.
      operationId: ListBootVolumeAttachments
      parameters:
        - $ref: '#/parameters/RequiredAvailabilityDomainQueryParam'
        - $ref: '#/parameters/CompartmentIdQueryParam'
        - $ref: '#/parameters/PaginationLimitQueryParam'
        - $ref: '#/parameters/PaginationTokenQueryParam'
        - $ref: '#/parameters/InstanceIdQueryParam'
        - $ref: '#/parameters/BootVolumeIdQueryParam'
      produces:
        - application/json
        - application/x-json-stream
      responses:
        200:
          description: The list is being retrieved.
          headers:
            opc-next-page: *ref-opc-next-page
            opc-request-id: *ref-opc-request-id
          schema:
            items:
              $ref: '#/definitions/BootVolumeAttachment'
            type: array
        400:
          $ref: '#/responses/400'
        401:
          $ref: '#/responses/401'
        404:
          $ref: '#/responses/404'
        500:
          $ref: '#/responses/500'
        default:
          $ref: '#/responses/DefaultError'
      summary: ListBootVolumeAttachments
    post:
      x-obmcs-splat:
        apiType: Asynchronous
        routing:
          strategy: route-to-inferred-ad
          onInferenceFailure: return-4xx
          inferenceSource: body
        audit:
          mode: automated
        resources:
          BootVolumeAttachment:
            serviceResourceName: BootVolumeAttachment
            actionKind: CREATE
            targetCompartmentId: downstream.tryGet('compute','GetInstance',request.body.instanceId).orThrow('NotAuthorizedOrNotFound','instance %s not found',request.body.instanceId).compartmentId
        throttling:
          spectreLimitKey: attach-boot-volume
        dryRunOnFailure: true
        serviceList: ['compute']
      tags: ['compute']
      description: |
        Attaches the specified boot volume to the specified instance.
      operationId: AttachBootVolume
      parameters:
        - description: Attach boot volume request
          in: body
          name: AttachBootVolumeDetails
          required: true
          schema:
            $ref: '#/definitions/AttachBootVolumeDetails'
        - $ref: '#/parameters/RetryTokenHeader'
      responses:
        200:
          description: The boot volume is being attached.
          headers:
            etag: *ref-etag
            opc-request-id: *ref-opc-request-id
          schema:
            $ref: '#/definitions/BootVolumeAttachment'
        400:
          $ref: '#/responses/400'
        401:
          $ref: '#/responses/401'
        404:
          $ref: '#/responses/404'
        409:
          $ref: '#/responses/409'
        500:
          $ref: '#/responses/500'
        default:
          $ref: '#/responses/DefaultError'
      summary: AttachBootVolume
  /bootVolumeAttachments/{bootVolumeAttachmentId}:
    x-obmcs-issue-routing-tag: computeSharedOwnershipVmAndBm
    delete:
      x-obmcs-splat:
        apiType: Asynchronous
        routing:
          strategy: route-to-inferred-ad
          onInferenceFailure: return-4xx
          inferenceSource: path
        audit:
          mode: automated
        resources:
          BootVolumeAttachment:
            serviceResourceName: BootVolumeAttachment
            actionKind: DELETE
            targetCompartmentId: downstream.tryGet('compute','GetBootVolumeAttachment',request.resourceId).orThrow('NotAuthorizedOrNotFound','BootVolumeAttachment %s not found',request.resourceId).compartmentId
        throttling:
          spectreLimitKey: detach-boot-volume
        serviceList: ['compute']
      tags: ['compute']
      description: |
        Detaches a boot volume from an instance. You must specify the OCID of the boot volume attachment.

        This is an asynchronous operation. The attachment's `lifecycleState` will change to DETACHING temporarily
        until the attachment is completely removed.
      operationId: DetachBootVolume
      parameters:
        - $ref: '#/parameters/BootVolumeAttachmentIdPathParam'
        - $ref: '#/parameters/IfMatchHeader'
      responses:
        204:
          description: The request was accepted by the server
          headers:
            opc-request-id: *ref-opc-request-id
        401:
          $ref: '#/responses/401'
        404:
          $ref: '#/responses/404'
        409:
          $ref: '#/responses/409'
        412:
          $ref: '#/responses/412'
        500:
          $ref: '#/responses/500'
        default:
          $ref: '#/responses/DefaultError'
      summary: DetachBootVolume
    get:
      x-obmcs-splat:
        routing:
          strategy: route-to-inferred-ad
          onInferenceFailure: return-4xx
          inferenceSource: path
        audit:
          mode: automated
        resources:
          BootVolumeAttachment:
            serviceResourceName: BootVolumeAttachment
            actionKind: READ
            targetCompartmentId: downstream.tryGet('compute','GetBootVolumeAttachment',request.resourceId).orThrow('NotAuthorizedOrNotFound','BootVolumeAttachment %s not found',request.resourceId).compartmentId
        throttling:
          spectreLimitKey: get-boot-volume-attachment
        serviceList: ['compute']
      tags: ['compute']
      description: Gets information about the specified boot volume attachment.
      operationId: GetBootVolumeAttachment
      parameters:
        - $ref: '#/parameters/BootVolumeAttachmentIdPathParam'
      responses:
        200:
          description: The boot volume attachment was retrieved.
          headers:
            etag: *ref-etag
            opc-request-id: *ref-opc-request-id
          schema:
            $ref: '#/definitions/BootVolumeAttachment'
        401:
          $ref: '#/responses/401'
        404:
          $ref: '#/responses/404'
        500:
          $ref: '#/responses/500'
        default:
          $ref: '#/responses/DefaultError'
      summary: GetBootVolumeAttachment
  /computeCapacityReservations:
    x-obmcs-issue-routing-tag: computeSharedOwnershipVmAndBm
    get:
      x-obmcs-splat:
        routing:
          strategy: paginate-across-ads
        audit:
          mode: automated
        resources:
          ComputeCapacityReservation:
            serviceResourceName: ComputeCapacityReservation
            actionKind: LIST
            targetCompartmentId: splat.getOrThrow(request.parameter.compartmentId,'MissingParameter','compartmentId is required.')
        throttling:
          spectreLimitKey: list-compute-capacity-reservations
        serviceList: ['compute']
      description: |
        Lists the compute capacity reservations that match the specified criteria and compartment.

        You can limit the list by specifying a compute capacity reservation display name
        (the list will include all the identically-named compute capacity reservations in the compartment).
      operationId: ListComputeCapacityReservations
      parameters:
        - $ref: '#/parameters/AvailabilityDomainQueryParam'
        - $ref: '#/parameters/CompartmentIdQueryParam'
        - $ref: '#/parameters/CapacityReservationLifecycleStateQueryParam'
        - $ref: '#/parameters/FilterByDisplayNameQueryParam'
        - $ref: '#/parameters/PaginationLimitQueryParam'
        - $ref: '#/parameters/PaginationTokenQueryParam'
        - $ref: '#/parameters/RequestIdHeader'
        - $ref: '#/parameters/SortByQueryParam'
        - $ref: '#/parameters/SortOrderQueryParam'
      produces:
        - application/json
        - application/x-json-stream
      responses:
        200:
          description: The list is being retrieved.
          headers:
            opc-next-page: *ref-opc-next-page
            opc-request-id: *ref-opc-request-id
          schema:
            items:
              $ref: '#/definitions/ComputeCapacityReservationSummary'
            type: array
