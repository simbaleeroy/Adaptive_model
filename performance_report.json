    @Test
    public void ccConvert_ConvertToCcGroup_GIVEN_PendingInactive_THEN_ReturnCcWithCcg() throws Exception {
        Transaction t = crossConnectBl.beginTransaction("add-CrossConnect");
        CrossConnectDo pendingCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                .displayName("pendingCc")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .location(ManagementResourceTestHelper.LOCATION_ID)
                .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                .state(CrossConnectDo.State.PROVISIONING)
                .connectionHintsNear(new String[]{})
                .connectionHintsFar(new String[]{})
                .deviceId("test_dev")
                .build());
        crossConnectBl.update(t, pendingCcDo.toBuilder().state(CrossConnectDo.State.PENDING_CUSTOMER).build());
        String pendingCcId = pendingCcDo.getId();
        t.commit();

        t = crossConnectGroupBl.beginTransaction("add-CrossConnectGroup");
        String inactiveCcgId = crossConnectGroupBl.create(t, CrossConnectGroupDo.builder()
                .displayName("inactiveCcg")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .crossConnectIds(new String[]{})
                .state(CrossConnectGroupDo.State.INACTIVE)
                .deviceId("test_dev")
                .build()).getId();
        t.commit();

        Response response = crossConnectManagementResource.ccConvert(pendingCcId, ConvertCrossConnectDetails.builder()
                .type(ConvertCrossConnectDetails.Type.ConvertToCcGroup)
                .ccgId(inactiveCcgId)
                .build());
        assertEquals(200, response.getStatus());
        CrossConnect crossConnect = (CrossConnect) response.getEntity();
        assertEquals(inactiveCcgId, crossConnect.getCrossConnectGroupId());
        assertEquals(CrossConnect.LifecycleState.PendingCustomer, crossConnect.getLifecycleState());
    }

