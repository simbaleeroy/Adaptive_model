        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        // One of the prefixes was set to verified and work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(0))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdateIpv6 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(3))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();

        UpdateVirtualCircuitPublicPrefix request = UpdateVirtualCircuitPublicPrefix.builder()
                .publicPrefixes(Arrays.asList(prefixUpdate, prefixUpdateIpv6))
                .build();

        Response response = virtualCircuitManagementResourceV1.updateVirtualCircuitPublicPrefixes(vc.getId(), request);
        assertEquals(response.getStatus(), HttpStatus.SC_ACCEPTED);
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(2);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        // One of the prefixes was set to not-verified and not work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate1 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(1))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Failed)
                .build();
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate1Ipv6 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(4))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Failed)
                .build();

        UpdateVirtualCircuitPublicPrefix request1 = UpdateVirtualCircuitPublicPrefix.builder()
                .publicPrefixes(Arrays.asList(prefixUpdate1, prefixUpdate1Ipv6))
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitPublicPrefixes(vc.getId(), request1);
        assertEquals(response.getStatus(), HttpStatus.SC_ACCEPTED);
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(2);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        // Verified prefix was set to verified again and not work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate2 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(0))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate2Ipv6 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(3))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();

        UpdateVirtualCircuitPublicPrefix request2 = UpdateVirtualCircuitPublicPrefix.builder()
                .publicPrefixes(Arrays.asList(prefixUpdate2, prefixUpdate2Ipv6))
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitPublicPrefixes(vc.getId(), request2);
        assertEquals(response.getStatus(), HttpStatus.SC_ACCEPTED);
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(2);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        // Verified prefix was set to in-progress again and work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate3 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(0))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.InProgress)
                .build();

        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate3Ipv6 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(0))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.InProgress)
                .build();


        UpdateVirtualCircuitPublicPrefix request3 = UpdateVirtualCircuitPublicPrefix.builder()
                .publicPrefixes(Arrays.asList(prefixUpdate3, prefixUpdate3Ipv6))
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitPublicPrefixes(vc.getId(), request3);
        assertEquals(response.getStatus(), HttpStatus.SC_ACCEPTED);
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(3);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        // Failed prefix was set to verified again and work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate4 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(1))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();
        // Failed prefix was set to verified again and work request should be created.
        UpdateVirtualCircuitPublicPrefixDetails prefixUpdate4Ipv6 = UpdateVirtualCircuitPublicPrefixDetails.builder()
                .cidrBlock(PUBLIC_PREFIXES.get(4))
                .verificationState(UpdateVirtualCircuitPublicPrefixDetails.VerificationState.Completed)
                .build();

        UpdateVirtualCircuitPublicPrefix request4 = UpdateVirtualCircuitPublicPrefix.builder()
                .publicPrefixes(Arrays.asList(prefixUpdate4, prefixUpdate4Ipv6))
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitPublicPrefixes(vc.getId(), request4);
        assertEquals(response.getStatus(), HttpStatus.SC_ACCEPTED);
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(4);

    }

