    @Test
    public void GIVEN_customerVirtualCircuit_WHEN_EnableQos_THEN_succeed()
            throws Exception {

        setupVcDependencies();
        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        try (Transaction t = deviceBl.beginTransaction("update-device-type")) {
            DeviceDo deviceDo = deviceBl.getOrThrow(crossConnect1.getDeviceId());
            deviceDo.getRoles().add(DeviceDo.Role.Qfx5120);
            deviceBl.update(t, deviceDo);
            t.commit();
        }

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);

        String transit_comm_prefix = Integer.toString(12345);
        UpdatePropertyRequest updatePropertyRequest= UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.VC_TRANSIT_COMMUNITY_PREFIX)
                .value(transit_comm_prefix)
                .build();

        virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), updatePropertyRequest);

        UpdatePropertyRequest updateEnableQosTrue = UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.ENABLE_QOS)
                .value(TRUE)
                .build();

        Response response = virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), updateEnableQosTrue);

        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());

        assertThat(response.getStatus()).isEqualTo(HTTP_202_STATUS);
        assertThat(virtualCircuitDo.getProperties().get(VirtualCircuitDo.ENABLE_QOS)).isEqualTo(TRUE);
        assertThat(virtualCircuitDo.isEnabledQos()).isEqualTo(Boolean.TRUE);
        assertThat(virtualCircuitDo.hasTransitCommunityPrefix()).isEqualTo(Boolean.TRUE);
        assertEquals(transit_comm_prefix, virtualCircuitDo.getTransitCommunityPrefix().get());

        UpdatePropertyRequest updateEnableQosFalse = UpdatePropertyRequest
                .builder()
                .key(VirtualCircuitDo.ENABLE_QOS)
                .value(FALSE)
                .build();

        response = virtualCircuitManagementResourceV1.updateVirtualCircuitProperty(vc.getId(), updateEnableQosFalse);

        virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());

        assertThat(response.getStatus()).isEqualTo(HTTP_202_STATUS);
        assertThat(virtualCircuitDo.getProperties().get(VirtualCircuitDo.ENABLE_QOS)).isEqualTo(FALSE);
        assertThat(virtualCircuitDo.isEnabledQos()).isEqualTo(Boolean.FALSE);

        Response responseDeleteProperty = virtualCircuitManagementResourceV1.deleteVirtualCircuitProperty(vc.getId(), VirtualCircuitDo.ENABLE_QOS);
        VirtualCircuitDo virtualCircuitDo2 = virtualCircuitBl.getOrThrow(vc.getId());

        assertThat(responseDeleteProperty.getStatus()).isEqualTo(HTTP_202_STATUS);
        assertThat(virtualCircuitDo2.getProperties().get(VirtualCircuitDo.ENABLE_QOS)).isEqualTo(null);
        assertThat(virtualCircuitDo2.isEnabledQos()).isEqualTo(Boolean.FALSE);
        assertThat(virtualCircuitDo.hasTransitCommunityPrefix()).isEqualTo(Boolean.TRUE);
        assertEquals(transit_comm_prefix, virtualCircuitDo.getTransitCommunityPrefix().get());
    }

