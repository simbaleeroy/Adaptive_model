def C3Data(data_retrieved):
    
    print(f'\n{data_retrieved}') # for the sake of debugging


def _get_jwt(ad="ad1", region="r2"):
    """ Generates JWT via SSH for accessing devops portal """
    command = f"ssh operator-access-token.svc.{ ad }.{ region } 'generate --mode=jwt'"
    jwt = subprocess.check_output(command, shell=True)
    return jwt.decode()


def regions():
    """ Fetches all regions and their attributes from the devops portal """
    jwt = _get_jwt()
    url = "https://devops.oci.oraclecorp.com/api/shepherd/v0/regions"
    response = requests.get(url, headers={"Authorization": f"bearer { jwt }"}, verify=False)
    response.raise_for_status()
    return response.json().get("items", [])


def realms():
    """
    Generates a dict of all realms with their attributes:
    {
        "OC1": {},
        "OC2": {},
        ...
    }
    """
    realms = dict()
    for region in regions():
        this_realm = region.get("realm")

        # New realm, insert attributes and start region list
        if this_realm not in realms:
            realms[this_realm] = region.pop("realmAttributes")
            realms[this_realm]["regions"] = [region]

        # Existing realm, extend region list only
        else:
            realms[this_realm]["regions"].append(region)

    return realms


