    @GET
    @Path("/ops/RouteInformation/{hostAddress}")
    @Timed(name = "get-RouteInformation")
    @VpnSkipAuthorization
    public Response getHostRouteInfo(@PathParam("hostAddress") String hostAddress) throws Exception {
        if (!inetAddressValidator.isValidInet4Address(hostAddress)) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "%s is not a valid ip address", hostAddress);
        }

        List<DeviceDo> deviceDos = deviceBl.stream()
                .filter(deviceDo -> !deviceDo.getState().equals(DeviceDo.State.PENDING_INSTALL))
                .collect(Collectors.toList());
        Set<RouteInformation> routeInformationSet = new HashSet<>();
        for (DeviceDo deviceDo : deviceDos) {
            try {
                String deviceIP = deviceBl.getDeviceIpFromDevice(deviceDo);
                DeviceConnector connector = deviceBl.getDeviceConnector(deviceIP, deviceDo);
                connector.startSession(DEVICE_CONNECTOR_TIMEOUT_MILLISEC);
                Set<RouteInformation> deviceRoutes = connector.getRouteInformation(hostAddress);
                routeInformationSet.addAll(connector.getRouteInformation(hostAddress));
                connector.closeSession();
            } catch (NotImplementedException e) {
                continue;
            }
        }
        return Response.ok(routeInformationSet.toArray()).build();
    }

