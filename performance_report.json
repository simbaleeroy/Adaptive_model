    @Override
    public VirtualCircuitDo update(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {
        baseValidate(t, virtualCircuitDo);

        virtualCircuitDo = associationHelper.addAssociations(t, virtualCircuitDo);
        VirtualCircuitDo effectivelyFinal = super.update(t, virtualCircuitDo);

        if (rqsHelper.isRQSEnabled()) {
            VirtualCircuitRqsModel virtualCircuitRqsModel = VirtualCircuitRqsModel.createFrom(
                    effectivelyFinal.toModel(providerServiceBl, bgpBl.get(), bgpBl.get().prepareBgpStateMap(), vcTunnelAssociationBl,
                            tenancyMetadataBl, identityMetadataHelper, null, null, null));
            rqsHelper.createOrUpdate(virtualCircuitRqsModel, VirtualCircuitRqsModel.TYPE, String.valueOf(virtualCircuitRqsModel.getChecksum()), t);
        }
        return effectivelyFinal;
    }

    public VirtualCircuitDo backfillTenantId(String vcId, String tenantId) throws ValidationException {
        if (tenantId == null) {
            return getOrThrow(vcId);
        }
        try (Transaction tx = beginTransaction("backfill-tenantId")) {
            VirtualCircuitDo vc = getOrThrow(tx, vcId);
            if (vc.getTenantId() != null) {
                return vc;
            }

            VirtualCircuitDo virtualCircuitDo = vc.toBuilder()
                    .tenantId(tenantId)
                    .build();

            // backfill and persist tenantId in VC
            virtualCircuitDo = update(tx, virtualCircuitDo);
            tx.commit();
            return virtualCircuitDo;
        } catch (CommitConflictException e) {
            throw new RuntimeException(e);
        }
    }


    @Override
    public ArchiveDo delete(Transaction t, VirtualCircuitDo virtualCircuitDo) throws ValidationException {

        virtualCircuitDo = associationHelper.clearAssociations(t, virtualCircuitDo);
        if (virtualCircuitDo.isPublic()) {
            virtualCircuitDo = releaseBgpPeerIps(t, virtualCircuitDo);
        }
        rqsHelper.delete(VirtualCircuitRqsModel.TYPE, virtualCircuitDo.getCompartmentId(), virtualCircuitDo.getId(), t);
        return super.delete(t, virtualCircuitDo);
    }

