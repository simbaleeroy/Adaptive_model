    @Test
    public void listCrossConnects_GIVEN_lifecycleState_THEN_ReturnCcsInSpecifiedState() throws Exception {
        CrossConnectDo.State[] states = CrossConnectDo.State.values();
        int index = 0;
        for (CrossConnectDo.State state : states) {
            Transaction t = crossConnectBl.beginTransaction("add-CrossConnects");
            CrossConnectDo newCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                    .displayName(String.format("testCC_%s", index))
                    .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                    .location(ManagementResourceTestHelper.LOCATION_ID)
                    .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                    .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                    .state(CrossConnectDo.State.PROVISIONING)
                    .connectionHintsNear(new String[]{})
                    .connectionHintsFar(new String[]{})
                    .deviceId("test_dev")
                    .build());
            t.commit();

            t = crossConnectBl.beginTransaction("set-CrossConnect-state");
            crossConnectBl.update(t, newCcDo.toBuilder()
                    .state(state)
                    .build());
            t.commit();
        }

        PaginatedResponse<CrossConnectInternal> cc = crossConnectManagementResource.listCrossConnects(
                500, null, null, null, null);
        log.info(cc.getResults().toString());
        assertEquals(cc.getResults().size(), states.length);

        for (CrossConnectDo.State state : states) {
            cc = crossConnectManagementResource.listCrossConnects(
                    500, null, null, null, state.getValue());
            log.info(cc.getResults().toString());
            assertEquals(1, cc.getResults().size());
            CrossConnectDo ccDo = crossConnectBl.getOrThrow(cc.getResults().get(0).getId());
            assertEquals(state, ccDo.getState());
        }
    }

    @Test
    public void GIVEN_getCrossConnect_THEN_backfillsTenantId_WhenMissing() throws Exception {

        CrossConnectInternal cc = createCrossConnect(crossConnectBl,
                 patchPanelPortPairBl,
                 locationBl,
                 "test-CC",
                 1,
                crossConnectGroupBl,
                 deviceBl);

        CrossConnectManagementResourceV1 resourceSpy = spy(crossConnectManagementResource); // fix here

        // replace cross connect bl with a spy of the real bl
        Field crossConnectBl = CrossConnectManagementResourceV1.class.getDeclaredField("crossConnectBl");
        crossConnectBl.setAccessible(true);
        Object originalBl = crossConnectBl.get(resourceSpy);
        CrossConnectBl blSpy = spy((CrossConnectBl) originalBl);
        crossConnectBl.set(resourceSpy, blSpy);

        CrossConnectDo realDo = blSpy.getOrThrowForAuth(cc.getId());
        CrossConnectDo doSpy = spy(realDo);

        // set tenacy id to null to simulate missing value and have it backfilled
        doReturn(null).when(doSpy).getTenantId(); // tenancyId
        doReturn(doSpy).when(blSpy).getOrThrowForAuth(cc.getId());

        String expectedTenantId = "expected-tenant-id";
        doReturn(expectedTenantId).when(identityHelper).getTenantId(doSpy.getCompartmentId());


        CrossConnectDo afterBackfill = spy(realDo);
        doReturn(expectedTenantId).when(afterBackfill).getTenantId();
        doReturn(afterBackfill).when(blSpy).backfillTenantId(cc.getId(), expectedTenantId);

        Response response = resourceSpy.getCrossConnect(cc.getId());
        CrossConnectInternal returnedCc = (CrossConnectInternal) response.getEntity();


        // assert that the returned cc has the backfilled tenant id
        assertThat(returnedCc.getTenancyId()).isNotNull();
        assertEquals(expectedTenantId, returnedCc.getTenancyId());

        verify(blSpy).backfillTenantId(cc.getId(), expectedTenantId);
    }

