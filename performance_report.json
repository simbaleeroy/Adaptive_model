    }

    @Test
    public void GIVEN_customerPublicVirtualCircuit_WHEN_BgpPeeringUpdated_THEN_VirutalCircuitProvisionedSucess()
            throws Exception {

        String oracleBgpIp = "20.20.20.2/30";
        String customerBgpIp = "20.20.20.1/30";

        String oracleBgpIpv6 = "2001:4860:4860::500/128";
        String customerBgpIpv6 = "2001:4860:4860::501/128";

        // When public virtual circuit is created BGP peering IP for crossconnect mappings is assigned by service itself.
        // In some cases customer would like to use their own public IP addresses. Test verifies that it is possible
        // to use these IPs by updating virtual circuit through management API.
        setupVcDependencies();

        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId(), VirtualCircuit.Type.Public).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);

        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {

            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());

            t.commit();
        }

        assertThat(vc.getCrossConnectMappings().size()).isEqualTo(1);
        CrossConnectMapping retMapping = vc.getCrossConnectMappings().get(0);
        validateBgpPeerIpsForPublicVc(retMapping);

        CrossConnectMapping updatedMapping = CrossConnectMapping.builder()
                .crossConnectOrCrossConnectGroupId(retMapping.getCrossConnectOrCrossConnectGroupId())
                .oracleBgpPeeringIp(oracleBgpIp)
                .customerBgpPeeringIp(customerBgpIp)
                .oracleBgpPeeringIpv6(oracleBgpIpv6)
                .customerBgpPeeringIpv6(customerBgpIpv6)
                .vlan(retMapping.getVlan())
                .build();

        // Update the BGP peering IP address for the mapping using management API.
        UpdateVirtualCircuitDetails updateRequest = UpdateVirtualCircuitDetails.builder()
                .crossConnectMappings(Collections.singletonList(updatedMapping))
                .providerState(UpdateVirtualCircuitDetails.ProviderState.Active)
                .build();

        Response response = virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), null, null, null, false,null, null,false, null, null, null, null, null, null, updateRequest);
        com.oracle.pic.vpn.model.VirtualCircuit mgmtVc = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();

        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(2);
        assertThat(mgmtVc.getLifecycleState()).isEqualTo(com.oracle.pic.vpn.model.VirtualCircuit.LifecycleState.Provisioning);
        assertThat(mgmtVc.getCrossConnectMappings().size()).isEqualTo(1);
        com.oracle.pic.vpn.model.CrossConnectMapping retMapping2 = mgmtVc.getCrossConnectMappings().get(0);

        assertThat(retMapping2.getCrossConnectOrCrossConnectGroupId()).isEqualTo(crossConnect1.getId());
        assertThat(retMapping2.getVlan()).isEqualTo(retMapping.getVlan());
        assertThat(retMapping2.getOracleBgpPeeringIp()).isEqualTo(oracleBgpIp);
        assertThat(retMapping2.getCustomerBgpPeeringIp()).isEqualTo(customerBgpIp);
        assertThat(retMapping2.getOracleBgpPeeringIpv6()).isEqualTo(oracleBgpIpv6);
        assertThat(retMapping2.getCustomerBgpPeeringIpv6()).isEqualTo(customerBgpIpv6);

        // Manually change the state of VC to provisioned.
        try (Transaction t = virtualCircuitBl.beginTransaction("updatevc")) {
            VirtualCircuitDo vcDo = virtualCircuitBl.getOrThrow(t, vc.getId());
            virtualCircuitBl.update(t, vcDo.toBuilder().state(VirtualCircuitDo.State.PROVISIONED).build());
            t.commit();
        }

        // Update the mapping to use a different VLAN.
        CrossConnectMapping updatedMapping2 = CrossConnectMapping.builder()
                .crossConnectOrCrossConnectGroupId(retMapping.getCrossConnectOrCrossConnectGroupId())
                .vlan(200)
                .build();

        UpdateVirtualCircuitDetails updateRequest2 = UpdateVirtualCircuitDetails.builder()
                .crossConnectMappings(Collections.singletonList(updatedMapping2))
                .build();

        VirtualCircuit vc2 = publicClient.updateVirtualCircuit(UpdateVirtualCircuitRequest.builder()
                .virtualCircuitId(vc.getId())
                .updateVirtualCircuitDetails(updateRequest2)
                .build()).getVirtualCircuit();

        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(3);
        assertThat(vc2.getLifecycleState()).isEqualTo(VirtualCircuit.LifecycleState.Provisioning);
        assertThat(vc2.getCrossConnectMappings().size()).isEqualTo(1);

        CrossConnectMapping retMapping3 = vc2.getCrossConnectMappings().get(0);

        // Verify the BGP peering addresses have not changed.
        assertThat(retMapping3.getCrossConnectOrCrossConnectGroupId()).isEqualTo(crossConnect1.getId());
        assertThat(retMapping3.getVlan()).isEqualTo(200);
        assertThat(retMapping3.getOracleBgpPeeringIp()).isEqualTo(oracleBgpIp);
        assertThat(retMapping3.getCustomerBgpPeeringIp()).isEqualTo(customerBgpIp);
        assertThat(retMapping2.getOracleBgpPeeringIpv6()).isEqualTo(oracleBgpIpv6);
        assertThat(retMapping2.getCustomerBgpPeeringIpv6()).isEqualTo(customerBgpIpv6);

        // Delete virtual circuit.
        publicClient.deleteVirtualCircuit(DeleteVirtualCircuitRequest.builder()
                .virtualCircuitId(vc2.getId())
                .build());

    }

