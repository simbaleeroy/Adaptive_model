    @PUT
    @Timed(name = "UpdateConfigSnippetOverrideTemplate")
    @Produces({"application/json", "application/x-json-stream"})
    @Path("/configSnippets/{configsnippet-id}/overrideTemplate")
    @VpnSkipAuthorization
    public ConfigSnippetOverrideTemplate updateConfigSnippetOverrideTemplate(
            @NonNull @PathParam("configsnippet-id") String configSnippetId,
            @Valid @NonNull UpdateConfigSnippetOverrideTemplateRequest request
    ) throws CommitConflictException, IOException, ValidationException {
        String overrideTemplateContents = request.getOverrideTemplateContents();
        ConfigSnippetDo configSnippetDo;
        Map<String, Object> newTemplateValues = ResourceUtils.parseStringifyiedJson(request.getTemplateValues());

        Map<String, Object> oldTemplateValues = configSnippetBl.getOrThrow(configSnippetId).getTemplateValues();
        Map<String, Object> encryptedTemplateValues = replaceRedactedValues(newTemplateValues, oldTemplateValues);

        try (Transaction t = configSnippetBl.beginTransaction("update-override-template")) {
            configSnippetDo = configSnippetBl.updateToCustomSnippet(
                    t, configSnippetId, overrideTemplateContents, encryptedTemplateValues);
            t.commit();
        }

        return ConfigSnippetOverrideTemplate.builder()
                .overrideTemplateContents(overrideTemplateContents)
                .templateValues(shahashTemplateValues(configSnippetDo.getTemplateValues()))
                .build();
    }

    @POST
    @Path("/flexibleConfigGroups")
    @Timed(name = "createFlexibleConfigGroup")
    @Consumes(MediaType.APPLICATION_JSON)
    @Produces(MediaType.APPLICATION_JSON)
    public Response createFlexibleConfigGroup(@PrincipalContext Principal principal,
                                              @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
                                              @HeaderParam("opc-request-id") String opcRequestId,
                                              @Valid CreateFlexibleConfigGroupRequest createFlexibleConfigGroupRequest) throws Exception {

        if(authorizationRequest == null) {
            throw new ValidationException(ErrorCode.NotAuthenticated, "User is not authenticated to complete the create flexible config request.");
        }

        if (createFlexibleConfigGroupRequest == null) {
            throw new ValidationException(ErrorCode.InvalidParameter, "Create Flexible Config Group Request cannot be NULL.");
        }

        log.info("Received create request for Flexible Config Group: {}", createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());

        //Ensure that at least 1 device is provided in the request
        if(createFlexibleConfigGroupRequest.getDeviceIds() == null || createFlexibleConfigGroupRequest.getDeviceIds().isEmpty()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "At least one device is required to create the Flexible Config Group: " + createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());
        }

        //Ensure that not more than 100 devices are provided in the request
        if(createFlexibleConfigGroupRequest.getDeviceIds().size() > 100) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Limit of 100 devices exceeded cannot create the Flexible Config Group: " + createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());
        }

        //Ensure that the provided CHANGE ticket is valid
        validateChangeTicket(createFlexibleConfigGroupRequest.getChangeTicket(), createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());

        //Ensure that the provided Expiry Date is valid
        validateFlexibleConfigExpiryDateGreaterThanToday(createFlexibleConfigGroupRequest.getExpiryDate(), createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());

        // Ensure the group does not already exist
        List<ConfigSnippetDo> snippets = Optional.ofNullable(
                        configSnippetBl.listSnippetsForDeviceConfigGroupName(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName(),
                                Optional.empty(), 1))
                .map(ScanPage::results).orElse(Collections.emptyList());

        if(!snippets.isEmpty()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Flexible Config Group already exists: " + createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());
        }

        //Ensure that the provided Devices is of type Juniper only
        validateFlexibleConfigDeviceType(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName(),
                createFlexibleConfigGroupRequest.getDeviceIds());

        return withRetriesOnCommitConflictException(() -> {
            try (Transaction t = configSnippetBl.beginTransaction("create-flexible-config-group")) {
                JuniperConfigHelper renderer = new JuniperConfigHelper();
                ConfigPair flexibleConfig = renderer.flexibleConfig(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName(),
                        createFlexibleConfigGroupRequest.getFlexibleConfigSnippet());

                log.info("Creating {} snippets for Flexible Config Group {}", createFlexibleConfigGroupRequest.getDeviceIds().size(),
                        createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());

                for (String deviceId: createFlexibleConfigGroupRequest.getDeviceIds()) {
                    ConfigSnippetDo configSnippetDo = ConfigSnippetDo.builder()
                            .deviceId(deviceId)
                            .groupName(flexibleConfig.getGroupName())
                            .deviceConfigGroupName(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName())
                            .referenceId(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName() + "_" + deviceId)
                            .templateValues(flexibleConfig.getProperties())
                            .templateName(flexibleConfig.getTemplateName())
                            .isActive(true)
                            .failed(false)
                            .changeTicket(createFlexibleConfigGroupRequest.getChangeTicket())
                            .expiryDate(createFlexibleConfigGroupRequest.getExpiryDate())
                            .build();
                    configSnippetBl.create(t, configSnippetDo);
                }
                t.commit();
                log.info("Successfully created Flexible Config Group: {}", createFlexibleConfigGroupRequest.getFlexibleConfigGroupName());
            }
            return Response.status(Response.Status.ACCEPTED)
                    .entity(CreateFlexibleConfigGroupResponse.builder()
                            .flexibleConfigGroupName(createFlexibleConfigGroupRequest.getFlexibleConfigGroupName())
                            .deviceIds(createFlexibleConfigGroupRequest.getDeviceIds())
                            .flexibleConfigSnippet(createFlexibleConfigGroupRequest.getFlexibleConfigSnippet())
                            .changeTicket(createFlexibleConfigGroupRequest.getChangeTicket())
                            .expiryDate(createFlexibleConfigGroupRequest.getExpiryDate())
                            .build())
                    .build();
        });
    }

    private void validateChangeTicket(String changeTicket, String flexibleConfigGroupName) throws ValidationException {
        String changeTicketRegex = "CHANGE-\\d{5,}";
        Pattern pattern = Pattern.compile(changeTicketRegex);
        if(!pattern.matcher(changeTicket).matches()) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "CHANGE Ticket: " + changeTicket + " provided is invalid for creating/updating the Flexible Config Group: " + flexibleConfigGroupName);
        }
    }

    private void validateFlexibleConfigExpiryDateGreaterThanToday(Date expiryDate, String flexibleConfigGroupName) throws ValidationException {
        LocalDate inputLocalDate = expiryDate.toInstant()
                .atZone(ZoneId.systemDefault())
                .toLocalDate();

        LocalDate today = LocalDate.now();
        LocalDate futureDate = today.plusDays(1);

        // Check if the input date is greater than today's date
        if (inputLocalDate.isBefore(futureDate)) {
            throw new ValidationException(ErrorCode.InvalidParameter,
                    "Expiry date: " + expiryDate + " needs to greater than today's date for creating/updating the Flexible Config Group: " + flexibleConfigGroupName);
        }
    }

    private void validateFlexibleConfigDeviceType(String finalFlexibleConfigGroupName, List<String> deviceIdList) throws ValidationException {
        for (String deviceId: deviceIdList) {
            DeviceDo deviceDo = deviceBl.getOrThrow(deviceId);
            if(deviceDo.getDeviceType() != DeviceDo.DeviceType.Juniper) {
                throw new ValidationException(ErrorCode.InvalidParameter,
                        "Flexible config can be applied to devices of type Juniper only. " +
                                "Provided Device: " + deviceDo.getName() + " is of type: " +
                                deviceDo.getDeviceType() + " for Flexible Config Group: " + finalFlexibleConfigGroupName);
            }
        }
    }

    @GET
    @Path("/flexibleConfigGroups")
    @Timed(name = "listFlexibleConfigGroupNames")
    @Produces({"application/json", "application/x-json-stream"})
    public List<FlexibleConfigGroupName> listFlexibleConfigGroupNames(@PrincipalContext Principal principal,
                                                                      @AuthorizationRequestContext AuthorizationRequest authorizationRequest,
                                                                      @HeaderParam("opc-request-id") String opcRequestId) throws ValidationException {

        log.info("Received request to list all flexible config group names");

        Iterable<ConfigSnippetDo> appliedSnippets =
                ScanAllIterable.from(configSnippetBl::list, 50);

        List<FlexibleConfigGroupName> flexibleConfigGroupNameList =
                StreamSupport.stream(appliedSnippets.spliterator(), false)
                        .map(ConfigSnippetDo::getDeviceConfigGroupName)
                        .filter(Objects::nonNull)
                        .filter(name -> !C3_CUSTOMER_CONFIG_GROUP_NAME.equals(name))
                        .filter(name -> !C3_BASE_CONFIG_GROUP_NAME.equals(name))
                        .filter(name -> !FtlGroupTemplateInterface.baseConfigGroupToTemplates.contains(name))
                        .distinct()
                        .map(name -> FlexibleConfigGroupName.builder().flexibleConfigGroupName(name).build())
                        .toList();

        log.info("Got {} flexible config group names", flexibleConfigGroupNameList.size());

        return flexibleConfigGroupNameList;
    }

