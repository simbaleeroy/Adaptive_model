function checkFromValuesHasRedundantCrossConnect(formValues: FormValues): boolean {
  if (formValues[VirtualCircuitFieldNames.AdditionalCrossConnect]) {
    for (const key in formValues) {
      if (key.lastIndexOf(stringRcc2) > 0) {
        return true;
      }
    }
  }
  return false;
}

export const transformData = (
  data: FormValues,
  isEdit: boolean = false,
  isBandwidthPolicingWhitelisted: boolean = false,
  type: string,
  providerService: FastConnectProviderService,
  crossConnectOrCrossConnectGroupId?: string,
  isProvider?: boolean,
) => {
  const formTags = data[VirtualCircuitFieldNames.Tags];
  const freeformTags = formTags ? formTags[VirtualCircuitFieldNames.FreeformTags] : {};
  const definedTags = formTags ? formTags[VirtualCircuitFieldNames.DefinedTags] : {};
  const hasRedundantCrossConnect = checkFromValuesHasRedundantCrossConnect(data);

   // Resolve display name – fall back to provider service name for Internet VC
  const resolvedDisplayName =
  data[VirtualCircuitFieldNames.DisplayName] ||
  providerService?.providerServiceName ||
  (type === VirtualCircuitTypeEnum.Internet ? "Internet virtual circuit" : undefined);

  // Initalize transformed data object with common properties
  const transformedData: Record<string, unknown> = {
    // [VirtualCircuitFieldNames.DisplayName]: isEdit
    //   ? data[VirtualCircuitFieldNames.DisplayName]
    //   : data[VirtualCircuitFieldNames.DisplayName] || undefined,
    [VirtualCircuitFieldNames.DisplayName]: resolvedDisplayName
  };
  const providerServiceId = data[VirtualCircuitFieldNames.ProviderServiceId] || providerService.id || undefined;
  const MTU = data[VirtualCircuitFieldNames.MTU];
  const crossConnectOrCrossConnectGroupIdRcc2: string =
    data[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupIdRcc2];
  const vlanInputShowing = shouldShowVlanInput(crossConnectOrCrossConnectGroupId);
  const crossConnectMappingsShowing = shouldShowCrossConnectMappings(type, providerService);
  const bgpMd5ElementsShowing =
    shouldShowCustomerBgpAsnInput(providerService) &&
    data[VirtualCircuitFieldNames.BgpMd5AuthKeyEnabled];
  const bgpMd5Rcc2ElementsShowing =
    shouldShowCustomerBgpAsnInput(providerService) &&
    data[VirtualCircuitFieldNames.BgpMd5AuthKeyEnabledRcc2];
  const updatedRouteFiltering = data[VirtualCircuitFieldNames.RoutingPolicy];
  const isBFD = data[VirtualCircuitFieldNames.IsBfdEnabled];
  const providerState = data[VirtualCircuitFieldNames.ProviderState];
  const referenceComment = isProvider ? data[VirtualCircuitFieldNames.ReferenceComment] : undefined;
  const isTransportMode =
    data[VirtualCircuitFieldNames.IsTransportMode] === TransportTrafficType.ipsecTraffic;

  if (isBandwidthPolicingWhitelisted && !providerServiceId) {
    const isBandwidthPolicingEnabled = data[VirtualCircuitFieldNames.isBandwidthPolicingEnabled];
    transformedData[VirtualCircuitFieldNames.isBandwidthPolicingEnabled] =
      isBandwidthPolicingEnabled?.length === 1;
  }

  transformedData[VirtualCircuitFieldNames.RoutingPolicy] = updatedRouteFiltering
    ? [updatedRouteFiltering]
    : undefined;

  transformedData[VirtualCircuitFieldNames.Type] = type;
  transformedData[VirtualCircuitFieldNames.CompartmentId] =
    data[VirtualCircuitFieldNames.CompartmentId];

  // Add provider service ID if not an Edit and it has a value
  if (!isEdit && providerServiceId) {
    transformedData[VirtualCircuitFieldNames.ProviderServiceId] = providerServiceId;
  }

  // Add MTU
  // transformedData[VirtualCircuitFieldNames.MTU] = MTU || undefined;
  if (type !== VirtualCircuitTypeEnum.Internet) {
    transformedData[VirtualCircuitFieldNames.MTU] = MTU || undefined;
  }
  const isQosBandwidthReservationEnabled =
    data[VirtualCircuitFieldNames.isQosBandwidthReservationEnabled];
  const qosBandwidthReservationTemplateShapeName =
    data[VirtualCircuitFieldNames.qosBandwidthReservationTemplateShapeName];
  transformedData[VirtualCircuitFieldNames.isQosBandwidthReservationEnabled] =
    isQosBandwidthReservationEnabled;
  transformedData[VirtualCircuitFieldNames.qosBandwidthReservationTemplateShapeName] =
    qosBandwidthReservationTemplateShapeName || undefined;

  // Reference comment
  transformedData[VirtualCircuitFieldNames.ReferenceComment] = referenceComment || undefined;

  // Provider state
  transformedData[VirtualCircuitFieldNames.ProviderState] = providerState;

  // BFD
  transformedData[VirtualCircuitFieldNames.IsBfdEnabled] = !!isBFD;

  // IsTransportMode
  transformedData[VirtualCircuitFieldNames.IsTransportMode] = isPrivateVC(type) && isTransportMode;

  // Add DRG if showing
  if (shouldShowGatewayElements(type)) {
    transformedData[VirtualCircuitFieldNames.GatewayId] = data[VirtualCircuitFieldNames.GatewayId];
  }

  // Add bandwidth if it's showing
  if (shouldShowBandwidthShapeSelect(providerService)) {
    transformedData[VirtualCircuitFieldNames.BandwidthShapeName] =
      data[VirtualCircuitFieldNames.BandwidthShapeName];
  }
  // Add provider service key if it's showing
  if (
    (!isEdit || (isEdit && isProviderATT(providerService))) &&
    shouldShowProviderServiceKeyInput(providerService)
  ) {
    transformedData[VirtualCircuitFieldNames.ProviderServiceKeyName] =
      data[VirtualCircuitFieldNames.ProviderServiceKeyName];
    if (hasRedundantCrossConnect) {
      transformedData[VirtualCircuitFieldNames.ProviderServiceKeyNameRcc2] =
        data[VirtualCircuitFieldNames.ProviderServiceKeyNameRcc2];
    }
  }

  // Add BGP ASN if it's showing
  if (
    (!isProvider && shouldShowCustomerBgpAsnInput(providerService)) ||
    (isProvider && shouldShowProviderBgpAsnInput(providerService))
  ) {
    const customerBgpAsnString = data[VirtualCircuitFieldNames.CustomerBgpAsn] || undefined;
    transformedData[VirtualCircuitFieldNames.CustomerBgpAsn] = Number.isFinite(
      Number(customerBgpAsnString),
    )
      ? Number(customerBgpAsnString)
      : undefined;
  }

  // Add cross connect mappings if showing, OR if any of the fields that are
  // showing can affect data INSIDE cross connect mappings.
  if (
    type === VirtualCircuitTypeEnum.Internet ||
    vlanInputShowing ||
    crossConnectMappingsShowing ||
    shouldShowCustomerBgpAsnInput(providerService)
  ) {
    const isIpv6Enabled: boolean = data[VirtualCircuitFieldNames.Ipv6Enabled];
    // const vlanString: string = data[VirtualCircuitFieldNames.Vlan] || undefined;
    // Hardcode VLAN to 102 for Internet type
    const vlanString: string =
      type === VirtualCircuitTypeEnum.Internet
        ? "102"
        : data[VirtualCircuitFieldNames.Vlan] || undefined;
    const vlan: number = Number.isFinite(Number(vlanString)) ? Number(vlanString) : undefined;

    const crossConnectMappings = [];

    const totalCrossConnects = providerService
      ? providerService.requiredTotalCrossConnects
      : colocatedDefaults.requiredTotalCrossConnects;
    for (let i = 0; i < totalCrossConnects; i++) {
      const mapping: Record<string, unknown> = {};
     // Add crossConnectOrCrossConnectGroupId and vlan to payload if showing
      // For Internet type, always include crossConnectOrCrossConnectGroupId even if VLAN input is not shown
      if (vlanInputShowing || type === VirtualCircuitTypeEnum.Internet) {
        mapping[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId] =
          crossConnectOrCrossConnectGroupId;
        if (vlanInputShowing) {
          mapping[VirtualCircuitFieldNames.Vlan] = vlan;
        } else if (type === VirtualCircuitTypeEnum.Internet) {
          // Hardcode VLAN to 102 for Internet type
          mapping[VirtualCircuitFieldNames.Vlan] = 102;
        }
      }
      // Add bgp IPs to payload if showing
      if (crossConnectMappingsShowing) {
        // mapping[VirtualCircuitFieldNames.CustomerBgpPeeringIp] =
        //   data[getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, i)] || undefined;
        // mapping[VirtualCircuitFieldNames.OracleBgpPeeringIp] =
        //   data[getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, i)] || undefined;
        if (isIpv6Enabled) {
          mapping[VirtualCircuitFieldNames.CustomerBgpPeeringIpv6] =
            data[getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIpv6, i)] ||
            undefined;
          mapping[VirtualCircuitFieldNames.OracleBgpPeeringIpv6] =
            data[getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIpv6, i)] ||
            undefined;
        }
      }
       // Add IGW fields for Internet type
      // if (type === VirtualCircuitTypeEnum.Internet && i === 0) {
      //   mapping[VirtualCircuitFieldNames.IgwOracleBgpIp] =
      //     data[VirtualCircuitFieldNames.IgwOracleBgpIp] || undefined;
      //   mapping[VirtualCircuitFieldNames.IgwRemoteBgpIp] =
      //     data[VirtualCircuitFieldNames.IgwRemoteBgpIp] || undefined;
      //   mapping[VirtualCircuitFieldNames.IgwOracleBgpIpv6] =
      //     data[VirtualCircuitFieldNames.IgwOracleBgpIpv6] || undefined;
      //   mapping[VirtualCircuitFieldNames.IgwRemoteBgpIpv6] =
      //     data[VirtualCircuitFieldNames.IgwRemoteBgpIpv6] || undefined;
      //   mapping[VirtualCircuitFieldNames.IgwPeerName] =
      //     data[VirtualCircuitFieldNames.IgwPeerName] || undefined;
      //   mapping[VirtualCircuitFieldNames.IgwPeerType] =
      //     data[VirtualCircuitFieldNames.IgwPeerType] || undefined;
      // }
      // Add md5 key to payload if showing
      if (bgpMd5ElementsShowing) {
        mapping[VirtualCircuitFieldNames.BgpMd5AuthKey] =
          data[getIndexedFieldName(VirtualCircuitFieldNames.BgpMd5AuthKey, i)];
      }
      crossConnectMappings.push(mapping);
    }

    if (hasRedundantCrossConnect) {
      const isIpv6EnabledRcc2: boolean = data[VirtualCircuitFieldNames.Ipv6EnabledRcc2];
      const vlanRcc2String: string = data[VirtualCircuitFieldNames.VlanRcc2] || undefined;
      const vlanRcc2: number = Number.isFinite(Number(vlanRcc2String))
        ? Number(vlanRcc2String)
        : undefined;
      const redundantCrossConnectMapping = [];
      const totalCrossConnects = providerService
        ? providerService.requiredTotalCrossConnects
        : colocatedDefaults.requiredTotalCrossConnects;
      for (let i = 0; i < totalCrossConnects; i++) {
        const mapping: Record<string, unknown> = {};

        // Add vlan to payload if showing
        if (vlanInputShowing) {
          mapping[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId] =
            crossConnectOrCrossConnectGroupIdRcc2;
          mapping[VirtualCircuitFieldNames.Vlan] = vlanRcc2;
        }
        const updatedIndex = i + 1;
        // Add bgp IPs to payload if showing
        if (crossConnectMappingsShowing) {
          mapping[VirtualCircuitFieldNames.CustomerBgpPeeringIp] =
            data[
              getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, updatedIndex, true)
            ] || undefined;
          mapping[VirtualCircuitFieldNames.OracleBgpPeeringIp] =
            data[
              getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, updatedIndex, true)
            ] || undefined;
          if (isIpv6EnabledRcc2) {
            mapping[VirtualCircuitFieldNames.CustomerBgpPeeringIpv6] =
              data[
                getIndexedFieldName(
                  VirtualCircuitFieldNames.CustomerBgpPeeringIpv6,
                  updatedIndex,
                  true,
                )
              ] || undefined;
            mapping[VirtualCircuitFieldNames.OracleBgpPeeringIpv6] =
              data[
                getIndexedFieldName(
                  VirtualCircuitFieldNames.OracleBgpPeeringIpv6,
                  updatedIndex,
                  true,
                )
              ] || undefined;
          }
        }
        // Add md5 key to payload if showing
        if (bgpMd5Rcc2ElementsShowing) {
          mapping[VirtualCircuitFieldNames.BgpMd5AuthKey] =
            data[getIndexedFieldName(VirtualCircuitFieldNames.BgpMd5AuthKey, updatedIndex, true)];
        }

        redundantCrossConnectMapping.push(mapping);
      }

      transformedData[VirtualCircuitFieldNames.CrossConnectMappings] = [
        ...crossConnectMappings,
        ...redundantCrossConnectMapping,
      ];
    } else {
      transformedData[VirtualCircuitFieldNames.CrossConnectMappings] = crossConnectMappings;
    }
  }
  // Tags
   // Add IGW fields to freeformTags for Internet type
  const finalFreeformTags = { ...freeformTags };
  if (type === VirtualCircuitTypeEnum.Internet) {
    const igwOracleBgpIp = data[VirtualCircuitFieldNames.IgwOracleBgpIp];
    const igwRemoteBgpIp = data[VirtualCircuitFieldNames.IgwRemoteBgpIp];
    const igwOracleBgpIpv6 = data[VirtualCircuitFieldNames.IgwOracleBgpIpv6];
    const igwRemoteBgpIpv6 = data[VirtualCircuitFieldNames.IgwRemoteBgpIpv6];
    const igwPeerName = data[VirtualCircuitFieldNames.IgwPeerName];
    const igwPeerType = data[VirtualCircuitFieldNames.IgwPeerType];
    
    if (igwOracleBgpIp) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwOracleBgpIp] = igwOracleBgpIp;
    }
    if (igwRemoteBgpIp) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwRemoteBgpIp] = igwRemoteBgpIp;
    }
    if (igwOracleBgpIpv6) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwOracleBgpIpv6] = igwOracleBgpIpv6;
    }
    if (igwRemoteBgpIpv6) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwRemoteBgpIpv6] = igwRemoteBgpIpv6;
    }
    if (igwPeerName) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwPeerName] = igwPeerName;
    }
    if (igwPeerType) {
      finalFreeformTags[VirtualCircuitFieldNames.IgwPeerType] = igwPeerType;
    }
  }
  // eslint-disable-next-line no-constant-condition
  if (typeof finalFreeformTags && !isProvider) {
    transformedData[VirtualCircuitFieldNames.FreeformTags] = finalFreeformTags;
  }

  // eslint-disable-next-line no-constant-condition
  if (typeof definedTags && !isProvider) {
    transformedData[VirtualCircuitFieldNames.DefinedTags] = definedTags;
  }

  if (isProvider) {
    transformedData[VirtualCircuitFieldNames.CrossConnectMappings] = data[
      VirtualCircuitFieldNames.CrossConnectMappings
    ].map((crossConnectMapping: Record<string, unknown>) => ({
      [VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId]:
        crossConnectMapping[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId] ||
        undefined,
      [VirtualCircuitFieldNames.Vlan]:
        crossConnectMapping[VirtualCircuitFieldNames.Vlan] || undefined,
      [VirtualCircuitFieldNames.CustomerBgpPeeringIp]:
        crossConnectMapping[VirtualCircuitFieldNames.CustomerBgpPeeringIp] || undefined,
      [VirtualCircuitFieldNames.OracleBgpPeeringIp]:
        crossConnectMapping[VirtualCircuitFieldNames.OracleBgpPeeringIp] || undefined,
      [VirtualCircuitFieldNames.CustomerBgpPeeringIpv6]:
        crossConnectMapping[VirtualCircuitFieldNames.CustomerBgpPeeringIpv6] || undefined,
      [VirtualCircuitFieldNames.OracleBgpPeeringIpv6]:
        crossConnectMapping[VirtualCircuitFieldNames.OracleBgpPeeringIpv6] || undefined,
      [VirtualCircuitFieldNames.BgpMd5AuthKey]:
        crossConnectMapping[VirtualCircuitFieldNames.BgpMd5AuthKey] || undefined,
    }));
  }

  // Add public prefixes if showing, and not an Edit
  if (!isEdit && shouldShowPublicPrefixesTextarea(type)) {
    transformedData[VirtualCircuitFieldNames.PublicPrefixes] = transformPublicPrefixes(
      data[VirtualCircuitFieldNames.PublicPrefixes],
    );
  }

  return transformedData;
};

export const getVCEditPayload = (
  $app: AppState,
  subFormValues: FormValues,
  defaultValues: VirtualCircuit,
  providerService: FastConnectProviderService,
  $crossConnectOrCrossConnectGroupId?: string,
) => {
  const transformedData = transformData(
    subFormValues,
    true,
    whitelistBandwidthPolicing($app),
    defaultValues?.type,
    providerService,
    $crossConnectOrCrossConnectGroupId,
    isProviderTenant($app.consoleState),
  );
  if (!subFormValues.isQosBandwidthReservationEnabled) {
    subFormValues.qosBandwidthReservationTemplateShapeName = undefined;
  }
  const updateVirtualCircuit = getChangedProperties(
    transformedData,
    // @ts-ignore
    cleanCrossConnectMappingsFromApiVirtualCircuit(defaultValues),
  );
  const shouldAddQosBandwidthReservationEnabled =
    Object.prototype.hasOwnProperty.call(
      updateVirtualCircuit,
      VirtualCircuitFieldNames.qosBandwidthReservationTemplateShapeName,
    ) &&
    !!updateVirtualCircuit[VirtualCircuitFieldNames.qosBandwidthReservationTemplateShapeName] &&
    !!defaultValues?.isQosBandwidthReservationEnabled;

  // Update changedValues based on the condition
  if (shouldAddQosBandwidthReservationEnabled) {
    updateVirtualCircuit.isQosBandwidthReservationEnabled = true;
  }
  return updateVirtualCircuit;
};

export const getVCCreatePayload = (
  $app: AppState,
  subFormValues: FormValues,
  providerService: FastConnectProviderService,
  $crossConnectOrCrossConnectGroupId?: string,
) => {
  const createVirtualCircuitDetails = transformData(
    subFormValues,
    false,
    whitelistBandwidthPolicing($app),
    subFormValues[VirtualCircuitFieldNames.Type],
    providerService,
    $crossConnectOrCrossConnectGroupId,
  );
  // Debug: Log the payload being sent to API
  console.log("=== CreateVirtualCircuit Payload ===");
  console.log("Type:", subFormValues[VirtualCircuitFieldNames.Type]);
  console.log("Provider service arg:", providerService);
  console.log("Form providerServiceId:", subFormValues[VirtualCircuitFieldNames.ProviderServiceId]);
  console.log("Provider service arg:", providerService);
  console.log("Form providerServiceId:", subFormValues[VirtualCircuitFieldNames.ProviderServiceId]);
  console.log("Full Payload:", JSON.stringify(createVirtualCircuitDetails, null, 2));
  console.log("====================================");

  return createVirtualCircuitDetails;
};

export const cleanCrossConnectMappingsFromApiVirtualCircuit = (
  virtualCircuit: VirtualCircuit,
): VirtualCircuit => {
  if (virtualCircuit?.crossConnectMappings) {
    virtualCircuit.crossConnectMappings
      .filter(obj => Object.keys(obj)?.length > 0)
      .forEach(mapping => {
        // If VC type is PUBLIC, the user cannot change CC mapping IPs, so clean them out.
        if (virtualCircuit.type === VirtualCircuitTypeEnum.Public) {
          delete mapping.customerBgpPeeringIp;
          delete mapping.customerBgpPeeringIpv6;
          delete mapping.oracleBgpPeeringIp;
          delete mapping.oracleBgpPeeringIpv6;
        }

        Object.entries(mapping).forEach(([key, value]) => {
          if (value === null) {
            // eslint-disable-next-line @typescript-eslint/no-dynamic-delete
            delete mapping[key as keyof typeof mapping];
          }
        });
      });
    if (virtualCircuit.crossConnectMappings?.length === 0) {
      delete virtualCircuit.crossConnectMappings;
    }
  }
  return virtualCircuit;
};

export const shouldShowPublicPrefixesTextarea = (type: string): boolean => {
  if (type && type === VirtualCircuitTypeEnum.Public) {
    return true;
  }
  return false;
};

export const isLayer2 = (virtualCircuit: VirtualCircuit): boolean =>
  virtualCircuit?.serviceType === FastConnectProviderServiceTypeEnum.Layer2;

export const isLayer3 = (virtualCircuit: VirtualCircuit): boolean =>
  virtualCircuit?.serviceType === FastConnectProviderServiceTypeEnum.Layer3;

export const isLayer3Partner = (
  providerServiceId: string,
  vcList: DEFINITION_CoreServicesApi_FastConnectProviderService[],
): boolean => {
  if (!providerServiceId || !Array.isArray(vcList)) {
    return false;
  }

  return vcList.some(
    vc =>
      vc.id === providerServiceId &&
      vc.type === "LAYER3" &&
      !vc.providerName?.toLowerCase().includes("google") &&
      !vc.providerName?.toLowerCase().includes("gcp"),
  );
};

export const getCrossConnectOrCrossConnectGroupsOptions = (
  ccDataSource: typeof CoreServicesApi.ListCrossConnects.datasource,
  ccgDataSource: typeof CoreServicesApi.ListCrossConnectGroups.datasource,
) => {
  const ccs =
    (getDataFromKey(
      ccDataSource as unknown as ActionResult<MauiDataActionResult>,
    ) as UiCrossConnect[]) || [];

  const ccgs =
    (getDataFromKey(
      ccgDataSource as unknown as ActionResult<MauiDataActionResult>,
    ) as UiCrossConnectGroup[]) || [];

  const ccAndCcgPicklist: SelectOption[] = [];

  ccgs.forEach(ccg => {
    ccAndCcgPicklist.push({
      label: displayNamePlusOcidSuffix(ccg.displayName, ccg.id.substring(ccg.id.length - 6)),
      value: ccg.id,
    });
  });

  ccs.forEach(cc => {
    if (!cc.crossConnectGroupId)
      ccAndCcgPicklist.push({
        label: displayNamePlusOcidSuffix(cc.displayName, cc.id.substring(cc.id.length - 6)),
        value: cc.id,
      });
  });

  return ccAndCcgPicklist;
};

