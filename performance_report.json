    public Response deleteLoa(@PathParam("loa-id") String loaId) throws Exception {

        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = loaBl.beginTransaction("delete-loa")) {
                LoaDo loaDo = loaBl.getOrThrow(t, loaId);

                //We want to check if cross connect is still present, if yes, we DO NOT want to delete LOA, and we need throw error
                if (loaDo.getCrossConnectId() != null) {
                    Optional<CrossConnectDo> ccDoOpt = crossConnectBl.get(t, loaDo.getCrossConnectId());
                    if (ccDoOpt.isPresent()) {
                        throw new ValidationException(ErrorCode.IncorrectState, String.format("Failure deleting LOA{do=%s} since it is associated with crossconnect", loaDo));
                    }
                }

                log.info("Deleting loa(do={})", loaDo);
                String tenantId = identityHelper.getTenantId(loaDo.getCompartmentId());
                String tenantName = identityHelper.getTenantName((loaDo.getCompartmentId()));
                loaBl.safeLoaDelete(t, loaId, tenantId, tenantName, true, false);
                t.commit();
            }

            return Response.accepted().build();
        });
    }

