        Assertions.assertThatThrownBy(
                        () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update4).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("QoS bandwidth reservation can not be applied to this Virtual Circuit");

        // Set Role only
        try ( Transaction t = deviceBl.beginTransaction("add-feature-flag")){
            DeviceDo deviceDo= virtualCircuitBl.getLogicalDevice(crossConnect1.getId());

            deviceDo = deviceDo.toBuilder()
                    .listOfEnabledFeatureFlags(new ArrayList<>())
                    .roles(new HashSet<>(List.of(DeviceDo.Role.FastConnectMx304)))
