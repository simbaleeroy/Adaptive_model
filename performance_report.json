            DeviceDo deviceDo= virtualCircuitBl.getLogicalDevice(crossConnect1.getId());

            deviceDo = deviceDo.toBuilder()
                    .listOfEnabledFeatureFlags(new ArrayList<>(List.of(DeviceDo.DYNAMIC_QOS_FEATURE_FLAG)))
                    .roles(new HashSet<>(List.of(DeviceDo.Role.Qfx5120)))
                    .build();
