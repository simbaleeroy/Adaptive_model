 @Test
    public void GIVEN_MigratePortsForCrossConnectGroup_THEN_resourceUpdated_AND_BackupCreated_AND_workflowLaunched() throws Exception {
        setupVcDependencies(true);
        VirtualCircuitDo virtualCircuitDo = setupVc();

        CrossConnectAndInterfacePair crossConnectAndInterfacePair1 = CrossConnectAndInterfacePair.builder()
                .crossConnectId(crossConnect1.getId())
                .interfaceName(INTERFACE_PREFIX + 3)
                .build();
        CrossConnectAndInterfacePair crossConnectAndInterfacePair2 = CrossConnectAndInterfacePair.builder()
                .crossConnectId(crossConnect2.getId())
                .interfaceName(INTERFACE_PREFIX + 4)
                .build();
        MigratePortsForCrossConnectGroupRequest migratePortsForCrossConnectGroupRequest = MigratePortsForCrossConnectGroupRequest.builder()
                .deviceId(MY_DEVICE_ID)
                .crossConnectAndInterfacePairList(Arrays.asList(crossConnectAndInterfacePair1, crossConnectAndInterfacePair2))
                .requestType(MigratePortsForCrossConnectGroupRequest.RequestType.Deprovisioning)
                .build();

        managementResource.migratePortsForCrossConnectGroup(crossConnectGroupDo.getId(), migratePortsForCrossConnectGroupRequest);

        CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrow(this.crossConnectGroupDo.getId());
        assertEquals(CrossConnectGroupDo.State.MIGRATING, crossConnectGroupDo.getState());
        for (String crossConnectId : crossConnectGroupDo.getCrossConnectIds()) {
            CrossConnectDo crossConnectDo = crossConnectBl.getOrThrow(crossConnectId);
            assertEquals(CrossConnectDo.State.MIGRATING, crossConnectDo.getState());
        }
        virtualCircuitDo = virtualCircuitBl.getOrThrow(virtualCircuitDo.getId());
        assertEquals(VirtualCircuitDo.State.MIGRATING, virtualCircuitDo.getState());

        // Backup is created
        Optional<PortMigrationBackupDo> portMigrationBackupDoOptional = portMigrationBackupBl.get(this.crossConnectGroupDo.getId());
        assertTrue(portMigrationBackupDoOptional.isPresent());
        assertEquals(crossConnectGroupDo.toBuilder().lastKievTxTimestamp(null).lastUpdated(null).build().toString(),
                portMigrationBackupDoOptional.get().getData());
        assertEquals(this.crossConnectGroupDo.getId(), portMigrationBackupDoOptional.get().getReferenceId());

        for (String crossConnectId : this.crossConnectGroupDo.getCrossConnectIds()) {
            Optional<PortMigrationBackupDo> ccOptional = portMigrationBackupBl.get(crossConnectId);
            assertTrue(ccOptional.isPresent());
            assertEquals(crossConnectGroupDo.toString(),
                    ccOptional.get().getData());
            assertEquals(this.crossConnectGroupDo.getId(), portMigrationBackupDoOptional.get().getReferenceId());
        }

        List<ConfigSnippetDo> configSnippetDos = configSnippetBl.listSnippetsForDomainObject(this.crossConnectGroupDo.getId());
        for (ConfigSnippetDo configSnippetDo : configSnippetDos) {
            Optional<PortMigrationBackupDo> snippetOptional = portMigrationBackupBl.get(configSnippetDo.getId());
            assertTrue(snippetOptional.isPresent());
            assertEquals(configSnippetDo.toBuilder().lastUpdated(null).lastAttempt(null).toString(), snippetOptional.get().getData());
            assertEquals(this.crossConnectGroupDo.getId(), portMigrationBackupDoOptional.get().getReferenceId());
        }

        Optional<PortMigrationBackupDo> vcOptional = portMigrationBackupBl.get(virtualCircuitDo.getId());
        assertTrue(vcOptional.isPresent());
        assertEquals("Down", vcOptional.get().getData());
        assertEquals(this.crossConnectGroupDo.getId(), vcOptional.get().getReferenceId());

        List<ConfigSnippetDo> vcConfigSnippetDos = configSnippetBl.listSnippetsForDomainObject(virtualCircuitDo.getId());
        for (ConfigSnippetDo configSnippetDo : vcConfigSnippetDos) {
            Optional<PortMigrationBackupDo> snippetOptional = portMigrationBackupBl.get(configSnippetDo.getId());
            assertTrue(snippetOptional.isPresent());
            assertEquals(configSnippetDo.toBuilder().lastUpdated(null).lastAttempt(null).toString(), snippetOptional.get().getData());
            assertEquals(this.crossConnectGroupDo.getId(), portMigrationBackupDoOptional.get().getReferenceId());
        }

        // CCDo is updated
        CrossConnectDo crossConnectDo1 = crossConnectBl.getOrThrow(crossConnect1.getId());
        assertEquals(INTERFACE_PREFIX + 3, crossConnectDo1.getInterfaceId());
        assertEquals(MY_DEVICE_ID, crossConnectDo1.getDeviceId());

        CrossConnectDo crossConnectDo2 = crossConnectBl.getOrThrow(crossConnect2.getId());
        assertEquals(INTERFACE_PREFIX + 4, crossConnectDo2.getInterfaceId());
        assertEquals(MY_DEVICE_ID, crossConnectDo1.getDeviceId());

        // workflow is launched
        List<WorkRequestDo> workRequests = workRequestBl.list(Optional.empty(), 10).results();
        assertEquals(1, workRequests.size());
    }
