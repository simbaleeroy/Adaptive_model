    @POST
    @Path("/crossConnectGroups")
    @Timed(name="create-crossConnectGroup")
    @VpnSkipAuthorization
    public Response createCrossConnectGroup(
            @Valid CreateCrossConnectGroupInternalDetails request
    ) throws Exception {

        if (request == null) {
            PublicValidation.failInvalidNullRequest();
        }

        MacsecProperties macsecProperties = request.getMacsecProperties();
        MacsecPropertiesInternal macsecPropertiesInternal = null;

        if(macsecProperties != null){
            macsecPropertiesInternal = MacsecPropertiesInternal.builder()
                    .bypassLldp(macsecProperties.getBypassLldp() != null? macsecProperties.getBypassLldp() : false)
                    .mkaServerPriority(macsecProperties.getMkaServerPriority() != null? macsecProperties.getMkaServerPriority() : 0)
                    .replayProtectionWindow(macsecProperties.getReplayProtectionWindow() != null ? macsecProperties.getReplayProtectionWindow() : 0L)
                    .rekeyPeriod(macsecProperties.getRekeyPeriod() != null ? macsecProperties.getRekeyPeriod() : 3600)
                    .allowUnprotectedTraffic(Optional.ofNullable(macsecProperties).map(MacsecProperties::getAllowUnprotectedTraffic).orElse(false))
                    .build();
        }
        TagUtils.validateTags(request.getFreeformTags(), request.getDefinedTags());

        String ccCompartmentId = request.getCompartmentId();

        try (Transaction t = crossConnectGroupBl.beginTransaction("create-CrossConnectGroup")) {

            // Check and update the limits before doing anything else.
            limitsHelper.validateAndIncrementCount(t, ccCompartmentId,
                    CountDo.CountType.Cross_Connect_Group);


            CrossConnectGroupDo crossConnectGroupDo = CrossConnectGroupDo.builder()
                    .compartmentId(request.getCompartmentId())
                    .crossConnectIds(new String[]{})
                    .displayName(ModelUtils.defaultDisplayNameIfBlank(
                            request.getDisplayName(), EntityType.VpnCrossConnectGroup))
                    .customerReferenceId(request.getCustomerReferenceName())
                    .state(CrossConnectGroupDo.State.INACTIVE)
                    .tags(TagUtils.encodeTags(
                            request.getFreeformTags(),
                            request.getDefinedTags()))
                    .lastStateChanged(new Date())
                    .macsecPropertiesInternal(macsecPropertiesInternal)
                    .build();

            crossConnectGroupDo = crossConnectGroupBl.create(t, crossConnectGroupDo);

            eventBl.create(t, crossConnectGroupDo.getId(), Component.API,
                    "Created CrossConnectGroup %s ", crossConnectGroupDo);
            log.info("Created CrossConnectGroup(request={},do={})", request, crossConnectGroupDo);
            t.commit();

            return Response.ok(crossConnectGroupToModel(crossConnectGroupDo)).build();
        }
    }

    @PUT
    @Path("/crossConnectGroups/{crossConnectGroupId}")
    @Timed(name = "update-crossConnectGroup")
    @VpnSkipAuthorization
    public Response updateCrossConnectGroup(
            @PathParam("crossConnectGroupId") String id,
            @Valid @NonNull UpdateCrossConnectGroupInternalDetails request) throws Exception {

        TagUtils.validateTags(request.getFreeformTags(), request.getDefinedTags());

        MacsecProperties macsecProperties = request.getMacsecProperties();
        MacsecPropertiesInternal macsecPropertiesInternal = null;

        if(macsecProperties != null && macsecProperties.getState().equals(MacsecProperties.State.Enabled)){

            if(macsecProperties.getEncryptionCipher() == null) {
                PublicValidation.failNullEncryptionCipher();
            }
            macsecPropertiesInternal = MacsecPropertiesInternal.builder()
                    .bypassLldp(macsecProperties.getBypassLldp() != null? macsecProperties.getBypassLldp() : false)
                    .mkaServerPriority(macsecProperties.getMkaServerPriority() != null? macsecProperties.getMkaServerPriority() : 0)
                    .replayProtectionWindow(macsecProperties.getReplayProtectionWindow() != null ? macsecProperties.getReplayProtectionWindow() : 0L)
                    .rekeyPeriod(macsecProperties.getRekeyPeriod() != null ? macsecProperties.getRekeyPeriod() : 3600)
                    .allowUnprotectedTraffic(Optional.ofNullable(macsecProperties).map(MacsecProperties::getAllowUnprotectedTraffic).orElse(false))
                    .build();
        }

        try (Transaction t = crossConnectGroupBl.beginTransaction("update-CrossConnectGroup")) {

            CrossConnectGroupDo crossConnectGroupDo = crossConnectGroupBl.getOrThrowForAuth(t, id);
            crossConnectGroupDo = CrossConnectGroupResource.validateDeviceDetails(crossConnectGroupDo, crossConnectBl);
            crossConnectGroupDo = crossConnectGroupDo.toBuilder()
                    .displayName(Optional.ofNullable(request.getDisplayName())
                            .orElseGet(crossConnectGroupDo::getDisplayName))
                    .customerReferenceId(Optional.ofNullable(request.getCustomerReferenceName())
                            .orElseGet(crossConnectGroupDo::getCustomerReferenceId))
                    .tags(TagUtils.encodeUpdatedTags(
                            request.getFreeformTags(),
                            request.getDefinedTags(),
                            crossConnectGroupDo.getTags()))
                    .macsecPropertiesInternal(macsecPropertiesInternal)
                    .build();

            CrossConnectGroupResource.validateCrossConnectGroupUpdate(crossConnectGroupDo, virtualCircuitBl);

            crossConnectGroupDo = crossConnectGroupBl.update(t, crossConnectGroupDo);
            Boolean isCustomer = limitsHelper.checkCustomerTenancyByCompartmentId(request.getCompartmentId());
            DeviceDo deviceDo = deviceBl.getOrThrow(crossConnectBl.getDeviceId(crossConnectGroupDo));
            Boolean isFakeDevice = deviceDo.isFakeDevice();

            if (crossConnectGroupDo.getState().equals(CrossConnectGroupDo.State.PROVISIONED) && crossConnectGroupDo.getMacsecKey() != null && crossConnectGroupDo.getMacsecKey().getServiceSecretOcid() != null) {
                WorkRequestDo workRequest = CrossConnectUtils.launchUpdateCrossConnectGroupWorkflow(crossConnectGroupDo.getId(), workRequestBl, t, isFakeDevice, isCustomer, RequestIdHolder.get());
                crossConnectGroupDo = crossConnectGroupBl.update(t, crossConnectGroupDo.toBuilder()
                        .state(CrossConnectGroupDo.State.PROVISIONING)
                        .build());
                List<String> ccOcids = Arrays.stream(crossConnectGroupDo.getCrossConnectIds()).collect(Collectors.toList());
                for(String ccOcid : ccOcids) {
                    CrossConnectDo ccDo = crossConnectBl.get(t, ccOcid).get();
                    crossConnectBl.update(t, ccDo.toBuilder().state(CrossConnectDo.State.PROVISIONING).build());
                }
                eventBl.create(t, crossConnectGroupDo.getId(), Component.API,
                        "Updating CrossConnectGroup %s with WorkRequest %s",
                        crossConnectGroupDo, workRequest.getId());

                log.info(String.format("Updating CrossConnectGroup(request=%s, do=%s)", workRequest, crossConnectGroupDo));
            }

            t.commit();

            return Response.ok(crossConnectGroupBl.toModel(encryptionManager, deviceBl, crossConnectBl, crossConnectGroupDo)).build();
        }
    }

