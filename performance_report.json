                        () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update4).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("QoS bandwidth reservation can not be applied to this Virtual Circuit");


    }

    @Test
    public void GIVEN_Valid_Input_FOR_updateVC_WITH_QOS_BANDWIDTH_RESERVATION_THEN_success() throws Exception{
        setupVcDependencies();
        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId(), VirtualCircuit.Type.Public).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);
        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getOrThrow(vc.getId());
        assertNull(virtualCircuitDo.getIsDynamicQosEnabled());
        assertNull(virtualCircuitDo.getDynamicQosTemplateName());
        assertFalse(vc.getIsQosBandwidthReservationEnabled());
        assertNull(vc.getQosBandwidthReservationTemplateShapeName());

        List<Integer> percentageAllocations = Arrays.asList(25, 25, 25, 20);
        String DISPLAY_NAME = setupQosBRTemplate(percentageAllocations, qosBandwidthReservationTemplateBl).getDisplayName();

        PropertiesBlTest.addOrUpdateProperty(propertiesBl, PropertiesDo.Keys.ENABLE_FC_DYNAMIC_QOS.getKeyName(), "true");
        PropertiesBlTest.addOrUpdateProperty(propertiesBl, PropertiesDo.Keys.ENABLE_VC_BANDWIDTH_VALIDATION.getKeyName(), "true");
        PropertiesBlTest.addOrUpdateProperty(propertiesBl, PropertiesDo.Keys.ENABLE_VC_TO_VLAN_MAPPING.getKeyName(), "true");

        try ( Transaction t = deviceBl.beginTransaction("update-device")){
            DeviceDo deviceDo= virtualCircuitBl.getLogicalDevice(virtualCircuitDo.getCrossConnectMapping().getMappings()[0].getCrossConnectId());
            deviceDo = deviceDo.toBuilder()
                    .listOfEnabledFeatureFlags(new ArrayList<>(List.of(DeviceDo.DYNAMIC_QOS_FEATURE_FLAG)))
                    .roles(new HashSet<>(List.of(DeviceDo.Role.FastConnectMx304)))
                    .build();
            deviceBl.update(t, deviceDo);
            t.commit();
        }
        UpdateVirtualCircuitDetails update = UpdateVirtualCircuitDetails.builder()
                .isQosBandwidthReservationEnabled(true)
                .qosBandwidthReservationTemplateShapeName(DISPLAY_NAME)
                .build();
        com.oracle.pic.vpn.model.VirtualCircuit vc_mgmt = (com.oracle.pic.vpn.model.VirtualCircuit) virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update).getEntity();

        virtualCircuitDo = virtualCircuitBl.getOrThrow(vc_mgmt.getId());
        assertEquals(vc_mgmt.getQosBandwidthReservationTemplateShapeName(), DISPLAY_NAME);
        assertEquals(vc_mgmt.getIsDynamicQosEnabled(), true);
        assertEquals(virtualCircuitDo.getDynamicQosTemplateName(), DISPLAY_NAME);
        assertEquals(virtualCircuitDo.getIsDynamicQosEnabled(), true);

        // Validate VcToVlanMappingDo
        try (Transaction t = vcToVlanMappingBl.beginTransaction("get-vcToVlanMappingDo")){
            List<VcToVlanMappingDo> vcToVlanMappingDos = vcToVlanMappingBl.getMappingByVcId(t, vc_mgmt.getId());
            assertEquals(vcToVlanMappingDos.size(), 1);
            VcToVlanMappingDo vcToVlanMappingDo = vcToVlanMappingDos.get(0);
            assertEquals(vcToVlanMappingDo.getIsDynamicQosEnabled(), true);
            assertEquals(vcToVlanMappingDo.getBandwidthInMbps(), (Integer) 10_000);
            assertEquals(vcToVlanMappingDo.getCcOrCcgId(), crossConnect1.getId());
        }

        UpdateVirtualCircuitDetails update1 = UpdateVirtualCircuitDetails.builder()
                .isQosBandwidthReservationEnabled(false)
                .build();

        Assertions.assertThatThrownBy(
                        () -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, false, update1).getEntity())
                .isInstanceOf(ValidationException.class)
                .hasMessageContaining("Unable to disable QoS when both enableDynamicQos and enableVcBandwidthValidation is not set to true");


        com.oracle.pic.vpn.model.VirtualCircuit vc_mgmt1 = (com.oracle.pic.vpn.model.VirtualCircuit) virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(), UPDATED_ORACLE_ASN, null, null,null, null, null, null, null, null, null, null, null, true, update1).getEntity();

        virtualCircuitDo = virtualCircuitBl.getOrThrow(vc_mgmt1.getId());
        assertNull(vc_mgmt1.getQosBandwidthReservationTemplateShapeName());
        assertEquals(vc_mgmt1.getIsDynamicQosEnabled(), false);
        assertNull(virtualCircuitDo.getDynamicQosTemplateName());
        assertEquals(virtualCircuitDo.getIsDynamicQosEnabled(), false);

        // Validate VcToVlanMappingDo
        try (Transaction t = vcToVlanMappingBl.beginTransaction("get-vcToVlanMappingDo")){
            List<VcToVlanMappingDo> vcToVlanMappingDos = vcToVlanMappingBl.getMappingByVcId(t, vc_mgmt1.getId());
            assertEquals(vcToVlanMappingDos.size(), 1);
            VcToVlanMappingDo vcToVlanMappingDo = vcToVlanMappingDos.get(0);
            assertEquals(vcToVlanMappingDo.getIsDynamicQosEnabled(), false);
            assertEquals(vcToVlanMappingDo.getBandwidthInMbps(), (Integer) 10_000);
            assertEquals(vcToVlanMappingDo.getCcOrCcgId(), crossConnect1.getId());
        }
    }

