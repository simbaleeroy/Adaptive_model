        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();


        // Create Redundancy DO
        FcRedundancyDo fcRedundancyDo = FcRedundancyBlTest.createFcRedundancyDO(DRG_ID,
                FcRedundancyDo.RedundancyLevel.POP, FcRedundancyDo.BgpSessionLevel.POP, FcRedundancyDo.BgpSessionLevel.POP, FcRedundancyDo.ResourceType.DRG);

        try (Transaction t = fcRedundancyBl.beginTransaction("create redundancy DO")) {
            fcRedundancyDo = fcRedundancyBl.create(t, fcRedundancyDo);
            t.commit();
        }


        // Get VirtualCircuitDo
        Response response = virtualCircuitManagementResourceV1.getVirtualCircuit(vc.getId());
