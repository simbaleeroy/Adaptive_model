    @Test
    public void GIVEN_getVirtualCircuit_ecmpOn_THEN_bgpLookUpUsingVcGroupId() throws Exception {
        setupVcDependencies();

        // 1. Set up VC
        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateL2ProviderDetailsWithId(l2ProviderId).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();

        // 2. Test logic when ECMP off
        String fakeDeviceName = deviceBl.getOrThrow(ManagementResourceTestHelper.MY_DEVICE_ID).getName();
        String remoteIp = createVirtualCircuitDetails.getCrossConnectMappings().get(0).getCustomerBgpPeeringIp().split("/")[0];
        String localIp = createVirtualCircuitDetails.getCrossConnectMappings().get(0).getOracleBgpPeeringIp().split("/")[0];

        // Set BGP to refer by vc.groupid, lookup by drg.groupid should fail
        // Read VC from DB so we know it's groupId
        VirtualCircuitDo virtualCircuitDo = virtualCircuitBl.getVirtualCircuitByGatewayId(vc.getGatewayId()).get(0);
        String vcGroupId = virtualCircuitDo.getGroupId();

        // Purposely, use vc.groupId not drg.groupId
        BgpSummary BGP_SUMMARY_FAKE_DEVICE = new BgpSummary(fakeDeviceName,
                ImmutableMap.of(
                        vcGroupId, Arrays.asList(
                                new BgpPeer(vcGroupId, BgpDo.sessionState.Established, localIp, remoteIp)
                        )
                )
        );

        String BGP_SUMMARY_FAKE_DEVICE_STRING = (new ObjectMapper().registerModule(new Jdk8Module())).writeValueAsString(BGP_SUMMARY_FAKE_DEVICE);

        try (Transaction t = bgpBl.beginTransaction("Bgp Transaction")) {
            BgpDo bgpDo = BgpDo.builder()
                    .id(ManagementResourceTestHelper.MY_DEVICE_ID)
                    .bgpData(BGP_SUMMARY_FAKE_DEVICE_STRING)
                    .build();

            bgpBl.create(t, bgpDo);
            t.commit();
        }

        // ECMP not turned on for VC by default, so BGP look up uses drg.gatewayId. Not found
        Response response = virtualCircuitManagementResourceV1.getVirtualCircuit(vc.getId());
        com.oracle.pic.vpn.model.VirtualCircuit vcReturned = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpSessionState.Down, vcReturned.getBgpSessionState());

        // Try listVC as well to ensure converage
        PaginatedResponse<com.oracle.pic.vpn.model.VirtualCircuit> listResponse =
                virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, null, null, null);
        assertThat(listResponse.getResults().size()).isEqualTo(1);
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpSessionState.Down, listResponse.getResults().get(0).getBgpSessionState());

        // 3. Turn on ECMP and try again, should succeed.
        // Turn ECMP on - in reality this should be done by Spectre and workflow, but for testing purpose
        // we just set routeDistinguisher here, to tell bgp lookup logic that ECMP is on
        try (Transaction t = virtualCircuitBl.beginTransaction("Update VC")) {
            virtualCircuitBl.setRouteDistinguisherIfNeeded(t, "1.1.1.1", "65016", virtualCircuitDo);
            t.commit();
        }

        // When ECMP is on, look up by vc.groupid, should find
        response = virtualCircuitManagementResourceV1.getVirtualCircuit(vc.getId());
        vcReturned = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpSessionState.Up, vcReturned.getBgpSessionState());

        listResponse =
                virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, null, null, null);
        assertThat(listResponse.getResults().size()).isEqualTo(1);
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpSessionState.Up, listResponse.getResults().get(0).getBgpSessionState());
    }

