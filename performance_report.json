    @Test
    public void GIVEN_getDrgRedundancyMap_THEN_Succeed() throws Exception {
        String CC_DISPLAY_NAME_NO_GROUP = "cc_no_group";

        String CC_ID1 = UUID.randomUUID().toString();
        String CC_ID2 = UUID.randomUUID().toString();

        String CCG_ID1 = UUID.randomUUID().toString();

        String VC_ID1 = UUID.randomUUID().toString();
        String VC_ID2 = UUID.randomUUID().toString();

        String interfaceId1 = UUID.randomUUID().toString();
        String interfaceId2 = UUID.randomUUID().toString();

        String DRG_ID1 = UUID.randomUUID().toString();
        String DRG_ID2 = UUID.randomUUID().toString();

        // Build all required DO objects

        DeviceDo device1 = DeviceDo.builder()
                .name(DEVICE1_NAME)
                .id(UUID.randomUUID().toString())
                .build();

        DeviceDo device2 = DeviceDo.builder()
                .name(DEVICE2_NAME)
                .id(UUID.randomUUID().toString())
                .build();

        CrossConnectDo crossConnectDo1 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(CCG_ID1)
                .interfaceId(interfaceId1)
                .id(CC_ID1)
                .compartmentId(MY_COMPARTMENT)
                .deviceId(device1.getId())
                .build();

        CrossConnectDo crossConnectDo2 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(CCG_ID1)
                .interfaceId(interfaceId2)
                .id(CC_ID2)
                .compartmentId(MY_COMPARTMENT)
                .deviceId(device2.getId())
                .build();

        CrossConnectGroupDo crossConnectGroupDo1 = CrossConnectGroupDo.builder()
                .id(CCG_ID1)
                .crossConnectIds(new String[]{CC_ID1})
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectMappings.Mapping mapping1 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectGroupDo1.getId())
                .build();

        CrossConnectMappings.Mapping mapping2 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo2.getId())
                .build();

        CrossConnectMappings.Mapping mapping3 = CrossConnectMappings.Mapping.builder().build();

        VirtualCircuitDo virtualCircuitDo1 = VirtualCircuitDo.builder()
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping1, mapping2}).build())
                .id(VC_ID1)
                .compartmentId(MY_COMPARTMENT)
                .gatewayId(DRG_ID1)
                .state(VirtualCircuitDo.State.PROVISIONED)
                .gatewayType(VirtualCircuitDo.GatewayType.DRG)
                .build();

        VirtualCircuitDo virtualCircuitDo2 = VirtualCircuitDo.builder()
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping3}).build())
                .id(VC_ID2)
                .compartmentId(MY_COMPARTMENT)
                .gatewayId(DRG_ID1)
                .state(VirtualCircuitDo.State.PROVISIONED)
                .gatewayType(VirtualCircuitDo.GatewayType.DRG_V2)
                .build();

        IPsecConnectionDo ipsec = IPsecConnectionDo.builder()
                .id(UUID.randomUUID().toString())
                .state(IPsecConnectionDo.State.Provisioned)
                .drgId(DRG_ID2)
                .build();

        TunnelDo tunnel1 = TunnelDo.builder()
                .id(UUID.randomUUID().toString())
                .deviceId(device1.getId())
                .ipsecId(ipsec.getId())
                .build();

        TunnelDo tunnel2 = TunnelDo.builder()
                .id(UUID.randomUUID().toString())
                .deviceId(device2.getId())
                .ipsecId(ipsec.getId())
                .build();

        // Setup mocks
        when(deviceBl.stream()).thenReturn(
                Arrays.asList(device1, device2)
                        .stream());
        when(crossConnectBl.stream()).thenReturn(
                Arrays.asList(crossConnectDo1, crossConnectDo2)
                        .stream());
        when(crossConnectGroupBl.stream()).thenReturn(Arrays.asList(crossConnectGroupDo1).stream());
        when(virtualCircuitBl.stream()).thenReturn
                (Arrays.asList(virtualCircuitDo1, virtualCircuitDo2).stream());
        when(iPsecConnectionBl.stream()).thenReturn(Arrays.asList(ipsec).stream());
        when(tunnelBl.stream()).thenReturn(Arrays.asList(tunnel1, tunnel2).stream());

        Response response = managementResource.getDrgRedundancyMap();

        List<DrgRedundancyRecord> results = (List<DrgRedundancyRecord>) response.getEntity();

        Map<String, Set<String>> drg2Device = new HashMap<>();
        for(DrgRedundancyRecord r : results) {
            if (!drg2Device.containsKey(r.getDrgid())) {
                drg2Device.put(r.getDrgid(), new HashSet<>());
            }

            drg2Device.get(r.getDrgid()).add(r.getDeviceName());
        }

        assertTrue(drg2Device.get(DRG_ID1).contains(DEVICE1_NAME));
        assertTrue(drg2Device.get(DRG_ID1).contains(DEVICE2_NAME));
        assertTrue(drg2Device.get(DRG_ID2).contains(DEVICE1_NAME));
        assertTrue(drg2Device.get(DRG_ID2).contains(DEVICE2_NAME));
    }

    @Test
    public void GIVEN_T2NonRedundantVcList_AND_T2PendingVcList_THEN_correctRedundanyStatus() throws Exception {

        // Prepare DOs and variables
        String CC_DISPLAY_NAME_NO_GROUP = "cc_no_group";
        String CC_DISPLAY_NAME_WITH_GROUP = "cc_with_group";
        String CCG_DISPLAY_NAME = "ccg_valid_device_id";

        String CC_ID1 = UUID.randomUUID().toString();
        String CC_ID2 = UUID.randomUUID().toString();
        String CCG_ID = UUID.randomUUID().toString();

        String VC_ID1 = UUID.randomUUID().toString();
        String VC_ID2 = UUID.randomUUID().toString();
        String VC_ID3 = UUID.randomUUID().toString();
        String VC_ID4 = UUID.randomUUID().toString();


        String interfaceId = UUID.randomUUID().toString();

        String NO_BGPSESSION_VC = "no_bgp_session_vc";
        String NO_BGPSESSION_VC_2 = "no_bgp_session_vc_2";
        String PENDING_VGP_SESSION_VC = "pending_bgp_session_vc";
        String REDUNDANT_BGP_SESSION_VC = "redundant_bgp_session_vc";


        HashMap<String, Set<Integer>> vcsToVlans = new HashMap<>();
        vcsToVlans.put(VC_ID1, new HashSet<>());
        vcsToVlans.put(VC_ID2, new HashSet<>());
        vcsToVlans.put(VC_ID3, new HashSet<>());
        vcsToVlans.put(VC_ID4, new HashSet<>());



        DeviceDo device1 = DeviceDo.builder()
                .name(DEVICE1_NAME)
                .id(UUID.randomUUID().toString())
                .build();

        DeviceDo device2 = DeviceDo.builder()
                .name(DEVICE2_NAME)
                .id(UUID.randomUUID().toString())
                .build();

        // Build all required DO objects
        CrossConnectDo crossConnectDo1 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_NO_GROUP)
                .crossConnectGroupId(null)
                .interfaceId(interfaceId)
                .id(CC_ID1)
                .vcsToVlans(vcsToVlans)
                .compartmentId(MY_COMPARTMENT)
                .state(CrossConnectDo.State.PROVISIONED)
                .build();

        CrossConnectDo crossConnectDo2 = CrossConnectDo.builder()
                .displayName(CC_DISPLAY_NAME_WITH_GROUP)
                .crossConnectGroupId(CCG_ID)
                .interfaceId("00000000-0000-0000-0000-0000000000")
                .id(CC_ID2)
                .vcsToVlans(vcsToVlans)
                .compartmentId(MY_COMPARTMENT)
                .state(CrossConnectDo.State.PROVISIONED)
                .build();

        CrossConnectGroupDo crossConnectGroupDo = CrossConnectGroupDo.builder()
                .displayName(CCG_DISPLAY_NAME)
                .id(CCG_ID)
                .interfaceId(interfaceId)
                .crossConnectIds(new String[]{CC_ID1, CC_ID2})
                .vcsToVlans(vcsToVlans)
                .compartmentId(MY_COMPARTMENT)
                .build();

        CrossConnectMappings.Mapping mapping1 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo1.getId())
                .build();

        CrossConnectMappings.Mapping mapping2 = CrossConnectMappings.Mapping.builder()
                .crossConnectId(crossConnectDo2.getId())
                .build();



        VirtualCircuitDo virtualCircuitDo1 = VirtualCircuitDo.builder()
                .associatedCcs(new HashSet<>(Arrays.asList(CC_ID1)))
                .displayName(NO_BGPSESSION_VC)
                .id(VC_ID1)
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping1, mapping2}).build())
                .compartmentId(MY_COMPARTMENT)
                .gatewayId("drg1")
                .ipAddressType(VirtualCircuitDo.IpAddressType.PRIVATE)
                .build();

        VirtualCircuitDo virtualCircuitDo2 = VirtualCircuitDo.builder()
                .associatedCcs(new HashSet<>(Arrays.asList(CC_ID2)))
                .displayName(PENDING_VGP_SESSION_VC)
                .id(VC_ID2)
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping1, mapping2}).build())
                .compartmentId(MY_COMPARTMENT)
                .gatewayId("drg2")
                .ipAddressType(VirtualCircuitDo.IpAddressType.PRIVATE)
                .build();

        VirtualCircuitDo virtualCircuitDo3 = VirtualCircuitDo.builder()
                .associatedCcgs(new HashSet<>(Arrays.asList(CCG_ID)))
                .displayName(NO_BGPSESSION_VC_2)
                .id(VC_ID3)
                .compartmentId(MY_COMPARTMENT)
                .ipAddressType(VirtualCircuitDo.IpAddressType.PUBLIC)
                .build();

        VirtualCircuitDo virtualCircuitDo4 = VirtualCircuitDo.builder()
                .associatedCcgs(new HashSet<>(Arrays.asList(CCG_ID)))
                .displayName(REDUNDANT_BGP_SESSION_VC)
                .id(VC_ID4)
                .gatewayId("drg3")
                .crossConnectMapping(CrossConnectMappings.builder()
                        .mappings(new CrossConnectMappings.Mapping[]{mapping1, mapping2}).build())
                .compartmentId(MY_COMPARTMENT)
                .ipAddressType(VirtualCircuitDo.IpAddressType.PRIVATE)
                .build();

        // Setup mocks
        when(deviceBl.stream()).thenReturn(
                Arrays.asList(device1, device2)
                        .stream());
        when(deviceBl.getDeviceDoByDeviceName(any(), any())).thenReturn(
                device1);
        when(deviceBl.getOrThrow(any())).thenReturn(
                device1);
        InterfaceDo interfaceDo = InterfaceDo.builder().id(interfaceId).name(INTERFACE_PREFIX).state(InterfaceDo.State.Assigned).build();

        // Setup mocks
        when(interfaceBl.stream()).thenReturn(Arrays.asList(interfaceDo).stream());
        when(interfaceBl.getInterfaceByName(any(), any(), any())).thenReturn(Optional.of(interfaceDo));
        when(interfaceBl.getOrThrow(any())).thenReturn(
                interfaceDo);
        when(crossConnectBl.stream()).thenReturn(
                Arrays.asList(crossConnectDo1, crossConnectDo2)
                        .stream());
        when(crossConnectBl.getOrThrow(crossConnectDo1.getId())).thenReturn(crossConnectDo1);
        when(crossConnectBl.getOrThrow(crossConnectDo2.getId())).thenReturn(crossConnectDo2);
        when(crossConnectBl.get(crossConnectDo1.getId())).thenReturn(Optional.of(crossConnectDo1));
        when(crossConnectBl.get(crossConnectDo2.getId())).thenReturn(Optional.of(crossConnectDo2));

        when(crossConnectGroupBl.stream()).thenReturn(Arrays.asList(crossConnectGroupDo).stream());
        when(virtualCircuitBl.stream()).thenReturn
                (Arrays.asList(virtualCircuitDo1, virtualCircuitDo2, virtualCircuitDo3, virtualCircuitDo4).stream());

        when(virtualCircuitBl.get(virtualCircuitDo1.getId())).thenReturn(Optional.of(virtualCircuitDo1));
        when(virtualCircuitBl.get(virtualCircuitDo2.getId())).thenReturn(Optional.of(virtualCircuitDo2));
        when(virtualCircuitBl.get(virtualCircuitDo3.getId())).thenReturn(Optional.of(virtualCircuitDo3));
        when(virtualCircuitBl.get(virtualCircuitDo4.getId())).thenReturn(Optional.of(virtualCircuitDo4));



        // mock T2 returning drg Id as impacted.
        Mockito.when(impactedCustomersT2.getVcRedundancyStatus(eq(ManagementResourceHelper.NO_BGP_SESSION_VC_QUERY), any(), any(),any(), any(), any()))
                .thenReturn(new HashSet<>(Arrays.asList(virtualCircuitDo1.getGatewayId(), virtualCircuitDo3.getId())));
        Mockito.when(impactedCustomersT2.getVcRedundancyStatus(eq(ManagementResourceHelper.PENDING_BGP_SESSION_VC_QUERY), any(), any(),any(), any(), any()))
                .thenReturn(new HashSet<>(Arrays.asList(virtualCircuitDo2.getGatewayId())));


        // Call API
        Response response = managementResource.listInterfacesImpactedCustomersV2(DEVICE1_NAME, INTERFACE_PREFIX, "now", 15);

        List<InterfaceCustomer> reslist = (List<InterfaceCustomer>) response.getEntity();

        // Validate Results
        reslist.forEach((ic) -> {
            if (ic.getResourceId().equals(virtualCircuitDo1.getId()) || ic.getResourceId().equals(virtualCircuitDo3.getId())) {
                assertFalse(ic.getCustomerBgpSessionUp());
            } else if (ic.getResourceId().equals(virtualCircuitDo4.getId())){
                assertTrue(ic.getCustomerBgpSessionUp());
            } else {
                assertNull(ic.getCustomerBgpSessionUp());
            }
        });


    }

