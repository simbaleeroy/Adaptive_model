export const shouldShowTransportMode = ($app: AppState, virtualCircuitType: string) =>
  isIPSecOverFCEnabled($app) && isPrivateVC(virtualCircuitType);

export const getInitialVirtualCircuitType = (
  isRedundancyEnabled: boolean,
  virtualCircuitType: string,
  providerService: DEFINITION_CoreServicesApi_FastConnectProviderService,
) => {
  if (isRedundancyEnabled) {
    return undefined;
  }
  if (virtualCircuitType) {
    return virtualCircuitType;
  }
  return getVirtualCircuitTypeInitialSelection(providerService?.supportedVirtualCircuitTypes);
};

export const getVirtualCircuitTypeOptions = (
  supportedTypes: string[],
  t: MauiTranslate,
  isLoadingOrError: boolean = false,
) => [
  {
    description: t(MessagesKeys.VirtualCircuit.form.virtualCircuitPrivateBody),
    disabled:
      isLoadingOrError ||
      (supportedTypes && !supportedTypes.includes(VirtualCircuitTypeEnum.Private)),
    label: t(MessagesKeys.VirtualCircuit.form.virtualCircuitPrivateTitle),
    value: VirtualCircuitTypeEnum.Private,
  },
  {
    description: t(MessagesKeys.VirtualCircuit.form.virtualCircuitPublicBody),
    disabled:
      isLoadingOrError ||
      (supportedTypes && !supportedTypes.includes(VirtualCircuitTypeEnum.Public)),
    label: t(MessagesKeys.VirtualCircuit.form.virtualCircuitPublicTitle),
    value: VirtualCircuitTypeEnum.Public,
  },
  {
    description: t(MessagesKeys.VirtualCircuit.form.virtualCircuitInternetBody),
    disabled: isLoadingOrError,
    label: t(MessagesKeys.VirtualCircuit.form.virtualCircuitInternetTitle),
    value: VirtualCircuitTypeEnum.Internet,
  },
];

export const getVirtualCircuitTypeInitialSelection = (supportedTypes: string[]) => {
  if (!supportedTypes) {
    return;
  }

  const includesPrivate = supportedTypes.includes(VirtualCircuitTypeEnum.Private);
  const includesPublic = supportedTypes.includes(VirtualCircuitTypeEnum.Public);
  const includesInternet = supportedTypes.includes(VirtualCircuitTypeEnum.Internet);
  if (!includesPrivate && !includesPublic && !includesInternet) {
    return;
  }
  if (includesPrivate && includesPublic && includesInternet) {
    return VirtualCircuitTypeEnum.Private;
  }
  if (includesPrivate) {
    return VirtualCircuitTypeEnum.Private;
  }
  if (includesPublic) {
    return VirtualCircuitTypeEnum.Public;
  }
  if (includesInternet) {
    return VirtualCircuitTypeEnum.Internet;
  }
};

export const getInitialVirtualCircuitIsTransportMode = (
  virtualCircuit: VirtualCircuit | undefined,
) =>
  virtualCircuit?.isTransportMode
    ? TransportTrafficType.ipsecTraffic
    : TransportTrafficType.allTraffic;

export const shouldDisableDrgDropdown = (
  isEditForm: boolean,
  associatedTunnels: DEFINITION_CoreServicesApi_VirtualCircuitAssociatedTunnelDetails[],
) => isEditForm && associatedTunnels?.length > 0;

export const getDrgSelectPlaceHolder = (
  drgs: DEFINITION_CoreServicesApi_Drg[],
  t: MauiTranslate,
  selectedCompartmentName?: string,
) => {
  if (!!drgs && drgs?.length > 0) {
    return t(MessagesKeys.VirtualCircuit.form.selectAValue);
  }
  return t(MessagesKeys.VirtualCircuit.form.drgNoneAvailable, selectedCompartmentName);
};

export const getDrgLabel = (
  drgs: DEFINITION_CoreServicesApi_Drg[],
  value: string,
): string | undefined => {
  if (!Array.isArray(drgs) || !value) {
    return undefined;
  }

  const match = drgs.find(drg => drg.id === value);
  return match?.displayName;
};

export const getDrgOptions = (drgs: DEFINITION_CoreServicesApi_Drg[]) =>
  drgs?.map(drg => {
    const { displayName, id } = drg;
