                            )
                    )
            );

            String BGP_SUMMARY_FAKE_DEVICE_STRING = (new ObjectMapper().registerModule(new Jdk8Module())).writeValueAsString(BGP_SUMMARY_FAKE_DEVICE);

            BgpDo bgpDo = BgpDo.builder()
                    .id(ManagementResourceTestHelper.MY_DEVICE_ID)
                    .bgpData(BGP_SUMMARY_FAKE_DEVICE_STRING)
                    .build();

            bgpBl.create(tx, bgpDo);
            tx.commit();
        }

        Response response = virtualCircuitManagementResourceV1.getVirtualCircuit(circuit.getId());
        com.oracle.pic.vpn.model.VirtualCircuit vcReturned = (com.oracle.pic.vpn.model.VirtualCircuit) response.getEntity();
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpIpv6SessionState.Down, vcReturned.getBgpIpv6SessionState());

        PaginatedResponse<com.oracle.pic.vpn.model.VirtualCircuit> listResponse =
                virtualCircuitManagementResourceV1.listVirtualCircuits(100, null, null, null, null);
        assertThat(listResponse.getResults().size()).isEqualTo(1);
        assertEquals(com.oracle.pic.vpn.model.VirtualCircuit.BgpIpv6SessionState.Down, listResponse.getResults().get(0).getBgpIpv6SessionState());
    }
