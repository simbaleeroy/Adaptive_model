    @Path("/locations/{location-id}")
    @VpnSkipAuthorization
    public Location updateLocation(
            @PathParam("location-id") String locationId,
            @Valid @NonNull UpdateLocationDetails request) throws Exception {

        try (Transaction t = locationBl.beginTransaction("update-location")) {
            LocationDo locationDo = locationBl.getOrThrow(t, locationId);

            LocationDo.State state = (null == request.getState()) ?
                    locationDo.getState() :
                    LocationDo.State.fromString(request.getState());

            String edgePopRegion = request.getEdgePopRegion() == null ? null : request.getEdgePopRegion().trim();
            String locationDoEdgePopRegion = locationDo.getEdgePopRegion() != null ? locationDo.getEdgePopRegion() : null;
            String edgePop = validateEdgePopRegion(edgePopRegion, locationDoEdgePopRegion);
            GlobalPopLocationMetadata locationMetadata = request.getGlobalPopLocationMetadata() == null ?
                    locationDo.getGlobalPopLocationMetadata() :
                    GlobalPopLocationMetadata.fromModel(request.getGlobalPopLocationMetadata());

            locationDo = LocationDo.builder()
                    .id(locationDo.getId())
                    .name(Optional.ofNullable(request.getName())
                            .map(String::trim)
                            .orElseGet(locationDo::getName))
                    .adName(Optional.ofNullable(request.getAdName())
                            .map(String::trim)
                            .orElseGet(locationDo::getAdName))
                    .description(Optional.ofNullable(request.getDescription())
                            .map(String::trim)
                            .orElseGet(locationDo::getDescription))
                    .address(Optional.ofNullable(request.getAddress())
                            .map(String::trim)
                            .orElseGet(locationDo::getAddress))
                    .facility(Optional.ofNullable(request.getFacility())
                            .map(String::trim)
                            .orElseGet(locationDo::getFacility))
                    .phoneNumber(Optional.ofNullable(request.getPhoneNumber())
                            .map(String::trim)
                            .orElseGet(locationDo::getPhoneNumber))
                    .state(state)
                    .edgePopRegion(edgePop)
                    .globalPopLocationMetadata(locationMetadata)
                    .build();

            locationDo = locationBl.update(t, locationDo);

            log.info("Updated location(request={},do={})", request, locationDo);

            t.commit();

            return toModel(locationDo);
        }
    }

    @POST
    @Timed(name = "createLocation")
    @Path("/locations")
    @VpnSkipAuthorization
    public Location createLocation(@Valid @NonNull CreateLocationDetails request) throws Exception {

        return withRetriesOnCommitConflictException(() -> {

            try (Transaction t = locationBl.beginTransaction("create-location")) {

                String locationNameTrimmed = request.getName() == null ? null : request.getName().trim();
                String locationNameNotTrimmed = request.getName() == null ? null : request.getName();

                String locationAdName = request.getAdName() == null ? null : request.getAdName().trim();
                String locationDescription = request.getDescription() == null ? null : request.getDescription().trim();
                String locationAddress = request.getAddress() == null ? null : request.getAddress().trim();
                String locationFacility = request.getFacility() == null ? null : request.getFacility().trim();
                String locationPhoneNumber = request.getPhoneNumber() == null ? null : request.getPhoneNumber().trim();
                LocationDo.State locationState = request.getState() == null ? LocationDo.State.NOT_AVAILABLE :
                        LocationDo.State.fromString(request.getState().trim());
                String edgePopRegion = request.getEdgePopRegion() == null ? null : request.getEdgePopRegion().trim();


                // Check both trimmed and untrimmed versions to avoid duplicate locations
                Optional<LocationDo> existing = locationBl.getLocation(t, locationNameTrimmed);
                existing.ifPresent(locationDo -> {
                    throw new RenderableException(ErrorCode.Conflict,
                            "Location already exists for name %s", locationNameTrimmed);
                });
                existing = locationBl.getLocation(t, locationNameNotTrimmed);
                existing.ifPresent(locationDo -> {
                    throw new RenderableException(ErrorCode.Conflict,
                            "Location already exists for name %s", locationNameNotTrimmed);
                });

                String edgePop = validateEdgePopRegion(edgePopRegion, null);
                GlobalPopLocationMetadata locationMetadata = request.getGlobalPopLocationMetadata() == null ?
                        null :
                        GlobalPopLocationMetadata.fromModel(request.getGlobalPopLocationMetadata());

                LocationDo locationDo = LocationDo.builder()
                        .id(UUID.randomUUID().toString())
                        .name(locationNameTrimmed) // save trimmed value
                        .adName(locationAdName)
                        .description(locationDescription)
                        .address(locationAddress)
                        .facility(locationFacility)
                        .phoneNumber(locationPhoneNumber)
                        .state(locationState)
                        .edgePopRegion(edgePop)
                        .globalPopLocationMetadata(locationMetadata)
                        .build();

                locationDo = locationBl.create(t, locationDo);

                log.info("Created location(request={},do={})", request, locationDo);
                t.commit();
                return toModel(locationDo);
            }
        });
    }

    private Location toModel(LocationDo locationDo) {
        GlobalPopLocationMetadata metadata = locationDo.getGlobalPopLocationMetadata();

        return Location.builder()
                .id(locationDo.getId())
                .name(locationDo.getName())
                .adName(locationDo.getAdName())
                .description(locationDo.getDescription())
                .address(locationDo.getAddress())
                .facility(locationDo.getFacility())
                .phoneNumber(locationDo.getPhoneNumber())
                .state(locationDo.getState().getValue())
                .edgePopRegion(locationDo.getEdgePopRegion())
                .globalPopLocationMetadata(metadata == null ? null : metadata.toModel())
                .build();
    }

