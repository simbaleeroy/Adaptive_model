package com.oracle.pic.vpn.db.devices.model;

import com.oracle.pic.kiev.mapping.annotations.Column;
import com.oracle.pic.kiev.mapping.annotations.KievEntity;
import lombok.Value;

import static com.oracle.pic.kiev.mapping.annotations.ColumnType.ENUM_STRING;
import static com.oracle.pic.kiev.mapping.annotations.ColumnType.STRING;

/**
 * This class is used only as an index key for ConfigScheduleDo and ConfigSnippetDo.
 * If these classes diverge then we should split this class into two different index
 * keys (as it couples the implementation of the two).
 */
@Value
@lombok.Builder(builderClassName = "Builder", toBuilder = true)
@KievEntity(builderClass = DeviceAndStateKey.Builder.class, builderPrefix = "")
public class DeviceAndStateKey {

    @Column(type = STRING, length = 36, index = 1, name = "deviceId")
    String deviceId;

    @Column(type = ENUM_STRING, length = 36, index = 2, name = "state")
    ConfigSnippetDo.State state;
}
