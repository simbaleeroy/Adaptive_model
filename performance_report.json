          - FIXED0100_25G
          - FIXED0200_25G
          - FIXED0400_25G
          - FIXED0800_25G
          - FIXED1600_25G
          - FIXED2400_25G
          - ENTIREHOST_25G
          - DYNAMIC_E1_25G # CAVIUM 25G WITH AMD E1 INSTANCES
          - FIXED0040_E1_25G
          - FIXED0070_E1_25G
          - FIXED0140_E1_25G
          - FIXED0280_E1_25G
          - FIXED0560_E1_25G
          - FIXED1120_E1_25G
          - FIXED1680_E1_25G
          - ENTIREHOST_E1_25G
          - DYNAMIC_B1_25G # CAVIUM 25G WITH X6 B1 INSTANCES
          - FIXED0040_B1_25G
          - FIXED0060_B1_25G
          - FIXED0120_B1_25G
          - FIXED0240_B1_25G
          - FIXED0480_B1_25G
