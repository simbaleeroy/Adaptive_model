
import { apiClients } from "@shared/api";

import { VirtualCircuit } from "@clients/CoreServicesApi";
import {
  CoreServicesApi,
  DEFINITION_CoreServicesApi_FastConnectProviderService,
} from "@clientUtils";

import Messages from "@messages";

import { VirtualCircuitDetailsActions } from "@modules/common/actions";
import {
  isProviderTenant,
  isSuperDrgTransitHubEnabled,
  whitelistMacsec,
} from "@modules/common/capabilities";
import {
  ipv4Sample,
  listRequestSize,
  publicPrefixesPlaceholderSample,
  validationRules,
  virtualCircuitForm,
  virtualCircuitFormRedundant,
} from "@modules/common/constants";
import { IntentId } from "@modules/common/id";
import {
  FastConnectIpMtuEnum,
  SelectOption,
  TransportTrafficType,
  UserStateWithForm, VirtualCircuitTypeEnum,
} from "@modules/common/types";
import { FastConnectCreateDoc, HelpDoc, HelpLink } from "@modules/common/url";
import {
  getIndexedFieldName,
  isValidIpv4CidrAddress,
  isValidIpv6CidrAddress,
} from "@modules/common/utils";
import {
  EditVirtualCircuitForm,
  getBandwidthOptionsPlaceHolder,
  getDefaultBandwidth,
  getDrgOptions,
  getDrgSelectPlaceHolder,
  getFilteredBandwidthOptions,
  getInitialIsIpv6Enabled,
  getInitialVirtualCircuitIsTransportMode,
  getInitialVirtualCircuitType,
  getQoSBandwidthTemplateShapeOptions,
  getQosBandwidthValueByIndex,
  getQosBandwidthValues,
  getRedundantCrossConnectOptions,
  getRoutingPolicyDefaultValue,
  getRoutingPolicyOptions,
  getVirtualCircuitTypeOptions,
  isATT,
  isLayer2,
  isLayer3,
  isPublicBgpProviderManaged,
  ProviderStateOptions,
  shouldDisableDrgDropdown,
  shouldShowBandwidthShapeSelect,
  shouldShowBgpMd5Elements,
  shouldShowCustomerBgpAsnInput,
  shouldShowGatewayElements, shouldShowIgwFields,
  shouldShowIpFields,
  shouldShowIpv6Fields,
  shouldShowProviderBgpAsnInput,
  shouldShowProviderServiceKeyName,
  shouldShowPublicPrefixesTextarea,
  shouldShowRoutingPolicy,
  shouldShowTransportMode,
  showCustomerBgpAsnInput,
  showProviderBgpAsnInput,
  updateDefaultProviderService,
  validateSelectedCrossConnectOrGroup,
  VirtualCircuitFieldNames,
} from "@modules/utils";
import {
  isIPSecOverFCEnabled,
  isPrivateVC,
  isQoSBandwidthTemplateEnabled,
  isRedundancyEnabled,
  isRouteFilteringPublicEnabled,
  transformPublicPrefixes,
  validatePublicPrefixes,
  whitelistBandwidthPolicing,
  whitelistIpv6,
} from "@modules/virtual-circuit";

declare const $user: UserStateWithForm<
  IntentId.EditVirtualCircuit | IntentId.AddVirtualCircuit,
  EditVirtualCircuitForm
> & {
  providerService?: DEFINITION_CoreServicesApi_FastConnectProviderService;
};
declare const $formId: IntentId.EditVirtualCircuit | IntentId.AddVirtualCircuit;
declare const $crossConnectOrCrossConnectGroupId: string | undefined;
declare const $virtualCircuit: VirtualCircuit | undefined;
declare const $isEdit: boolean;
declare const $crossConnectOrCrossConnectGroupOptions: SelectOption[];

const VirtualCircuitSubForm: Template["content"]["1.0.6"] = {
  id: IntentId.VirtualCircuitSubForm,
  content: [
    {
      type: "TextInput",
      name: VirtualCircuitFieldNames.DisplayName,
      label: Messages.DisplayNameField.label,
      optional: true,
      readOnly: mauiExpression(isProviderTenant($app.consoleState)),
      validators: [
        {
          type: "max-length",
          maxLength: validationRules.displayNameMaxLength,
          message: Messages.VirtualCircuit.form.ipLengthError(
            String(validationRules.displayNameMinLength),
            String(validationRules.displayNameMaxLength),
          ),
        },
      ],
      defaultValue: mauiExpression($virtualCircuit?.displayName),
    },
    /* Provider specific fields */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(isProviderTenant($app.consoleState)),
      content: [
        {
          type: "TextInput",
          name: VirtualCircuitFieldNames.ReferenceComment,
          label: Messages.ReferenceNameField.label,
          defaultValue: mauiExpression($virtualCircuit?.referenceComment),
        },
        {
          type: "Select",
          name: VirtualCircuitFieldNames.ProviderState,
          label: Messages.PartnerState.label,
          defaultValue: mauiExpression($virtualCircuit?.providerState),
          options: ProviderStateOptions,
          validators: [
            {
              type: "required",
              message: Messages.VirtualCircuit.form.partnerStateError,
            },
          ],
        },
      ],
    },
    {
      type: "ConditionalRender",
      predicate: mauiExpression(!$isEdit),
      content: [
        {
          name: VirtualCircuitFieldNames.CompartmentId,
          label: Messages.VirtualCircuit.form.compartment,
          type: "CompartmentSelectV2",
          defaultValue: mauiExpression($app?.consoleState?.compartmentId),
        },
      ],
    },
    /* TODO: ProviderSelect field for create fast connect */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(!$isEdit),
      content: [
        {
          type: "CardRadioGroup",
          columns: 3,
          name: VirtualCircuitFieldNames.Type,
          label: Messages.VirtualCircuit.form.virtualCircuitType,
          debug: false,
          defaultValue: mauiExpression(
            getInitialVirtualCircuitType(
              isRedundancyEnabled($app),
              $virtualCircuit?.type,
              $user?.providerService,
            ),
          ),
          validators: [
            {
              type: "required",
              message: Messages.VirtualCircuit.form.virtualCircuitTypeError,
            },
          ],
          options: mauiExpression(
            getVirtualCircuitTypeOptions($user?.providerService?.supportedVirtualCircuitTypes, t),
          ),
        },
      ],
    },
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          shouldShowTransportMode(
            $app,
            $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
              $virtualCircuit?.type,
          ),
      ),
      content: [
        {
          type: "CardRadioGroup",
          columns: 2,
          name: VirtualCircuitFieldNames.IsTransportMode,
          label: Messages.VirtualCircuit.form.traffic,
          debug: false,
          defaultValue: mauiExpression(
            getInitialVirtualCircuitIsTransportMode($isEdit ? $virtualCircuit : undefined),
          ),
          options: [
            {
              description: Messages.VirtualCircuit.form.allTrafficBody,
              label: Messages.VirtualCircuit.form.allTrafficTitle,
              value: TransportTrafficType.allTraffic,
            },
            {
              description: Messages.VirtualCircuit.form.ipsecTrafficBody,
              label: Messages.VirtualCircuit.form.ipsecTrafficTitle,
              value: TransportTrafficType.ipsecTraffic,
            },
          ],
        },
      ],
    },
    /* Drg compartment & select */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          shouldShowGatewayElements(
            $isEdit
              ? $virtualCircuit?.type
              : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type],
          ),
      ),
      content: [
        {
          name: VirtualCircuitFieldNames.GatewayCompartment,
          fieldName: VirtualCircuitFieldNames.GatewayCompartment,
          type: "CompartmentScoped",
          label: Messages.VirtualCircuit.form.drg,
          initialCompartmentId: mauiExpression(
            $virtualCircuit?.compartmentId || $app?.consoleState?.compartmentId,
          ),
          controlDisabled: mauiExpression(
            shouldDisableDrgDropdown(
              $isEdit,
              CoreServicesApi.ListVirtualCircuitAssociatedTunnels.namespaced(
                virtualCircuitForm,
              ).response()?.data,
            ),
          ),
          fields: [
            {
              name: VirtualCircuitFieldNames.GatewayId,
              type: "Select",
              placeholder: mauiExpression(
                getDrgSelectPlaceHolder(
                  CoreServicesApi.ListDrgs?.response()?.data,
                  t,
                  $user?.forms?.[$formId]?.$formFields?.[
                    VirtualCircuitFieldNames.GatewayCompartment
                  ]?.name,
                ),
              ),
              options: mauiExpression(getDrgOptions(CoreServicesApi.ListDrgs?.response()?.data)),
              controlDisabled: mauiExpression(
                shouldDisableDrgDropdown(
                  $isEdit,
                  CoreServicesApi.ListVirtualCircuitAssociatedTunnels.namespaced(
                    virtualCircuitForm,
                  ).response()?.data,
                ),
              ),
              defaultValue: mauiExpression($virtualCircuit?.gatewayId),
              validators: [
                {
                  type: "required",
                  message: Messages.VirtualCircuit.form.drgError,
                },
              ],
            },
          ],
        },
        {
          type: "ConditionalRender",
          predicate: mauiExpression(
            isSuperDrgTransitHubEnabled($app.consoleState) &&
              $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.GatewayId],
          ),
          content: [
            {
              type: "SwitchRender",
              value: mauiExpression(!$isEdit),
              cases: {
                true: {
                  type: "InfoBlock",
                  infoText: Messages.VirtualCircuit.OnCreationInfoBlock.drgGatway,
                  status: "info",
                },
                false: {
                  type: "InfoBlock",
                  infoText: Messages.VirtualCircuit.OnCreationInfoBlock.drgGatwayWarning(
                    mauiExpression(HelpLink.DRGAttachmentHelpPage).ref,
                  ),
                  status: "info",
                },
              },
            },
          ],
        },
      ],
    },
    /* Bandwidth select */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          ($isEdit
            ? $virtualCircuit?.type
            : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type]) &&
          shouldShowBandwidthShapeSelect($user?.providerService),
      ),
      content: [
        {
          type: "ConditionalRender",
          predicate: mauiExpression(
            whitelistBandwidthPolicing($app) && !$user?.providerService?.id,
          ),
          content: [
            {
              type: "ConditionalRender",
              predicate: mauiExpression($virtualCircuit?.crossConnectMappings?.length > 1),
              content: [
                {
                  type: "InfoBlock",
                  infoText: Messages.VirtualCircuit.form.policingDisabledInfoTitle,
                  status: "warning",
                },
              ],
            },
            {
              type: "Switch",
              name: VirtualCircuitFieldNames.isBandwidthPolicingEnabled,
              label: Messages.VirtualCircuit.form.bandwidthPolicing,
              defaultValue: mauiExpression(
                $isEdit ? $virtualCircuit?.isBandwidthPolicingEnabled : false,
              ),
              disabled: mauiExpression($virtualCircuit?.crossConnectMappings?.length > 1),
              hint: Messages.VirtualCircuit.form.bandwidthPolicingHint,
            },
          ],
        },
        {
          name: VirtualCircuitFieldNames.BandwidthShapeName,
          label: Messages.VirtualCircuit.form.provisionedBandwidth,
          type: "Select",
          placeholder: mauiExpression(
            getBandwidthOptionsPlaceHolder(
              t,
              $isEdit && $virtualCircuit?.providerServiceId
                ? !!CoreServicesApi.ListFastConnectProviderVirtualCircuitBandwidthShapes?.loading
                : !!CoreServicesApi.ListVirtualCircuitBandwidthShapes?.loading,
              $isEdit && $virtualCircuit?.providerServiceId
                ? !!CoreServicesApi.ListFastConnectProviderVirtualCircuitBandwidthShapes?.error
                : !!CoreServicesApi.ListVirtualCircuitBandwidthShapes?.error,
              !!CoreServicesApi.ListCrossconnectPortSpeedShapes.loading,
              !!CoreServicesApi.ListCrossconnectPortSpeedShapes.error,
              $isEdit && $virtualCircuit?.providerServiceId
                ? CoreServicesApi.ListFastConnectProviderVirtualCircuitBandwidthShapes.response()
                    ?.data
                : CoreServicesApi.ListVirtualCircuitBandwidthShapes?.response()?.data,
              CoreServicesApi.ListCrossconnectPortSpeedShapes.response()?.data,
              CoreServicesApi.GetCrossConnect.namespaced(virtualCircuitForm).response()?.data,
              CoreServicesApi.ListCrossConnects.namespaced(virtualCircuitForm).response()?.data,
              $user?.providerService?.id,
            ),
          ),
          options: mauiExpression(
            getFilteredBandwidthOptions(
              $isEdit && $virtualCircuit?.providerServiceId
                ? CoreServicesApi.ListFastConnectProviderVirtualCircuitBandwidthShapes.response()
                    ?.data
                : CoreServicesApi.ListVirtualCircuitBandwidthShapes?.response()?.data,
              CoreServicesApi.GetCrossConnect.namespaced(virtualCircuitForm).response()?.data,
              CoreServicesApi.ListCrossConnects.namespaced(virtualCircuitForm).response()?.data,
              CoreServicesApi.ListCrossconnectPortSpeedShapes.response()?.data,
              $user?.providerService?.id,
            ),
          ),
          defaultValue: mauiExpression(
            getDefaultBandwidth(
              $virtualCircuit?.bandwidthShapeName,
              $isEdit && $virtualCircuit?.providerServiceId
                ? CoreServicesApi.ListFastConnectProviderVirtualCircuitBandwidthShapes.response()
                    ?.data
                : CoreServicesApi.ListVirtualCircuitBandwidthShapes?.response()?.data,
              CoreServicesApi.GetCrossConnect.namespaced(virtualCircuitForm).response()?.data,
              CoreServicesApi.ListCrossConnects.namespaced(virtualCircuitForm).response()?.data,
              CoreServicesApi.ListCrossconnectPortSpeedShapes.response()?.data,
              $user?.providerService?.id,
            ),
          ),
          validators: [
            {
              type: "required",
              message: Messages.VirtualCircuit.form.provisionedBandwidthError,
            },
          ],
          hint: mauiExpression(() => {
            if (!whitelistBandwidthPolicing($app) || $user?.providerService?.id) {
              return "";
            }
            if (
              $user?.forms?.[$formId]?.$formFields?.[
                VirtualCircuitFieldNames.isBandwidthPolicingEnabled
              ]
            ) {
              return Messages.VirtualCircuit.form.provisionedBandwidthPolicedHint;
            }
            return Messages.VirtualCircuit.form.provisionedBandwidthNoPolicingHint;
          }),
        },
      ],
    },
    /* Routing Policy */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          shouldShowRoutingPolicy(
            $isEdit
              ? $virtualCircuit?.type
              : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type],
            isRouteFilteringPublicEnabled($app),
          ),
      ),
      content: [
        {
          name: VirtualCircuitFieldNames.RoutingPolicy,
          label: Messages.VirtualCircuit.form.routeFiltering,
          type: "Select",
          options: mauiExpression(
            getRoutingPolicyOptions(
              $isEdit
                ? $virtualCircuit?.type
                : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type],
              t,
            ),
          ),
          defaultValue: mauiExpression(
            getRoutingPolicyDefaultValue($isEdit ? $virtualCircuit : undefined),
          ),
          placeholder: Messages.VirtualCircuit.form.selectAValue,
          validators: [],
          tooltip: {
            text: Messages.VirtualCircuit.form.infoRoutePolicy(
              mauiExpression(FastConnectCreateDoc.FastConnectRouteFiltering).ref,
            ),
          },
        },
      ],
    },
    /* Public Prefixes */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          !$isEdit &&
          shouldShowPublicPrefixesTextarea(
            $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type],
          ),
      ),
      content: [
        {
          type: "TextArea",
          name: VirtualCircuitFieldNames.PublicPrefixes,
          label: Messages.PublicPrefixTextareaField.publicPrefixes,
          hint: Messages.PublicPrefixTextareaField.publicPrefixesHint,
          placeholder: Messages.PublicPrefixTextareaField.publicPrefixesPlaceholder(
            mauiExpression(publicPrefixesPlaceholderSample).ref,
          ),
          tooltip: {
            text: Messages.PublicPrefixTextareaField.publicPrefixesPlaceholder(
              mauiExpression(publicPrefixesPlaceholderSample).ref,
            ),
          },
          readOnly: false,
          optional: true,
          validators: [
            {
              type: "custom",
              isValid: mauiExpression(
                validatePublicPrefixes(
                  transformPublicPrefixes(
                    $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.PublicPrefixes],
                  ),
                  true,
                ),
              ),
              message: Messages.PublicPrefixTextareaField.publicPrefixesInvalidError,
            },
          ],
        },
      ],
    },

    /* Provider key   */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          shouldShowProviderServiceKeyName($user?.providerService, $isEdit),
      ),
      content: [
        {
          type: "TextInput",
          name: VirtualCircuitFieldNames.ProviderServiceKeyName,
          label: Messages.VirtualCircuit.form.partnerKey,
          optional: mauiExpression(isATT($user?.providerService)),
          tooltip: {
            text: Messages.VirtualCircuit.form.partnerKeyInfo,
          },
          validators: [
            {
              type: "max-length",
              maxLength: validationRules.providerServiceKeyMaxLength,
              message: Messages.VirtualCircuit.form.partnerKeyErrorLength(
                String(validationRules.providerServiceKeyMinLength),
                String(validationRules.providerServiceKeyMaxLength),
              ),
            },
            {
              type: "min-length",
              minLength: validationRules.providerServiceKeyMinLength,
              message: Messages.VirtualCircuit.form.partnerKeyErrorLength(
                String(validationRules.providerServiceKeyMinLength),
                String(validationRules.providerServiceKeyMaxLength),
              ),
            },
          ],
          defaultValue: mauiExpression($virtualCircuit?.providerServiceKeyName),
        },
      ],
    },
    /* VLAN - Only show for Direct VCs (exclude Internet type) */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        ($isEdit
          ? $virtualCircuit?.type &&
              !$virtualCircuit?.providerServiceId &&
              !isProviderTenant($app.consoleState)
          : $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type]) &&
          ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
            $virtualCircuit?.type) !== VirtualCircuitTypeEnum.Internet,
      ),
      content: [
        {
          type: "NumberInput",
          name: VirtualCircuitFieldNames.Vlan,
          label: Messages.VirtualCircuit.form.vlan,
          min: validationRules.vlanMinValue,
          max: validationRules.vlanMaxValue,
          validators: [
            {
              type: "required",
              message: Messages.VirtualCircuit.form.vlanError,
            },
            {
              type: "min",
              min: validationRules.vlanMinValue,
              message: Messages.VirtualCircuit.form.vlanValueError(
                String(validationRules.vlanMinValue),
                String(validationRules.vlanMaxValue),
              ),
            },
            {
              type: "max",
              max: validationRules.vlanMaxValue,
              message: Messages.VirtualCircuit.form.vlanValueError(
                String(validationRules.vlanMinValue),
                String(validationRules.vlanMaxValue),
              ),
            },
          ],
          defaultValue: mauiExpression(
            $virtualCircuit?.crossConnectMappings?.[0]?.vlan,
          ),
        },
      ],
    },
    /* IPv4 fields */
    {
      type: "ConditionalRender",
      predicate: mauiExpression(
        !isProviderTenant($app.consoleState) &&
          (($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
              $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet ||
            shouldShowIpFields(
              $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                $virtualCircuit?.type,
              $user?.providerService,
            )),
      ),
      content: [
        {
          type: "FieldSet",
          legend: Messages.VirtualCircuit.form.bgpIpAddresses,
          content: [
            {
              type: "ConditionalRender",
               predicate: mauiExpression(
                ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                  $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet ||
                  $user?.providerService?.requiredTotalCrossConnects === 1,
                ),
              content: [
                {
                  type: "TextInput",
                  name: mauiExpression(
                    getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, 0),
                  ),
                  label: Messages.VirtualCircuit.form.customerIpv4,
                  hint: Messages.VirtualCircuit.form.customerIpHint,
                  validators: [
                    {
                      type: "required",
                      message: Messages.VirtualCircuit.form.ipMissingError,
                    },
                    {
                      type: "max-length",
                      maxLength: validationRules.ipMaxLength,
                      message: Messages.VirtualCircuit.form.ipLengthError(
                        String(validationRules.ipMinLength),
                        String(validationRules.ipMaxLength),
                      ),
                    },
                    {
                      type: "custom",
                      isValid: mauiExpression(
                        isValidIpv4CidrAddress(
                          /* @ts-ignore */
                          $user?.forms?.[$formId]?.$formFields?.[
                            getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, 0)
                          ],
                        ),
                      ),
                      message: Messages.VirtualCircuit.form.ipInvalidError,
                    },
                  ],
                  defaultValue: mauiExpression(
                    $virtualCircuit?.crossConnectMappings[0]?.customerBgpPeeringIp,
                  ),
                },
                {
                  type: "TextInput",
                  name: mauiExpression(
                    getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, 0),
                  ),
                  label: Messages.VirtualCircuit.form.oracleIpv4,
                  hint: Messages.VirtualCircuit.form.oracleIpHint,
                  validators: [
                    {
                      type: "required",
                      message: Messages.VirtualCircuit.form.ipMissingError,
                      predicate: mauiExpression(
                        ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                          $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet,
                      ),
                    },
                    {
                      type: "max-length",
                      maxLength: validationRules.ipMaxLength,
                      message: Messages.VirtualCircuit.form.ipLengthError(
                        String(validationRules.ipMinLength),
                        String(validationRules.ipMaxLength),
                      ),
                    },
                    {
                      type: "custom",
                      isValid: mauiExpression(
                        isValidIpv4CidrAddress(
                          $user?.forms?.[$formId]?.$formFields?.[
                            getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, 0)
                          ],
                        ),
                      ),
                      message: Messages.VirtualCircuit.form.ipInvalidError,
                    },
                  ],
                  defaultValue: mauiExpression(
                    $virtualCircuit?.crossConnectMappings[0]?.oracleBgpPeeringIp,
                  ),
                  optional: mauiExpression(
                    ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                      $virtualCircuit?.type) !== VirtualCircuitTypeEnum.Internet,
                  ),
                },
              ],
            },
            {
              type: "ConditionalRender",
              predicate: mauiExpression(
                ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                  $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet ||
                  $user?.providerService?.requiredTotalCrossConnects === 2,
                ),
              content: [
                {
                  type: "TextInput",
                  name: mauiExpression(
                    getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, 0),
                  ),
                  label: Messages.VirtualCircuit.form.customerPrimaryIpv4,
                  hint: Messages.VirtualCircuit.form.customerIpHint,
                  validators: [
                    {
                      type: "required",
                      message: Messages.VirtualCircuit.form.ipMissingError,
                    },
                    {
                      type: "max-length",
                      maxLength: validationRules.ipMaxLength,
                      message: Messages.VirtualCircuit.form.ipLengthError(
                        String(validationRules.ipMinLength),
                        String(validationRules.ipMaxLength),
                      ),
                    },
                    {
                      type: "custom",
                      isValid: mauiExpression(
                        isValidIpv4CidrAddress(
                          $user?.forms?.[$formId]?.$formFields?.[
                            getIndexedFieldName(VirtualCircuitFieldNames.CustomerBgpPeeringIp, 0)
                          ],
                        ),
                      ),
                      message: Messages.VirtualCircuit.form.ipInvalidError,
                    },
                  ],
                  defaultValue: mauiExpression(
                    $virtualCircuit?.crossConnectMappings[0]?.customerBgpPeeringIp,
                  ),
                },
                {
                  type: "TextInput",
                  name: mauiExpression(
                    getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, 0),
                  ),
                  label: Messages.VirtualCircuit.form.oraclePrimaryIpv4,
                  hint: Messages.VirtualCircuit.form.oracleIpHint,
                  validators: [
                    {
                      type: "required",
                      message: Messages.VirtualCircuit.form.ipMissingError,
                      predicate: mauiExpression(
                        ($user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.Type] ??
                          $virtualCircuit?.type) === VirtualCircuitTypeEnum.Internet,
                      ),
                    },
                    {
                      type: "max-length",
                      maxLength: validationRules.ipMaxLength,
                      message: Messages.VirtualCircuit.form.ipLengthError(
                        String(validationRules.ipMinLength),
                        String(validationRules.ipMaxLength),
                      ),
                    },
                    {
                      type: "custom",
                      isValid: mauiExpression(
                        isValidIpv4CidrAddress(
                          $user?.forms?.[$formId]?.$formFields?.[
                            getIndexedFieldName(VirtualCircuitFieldNames.OracleBgpPeeringIp, 0)
                          ],
                        ),
                      ),
                      message: Messages.VirtualCircuit.form.ipInvalidError,
                    },
                  ],
                  defaultValue: mauiExpression(
                    $virtualCircuit?.crossConnectMappings[0]?.oracleBgpPeeringIp,
                  ),
