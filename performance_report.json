                    virtualCircuitDo.getCrossConnectMapping().getMappings().length,
                    MIN_CROSS_CONNECTS);
        }
        if (virtualCircuitDo.getCrossConnectMapping()
                .getMappings().length > MAX_CROSS_CONNECTS) {
