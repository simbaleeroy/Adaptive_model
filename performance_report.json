{
      type: "ConditionalRender",
      predicate: mauiExpression(!$isEdit && !isProviderTenant($app.consoleState)),
      content: [
        {
          type: "Select",
          name: VirtualCircuitFieldNames.ProviderServiceId,
          label: Messages.FastConnect.create.partner,
          placeholder: Messages.VirtualCircuit.form.selectAValue,
          options: mauiExpression(
            getProviderServiceOptions(
              CoreServicesApi.ListFastConnectProviderServices?.response()?.data,
            ),
          ),
          defaultValue: mauiExpression(
            $user?.forms?.[$formId]?.$formFields?.[VirtualCircuitFieldNames.ProviderServiceId] ||
              CoreServicesApi.ListFastConnectProviderServices?.response()?.data?.[0]?.id,
          ),
          validators: [
            {
              type: "required",
              message: Messages.FastConnect.create.partnerError,
            },
          ],
          onChangeAction: [VirtualCircuitDetailsActions.shouldGetFastConnectProviderService],
        },
      ],
    },
