    public void WHEN_getVirtualCircuit_GIVEN_BgpSessionStateIsNotEstablished_Then_BgpIpv6SessionStateIsDown() throws Exception {

        setupVcDependencies();

        try (Transaction t = propertiesBl.beginTransaction("properties")) {

            PropertiesDo propertiesDo = PropertiesDo.builder()
                    .id(PropertiesDo.Keys.ENABLE_FASTCONNECT_IPV6.getKeyName())
