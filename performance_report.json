@GET
    @Path("/tenancy/{tenancyId}/export")
    @Produces({ "application/json" })
    @Timed(name = "export-tenancy-data")
    @VpnSkipAuthorization
    public Response exportTenancyData(@PathParam("tenancyId") String tenancyId) throws ValidationException {
        Validation.OCIDValidate(tenancyId);

        javax.ws.rs.core.StreamingOutput stream = (output) -> {
            com.fasterxml.jackson.core.JsonGenerator gen = null;
            try {
                gen = mapper.getFactory().createGenerator(output, com.fasterxml.jackson.core.JsonEncoding.UTF8);
                gen.writeStartObject();

                // predicate: checks tenantId then falls back to compartment resolution
                java.util.function.Predicate<Object> belongsToTenancy = (obj) -> {
                    try {
                        if (obj == null)
                            return false;
                        // Try tenantId getter
                        try {
                            java.lang.reflect.Method m = obj.getClass().getMethod("getTenantId");
                            Object tenantId = m.invoke(obj);
                            if (tenantId != null)
                                return tenancyId.equals(tenantId.toString());
                        } catch (NoSuchMethodException ignore) {
                        }
                        // Try compartmentId getter
                        try {
                            java.lang.reflect.Method mc = obj.getClass().getMethod("getCompartmentId");
                            Object compartmentId = mc.invoke(obj);
                            if (compartmentId != null) {
                                String resolved = identityHelper.getTenantId(compartmentId.toString());
                                return tenancyId.equals(resolved);
                            }
                        } catch (NoSuchMethodException ignore) {
                        }
                    } catch (Exception e) {
                        log.warn("Failed tenancy check for object {}", obj, e);
                    }
                    return false;
                };

                // Simple approach - directly fetch and write each resource type

                // CrossConnects
                gen.writeFieldName("crossConnects");
                gen.writeStartArray();
                try {
                    java.util.List<?> crossConnects = crossConnectBl.list(null, 1000);
                    if (crossConnects != null) {
                        for (Object item : crossConnects) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get crossConnects list", e);
                }
                gen.writeEndArray();

                // CrossConnectGroups
                gen.writeFieldName("crossConnectGroups");
                gen.writeStartArray();
                try {
                    java.util.List<?> crossConnectGroups = crossConnectGroupBl.list(null, 1000);
                    if (crossConnectGroups != null) {
                        for (Object item : crossConnectGroups) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get crossConnectGroups list", e);
                }
                gen.writeEndArray();

                // VirtualCircuits
                gen.writeFieldName("virtualCircuits");
                gen.writeStartArray();
                try {
                    java.util.List<?> virtualCircuits = virtualCircuitBl.list(null, 1000);
                    if (virtualCircuits != null) {
                        for (Object item : virtualCircuits) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get virtualCircuits list", e);
                }
                gen.writeEndArray();

                // IPsec Connections
                gen.writeFieldName("ipsecConnections");
                gen.writeStartArray();
                try {
                    java.util.List<?> ipsecConnections = iPsecConnectionBl.list(null, 1000);
                    if (ipsecConnections != null) {
                        for (Object item : ipsecConnections) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get ipsecConnections list", e);
                }
                gen.writeEndArray();

                // Remote Peering Connections
                gen.writeFieldName("remotePeeringConnections");
                gen.writeStartArray();
                try {
                    java.util.List<?> remotePeeringConnections = remotePeeringConnectionBl.list(null, 1000);
                    if (remotePeeringConnections != null) {
                        for (Object item : remotePeeringConnections) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get remotePeeringConnections list", e);
                }
                gen.writeEndArray();

                // Tunnels
                gen.writeFieldName("tunnels");
                gen.writeStartArray();
                try {
                    java.util.List<?> tunnels = tunnelBl.list(null, 1000);
                    if (tunnels != null) {
                        for (Object item : tunnels) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get tunnels list", e);
                }
                gen.writeEndArray();

                // Devices
                gen.writeFieldName("devices");
                gen.writeStartArray();
                try {
                    java.util.List<?> devices = deviceBl.list(null, 1000);
                    if (devices != null) {
                        for (Object item : devices) {
                            if (item != null && belongsToTenancy.test(item)) {
                                mapper.writeValue(gen, item);
                            }
                        }
                    }
                } catch (Exception e) {
                    log.warn("Failed to get devices list", e);
                }
                gen.writeEndArray();

                // tenancy metadata
                gen.writeFieldName("tenancyMetadata");
                try {
                    mapper.writeValue(gen, tenancyMetadataBl.get(tenancyId).orElse(null));
                } catch (Exception e) {
                    log.warn("Failed to get tenancy metadata for tenancyId: {}", tenancyId, e);
                    gen.writeNull();
                }

                gen.writeEndObject();
                gen.flush();
            } catch (IOException e) {
                throw new RuntimeException(e);
            } finally {
                if (gen != null)
                    try {
                        gen.close();
                    } catch (IOException ignored) {
                    }
            }
        };

        return Response.ok(stream).type(javax.ws.rs.core.MediaType.APPLICATION_JSON).build();
    }
