    @patch.dict(os.environ, {'hostname': 'test-api.example.com', 'LOCAL_PORT': '8080'})
    @patch('requests.get')
    @patch('json.loads')
    def test_crossconnect_successful_request(self, mock_json_loads, mock_requests_get):
        """Test successful crossconnect data retrieval."""
        # Mock the HTTP response
        mock_response = Mock()
        mock_response.text = json.dumps(self.sample_crossconnect_response)
        mock_requests_get.return_value = mock_response
        
        # Mock json.loads to return our sample data
        mock_json_loads.return_value = self.sample_crossconnect_response
        
        # Call the function - NO REAL API CALL MADE due to @patch('requests.get')
        result = getC3MultiAttributes(self.test_ocid)
        
        # Verify the requests.get call was made correctly
        mock_requests_get.assert_called_once()
        call_args, call_kwargs = mock_requests_get.call_args
        
        # Check URL construction
        expected_url_pattern = 'https://test-api.example.com/v1/management/crossconnects/'
        self.assertIn(expected_url_pattern, call_args[0])
        self.assertIn(self.test_ocid, call_args[0])
        
        # Check authentication parameter
        self.assertIn('auth', call_kwargs)
        
        # Check proxies parameter
        self.assertIn('proxies', call_kwargs)
        self.assertIn('https', call_kwargs['proxies'])
        
        # Check verify parameter
        self.assertEqual(call_kwargs['verify'], False)
        
        # Verify json.loads was called with response.text
        mock_json_loads.assert_called_once_with(mock_response.text)
        
        # Check return value structure
        expected_result = {'resource_name': self.sample_crossconnect_response}
        self.assertEqual(result, expected_result)
        pass

