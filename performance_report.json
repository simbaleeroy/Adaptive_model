            reconciliationCanStartAfterSecs: 30
            availabilityDomain: downstream.getOr404('compute','GetInstance',request.body.instanceId).availabilityDomain
          InstanceAttachResource:
            serviceResourceName: Instance
            actionKind: ATTACH
