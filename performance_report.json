 @Test
    public void ttestCreateOrUpdateDrgV2Attachment_BmcExceptionAndVC_put_in_FailedState() throws Exception {
        // Arrange
//        VirtualCircuitDo virtualCircuitDo = VirtualCircuitDo.builder()
//                .id(TEST_EXISTING_VC_ID)
//                .gatewayId(TEST_DRG_ID)
//                .state(VirtualCircuitDo.State.PROVISIONING)
//                .build();
        VirtualCircuitDo virtualCircuitDo  = generateVirtualCircuitDo(VirtualCircuitDo.IpAddressType.PUBLIC, null, null);
        Transaction t = virtualCircuitBl.beginTransaction("create-vc");
            VirtualCircuitDo vcToUpdate = virtualCircuitBl.getOrThrow(virtualCircuitDo.getId());
            VirtualCircuitDo updated = vcToUpdate.toBuilder().state(VirtualCircuitDo.State.PROVISIONING).build();
            virtualCircuitBl.update(t, updated);
            t.commit();


           // Act and Assert - Test that BmcException is thrown and VC state is updated
           try (Transaction tx = drgV2AttachmentBl.beginTransaction("test")) {

               when(drgV2Helper.createDrgV2AttachmentAndDo(tx, virtualCircuitDo, true))
                       .thenThrow(new BmcException(500, "test", "test", "test"));

               Method method = VirtualCircuitWorkflowBase.class.getDeclaredMethod("createOrUpdateDrgV2Attachment", Transaction.class, VirtualCircuitDo.class, VpnRegion.class);
               method.setAccessible(true);
               assertThrows(Exception.class, () -> {
                   method.invoke(createVcDrgV2AttachmentWorkflow, tx, virtualCircuitDo, null);
               }, "Expected BmcException to be thrown");

               //virtualCircuitBl.update(t, virtualCircuitDo);
               tx.commit();
           }

           VirtualCircuitDo updatedVc = virtualCircuitBl.getOrThrow(virtualCircuitDo.getId());
           assertThat(updatedVc.getId()).isEqualTo(virtualCircuitDo.getId());
           assertThat(updatedVc.getState()).isEqualTo(VirtualCircuitDo.State.FAILED);

    }
