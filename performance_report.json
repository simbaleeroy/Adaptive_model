    @Test
    public void GIVEN_customerVirtualCircuit_WHEN_updateMapping_null_THEN_exception()
            throws Exception {
        setupVcDependencies();
        CreateVirtualCircuitDetails createVirtualCircuitDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createVirtualCircuitDetails)
                .build()).getVirtualCircuit();
        assertThat(workRequestBl.list(Optional.empty(), 10).results().size()).isEqualTo(1);

        CrossConnectMapping mapping = CrossConnectMapping.builder()
                .customerBgpPeeringIp("20.20.20.1/30")
                .build();
        UpdateVirtualCircuitDetails update = UpdateVirtualCircuitDetails
                .builder()
                .crossConnectMappings(Arrays.asList(mapping, null))
                .build();

        Assertions.assertThatThrownBy(() -> virtualCircuitManagementResourceV1.updateVirtualCircuit(vc.getId(),
                        UPDATED_ORACLE_ASN, null, null, true, null, true, false, null, null, null, null, null, null, update))
                .hasMessageContaining("A mapping cannot be explicitly null in crossConnectMappings.")
                .isInstanceOf(ValidationException.class);
    }

    @Test
    public void GIVEN_lifecycleStateParam_WHEN_toModelFails_THEN_wrappedException() throws Exception {
        setupVcDependencies();

        VirtualCircuitDo.State targetState = VirtualCircuitDo.State.PROVISIONING;

        CreateVirtualCircuitDetails createDetails =
                getCreateVirtualCircuitDetailsBuilder(crossConnect1.getId()).build();

        VirtualCircuit vc = publicClient.createVirtualCircuit(CreateVirtualCircuitRequest.builder()
                .createVirtualCircuitDetails(createDetails)
                .build()).getVirtualCircuit();

        try (Transaction t = virtualCircuitBl.beginTransaction("set-state")) {
            virtualCircuitBl.update(t, virtualCircuitBl.getOrThrow(t, vc.getId()).toBuilder().state(targetState).build());
            t.commit();
        }

        VirtualCircuitManagementResourceV1 resourceSpy = spy(virtualCircuitManagementResourceV1);
        doThrow(new com.oracle.pic.vpn.db.exception.ValidationException(ErrorCode.InternalError, "fail"))
                .when(resourceSpy)
                .toModel(any(VirtualCircuit.class), any(VirtualCircuitDo.class));

        assertThatThrownBy(() ->
                resourceSpy.listVirtualCircuits(100, null, null, null, targetState.getValue())
        )
                .isInstanceOf(RuntimeException.class)
                .hasMessage("Virtual circuit operation failed.")
                .hasCauseInstanceOf(com.oracle.pic.vpn.db.exception.ValidationException.class);
    }

