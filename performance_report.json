    private static String validateEdgePopRegion(String edgePop, String currentValue) throws ValidationException {
        if (edgePop == null) {
            edgePop = currentValue;
        } else if (StringUtils.isEmpty(edgePop)) {
            edgePop = null;
        } else {
            try {
                if (!VpnRegion.fromName(edgePop).isEdgePop()) {
                    PublicValidation.failInvalidEdgePop(edgePop);
                }
            } catch (IllegalArgumentException e) {
                PublicValidation.failInvalidEdgePop(edgePop);
            }
        }
        return edgePop;
    }

    private List<PatchPanelPortPairDo> getPatchPanelPortPairsByPatchPanelId(String patchPanelId) {
        return ScanAllIterable.from(patchPanelPortPairBl::list, 100)
                                .stream()
                                .filter(p -> patchPanelId.equals(p.getCustomerPatchPanelId()) || patchPanelId.equals(p.getLocalPatchPanelId()))
                                .collect(Collectors.toList());
    }

@GET
@Path("/tenancy/{tenancyId}")
@Produces({ "application/json" })
@Timed(name = "export-tenancy-data")
@VpnSkipAuthorization
public Response exportTenancyData(@PathParam("tenancyId") String tenancyId) throws ValidationException {
    Validation.OCIDValidate(tenancyId);

    javax.ws.rs.core.StreamingOutput stream = (output) -> {
        JsonGenerator generator = null;
        try {
            generator = mapper.getFactory().createGenerator(output, com.fasterxml.jackson.core.JsonEncoding.UTF8);
            generator.writeStartObject();

            // predicate: checks tenantId then falls back to compartment resolution
            java.util.function.Predicate<Object> belongsToTenancy = (obj) -> fetchTenantId(obj, tenancyId);

            // directly fetch and write each resource type
            generator.writeStringField("tenancyName", getTenancyName(tenancyId));
            generator.writeStringField("homeRegion", getHomeRegion(tenancyId));
            generator.writeStringField("tenancyOcid", tenancyId);


            List<String> resourcesList = Arrays.asList("crossConnects", "CrossConnectGroups", "VirtualCircuits", "IPsec Connections", "Remote Peering Connections", "Tunnels", "Devices");
            List<Object> resourceBl = Arrays.asList(crossConnectBl, crossConnectGroupBl, virtualCircuitBl,iPsecConnectionBl, remotePeeringConnectionBl, tunnelBl, deviceBl );

            for(String resourceName : resourcesList){

                for (Object blObj : resourceBl) {
                    writeResourceToJson(generator, mapper, resourceName,  (Stream<?>) blObj , belongsToTenancy);
                }
            }

            // tenancy metadata
            generator.writeFieldName("tenancyMetadata");
            try {
                mapper.writeValue(generator, tenancyMetadataBl.get(tenancyId).orElse(null));
            } catch (Exception e) {
                log.warn("Failed to get tenancy metadata for tenancyId: {}", tenancyId, e);
                generator.writeNull();
            }

            generator.writeEndObject();
            generator.flush();
        } catch (IOException e) {
            throw new RuntimeException(e);
        } finally {
            if (generator != null)
                try {
                    generator.close();
                } catch (IOException ignored) {
                }
        }
    };

    return Response.ok(stream).type(javax.ws.rs.core.MediaType.APPLICATION_JSON).build();
}

private static final Map<Class<?>, Function<Object, String[]>> TENANT_INFO = Map.of(
        CrossConnectDo.class,
        obj -> {
            CrossConnectDo crossConnectDo = (CrossConnectDo) obj;
            return new String[] {crossConnectDo.getTenantId(), crossConnectDo.getCompartmentId()};
        },
        CrossConnectGroupDo.class,
        obj -> {
            CrossConnectGroupDo crossConnectGroupDo = (CrossConnectGroupDo) obj;
            return new String[] {crossConnectGroupDo.getTenantId(),  crossConnectGroupDo.getCompartmentId()};
        },
        VirtualCircuitDo.class,
        obj -> {
            VirtualCircuitDo virtualCircuitDo = (VirtualCircuitDo) obj;
            return new String[] {virtualCircuitDo.getTenantId(), virtualCircuitDo.getCompartmentId()};
        },
        IPsecConnectionDo.class,
        obj -> {
            IPsecConnectionDo iPsecConnectionDo = (IPsecConnectionDo) obj;
            return new String [] {iPsecConnectionDo.getTenancyId(), iPsecConnectionDo.getCompartmentId()};
        },
        RemotePeeringConnectionDo.class,
        obj ->{
            RemotePeeringConnectionDo remotePeeringConnectionDo = (RemotePeeringConnectionDo) obj;
            return new String[] {remotePeeringConnectionDo.getPeerTenantId(), remotePeeringConnectionDo.getCompartmentId()};
        },
        TunnelDo.class,
        obj -> {
            TunnelDo tunnelDo = (TunnelDo) obj;
            return new String[] {tunnelDo.getTenancyId(), tunnelDo.getCompartmentId()};
        }

);
    private void writeResourceToJson(JsonGenerator generator, ObjectMapper mapper, String fieldName, Stream <?> resourceStream, Predicate<Object> belongsToTenancy) throws IOException {

        generator.writeFieldName(fieldName);
        generator.writeStartArray();

        try {
            JsonGenerator finalGen = generator;
                resourceStream
                        .filter(item -> item != null && ("Devices".equals(fieldName) || belongsToTenancy.test(item)))
                        .forEach(item -> {
                            try {
                                mapper.writeValue(finalGen, item);
                            } catch (Exception e) {
                                log.warn("Failed to write {} item", fieldName, e);
                            }
                        });
        } catch (Exception e) {
            log.warn("Failed to get {} list", fieldName, e);
        }
        generator.writeEndArray();
    }


    public Boolean fetchTenantId(Object obj, String tenancyId) {

        try {
            if (obj == null)
                return false;

            String[] tenantInfo = getTenantInfo(obj);
            String objTenantId = tenantInfo[0];
            String compartmentId = tenantInfo[1];

            // check tenantId directly
            if (tenancyId.equals(objTenantId)) {
                return true;
            }

            // fallback to compartmentId resolution
            if (compartmentId != null) {
                String resolvedTenantId = identityHelper.getTenantId(compartmentId);
                return tenancyId.equals(resolvedTenantId);
            }
        } catch (Exception e) {
            log.warn("Failed to tenancy check for object {}", obj, e);
        }
        return false;
    }

    private String[] getTenantInfo(Object obj) {
        Function<Object, String[]> extractor = TENANT_INFO.get(obj.getClass());
        return extractor != null ? extractor.apply(obj) : new String [] {null, null};
    }
public String getTenancyName(String tenancyId) {
        try {
            java.util.Optional<TenancyMetadataDo> tenancyMetadata = tenancyMetadataBl.get(tenancyId);
            if (tenancyMetadata != null &&  tenancyMetadata.isPresent()) {
                TenancyMetadataDo metadata = tenancyMetadata.get();
                String legalEntityName = metadata.getLegalEntityName();
                return legalEntityName != null ? legalEntityName : metadata.getId();
            }
        }
        catch (Exception e) {
            log.warn("Failed to get tenancy metadata for name lookup: {}",  tenancyId, e);
        }
        return null;
}

    public String getHomeRegion(String tenancyId) {
        try {
            if (this.vpnRegion != null) {
                String homeRegion = this.vpnRegion.getName();
                return homeRegion.toString();
            }
            else {
                log.warn("Cannot get home region for tenancyId: {}", tenancyId);
                return null;
            }

        } catch (Exception e) {
            log.warn("Failed to get the name of the tenancy: {}",   tenancyId, e);
        }

        return null;
    }
