    @Test
    public void ccConvert_GIVEN_ProvisionedCcgId_THEN_ReturnCc2() throws Exception {
        Transaction t = crossConnectBl.beginTransaction("add-CrossConnect");

        MacsecPropertiesInternal macsecPropertiesInternal = MacsecPropertiesInternal.builder()
                .rekeyPeriod(50)
                .replayProtectionWindow(50l)
                .mkaServerPriority(50)
                .bypassLldp(false)
                .build();

        CrossConnectDo pendingCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                .displayName("pendingCc")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .location(ManagementResourceTestHelper.LOCATION_ID)
                .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                .state(CrossConnectDo.State.PROVISIONING)
                .connectionHintsNear(new String[]{})
                .connectionHintsFar(new String[]{})
                .deviceId("test_dev")
                .build());
        String pendingCcId = pendingCcDo.getId();
        t.commit();

        Set<DeviceDo.Role> roles =  new HashSet<>();
        roles.add(DeviceDo.Role.AristaSwitch);
        t = deviceBl.beginTransaction("fakedevice");
        DeviceDo deviceDo = deviceBl.create(t, DeviceDo.builder().id("test_dev")
                .managementIpAddress("11.2.3.4")
                .name("name")
                .ad("ad")
                .anycastIp("4.3.2.1")
                .auth(new Authentication("user", "password"))
                .deviceType(DeviceDo.DeviceType.Fake)
                .roles(roles)
                .lastUpdated(new Date())
                .configSyncEnabled(true)
                .deviceConfig(com.oracle.pic.vpn.db.devices.model.DeviceConfig
                        .builder()
                        .circonusCheckId("id1")
                        .circonusHostname("hostname1")
                        .snmpEnabled(true)
                        .connectionToMx(new DeviceConfig.ConnectionToPeerDevice[] {
                                DeviceConfig.ConnectionToPeerDevice.builder().connectToDeviceId("test_dev").build() })
                        .snmpCommunityString("test")
                        .build())
                .build());
        t.commit();

        t = crossConnectGroupBl.beginTransaction("add-CrossConnectGroup");
        String provisionedCcgWithPendingCcId = crossConnectGroupBl.create(t, CrossConnectGroupDo.builder()
                .displayName("provisionedCcg")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .crossConnectIds(new String[]{pendingCcId})
                .state(CrossConnectGroupDo.State.PROVISIONED)
                .deviceId("test_dev")
                .macsecPropertiesInternal(macsecPropertiesInternal)
                .build()).getId();
        t.commit();

        t = crossConnectBl.beginTransaction("update-CrossConnect");
        crossConnectBl.update(t, pendingCcDo.toBuilder()
                .state(CrossConnectDo.State.PENDING_CUSTOMER)
                .crossConnectGroupId(provisionedCcgWithPendingCcId).build());
        t.commit();

        Response response = crossConnectManagementResource.getCrossConnect(pendingCcId);

        assertEquals(200, response.getStatus());
        CrossConnectInternal crossConnectInternal = (CrossConnectInternal) response.getEntity();

        assertEquals(macsecPropertiesInternal.getBypassLldp(),
                crossConnectInternal.getMacsecProperties().getBypassLldp());
        assertEquals(macsecPropertiesInternal.getReplayProtectionWindow(),
                crossConnectInternal.getMacsecProperties().getReplayProtectionWindow());
        assertEquals(macsecPropertiesInternal.getRekeyPeriod(),
                crossConnectInternal.getMacsecProperties().getRekeyPeriod());
        assertEquals(macsecPropertiesInternal.getMkaServerPriority(),
                crossConnectInternal.getMacsecProperties().getMkaServerPriority());
    }

    @Test
    public void ccConvert_GIVEN_ProvisionedCcgId_THEN_ReturnCc() throws Exception {
        Transaction t = crossConnectBl.beginTransaction("add-CrossConnect");
        CrossConnectDo pendingCcDo = crossConnectBl.create(t, CrossConnectDo.builder()
                .displayName("pendingCc")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .location(ManagementResourceTestHelper.LOCATION_ID)
                .portSpeed(ManagementResourceTestHelper.MY_PORT_SPEED)
                .interfaceId(ManagementResourceTestHelper.INTERFACE_PREFIX + "1")
                .state(CrossConnectDo.State.PROVISIONING)
                .connectionHintsNear(new String[]{})
                .connectionHintsFar(new String[]{})
                .deviceId("test_dev")
                .build());
        String pendingCcId = pendingCcDo.getId();
        t.commit();

        t = crossConnectGroupBl.beginTransaction("add-CrossConnectGroup");
        String provisionedCcgWithPendingCcId = crossConnectGroupBl.create(t, CrossConnectGroupDo.builder()
                .displayName("provisionedCcg")
                .compartmentId(ManagementResourceTestHelper.MY_COMPARTMENT)
                .crossConnectIds(new String[]{pendingCcId})
                .state(CrossConnectGroupDo.State.PROVISIONED)
                .deviceId("test_dev")
                .build()).getId();
        t.commit();

        t = crossConnectBl.beginTransaction("update-CrossConnect");
        crossConnectBl.update(t, pendingCcDo.toBuilder()
                .state(CrossConnectDo.State.PENDING_CUSTOMER)
                .crossConnectGroupId(provisionedCcgWithPendingCcId).build());
        t.commit();

        Response response = crossConnectManagementResource.ccConvert(pendingCcId, ConvertCrossConnectDetails.builder()
                .type(ConvertCrossConnectDetails.Type.ConvertToCcNoGroup)
                .build());
        assertEquals(200, response.getStatus());
        CrossConnect crossConnect = (CrossConnect) response.getEntity();
        assertNull(crossConnect.getCrossConnectGroupId());
        assertEquals(CrossConnect.LifecycleState.PendingCustomer, crossConnect.getLifecycleState());

        response = crossConnectManagementResource.ccConvert(pendingCcId, ConvertCrossConnectDetails.builder()
                .type(ConvertCrossConnectDetails.Type.ConvertToCcGroup)
                .ccgId(provisionedCcgWithPendingCcId)
                .build());
        assertEquals(200, response.getStatus());
        crossConnect = (CrossConnect) response.getEntity();
        assertEquals(provisionedCcgWithPendingCcId, crossConnect.getCrossConnectGroupId());
        assertEquals(CrossConnect.LifecycleState.PendingCustomer, crossConnect.getLifecycleState());
    }

