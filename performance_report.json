
#!/usr/bin/env python3
"""
Network Log Analyzer with Ollama Integration
Kicks off network monitoring script and uses local Ollama model to analyze output for issues.
"""

import argparse
import subprocess
import sys
import os
import re
import json
import requests
import time
from datetime import datetime
from typing import List, Dict, Any, Optional
from dataclasses import dataclass
from tabulate import tabulate


@dataclass
class Issue:
    """Represents a detected network issue"""
    category: str
    severity: str  # HIGH, MEDIUM, LOW
    component: str
    description: str
    details: str
    recommendation: str = ""
    ocid: str = ""  # Add OCID to track which network this issue belongs to


class OllamaClient:
    # Client for interacting with local Ollama model
    
    def __init__(self, base_url: str = "http://localhost:11434", model: str = "llama3.2:3b"):
        self.base_url = base_url
        self.model = model
        
    def is_available(self) -> bool:
        # Check if Ollama service is available
        try:
            response = requests.get(f"{self.base_url}/api/tags", timeout=5)
            return response.status_code == 200
        except:
            return False
            
    def get_available_models(self) -> List[str]:
        # Get list of available models
        try:
            response = requests.get(f"{self.base_url}/api/tags")
            if response.status_code == 200:
                data = response.json()
                return [model['name'] for model in data.get('models', [])]
        except:
            return []
        return []
    
    def analyze_text(self, prompt: str, context: str) -> str:
        # Send text to Ollama model for analysis
        try:
            payload = {
                "model": self.model,
                "prompt": f"{prompt}\n\nNetwork Log Data:\n{context}",
                "stream": False,
                "options": {
                    "temperature": 0.1,  # Low temperature for consistent analysis
                    "top_p": 0.9,
                    "repeat_penalty": 1.1
                }
            }
            
            response = requests.post(
                f"{self.base_url}/api/generate",
                json=payload,
                timeout=30  # Reduced from 120s for faster response
            )
            
            if response.status_code == 200:
                return response.json().get('response', '')
            else:
                return f"Error: {response.status_code}"
                
        except Exception as e:
            return f"Error communicating with Ollama: {e}"


def typewriter_print(text: str, delay: float = 0.005):
    # Print text character by character like ChatGPT - fast but visible
    import sys
    import os
    
    # Force unbuffered output
    os.environ['PYTHONUNBUFFERED'] = '1'
    
    lines = text.split('\n')
    for line_idx, line in enumerate(lines):
        if line.strip():  # Only animate non-empty lines
            # Print in small chunks for speed while maintaining effect
            chunk_size = 3  # Print 3 characters at a time
            for i in range(0, len(line), chunk_size):
                chunk = line[i:i + chunk_size]
                sys.stdout.write(chunk)
                sys.stdout.flush()
                time.sleep(delay)
            sys.stdout.write('\n')
        else:
            sys.stdout.write('\n')
        sys.stdout.flush()


class NetworkLogAnalyzer:
    # Analyzes network monitoring logs using Ollama LLM
    
    def __init__(self, model_name: str = "llama3.2:3b", typewriter_mode: bool = False):
        self.ollama = OllamaClient(model=model_name)
        self.issues: List[Issue] = []
        self.typewriter_mode = typewriter_mode
        
    def run_monitoring_script(self, script_path: str, ocids: List[str],  realm: str = None, region: str = None, output_file: str = None,) -> str:
        # Execute the monitoring script with multiple OCIDs and return output file path
        if output_file is None:
            output_file = f"network_output_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"
            
        try:
            if len(ocids) == 1:
                print(f"\nExecuting monitoring script for OCID: {ocids[0]}")
            else:
                print(f"\nExecuting monitoring script for {len(ocids)} OCIDs: {', '.join(ocids[:3])}{'...' if len(ocids) > 3 else ''}")
            
            # Pass OCIDs as space-separated string (quoted for shell)
            ocid_string = " ".join(ocids)
            cmd = [sys.executable, script_path, "--ocid", f'"{ocid_string}"']
            
            # Add region and realm only if they are provided
            if region:
                cmd.extend(["--region", region])
            if realm:
                cmd.extend(["--realm", realm])

            print(f"DEBUG: Command: {' '.join(cmd)}")
            
            with open(output_file, 'w') as f:
                # result = subprocess.run(cmd, stdout=f, stderr=subprocess.STDOUT, 
                #                       text=True, timeout=600)  # Longer timeout for multiple OCIDs
                # result = subprocess.run(cmd, text = True, timeout = 600)
                tee_cmd = cmd + ["|", "tee", output_file]
                full_cmd = " ".join(cmd) + f" | tee {output_file}"
                result = subprocess.run(full_cmd, shell = True, text = True, timeout = 600)
            
            if result.returncode != 0:
                print(f"Script exited with code {result.returncode}")
            else:
                print(f"Output saved to: {output_file}")
                
            return output_file
            
        except subprocess.TimeoutExpired:
            print("Script timed out after 10 minutes")
            return output_file
        except Exception as e:
            print(f"Error running script: {e}")
            return output_file

    def analyze_log_with_llm(self, log_file: str, requested_ocids: List[str] = None) -> List[Issue]:
        # Analyze the log file using Ollama LLM
        try:
            with open(log_file, 'r') as f:
                content = f.read()
                
            print("\nChecking Ollama availability...")
            if not self.ollama.is_available():
                print(f"DEBUG: Ollama not available at {self.ollama.base_url}")
                print("DEBUG: Make sure Ollama is running: ollama serve")
                print("\nOllama service not available. Using fallback analysis...")
                return self._fallback_analysis_multi_ocid(content, requested_ocids)

            # Check if the model is available
            available_models = self.ollama.get_available_models()
            print(f"DEBUG: Available models: {available_models}")
            if self.ollama.model not in available_models:
                print(f"WARNING: Model {self.ollama.model} not found!")
                print("DEBUG: Try: ollama pull llama3.2:3b")
                if available_models:
                    print(f"DEBUG: Using first available model: {available_models[0]}")
                    self.ollama.model = available_models[0]
                else:
                    print("ERROR: No models available, falling back to pattern matching")
                    return self._fallback_analysis_multi_ocid(content, requested_ocids)

            print(f"\nUsing Ollama model: {self.ollama.model}")
            
            # Use optimal chunks for fast local LLM processing
            max_chunk_size = 5000  # Optimal size for local models - faster processing
            chunks = self._split_content(content, max_chunk_size)
            
            # Quick scan for critical issues first
            critical_patterns = [
                "FEC Corrected Errors              2482307",  # High FEC errors
                "Physical link is Down",  # Interface down
                "alarms currently active",  # Active alarms
                "bgpSessionState': 'DOWN'"  # BGP down
            ]

            has_critical_issues = any(pattern in content for pattern in critical_patterns)

            if has_critical_issues:
                print(f"\nCritical issues detected! Processing all {len(chunks)} chunks...")
            else:
                # Limit chunks for normal processing
                if len(chunks) > 2:
                    print(f"\nNo critical issues detected. Analyzing first 2 chunks of {len(chunks)} for speed...")
                    chunks = chunks[:2]
            
            all_issues = []
            
            for i, chunk in enumerate(chunks):
                print(f"\nAnalyzing chunk {i+1}/{len(chunks)}...")
                issues = self._analyze_chunk_with_llm(chunk, requested_ocids)
                all_issues.extend(issues)
            
            # Always run fallback analysis on full content for comprehensive detection
            print("\nRunning comprehensive pattern matching analysis...")
            fallback_issues = self._fallback_analysis_multi_ocid(content, requested_ocids)
            all_issues.extend(fallback_issues)
            
            # Prioritize pattern matching results over LLM results to reduce hallucinations
            print("Prioritizing pattern matching results over LLM analysis...")
            
            # Remove duplicates
            print("Removing duplicate issues...")
            deduplicated_issues = self._deduplicate_issues(all_issues)
            print(f"Removed {len(all_issues) - len(deduplicated_issues)} duplicate issues")
                
            return deduplicated_issues
            
        except Exception as e:
            print(f"Error during LLM analysis: {e}")
            return self._fallback_analysis_multi_ocid(content, requested_ocids)

    def _split_content(self, content: str, max_size: int) -> List[str]:
        # Split content into manageable chunks, skipping non-critical sections
        if len(content) <= max_size:
            return [content]

        # Skip setup and banner sections to focus on actual network data
        lines = content.split('\n')
        filtered_lines = []
        skip_section = False

        for line in lines:
            # Skip setup sections and command tables
            if any(skip_phrase in line for skip_phrase in [
                "SetUp Step", "Welcome to the", "Commands", "Pipe Commands",
                "Use help", "TAB is available", "+---------"]):
                skip_section = True
                continue

            # Start processing from actual network operations
            if "Operation: show interfaces" in line or "Physical interface:" in line:
                skip_section = False

            if not skip_section:
                filtered_lines.append(line)

        content = '\n'.join(filtered_lines)

        chunks = []
        current_chunk = ""

        for line in filtered_lines:
            if len(current_chunk + line + "\n") > max_size:
                if current_chunk:
                    chunks.append(current_chunk)
                    current_chunk = line + "\n"
                else:
                    # Single line is too long, split it
                    chunks.append(line[:max_size])
                    current_chunk = line[max_size:] + "\n"
            else:
                current_chunk += line + "\n"

        if current_chunk:
            chunks.append(current_chunk)

        return chunks

    def _analyze_chunk_with_llm(self, chunk: str, requested_ocids: List[str] = None) -> List[Issue]:
        """Analyze a chunk of log data with LLM"""
        analysis_prompt = """Analyze Juniper network device log data and return results as JSON.

CRITICAL RULES:
1. ONLY report issues that are explicitly present in the log data
2. Do NOT invent, assume, or hallucinate any issues
3. Do NOT report interfaces that don't exist in the log
4. Do NOT report BGP issues unless BGP data is actually present
5. Only use exact text from the log in details field

Look for these EXACT patterns in the log:
1. Device errors: "error: device" followed by "not found"
2. Interface down: "Physical link is Down" (exact text match)
3. High FEC errors: "FEC Corrected Errors" > 1000000 OR "FEC Uncorrected Errors" > 100
4. Fabric drops: "Fabric drops" > 0
5. Active alarms: "alarms currently active" with count > 0, followed by alarm details
6. LACP errors: "RpcError" or "invalid interface type"
7. BGP sessions down: "bgpSessionState': 'DOWN'" or "bgpIpv6SessionState': 'DOWN'"
8. High bit/block errors: "Bit errors" or "Errored blocks" with high counts
9. Light level issues: "Laser output power" or "Laser receiver power" outside normal ranges
10. Optical issues: "Laser bias current" too high or too low

VALIDATION RULES:
- Component must be an exact interface name from the log (et-0/1/1, et-1/1/5, etc.)
- Details must contain exact text from the log
- Description must be specific, not generic
- Do NOT use words like "detected", "found", "identified" in descriptions

For FEC errors, use these severity levels:
- HIGH: FEC Corrected > 2000000 OR FEC Uncorrected > 10000
- MEDIUM: FEC Corrected > 500000 OR FEC Uncorrected > 1000
- LOW: FEC Corrected > 100000 OR FEC Uncorrected > 100

Return ONLY this JSON format:
{
  "issues": [
    {
      "category": "Interface|BGP|Fabric|Alarm|LACP|Optics",
      "severity": "HIGH|MEDIUM|LOW",
      "component": "exact interface name from log",
      "description": "specific issue description",
      "details": "exact text from log showing the issue",
      "recommendation": "specific action to take"
    }
  ]
}

If no issues found, return:
{"issues": []}

Return ONLY valid JSON, no explanatory text:"""
        
        response = self.ollama.analyze_text(analysis_prompt, chunk)
        
        # Clean the response - remove any non-JSON text
        response = response.strip()
        
        # Try multiple JSON extraction methods
        parsed_issues = self._extract_json_from_response(response, requested_ocids)
        if parsed_issues is not None:
            print(f"Successfully parsed {len(parsed_issues)} issues from LLM")
            return parsed_issues
        
        # If all JSON parsing fails, return empty list (fallback will handle it)
        print("\nDEBUG: All JSON parsing methods failed!")
        print(f"DEBUG: Response length: {len(response)} characters")
        print(f"DEBUG: Response contains '{{': {'{' in response}")
        print(f"DEBUG: Response contains 'issues': {'issues' in response.lower()}")
        print("WARNING: Could not parse LLM response, falling back to pattern matching")
        return []
    
    def _extract_json_from_response(self, response: str, requested_ocids: List[str] = None) -> List[Issue]:
        """Try multiple methods to extract valid JSON from LLM response"""
        print(f"DEBUG: LLM raw response (first 500 chars): {response[:500]}...")

        # Method 0: Handle markdown code blocks (```json ... ```)
        try:
            import re
            code_block_pattern = r'```(?:json)?\s*\n?(.*?)\n?```'
            match = re.search(code_block_pattern, response, re.DOTALL)
            if match:
                json_content = match.group(1).strip()
                print(f"DEBUG: Found JSON in code block: {json_content[:200]}...")
                data = json.loads(json_content)
                return self._convert_json_to_issues(data, requested_ocids)
        except json.JSONDecodeError as e:
            print(f"DEBUG: Code block JSON parsing failed: {e}")
            pass

        # Method 1: Try parsing the entire response as JSON
        try:
            data = json.loads(response)
            print(f"DEBUG: Successfully parsed entire response as JSON")
            return self._convert_json_to_issues(data, requested_ocids)
        except json.JSONDecodeError as e:
            print(f"DEBUG: Full response JSON parsing failed: {e}")
            pass
        
        # Method 2: Look for JSON between curly braces
        try:
            json_start = response.find('{')
            json_end = response.rfind('}') + 1
            if json_start >= 0 and json_end > json_start:
                json_str = response[json_start:json_end]
                print(f"DEBUG: Extracted JSON between braces: {json_str[:200]}...")
                data = json.loads(json_str)
                print(f"DEBUG: Successfully parsed JSON between braces")
                return self._convert_json_to_issues(data, requested_ocids)
        except json.JSONDecodeError as e:
            print(f"DEBUG: Brace extraction JSON parsing failed: {e}")
            pass
        
        # Method 3: Look for multiple JSON objects
        try:
            # Try to find all JSON-like structures
            import re
            json_pattern = r'\{[^{}]*"issues"[^{}]*\[[^\]]*\][^{}]*\}'
            matches = re.findall(json_pattern, response, re.DOTALL)
            for match in matches:
                try:
                    data = json.loads(match)
                    return self._convert_json_to_issues(data, requested_ocids)
                except json.JSONDecodeError:
                    continue
        except:
            pass
        
        # Method 4: Try to fix common JSON issues
        try:
            # Remove any text before first { and after last }
            cleaned = response
            if '{' in cleaned and '}' in cleaned:
                start = cleaned.find('{')
                end = cleaned.rfind('}') + 1
                cleaned = cleaned[start:end]
                
                # Fix common issues
                cleaned = cleaned.replace("'", '"')  # Replace single quotes
                cleaned = re.sub(r',\s*}', '}', cleaned)  # Remove trailing commas
                cleaned = re.sub(r',\s*]', ']', cleaned)  # Remove trailing commas in arrays
                
                data = json.loads(cleaned)
                return self._convert_json_to_issues(data, requested_ocids)
        except:
            pass
        
        return None
    
    def _convert_json_to_issues(self, data: dict, requested_ocids: List[str] = None) -> List[Issue]:
        # Convert parsed JSON data to Issue objects with validation
        issues = []
        for issue_data in data.get('issues', []):
            # Validate the issue data to prevent hallucinations
            if self._validate_issue_data(issue_data):
                # Use the first requested OCID if available, otherwise leave blank
                ocid = requested_ocids[0] if requested_ocids and len(requested_ocids) > 0 else ""
                issue = Issue(
                    category=issue_data.get('category', 'Unknown'),
                    severity=issue_data.get('severity', 'MEDIUM'),
                    component=issue_data.get('component', 'Unknown'),
                    description=issue_data.get('description', ''),
                    details=issue_data.get('details', ''),
                    recommendation=issue_data.get('recommendation', ''),
                    ocid=ocid
                )
                issues.append(issue)
        return issues
    
    def _validate_issue_data(self, issue_data: dict) -> bool:
        """Validate issue data to prevent hallucinations and ensure only real data is reported"""
        # Check for empty or suspicious data
        if not issue_data.get('component') or issue_data.get('component') == 'Unknown':
            return False
        
        # Check for empty descriptions or details
        if not issue_data.get('description') or not issue_data.get('details'):
            return False
        
        # Check for suspiciously high numbers that might be hallucinated
        details = issue_data.get('details', '')
        if any(suspicious in details for suspicious in ['10000', '5000', '123456', '999999']):
            # These are common hallucinated numbers
            return False
        
        # Check for valid interface format using flexible regex
        component = issue_data.get('component', '')
        
        # Generic interface patterns that can match any valid interface format
        # Pattern 1: Interface with slot/port format (et-0/1/1, ge-0/0/0, xe-1/2/3, etc.)
        slot_port_pattern = r'^[a-zA-Z]+-\d+/\d+/\d+$'
        
        # Pattern 2: Interface with single number (ae0, lo0, fxp1, etc.)
        single_number_pattern = r'^[a-zA-Z]+\d+$'
        
        # Pattern 3: Interface with dot notation (vlan.100, irb.200, st0.0, etc.)
        dot_notation_pattern = r'^[a-zA-Z]+\.\d+$'
        
        # Pattern 4: Interface with multiple dashes and numbers (gr-0/0/0, lt-1/2/3, etc.)
        multi_dash_pattern = r'^[a-zA-Z]+-\d+/\d+/\d+$'
        
        # Check if component looks like an interface using flexible patterns
        is_interface = (re.match(slot_port_pattern, component) or 
                       re.match(single_number_pattern, component) or 
                       re.match(dot_notation_pattern, component) or 
                       re.match(multi_dash_pattern, component))
        
        if is_interface:
            # This is a valid interface format
            pass
        elif component and not any(keyword in component.lower() for keyword in ['fabric', 'chassis', 'system', 'host', 'lane', 'none', 'bgp', 'lacp', 'alarm']):
            # If it's not a valid interface format and not a known non-interface component, it might be hallucinated
            return False
        
        # Check for BGP issues that might be hallucinated
        if issue_data.get('category') == 'BGP':
            # Only allow BGP issues if BGP data is actually present in the log
            # This will be checked by the pattern matching logic
            return False
        
        # Check for generic descriptions that might be hallucinated
        description = issue_data.get('description', '').lower()
        if any(generic in description for generic in ['detected', 'found', 'identified']):
            # These are often hallucinated generic descriptions
            return False
        
        # Check for false "Physical link is Down" reports
        if "physical link is down" in description.lower():
            # This is often hallucinated - interfaces are usually up
            return False
        
        # Check for suspicious details that don't match the description
        details = issue_data.get('details', '').lower()
        if "physical link is down" in details and "physical link is up" in details:
            # Contradictory information - likely hallucinated
            return False
        
        return True

    def _is_valid_interface(self, interface_name: str) -> bool:
        """Check if a string looks like a valid interface name using flexible regex patterns"""
        # Generic interface patterns that can match any valid interface format
        # Pattern 1: Interface with slot/port format (et-0/1/1, ge-0/0/0, xe-1/2/3, etc.)
        slot_port_pattern = r'^[a-zA-Z]+-\d+/\d+/\d+$'
        
        # Pattern 2: Interface with single number (ae0, lo0, fxp1, etc.)
        single_number_pattern = r'^[a-zA-Z]+\d+$'
        
        # Pattern 3: Interface with dot notation (vlan.100, irb.200, st0.0, etc.)
        dot_notation_pattern = r'^[a-zA-Z]+\.\d+$'
        
        # Pattern 4: Interface with multiple dashes and numbers (gr-0/0/0, lt-1/2/3, etc.)
        multi_dash_pattern = r'^[a-zA-Z]+-\d+/\d+/\d+$'
        
        # Check if it matches any of the flexible patterns
        return (re.match(slot_port_pattern, interface_name) or 
                re.match(single_number_pattern, interface_name) or 
                re.match(dot_notation_pattern, interface_name) or 
                re.match(multi_dash_pattern, interface_name))

    def _check_light_levels(self, lines: List[str], issues: List[Issue]) -> None:
        """Check for light level issues in optical interfaces"""
        current_interface = None
        in_optics_section = False
        light_levels = {}
        
        for i, line in enumerate(lines):
            # Detect start of optics diagnostics section
            if "show interfaces diagnostics optics" in line:
                in_optics_section = True
                # Extract interface name from the command
                interface_match = re.search(r'diagnostics optics (\S+)', line)
                if interface_match:
                    current_interface = interface_match.group(1)
                    light_levels[current_interface] = {}
                continue
            
            # Detect end of optics section
            if in_optics_section and (line.startswith('<') or line.startswith('ncpcli@')):
                in_optics_section = False
                current_interface = None
                continue
            
            if in_optics_section and current_interface:
                # Extract laser output power
                output_power_match = re.search(r'Laser output power\s+:\s+([\d.]+)\s+mW\s+/\s+([\d.-]+)\s+dBm', line)
                if output_power_match:
                    power_mw = float(output_power_match.group(1))
                    power_dbm = float(output_power_match.group(2))
                    light_levels[current_interface]['output_power'] = {
                        'mw': power_mw,
                        'dbm': power_dbm
                    }
                
                # Extract laser receiver power
                rx_power_match = re.search(r'Laser receiver power\s+:\s+([\d.]+)\s+mW\s+/\s+([\d.-]+)\s+dBm', line)
                if rx_power_match:
                    power_mw = float(rx_power_match.group(1))
                    power_dbm = float(rx_power_match.group(2))
                    light_levels[current_interface]['rx_power'] = {
                        'mw': power_mw,
                        'dbm': power_dbm
                    }
                
                # Extract laser bias current
                bias_current_match = re.search(r'Laser bias current\s+:\s+([\d.]+)\s+mA', line)
                if bias_current_match:
                    bias_current = float(bias_current_match.group(1))
                    light_levels[current_interface]['bias_current'] = bias_current
                
                # Extract thresholds
                high_alarm_match = re.search(r'Laser output power high alarm threshold\s+:\s+([\d.]+)\s+mW\s+/\s+([\d.-]+)\s+dBm', line)
                if high_alarm_match:
                    high_mw = float(high_alarm_match.group(1))
                    high_dbm = float(high_alarm_match.group(2))
                    light_levels[current_interface]['high_alarm_threshold'] = {
                        'mw': high_mw,
                        'dbm': high_dbm
                    }
                
                low_alarm_match = re.search(r'Laser output power low alarm threshold\s+:\s+([\d.]+)\s+mW\s+/\s+([\d.-]+)\s+dBm', line)
                if low_alarm_match:
                    low_mw = float(low_alarm_match.group(1))
                    low_dbm = float(low_alarm_match.group(2))
                    light_levels[current_interface]['low_alarm_threshold'] = {
                        'mw': low_mw,
                        'dbm': low_dbm
                    }
        
        # Analyze light levels for each interface
        for interface, levels in light_levels.items():
            if not self._is_valid_interface(interface):
                continue
                
            # Check if we have complete light level data
            if 'output_power' in levels and 'high_alarm_threshold' in levels and 'low_alarm_threshold' in levels:
                output_dbm = levels['output_power']['dbm']
                high_threshold = levels['high_alarm_threshold']['dbm']
                low_threshold = levels['low_alarm_threshold']['dbm']
                
                # Check for light level issues
                if output_dbm > high_threshold:
                    issues.append(Issue(
                        category="Optics",
                        severity="HIGH",
                        component=interface,
                        description="Laser output power too high",
                        details=f"Output power: {output_dbm:.2f} dBm (threshold: {high_threshold:.2f} dBm)",
                        recommendation="Check optical power settings and consider attenuation"
                    ))
                elif output_dbm < low_threshold:
                    issues.append(Issue(
                        category="Optics",
                        severity="HIGH",
                        component=interface,
                        description="Laser output power too low",
                        details=f"Output power: {output_dbm:.2f} dBm (threshold: {low_threshold:.2f} dBm)",
                        recommendation="Check optical connections, clean connectors, or replace transceiver"
                    ))
                else:
                    # Light levels are good - report as informational
                    issues.append(Issue(
                        category="Optics",
                        severity="LOW",
                        component=interface,
                        description="Light levels normal",
                        details=f"Output power: {output_dbm:.2f} dBm (within {low_threshold:.2f} to {high_threshold:.2f} dBm range)",
                        recommendation="Optical power levels are within acceptable range"
                    ))
            
            # Check receiver power if available
            if 'rx_power' in levels:
                rx_dbm = levels['rx_power']['dbm']
                if rx_dbm < -20:  # Very low receiver power
                    issues.append(Issue(
                        category="Optics",
                        severity="MEDIUM",
                        component=interface,
                        description="Low receiver power",
                        details=f"Receiver power: {rx_dbm:.2f} dBm (very low)",
                        recommendation="Check optical connections and fiber quality"
                    ))
                elif rx_dbm > 5:  # Very high receiver power
                    issues.append(Issue(
                        category="Optics",
                        severity="MEDIUM",
                        component=interface,
                        description="High receiver power",
                        details=f"Receiver power: {rx_dbm:.2f} dBm (very high)",
                        recommendation="Check for optical amplifier issues or excessive input power"
                    ))
            
            # Check bias current if available
            if 'bias_current' in levels:
                bias_current = levels['bias_current']
                if bias_current > 80:  # High bias current
                    issues.append(Issue(
                        category="Optics",
                        severity="MEDIUM",
                        component=interface,
                        description="High laser bias current",
                        details=f"Bias current: {bias_current:.2f} mA (high)",
                        recommendation="Monitor laser health, may indicate aging transceiver"
                    ))
                elif bias_current < 5:  # Low bias current
                    issues.append(Issue(
                        category="Optics",
                        severity="MEDIUM",
                        component=interface,
                        description="Low laser bias current",
                        details=f"Bias current: {bias_current:.2f} mA (low)",
                        recommendation="Check laser functionality and transceiver health"
                    ))

    def _fallback_analysis(self, content: str) -> List[Issue]:
        # Fallback analysis using pattern matching if LLM is unavailable
        issues = []
        lines = content.split('\n')
        
        # Check for BGP issues (handle both quote formats)
        if "bgpSessionState': 'DOWN'" in content or '"bgpSessionState": "DOWN"' in content:
            issues.append(Issue(
                category="BGP",
                severity="HIGH", 
                component="BGP IPv4 Session",
                description="BGP IPv4 session is down",
                details="BGP session state is DOWN",
                recommendation="Check BGP configuration, routing, and peer connectivity"
            ))
            
        if "bgpIpv6SessionState': 'DOWN'" in content or '"bgpIpv6SessionState": "DOWN"' in content:
            issues.append(Issue(
                category="BGP",
                severity="HIGH", 
                component="BGP IPv6 Session", 
                description="BGP IPv6 session is down",
                details="BGP IPv6 session state is DOWN",
                recommendation="Check IPv6 BGP configuration and connectivity"
            ))
        
        # Check for redundancy SLA issues (handle both quote formats)
        if "ipv4bgpSessionRedundancyStatus': 'NOT_MET_SLA'" in content or '"ipv4bgpSessionRedundancyStatus": "NOT_MET_SLA"' in content:
            issues.append(Issue(
                category="Redundancy",
                severity="HIGH",
                component="IPv4 BGP Redundancy",
                description="IPv4 BGP redundancy SLA not met",
                details="ipv4bgpSessionRedundancyStatus: NOT_MET_SLA",
                recommendation="Check redundant BGP sessions and failover configuration"
            ))
            
        if "ipv6bgpSessionRedundancyStatus': 'NOT_MET_SLA'" in content or '"ipv6bgpSessionRedundancyStatus": "NOT_MET_SLA"' in content:
            issues.append(Issue(
                category="Redundancy", 
                severity="HIGH",
                component="IPv6 BGP Redundancy",
                description="IPv6 BGP redundancy SLA not met", 
                details="ipv6bgpSessionRedundancyStatus: NOT_MET_SLA",
                recommendation="Check IPv6 redundant BGP sessions and failover configuration"
            ))
        
        # Check for device not found errors
        for i, line in enumerate(lines):
            if "error: device" in line and "not found" in line:
                # Extract interface name from the error using regex
                interface_match = re.search(r'device (\S+) not found', line)
                if interface_match:
                    interface_name = interface_match.group(1)
                    # Validate that it looks like an interface
                    if self._is_valid_interface(interface_name):
                        issues.append(Issue(
                            category="Interface",
                            severity="HIGH",
                            component=interface_name,
                            description="Device not found",
                            details=line.strip(),
                            recommendation="Check interface configuration and physical connections"
                        ))
        
        # Check for interface down status (only if actually down)
        for i, line in enumerate(lines):
            if "Physical link is Down" in line:
                # Look for interface name in previous lines using regex
                interface_name = "Unknown"
                for j in range(max(0, i-5), i):
                    if "Physical interface:" in lines[j]:
                        interface_match = re.search(r'Physical interface: (\S+)', lines[j])
                        if interface_match:
                            interface_name = interface_match.group(1)
                            break
                
                # Validate that it looks like an interface
                if not self._is_valid_interface(interface_name):
                    continue
                
                # Double-check that this interface is actually down
                # Look for "Physical link is Up" in the same interface section
                is_actually_down = True
                for k in range(i, min(len(lines), i+10)):
                    if "Physical link is Up" in lines[k]:
                        is_actually_down = False
                        break
                    if "Physical interface:" in lines[k] and k > i:
                        # We've moved to the next interface
                        break
                
                if is_actually_down:
                    issues.append(Issue(
                        category="Interface",
                        severity="HIGH",
                        component=interface_name,
                        description="Interface down",
                        details="Physical link is Down",
                        recommendation="Check physical connections and interface configuration"
                    ))
        
        # Check for high FEC errors
        fec_pattern = r'FEC Corrected Errors\s+(\d+)'
        interface_context = None
        
        for i, line in enumerate(lines):
            # Track current interface context
            if_match = re.search(r'Physical interface: ([\w/-]+)', line)
            if if_match:
                interface_context = if_match.group(1)
                # Validate that it looks like an interface
                if not self._is_valid_interface(interface_context):
                    interface_context = None
                
            # Check for high FEC errors
            fec_match = re.search(fec_pattern, line)
            if fec_match and interface_context:
                errors = int(fec_match.group(1))
                if errors > 10000000000:  # 10B+ errors threshold
                    issues.append(Issue(
                        category="Interface",
                        severity="MEDIUM",
                        component=interface_context,
                        description="High FEC corrected errors detected",
                        details=f"FEC corrected errors: {errors:,} on {interface_context}",
                        recommendation="Monitor for signal quality issues, check cable connections"
                    ))
        
        # Check for interface issues
        for i, line in enumerate(lines, 1):
            # Check for interface down
            if re.search(r'Physical link is Down', line):
                interface_match = re.search(r'Physical interface: ([\w/-]+)', line)
                interface = interface_match.group(1) if interface_match else "Unknown"
                issues.append(Issue(
                    category="Interface",
                    severity="HIGH",
                    component=interface,
                    description="Physical link is down",
                    details=line.strip(),
                    recommendation="Check cable connections and interface configuration"
                ))
            
            # Check for disabled interfaces
            if re.search(r'Physical interface: [\w/-]+, Disabled', line):
                interface_match = re.search(r'Physical interface: ([\w/-]+)', line)
                interface = interface_match.group(1) if interface_match else "Unknown"
                issues.append(Issue(
                    category="Interface",
                    severity="MEDIUM",
                    component=interface,
                    description="Interface is administratively disabled",
                    details=line.strip(),
                    recommendation="Enable interface if needed: no shutdown"
                ))
            
            # Check for device not found errors
            if re.search(r'error: device .* not found', line):
                issues.append(Issue(
                    category="Error",
                    severity="MEDIUM",
                    component="Device",
                    description="Device not found error",
                    details=line.strip(),
                    recommendation="Verify device name and configuration"
                ))
            
            # Check for fabric drops
            if re.search(r'Fabric.*drops\s*:\s*(\d+)', line):
                drops_match = re.search(r'Fabric.*drops\s*:\s*(\d+)', line)
                if drops_match and int(drops_match.group(1)) > 0:
                    issues.append(Issue(
                        category="Fabric", 
                        severity="MEDIUM",
                        component="Fabric",
                        description="Fabric packet drops detected",
                        details=f"Fabric drops: {drops_match.group(1)}",
                        recommendation="Investigate fabric congestion or hardware issues"
                    ))
        
        # Check for LACP errors
        for i, line in enumerate(lines):
            if "RpcError" in line and "invalid interface type" in line:
                issues.append(Issue(
                    category="LACP",
                    severity="MEDIUM",
                    component="LACP",
                    description="LACP configuration error",
                    details=line.strip(),
                    recommendation="Check LACP interface configuration and valid interface types"
                ))
        
        # Check for light level issues
        self._check_light_levels(lines, issues)
        
        # Check for active alarms (other than "No alarms")
        in_alarm_section = False
        for i, line in enumerate(lines, 1):
            if 'show chassis alarms' in line.lower() or 'show system alarms' in line.lower():
                in_alarm_section = True
                alarm_type = "Chassis" if "chassis" in line.lower() else "System"
                continue
                
            if in_alarm_section:
                if line.strip() and "No alarms currently active" not in line and "Result:" not in line:
                    if not line.startswith('*') and not line.startswith('<') and line.strip():
                        issues.append(Issue(
                            category="Alarm",
                            severity="HIGH",
                            component=f"{alarm_type} Alarms",
                            description="Active alarm detected",
                            details=line.strip(),
                            recommendation="Investigate and resolve alarm condition"
                        ))
                
                # Exit alarm section on next command
                if line.startswith('<') and line.endswith('>'):
                    in_alarm_section = False
        
        return issues

    def _fallback_analysis_multi_ocid(self, content: str, requested_ocids: List[str] = None) -> List[Issue]:
        # Enhanced fallback analysis that tracks OCID for each issue
        issues = []
        lines = content.split('\n')
        
        if requested_ocids:
            # Only analyze the specifically requested OCIDs
            for ocid in requested_ocids:
                # Find sections in the log that relate to this OCID
                ocid_sections = self._extract_sections_for_ocid(content, ocid)
                for section_content in ocid_sections:
                    section_issues = self._analyze_section(section_content, ocid)
                    issues.extend(section_issues)
        else:
            # Fallback to old behavior if no specific OCIDs requested
            bgp_sections = self._split_by_ocid_context(content)
            for section_ocid, section_content in bgp_sections.items():
                section_issues = self._analyze_section(section_content, section_ocid)
                issues.extend(section_issues)
            
        return issues
    
    def _extract_sections_for_ocid(self, content: str, target_ocid: str) -> List[str]:
        # Extract sections of content that relate to a specific OCID
        lines = content.split('\n')
        sections = []
        current_section = []
        in_relevant_section = False
        
        for line in lines:
            # Check if this line starts processing for our target OCID
            if f"PROCESSING OCID: {target_ocid}" in line:
                in_relevant_section = True
                current_section = [line]
                continue
            
            # Check if we've reached the end of this OCID's section
            if f"END OCID: {target_ocid}" in line:
                in_relevant_section = False
                current_section.append(line)
                sections.append('\n'.join(current_section))
                current_section = []
                continue
            
            # If we're in a relevant section, or if the line mentions our OCID, include it
            if in_relevant_section or target_ocid in line:
                current_section.append(line)
        
        # Add any remaining content
        if current_section:
            sections.append('\n'.join(current_section))
        
        # If no specific sections found, analyze entire content but tag with the requested OCID
        if not sections:
            sections.append(content)
            
        return sections
    
    def _split_by_ocid_context(self, content: str) -> Dict[str, str]:
        # Split content by OCID context to associate issues with correct OCIDs
        sections = {}
        lines = content.split('\n')
        current_ocid = "unknown"
        current_section = []
        
        for line in lines:
            # Look for OCID patterns in the line
            ocid_match = re.search(r'ocid1\.[a-zA-Z0-9.-]+', line)
            if ocid_match:
                # Save previous section
                if current_section:
                    sections[current_ocid] = '\n'.join(current_section)
                # Start new section
                current_ocid = ocid_match.group(0)
                current_section = [line]
            else:
                current_section.append(line)
        
        # Save the last section
        if current_section:
            sections[current_ocid] = '\n'.join(current_section)
        
        # If no OCIDs found, treat as single section
        if not sections:
            sections["unknown"] = content
            
        return sections
    
