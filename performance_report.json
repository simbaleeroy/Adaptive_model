export const getActionName = (user: any) => {
  const currentFlowType = getCurrentCreateFlowType(user);
  //   console.log("getActionName Flow Type ===>", currentFlowType);

  const formFields = user?.forms?.["intent.fast-connect.create.Step2"]?.$formFields;
  const isCCGroup = formFields?.crossConnectType === CrossConnectType.Group;

  switch (currentFlowType) {
    case "type1":
      return [VirtualCircuitDetailsActions.createVCSubmit1];

    case "type2":
      return [VirtualCircuitDetailsActions.createVCSubmit2];

    case "type3":
      return isCCGroup
        ? [VirtualCircuitDetailsActions.createVCSubmit3CCGroup]
        : [VirtualCircuitDetailsActions.createVCSubmit3];

    case "type4":
      return isCCGroup
        ? [VirtualCircuitDetailsActions.createVCSubmit4CCGroup]
        : [VirtualCircuitDetailsActions.createVCSubmit4];

    case "type5":
      return isCCGroup
        ? [VirtualCircuitDetailsActions.createVCSubmit5CCGroup]
        : [VirtualCircuitDetailsActions.createVCSubmit5];

    default:
      //   console.warn("Unknown flow type. Returning empty body.");
      return "";
  }
};

export const getSaveAsStackResourceName = ($user: UserState) => {
  const currentFlowType = getCurrentCreateFlowType($user);
  const formFields = ($user?.forms?.[IntentId.CreateStep2] as any)?.$formFields;
  const isCCGroup = formFields?.crossConnectType === CrossConnectType.Group;
  const numberOfCrossConnectsCCG1 = formFields?.[CrossConnectFieldNames.NumberOfCrossConnects];
  const numberOfCrossConnectsCCG2 =
    formFields?.[`${CrossConnectFieldNames.NumberOfCrossConnects}-1`];

  switch (currentFlowType) {
    case "type1":
      return [
        "generated_" + TerraformResourceTypes.VirtualCircuit,
        "generated_" + TerraformResourceTypes.VirtualCircuit + "_redundant",
      ];
    case "type2":
      return "generated_" + TerraformResourceTypes.VirtualCircuit;
    case "type3":
    case "type4":
      return isCCGroup
        ? [
            "generated_" + TerraformResourceTypes.CrossConnectGroup,
            ...new Array(numberOfCrossConnectsCCG1)
              .fill(0)
              .map((_, index) => `generated_${TerraformResourceTypes.CrossConnect}_${index + 1}`),
            "generated_" + TerraformResourceTypes.CrossConnectGroup + "_redundant",
            ...new Array(numberOfCrossConnectsCCG2)
              .fill(0)
              .map(
                (_, index) =>
                  `generated_${TerraformResourceTypes.CrossConnect}_redundant_${index + 1}`,
              ),
          ]
        : [
            "generated_" + TerraformResourceTypes.CrossConnect,
            "generated_" + TerraformResourceTypes.CrossConnect + "_redundant",
          ];
    case "type5":
      return isCCGroup
        ? [
            "generated_" + TerraformResourceTypes.CrossConnectGroup,
            ...new Array(numberOfCrossConnectsCCG1)
              .fill(0)
              .map((_, index) => `generated_${TerraformResourceTypes.CrossConnect}_${index + 1}`),
          ]
        : "generated_" + TerraformResourceTypes.CrossConnect;
  }
};

export const getSaveAsStackResourceType = ($user: UserState) => {
  const currentFlowType = getCurrentCreateFlowType($user);
  const formFields = ($user?.forms?.[IntentId.CreateStep2] as any)?.$formFields;
  const isCCGroup = formFields?.crossConnectType === CrossConnectType.Group;
  const numberOfCrossConnectsCCG1 = formFields?.[CrossConnectFieldNames.NumberOfCrossConnects];
  const numberOfCrossConnectsCCG2 =
    formFields?.[`${CrossConnectFieldNames.NumberOfCrossConnects}-1`];

  switch (currentFlowType) {
    case "type1":
      return [TerraformResourceTypes.VirtualCircuit, TerraformResourceTypes.VirtualCircuit];
    case "type2":
      return TerraformResourceTypes.VirtualCircuit;
    case "type3":
    case "type4":
      return isCCGroup
        ? [
            TerraformResourceTypes.CrossConnectGroup,
            ...new Array(numberOfCrossConnectsCCG1).fill(TerraformResourceTypes.CrossConnect),
            TerraformResourceTypes.CrossConnectGroup,
            ...new Array(numberOfCrossConnectsCCG2).fill(TerraformResourceTypes.CrossConnect),
          ]
        : [TerraformResourceTypes.CrossConnect, TerraformResourceTypes.CrossConnect];
    case "type5":
      return isCCGroup
        ? [
            TerraformResourceTypes.CrossConnectGroup,
            ...new Array(numberOfCrossConnectsCCG1).fill(TerraformResourceTypes.CrossConnect),
          ]
        : TerraformResourceTypes.CrossConnect;
  }
};

export const getSaveAsStackResourceObject = ($user: UserState) => {
  const currentFlowType = getCurrentCreateFlowType($user);
  const formFields = ($user?.forms?.[IntentId.CreateStep2] as any)?.$formFields;
  const isCCGroup = formFields?.crossConnectType === CrossConnectType.Group;

  switch (currentFlowType) {
    case "type1":
      return [getType1Body($user, 1), getType1Body($user, 2)];
    case "type2":
      return getType2Body($user);
    case "type3":
      return isCCGroup
        ? [
            getCrossConnectGroupBody($user, 1),
            ...getTerraformMultipleCCs(
              getMultipleCrossConnectsBody($user, {
                id: getTerraformCCGId("generated_" + TerraformResourceTypes.CrossConnectGroup),
              } as DEFINITION_CoreServicesApi_CrossConnectGroup),
            ),
            getCrossConnectGroupBody($user, 2),
            ...getTerraformMultipleCCs(
              getMultipleCrossConnectsBodyC2(
                $user,
                {
                  id: getTerraformCCGId(
                    "generated_" + TerraformResourceTypes.CrossConnectGroup + "_redundant",
                  ),
                } as DEFINITION_CoreServicesApi_CrossConnectGroup,
                {
                  id: getTerraformCCGId("generated_" + TerraformResourceTypes.CrossConnectGroup),
                } as DEFINITION_CoreServicesApi_CrossConnectGroup,
              ),
            ),
          ]
        : [getType3SingleCCBody($user, 1), getType3SingleCCBody($user, 2)];
    case "type4":
      return isCCGroup
        ? [
            getCrossConnectGroupBody($user, 1),
            ...getTerraformMultipleCCs(
              getMultipleCrossConnectsBody($user, {
                id: getTerraformCCGId("generated_" + TerraformResourceTypes.CrossConnectGroup),
              } as DEFINITION_CoreServicesApi_CrossConnectGroup),
            ),
            getCrossConnectGroupBody($user, 2),
            ...getTerraformMultipleCCs(
              getMultipleCrossConnectsBodyC2(
                $user,
                {
                  id: getTerraformCCGId(
                    "generated_" + TerraformResourceTypes.CrossConnectGroup + "_redundant",
                  ),
                } as DEFINITION_CoreServicesApi_CrossConnectGroup,
                {
                  id: getTerraformCCGId("generated_" + TerraformResourceTypes.CrossConnectGroup),
                } as DEFINITION_CoreServicesApi_CrossConnectGroup,
              ),
            ),
          ]
        : [
            getType4SingleCCBody($user, 1),
            getType4SingleCCBody($user, 2, {
              id: getTerraformCC1Id("generated_" + TerraformResourceTypes.CrossConnect),
            }),
          ];
    case "type5":
      return isCCGroup
        ? [
            getCrossConnectGroupBody($user, 1),
            ...getTerraformMultipleCCs(
              getMultipleCrossConnectsBody($user, {
                id: getTerraformCCGId("generated_" + TerraformResourceTypes.CrossConnectGroup),
              } as DEFINITION_CoreServicesApi_CrossConnectGroup),
              formFields?.displayName,
            ),
          ]
        : getSingleCrossConnectBody($user);
  }
};

export const getTerraformCC1Id = (ccName: string) =>
  "${" + `${TerraformResourceTypes.CrossConnect}.${ccName}.id` + "}";

export const getTerraformCCGId = (ccgName: string) =>
  "${" + `${TerraformResourceTypes.CrossConnectGroup}.${ccgName}.id` + "}";

export const getTerraformCCGDisplayName = (ccgName: string) =>
  "${" + `${TerraformResourceTypes.CrossConnectGroup}.${ccgName}.displayName` + "}";

export const getTerraformMultipleCCs = (
  ccPayloads: Array<{ crossConnectPayload: Record<string, any> }>,
  ccgDisplayName?: string,
) => {
  return ccPayloads.map((item, index) => ({
    ...item.crossConnectPayload,
    displayName: ccgDisplayName
      ? `${ccgDisplayName}-${index + 1}`
      : `${getTerraformCCGDisplayName("generated_" + TerraformResourceTypes.CrossConnectGroup)}-${index + 1}`,
  }));
};

export const displayNamePlusOcidSuffix = (name: string, suffix: string): string => {
  return `${name}   ...${suffix}`;
};

export const validateSelectedCrossConnectOrGroup = (
  crossConnectMappings: CrossConnectMapping[],
  currentIndex: number,
) => {
  const selectedId =
    crossConnectMappings?.[currentIndex]?.[
      VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId
    ];
  if (!selectedId) return true; // No selection made yet

  // Check for duplicates in the array excluding the current index
  return crossConnectMappings.every(
    (mapping, index) =>
      index === currentIndex ||
      mapping?.[VirtualCircuitFieldNames.CrossConnectOrCrossConnectGroupId] !== selectedId,
  );
};
